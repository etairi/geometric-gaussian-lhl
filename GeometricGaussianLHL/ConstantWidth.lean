section BerryEsseenNumericalCertification

noncomputable section
set_option backward.isDefEq.respectTransparency false
open MeasureTheory ProbabilityTheory Set Filter
open scoped BigOperators Interval Topology
namespace GeometricGaussianLHL

/-- A real exponential has the same explicit Taylor remainder as the complex exponential. -/
theorem berryEsseen_exp_taylor_remainder {x : ℝ} {n : ℕ}
    (hx : |x| / (n + 1) ≤ 1 / 2) :
    |Real.exp x - ∑ m ∈ Finset.range n, x ^ m / m.factorial| ≤
      |x| ^ n / n.factorial * 2 := by
  have hxc : ‖(x : ℂ)‖ / (n + 1) ≤ 1 / 2 := by simpa using hx
  have h := Complex.exp_bound' (n := n) (x := (x : ℂ)) (by simpa using hxc)
  norm_cast at h ⊢

/-- Rational arithmetic data sufficient to certify an upper bound for the exponential. -/
def berryEsseenExpUpperCheck (x y : ℚ) (n : ℕ) : Prop :=
  |x| / (n + 1) ≤ 1 / 2 ∧
    (∑ m ∈ Finset.range n, x ^ m / m.factorial) + |x| ^ n / n.factorial * 2 ≤ y

instance (x y : ℚ) (n : ℕ) : Decidable (berryEsseenExpUpperCheck x y n) := by
  unfold berryEsseenExpUpperCheck
  infer_instance

/-- Correctness of the rational exponential checker; the data are checked by the kernel. -/
theorem berryEsseen_exp_le_of_check {x y : ℚ} {n : ℕ}
    (h : berryEsseenExpUpperCheck x y n) : Real.exp (x : ℝ) ≤ (y : ℝ) := by
  obtain ⟨hsmall, hsum⟩ := h
  have hx : |(x : ℝ)| / (n + 1) ≤ 1 / 2 := by
    have h := (Rat.cast_le (K := ℝ)).mpr hsmall
    simpa only [Rat.cast_div, Rat.cast_abs, Rat.cast_add, Rat.cast_natCast, Rat.cast_one, Rat.cast_ofNat] using h
  have hs : (∑ m ∈ Finset.range n, (x : ℝ) ^ m / m.factorial) +
      |(x : ℝ)| ^ n / n.factorial * 2 ≤ (y : ℝ) := by exact_mod_cast hsum
  have hb := (abs_le.mp (berryEsseen_exp_taylor_remainder hx)).2
  linarith

/-- Rational arithmetic data sufficient to certify a lower bound for the exponential. -/
def berryEsseenExpLowerCheck (x y : ℚ) (n : ℕ) : Prop :=
  |x| / (n + 1) ≤ 1 / 2 ∧
    y ≤ (∑ m ∈ Finset.range n, x ^ m / m.factorial) - |x| ^ n / n.factorial * 2

instance (x y : ℚ) (n : ℕ) : Decidable (berryEsseenExpLowerCheck x y n) := by
  unfold berryEsseenExpLowerCheck
  infer_instance

/-- Correctness of the rational lower exponential checker. -/
theorem berryEsseen_le_exp_of_check {x y : ℚ} {n : ℕ}
    (h : berryEsseenExpLowerCheck x y n) : (y : ℝ) ≤ Real.exp (x : ℝ) := by
  obtain ⟨hsmall, hsum⟩ := h
  have hx : |(x : ℝ)| / (n + 1) ≤ 1 / 2 := by
    have h := (Rat.cast_le (K := ℝ)).mpr hsmall
    simpa only [Rat.cast_div, Rat.cast_abs, Rat.cast_add, Rat.cast_natCast, Rat.cast_one, Rat.cast_ofNat] using h
  have hs : (y : ℝ) ≤ (∑ m ∈ Finset.range n, (x : ℝ) ^ m / m.factorial) -
      |(x : ℝ)| ^ n / n.factorial * 2 := by exact_mod_cast hsum
  have hb := (abs_le.mp (berryEsseen_exp_taylor_remainder hx)).1
  linarith

/-- Exact integer coefficients of the real and imaginary exponential Taylor polynomials. -/
def berryEsseenTrigCoeff (imaginary : Bool) (m : ℕ) : ℤ :=
  if imaginary then (if m % 4 = 1 then 1 else if m % 4 = 3 then -1 else 0)
  else (if m % 4 = 0 then 1 else if m % 4 = 2 then -1 else 0)

private theorem trigCoeff_re (m : ℕ) : (Complex.I ^ m).re = (berryEsseenTrigCoeff false m : ℝ) := by
  rw [Complex.I_pow_eq_pow_mod]
  have h : m % 4 = 0 ∨ m % 4 = 1 ∨ m % 4 = 2 ∨ m % 4 = 3 := by omega
  rcases h with h | h | h | h <;> norm_num [berryEsseenTrigCoeff, h, Complex.I_sq, Complex.I_pow_three]

private theorem trigCoeff_im (m : ℕ) : (Complex.I ^ m).im = (berryEsseenTrigCoeff true m : ℝ) := by
  rw [Complex.I_pow_eq_pow_mod]
  have h : m % 4 = 0 ∨ m % 4 = 1 ∨ m % 4 = 2 ∨ m % 4 = 3 := by omega
  rcases h with h | h | h | h <;> norm_num [berryEsseenTrigCoeff, h, Complex.I_sq, Complex.I_pow_three]

/-- The sine and cosine Taylor remainders inherit the certified complex-exponential bound. -/
theorem berryEsseen_trig_taylor_remainder (imaginary : Bool) {x : ℝ} {n : ℕ}
    (hx : |x| / (n+1) ≤ 1/2) :
    |(if imaginary then Real.sin x else Real.cos x) -
      ∑ m ∈ Finset.range n, (berryEsseenTrigCoeff imaginary m : ℝ) * x^m / m.factorial| ≤
        |x|^n/n.factorial*2 := by
  have hnorm : ‖(x : ℂ)*Complex.I‖ = |x| := by simp
  have h := Complex.exp_bound' (x := (x : ℂ)*Complex.I) (n := n) (by simpa [hnorm] using hx)
  rw [hnorm] at h
  cases imaginary
  · have hr := (Complex.abs_re_le_norm
      (Complex.exp ((x : ℂ)*Complex.I) - ∑ m ∈ Finset.range n, ((x : ℂ)*Complex.I)^m/m.factorial)).trans h
    simp only [Complex.sub_re, Complex.exp_ofReal_mul_I_re,
      Complex.re_sum, Complex.div_natCast_re, mul_pow, Complex.mul_re, ← Complex.ofReal_pow,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, trigCoeff_re] at hr
    simpa only [Bool.false_eq_true, ↓reduceIte, mul_comm] using hr
  · have hi := (Complex.abs_im_le_norm
      (Complex.exp ((x : ℂ)*Complex.I) - ∑ m ∈ Finset.range n, ((x : ℂ)*Complex.I)^m/m.factorial)).trans h
    simp only [Complex.sub_im, Complex.exp_ofReal_mul_I_im,
      Complex.im_sum, Complex.div_natCast_im, mul_pow, Complex.mul_im, ← Complex.ofReal_pow,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero, trigCoeff_im] at hi
    simpa only [↓reduceIte, mul_comm] using hi

/-- Exact rational trigonometric Taylor polynomials. -/
def berryEsseenTrigTaylor (imaginary : Bool) (x : ℚ) (n : ℕ) : ℚ :=
  ∑ m ∈ Finset.range n, (berryEsseenTrigCoeff imaginary m : ℚ) * x^m / m.factorial

/-- Finite rational data that enclose a sine or cosine value. -/
def berryEsseenTrigCheck (imaginary : Bool) (x lo hi : ℚ) (n : ℕ) : Prop :=
  |x|/(n+1) ≤ 1/2 ∧
    lo ≤ berryEsseenTrigTaylor imaginary x n - |x|^n/n.factorial*2 ∧
    berryEsseenTrigTaylor imaginary x n + |x|^n/n.factorial*2 ≤ hi

instance (imaginary : Bool) (x lo hi : ℚ) (n : ℕ) :
    Decidable (berryEsseenTrigCheck imaginary x lo hi n) := by
  unfold berryEsseenTrigCheck
  infer_instance

/-- Correctness of the rational sine and cosine checker. -/
theorem berryEsseen_trig_mem_of_check {imaginary : Bool} {x lo hi : ℚ} {n : ℕ}
    (h : berryEsseenTrigCheck imaginary x lo hi n) :
    (lo : ℝ) ≤ (if imaginary then Real.sin (x : ℝ) else Real.cos (x : ℝ)) ∧
      (if imaginary then Real.sin (x : ℝ) else Real.cos (x : ℝ)) ≤ (hi : ℝ) := by
  obtain ⟨hsmall, hlo, hhi⟩ := h
  have hx : |(x : ℝ)|/(n+1) ≤ 1/2 := by
    have h := (Rat.cast_le (K := ℝ)).mpr hsmall
    simpa only [Rat.cast_div, Rat.cast_abs, Rat.cast_add, Rat.cast_natCast, Rat.cast_one, Rat.cast_ofNat] using h
  have hl : (lo : ℝ) ≤
      (∑ m ∈ Finset.range n, (berryEsseenTrigCoeff imaginary m : ℝ) * (x : ℝ)^m / m.factorial) -
        |(x : ℝ)|^n/n.factorial*2 := by
    unfold berryEsseenTrigTaylor at hlo
    exact_mod_cast hlo
  have hh :
      (∑ m ∈ Finset.range n, (berryEsseenTrigCoeff imaginary m : ℝ) * (x : ℝ)^m / m.factorial) +
        |(x : ℝ)|^n/n.factorial*2 ≤ (hi : ℝ) := by
    unfold berryEsseenTrigTaylor at hhi
    exact_mod_cast hhi
  have hb := abs_le.mp (berryEsseen_trig_taylor_remainder imaginary hx)
  constructor <;> linarith

/-- Cellwise enclosures certify an integral; endpoint values of the integrand are irrelevant. -/
theorem berryEsseen_integral_le_rectangles {f : ℝ → ℝ} {n : ℕ} (a c : ℕ → ℝ)
    (ha : ∀ i < n, a i ≤ a (i+1))
    (hf : ∀ i < n, IntervalIntegrable f volume (a i) (a (i+1)))
    (hcell : ∀ i < n, ∀ x ∈ Ioo (a i) (a (i+1)), f x ≤ c i) :
    (∫ x in a 0..a n, f x) ≤ ∑ i ∈ Finset.range n, (a (i+1)-a i)*c i := by
  rw [← intervalIntegral.sum_integral_adjacent_intervals hf]
  apply Finset.sum_le_sum
  intro i hi
  have h := intervalIntegral.integral_mono_on_of_le_Ioo (ha i (Finset.mem_range.mp hi))
    (hf i (Finset.mem_range.mp hi)) (intervalIntegrable_const : IntervalIntegrable (fun _ : ℝ => c i) volume _ _)
    (hcell i (Finset.mem_range.mp hi))
  simpa only [intervalIntegral.integral_const, smul_eq_mul] using h

/-- Explicit first and second derivatives give a certified one-cell trapezoidal enclosure. -/
theorem berryEsseen_integral_le_trapezoid {f f' f'' : ℝ → ℝ} {a b M : ℝ}
    (hab : a < b) (hM : 0 ≤ M)
    (hd : ∀ x ∈ Icc a b, HasDerivAt f (f' x) x)
    (hdd : ∀ x ∈ Icc a b, HasDerivAt f' (f'' x) x)
    (hb : ∀ x ∈ Icc a b, |f'' x| ≤ M) :
    (∫ x in a..b, f x) ≤ (b-a)*(f a+f b)/2 + (b-a)^3*M/12 := by
  have huniq := uniqueDiffOn_Icc hab
  have heq : EqOn (derivWithin f (Icc a b)) f' (Icc a b) := by
    intro x hx
    exact (hd x hx).hasDerivWithinAt.derivWithin (huniq x hx)
  have hd1 : DifferentiableOn ℝ f (Icc a b) := fun x hx => (hd x hx).differentiableAt.differentiableWithinAt
  have hd2 : DifferentiableOn ℝ (derivWithin f (Icc a b)) (Icc a b) := by
    apply (show DifferentiableOn ℝ f' (Icc a b) from fun x hx => (hdd x hx).differentiableAt.differentiableWithinAt).congr
    exact heq
  have hsecond : ∀ x, |iteratedDerivWithin 2 f (Icc a b) x| ≤ M := by
    intro x
    by_cases hx : x ∈ Icc a b
    · have hid : iteratedDerivWithin 2 f (Icc a b) x = f'' x := by
        simp only [iteratedDerivWithin_succ', iteratedDerivWithin_zero]
        rw [derivWithin_congr heq (heq hx)]
        exact (hdd x hx).hasDerivWithinAt.derivWithin (huniq x hx)
      rw [hid]
      exact hb x hx
    · rw [iteratedDerivWithin_succ, derivWithin_zero_of_notMem_closure (by rwa [closure_Icc]), abs_zero]
      exact hM
  have h := trapezoidal_error_le (a := a) (b := b) (N := 1)
    (by simpa only [uIcc_of_le hab.le] using hd1)
    (by simpa only [uIcc_of_le hab.le] using hd2)
    (by simpa only [uIcc_of_le hab.le] using hsecond) (by norm_num)
  simp only [trapezoidal_error, trapezoidal_integral_one, Nat.cast_one, one_pow, mul_one,
    abs_of_pos (sub_pos.mpr hab)] at h
  have h := (abs_le.mp h).1
  linarith

/-- The clipped sine is nonnegative on the domain of the moment bound. -/
theorem clippedSine_nonneg {x : ℝ} (hx : 0 ≤ x) : 0 ≤ clippedSine x := by
  have h := monotoneOn_clippedSine (show (0 : ℝ) ∈ Ici 0 by simp) hx hx
  simpa [clippedSine, min_eq_left (by positivity : (0 : ℝ) ≤ Real.pi / 2)] using h

/-- Clipping preserves the elementary linear upper bound for sine. -/
theorem clippedSine_le {x : ℝ} (hx : 0 ≤ x) : clippedSine x ≤ x := by
  exact (Real.sin_le (le_min hx (by positivity))).trans (min_le_left _ _)

/-- Capping the residual bump at its maximum gives an increasing function. -/
theorem berryEsseenResidualBump_min_mono {x y : ℝ} (hx : 0 ≤ x) (hxy : x ≤ y) :
    berryEsseenResidualBump (min x (250000 / 148743)) ≤
      berryEsseenResidualBump (min y (250000 / 148743)) :=
  berryEsseenResidualBump_le_min (le_min hx (by norm_num)) ((min_le_left _ _).trans hxy)

/-- The normal-error envelope is nonnegative for nonnegative moment and frequency parameters. -/
theorem berryEsseenNormalErrorBound_nonneg {ℓ q t : ℝ} (hℓ : 0 ≤ ℓ) (ht : 0 ≤ t) :
    0 ≤ berryEsseenNormalErrorBound ℓ q t := by
  unfold berryEsseenNormalErrorBound
  apply mul_nonneg (by positivity)
  apply intervalIntegral.integral_nonneg ht
  intro u hu
  have hu0 : 0 ≤ u := hu.1
  exact mul_nonneg (mul_nonneg (clippedSine_nonneg (by positivity)) hu.1) (Real.exp_pos _).le

/-- Increasing either moment parameter can only increase the normal-error envelope. -/
theorem berryEsseenNormalErrorBound_mono {ℓ₁ ℓ₂ q₁ q₂ t : ℝ}
    (hℓ₁ : 0 ≤ ℓ₁) (hℓ : ℓ₁ ≤ ℓ₂) (hq₁ : 0 ≤ q₁) (hq : q₁ ≤ q₂) (ht : 0 ≤ t) :
    berryEsseenNormalErrorBound ℓ₁ q₁ t ≤ berryEsseenNormalErrorBound ℓ₂ q₂ t := by
  unfold berryEsseenNormalErrorBound
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  apply intervalIntegral.integral_mono_on ht
    (by apply Continuous.intervalIntegrable; unfold berryEsseenResidualBump; fun_prop)
    (by apply Continuous.intervalIntegrable; unfold berryEsseenResidualBump; fun_prop)
  intro u hu
  have hu0 : 0 ≤ u := hu.1
  have hs : clippedSine (u * ℓ₁ / 4) ≤ clippedSine (u * ℓ₂ / 4) :=
    monotoneOn_clippedSine (by change 0 ≤ u * ℓ₁ / 4; positivity) (by change 0 ≤ u * ℓ₂ / 4; have : 0 ≤ ℓ₂ := hℓ₁.trans hℓ; positivity)
      (by nlinarith [mul_le_mul_of_nonneg_left hℓ hu.1])
  have hb := berryEsseenResidualBump_min_mono (mul_nonneg hu.1 hq₁)
    (mul_le_mul_of_nonneg_left hq hu.1)
  have he : Real.exp ((49581 / 250000 : ℝ) * ℓ₁ * u^3 +
      berryEsseenResidualBump (min (u*q₁) (250000/148743))) ≤
      Real.exp ((49581 / 250000 : ℝ) * ℓ₂ * u^3 +
        berryEsseenResidualBump (min (u*q₂) (250000/148743))) := by
    apply Real.exp_le_exp.mpr
    have h := mul_le_mul_of_nonneg_right hℓ (by positivity : 0 ≤ (49581/250000:ℝ)*u^3)
    nlinarith
  exact mul_le_mul (mul_le_mul_of_nonneg_right hs hu.1) he (Real.exp_pos _).le
    (mul_nonneg (clippedSine_nonneg (by have : 0 ≤ ℓ₂ := hℓ₁.trans hℓ; positivity)) hu.1)

/-- The finite characteristic-function magnitude envelope is increasing in its moment budget. -/
theorem berryEsseenMagnitudeBound_mono {ℓ₁ ℓ₂ : ℝ} (hℓ : ℓ₁ ≤ ℓ₂) (t : ℝ) :
    berryEsseenMagnitudeBound ℓ₁ t ≤ berryEsseenMagnitudeBound ℓ₂ t := by
  unfold berryEsseenMagnitudeBound
  apply min_le_min le_rfl
  apply min_le_min
  · apply Real.exp_le_exp.mpr
    have h := mul_le_mul_of_nonneg_right hℓ (by positivity : 0 ≤ (49581/250000:ℝ)*|t|^3)
    nlinarith
  · apply Finset.le_inf'
    intro i hi
    refine (Finset.inf'_le _ hi).trans ?_
    have hi0 : 0 ≤ (i : ℝ) := Nat.cast_nonneg _
    have hi1 : (i : ℝ) ≤ 64 := by exact_mod_cast (Nat.le_of_lt_succ i.isLt)
    have hb := berryEsseenTangentB_nonneg (θ := berryEsseenTangentParameter i)
      (by unfold berryEsseenTangentParameter; nlinarith)
      (by unfold berryEsseenTangentParameter; nlinarith)
    apply Real.exp_le_exp.mpr
    have h := mul_le_mul_of_nonneg_right hℓ
      (by positivity : 0 ≤ 2 * berryEsseenTangentB (berryEsseenTangentParameter i) * |t|^3)
    nlinarith

/-- A numerical certificate at the upper corner of a parameter box controls the whole box. -/
theorem berryEsseenCDFErrorBound_mono {ℓ₁ ℓ₂ q₁ q₂ U τ : ℝ}
    (hℓ₁ : 0 ≤ ℓ₁) (hℓ : ℓ₁ ≤ ℓ₂) (hq₁ : 0 ≤ q₁) (hq : q₁ ≤ q₂)
    (hU : 0 < U) (hτ : 0 < τ) (hτ1 : τ < 1) :
    berryEsseenCDFErrorBound ℓ₁ q₁ U τ ≤ berryEsseenCDFErrorBound ℓ₂ q₂ U τ := by
  have hlow :
      (∫ t in (0 : ℝ)..τ, ‖berryEsseenSmoothingKernel t‖ * berryEsseenNormalErrorBound ℓ₁ q₁ (U*t)) ≤
      (∫ t in (0 : ℝ)..τ, ‖berryEsseenSmoothingKernel t‖ * berryEsseenNormalErrorBound ℓ₂ q₂ (U*t)) := by
    apply intervalIntegral.integral_mono_on hτ.le
      (intervalIntegrable_smoothing_normalErrorBound ℓ₁ q₁ hU hτ hτ1)
      (intervalIntegrable_smoothing_normalErrorBound ℓ₂ q₂ hU hτ hτ1)
    intro t ht
    exact mul_le_mul_of_nonneg_left
      (berryEsseenNormalErrorBound_mono hℓ₁ hℓ hq₁ hq (mul_nonneg hU.le ht.1)) (norm_nonneg _)
  have hhigh :
      (∫ t in τ..1, ‖berryEsseenSmoothingKernel t‖ * berryEsseenMagnitudeBound ℓ₁ (U*t)) ≤
      (∫ t in τ..1, ‖berryEsseenSmoothingKernel t‖ * berryEsseenMagnitudeBound ℓ₂ (U*t)) := by
    apply intervalIntegral.integral_mono_on hτ1.le
      (intervalIntegrable_smoothing_magnitudeBound ℓ₁ U hτ hτ1)
      (intervalIntegrable_smoothing_magnitudeBound ℓ₂ U hτ hτ1)
    intro t _
    exact mul_le_mul_of_nonneg_left (berryEsseenMagnitudeBound_mono hℓ (U*t)) (norm_nonneg _)
  unfold berryEsseenCDFErrorBound
  linarith

/-- The Gaussian tail with its derivative weight has an exact elementary integral. -/
theorem berryEsseen_gaussian_derivative_tail {U τ : ℝ} (hU : 0 < U) (hτ : 0 ≤ τ) :
    (∫ t in Ioi τ, U^2*t*Real.exp (-(U*t)^2/2)) = Real.exp (-(U*τ)^2/2) := by
  have hd (x : ℝ) : HasDerivAt (fun t : ℝ => -Real.exp (-(U*t)^2/2))
      (U^2*x*Real.exp (-(U*x)^2/2)) x := by
    convert! ((((((hasDerivAt_id x).const_mul U).pow 2).neg).div_const 2).exp).neg using 1
    simp only [Pi.pow_apply, Pi.neg_apply, id_eq]
    ring
  have ht : Tendsto (fun t : ℝ => -Real.exp (-(U*t)^2/2)) atTop (𝓝 0) := by
    have h := (gaussian_test_tendsto_zero (a := U^2/2) (by positivity)).neg
    convert! h using 1
    · ext t
      congr 2
      ring
    · simp
  have hn : ∀ t ∈ Ioi τ, 0 ≤ U^2*t*Real.exp (-(U*t)^2/2) := by
    intro t ht
    have ht0 : 0 ≤ t := hτ.trans ht.le
    positivity
  have h := integral_Ioi_of_hasDerivAt_of_nonneg' (a := τ) (fun x _ => hd x) hn ht
  simpa using h

/-- An explicit integrable majorant for the infinite-frequency normal tail. -/
theorem berryEsseen_smoothing_tail_le {U τ : ℝ} (hU : 0 < U) (hτ : 0 < τ) :
    (∫ t in Ioi τ, (1 / (Real.pi*t))*Real.exp (-(U*t)^2/2)) ≤
      Real.exp (-(U*τ)^2/2) / (Real.pi*(U*τ)^2) := by
  have hg : IntegrableOn (fun t : ℝ => U^2*t*Real.exp (-(U*t)^2/2)) (Ioi τ) := by
    have h := ((integrable_mul_exp_neg_mul_sq (b := U^2/2) (by positivity)).const_mul (U^2)).integrableOn (s := Ioi τ)
    convert! h using 1
    ext t
    rw [show -(U*t)^2/2 = -(U^2/2)*t^2 by ring]
    ring
  have hconst : 0 < 1 / (Real.pi*(U*τ)^2) := by positivity
  have hbound : (∫ t in Ioi τ, (1 / (Real.pi*t))*Real.exp (-(U*t)^2/2)) ≤
      ∫ t in Ioi τ, (1 / (Real.pi*(U*τ)^2)) * (U^2*t*Real.exp (-(U*t)^2/2)) := by
    apply integral_mono_of_nonneg
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      have ht0 : 0 < t := hτ.trans ht
      positivity
    · exact hg.const_mul _
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      have ht0 : 0 < t := hτ.trans ht
      have hcoef : 1 / (Real.pi*t) ≤ (1 / (Real.pi*(U*τ)^2))*(U^2*t) := by
        field_simp
        nlinarith [sq_nonneg τ, mul_nonneg (sub_nonneg.mpr ht.le) (by positivity : 0 ≤ t+τ)]
      convert! mul_le_mul_of_nonneg_right hcoef (Real.exp_pos (-(U*t)^2/2)).le using 1
      ring
  refine hbound.trans_eq ?_
  rw [integral_const_mul, berryEsseen_gaussian_derivative_tail hU hτ.le]
  ring

/-- The second Gaussian half-line moment, used by the small-moment analytic regime. -/
theorem berryEsseen_integral_sq_gaussian {b : ℝ} (hb : 0 < b) :
    (∫ x : ℝ in Ioi 0, x^2 * Real.exp (-b*x^2)) = Real.sqrt (Real.pi/b)/(4*b) := by
  have h := integral_rpow_mul_exp_neg_mul_rpow (p := 2) (q := 2) (b := b)
    (by norm_num) (by norm_num) hb
  simp only [Real.rpow_two] at h
  have hg : Real.Gamma ((2+1)/2) = Real.sqrt Real.pi/2 := by
    rw [show (2+1)/2 = (1/2:ℝ)+1 by ring, Real.Gamma_add_one (by norm_num), Real.Gamma_one_half_eq]
    ring
  rw [hg] at h
  have hr : b ^ (-(2+1)/2 : ℝ) = (b * Real.sqrt b)⁻¹ := by
    rw [show (-(2+1)/2 : ℝ) = -(1+1/2) by ring, Real.rpow_neg hb.le,
      Real.rpow_add hb, Real.rpow_one, ← Real.sqrt_eq_rpow]
  rw [hr] at h
  rw [h, Real.sqrt_div Real.pi_pos.le]
  ring

/-- The third Gaussian half-line moment has a rational value when the exponent coefficient does. -/
theorem berryEsseen_integral_cube_gaussian {b : ℝ} (hb : 0 < b) :
    (∫ x : ℝ in Ioi 0, x^3 * Real.exp (-b*x^2)) = 1/(2*b^2) := by
  have h := integral_rpow_mul_exp_neg_mul_rpow (p := 2) (q := 3) (b := b)
    (by norm_num) (by norm_num) hb
  norm_num [Real.rpow_two, Real.rpow_natCast, Real.rpow_neg hb.le] at h
  calc
    _ = (b^2)⁻¹*(1/2) := by simpa only [neg_mul] using h
    _ = _ := by ring

/-- The explicit second-moment coefficient in the smoothing estimate is below one twelfth. -/
theorem berryEsseen_gaussian_second_coefficient :
    Real.sqrt (Real.pi/(11/25))/(4*(11/25)) / (6*Real.pi) ≤ (1/12 : ℝ) := by
  have hs := Real.sq_sqrt (show 0 ≤ Real.pi/(11/25) by positivity)
  have hpi := Real.pi_gt_d2
  have hs0 := Real.sqrt_nonneg (Real.pi/(11/25))
  apply (div_le_iff₀ (by positivity : 0 < 6*Real.pi)).mpr
  apply (div_le_iff₀ (by norm_num : (0:ℝ) < 4*(11/25))).mpr
  nlinarith [Real.pi_pos, mul_nonneg (show 0 ≤ Real.pi by positivity) (show 0 ≤ Real.pi-3.14 by linarith)]

/-- The normal smoothing correction has coefficient at most twenty-one fiftieths. -/
theorem berryEsseen_gaussian_correction_coefficient :
    Real.sqrt (Real.pi/(1/2))/2/3 ≤ (21/50 : ℝ) := by
  have hs := Real.sq_sqrt (show 0 ≤ Real.pi/(1/2) by positivity)
  have hp := Real.pi_lt_d2
  have hn := Real.sqrt_nonneg (Real.pi/(1/2))
  have heq : Real.pi/(1/2) = 2*Real.pi := by ring
  rw [heq] at hs hn ⊢
  nlinarith

/-- The capped residual bump never exceeds its quadratic part before capping. -/
theorem berryEsseenResidualBump_min_le_sq {z : ℝ} (hz : 0 ≤ z) :
    berryEsseenResidualBump (min z (250000/148743)) ≤ z^2/2 := by
  have hm0 : 0 ≤ min z (250000/148743) := le_min hz (by norm_num)
  have hm1 := min_le_left z (250000/148743:ℝ)
  have hsq := (sq_le_sq₀ hm0 hz).mpr hm1
  unfold berryEsseenResidualBump
  nlinarith [pow_nonneg hm0 3]

/-- A simple Gaussian envelope is sufficient in the small-third-moment regime. -/
theorem berryEsseenNormalErrorBound_small {ℓ u : ℝ} (hℓ : 0 ≤ ℓ) (hu : 0 ≤ u)
    (hsmall : ℓ*u ≤ 1/10) :
    berryEsseenNormalErrorBound ℓ (1/4) u ≤
      ℓ*u^3/6 * Real.exp (-(11/25:ℝ)*u^2) := by
  have hpoint (s : ℝ) (hs : s ∈ Icc 0 u) :
      clippedSine (s*ℓ/4)*s*Real.exp ((49581/250000:ℝ)*ℓ*s^3 +
        berryEsseenResidualBump (min (s*(1/4)) (250000/148743))) ≤
      (ℓ/4)*s^2*Real.exp ((3/50:ℝ)*u^2) := by
    have hs0 : 0 ≤ s := hs.1
    have hls : ℓ*s ≤ 1/10 := (mul_le_mul_of_nonneg_left hs.2 hℓ).trans hsmall
    have hb := berryEsseenResidualBump_min_le_sq (z := s*(1/4)) (by positivity)
    have hss : s^2 ≤ u^2 := (sq_le_sq₀ hs.1 hu).mpr hs.2
    have hg : (49581/250000:ℝ)*ℓ*s^3 +
        berryEsseenResidualBump (min (s*(1/4)) (250000/148743)) ≤ (3/50:ℝ)*u^2 := by
      have hp := mul_nonneg (sub_nonneg.mpr hls) (sq_nonneg s)
      nlinarith
    have hc : clippedSine (s*ℓ/4)*s ≤ (ℓ/4)*s^2 := by
      have h := mul_le_mul_of_nonneg_right (clippedSine_le (by positivity : 0 ≤ s*ℓ/4)) hs0
      nlinarith
    exact mul_le_mul hc (Real.exp_le_exp.mpr hg) (Real.exp_pos _).le (by positivity)
  have hint :
      (∫ s in (0:ℝ)..u, clippedSine (s*ℓ/4)*s*Real.exp ((49581/250000:ℝ)*ℓ*s^3 +
        berryEsseenResidualBump (min (s*(1/4)) (250000/148743)))) ≤
      (ℓ*u^3/12)*Real.exp ((3/50:ℝ)*u^2) := by
    calc
      _ ≤ ∫ s in (0:ℝ)..u, (ℓ/4)*s^2*Real.exp ((3/50:ℝ)*u^2) := by
        apply intervalIntegral.integral_mono_on hu
          (by apply Continuous.intervalIntegrable; unfold berryEsseenResidualBump; fun_prop)
          (by apply Continuous.intervalIntegrable; fun_prop) hpoint
      _ = _ := by
        rw [intervalIntegral.integral_mul_const, intervalIntegral.integral_const_mul, integral_pow]
        norm_num
        ring
  unfold berryEsseenNormalErrorBound
  calc
    _ ≤ 2*Real.exp (-u^2/2)*((ℓ*u^3/12)*Real.exp ((3/50:ℝ)*u^2)) :=
      mul_le_mul_of_nonneg_left hint (by positivity)
    _ = _ := by
      rw [show 2*Real.exp (-u^2/2)*((ℓ*u^3/12)*Real.exp ((3/50:ℝ)*u^2)) =
          (ℓ*u^3/6)*(Real.exp (-u^2/2)*Real.exp ((3/50:ℝ)*u^2)) by ring,
        ← Real.exp_add]
      congr 2
      ring

private theorem tangent_parameter_57_bound :
    (1/1000 : ℝ) ≤ berryEsseenTangentA (berryEsseenTangentParameter (57 : Fin 65)) -
      6*berryEsseenTangentB (berryEsseenTangentParameter (57 : Fin 65)) := by
  norm_num [berryEsseenTangentA, berryEsseenTangentB, berryEsseenTangentParameter]

/-- One certified tangent controls the upper-frequency part of the small-moment regime. -/
theorem berryEsseenMagnitudeBound_small {ℓ t : ℝ} (hℓ : 0 < ℓ)
    (ht : 1/(10*ℓ) ≤ t) (ht1 : t ≤ 3/ℓ) :
    berryEsseenMagnitudeBound ℓ t ≤ Real.exp (-1/(1000*ℓ^2)) := by
  have ht0 : 0 < t := (by positivity : 0 < 1/(10*ℓ)).trans_le ht
  have hℓt : ℓ*t ≤ 3 := by have := (le_div_iff₀ hℓ).mp ht1; nlinarith
  by_cases hh : ℓ*t ≤ 1
  · have hbase : berryEsseenMagnitudeBound ℓ t ≤
        Real.exp (-t^2/2+(49581/250000:ℝ)*ℓ*t^3) := by
      unfold berryEsseenMagnitudeBound
      rw [abs_of_pos ht0]
      exact (min_le_right _ _).trans (min_le_left _ _)
    refine hbase.trans (Real.exp_le_exp.mpr ?_)
    have hsq : 1/(100*ℓ^2) ≤ t^2 := by
      have h := (sq_le_sq₀ (by positivity : 0 ≤ 1/(10*ℓ)) ht0.le).mpr ht
      convert! h using 1
      ring
    have hp := mul_nonneg (sub_nonneg.mpr hh) (sq_nonneg t)
    have hnorm : 1/(1000*ℓ^2) = (1/(100*ℓ^2))/10 := by ring
    simp only [neg_div]
    rw [hnorm]
    nlinarith [sq_nonneg t]
  · let A := berryEsseenTangentA (berryEsseenTangentParameter (57 : Fin 65))
    let B := berryEsseenTangentB (berryEsseenTangentParameter (57 : Fin 65))
    have hB : 0 ≤ B := berryEsseenTangentB_nonneg
      (by norm_num [berryEsseenTangentParameter]) (by norm_num [berryEsseenTangentParameter])
    have hAB : (1/1000:ℝ) ≤ A-6*B := tangent_parameter_57_bound
    have hbase : berryEsseenMagnitudeBound ℓ t ≤ Real.exp (-A*t^2+2*B*ℓ*t^3) := by
      unfold berryEsseenMagnitudeBound
      rw [abs_of_pos ht0]
      exact (min_le_right _ _).trans ((min_le_right _ _).trans
        (Finset.inf'_le _ (Finset.mem_univ (57 : Fin 65))))
    refine hbase.trans (Real.exp_le_exp.mpr ?_)
    have htt : 1/ℓ ≤ t := by apply (div_le_iff₀ hℓ).mpr; nlinarith
    have hsq : 1/ℓ^2 ≤ t^2 := by
      have h := (sq_le_sq₀ (by positivity : 0 ≤ 1/ℓ) ht0.le).mpr htt
      convert! h using 1
      ring
    have hc : (1/1000:ℝ) ≤ A-2*B*(ℓ*t) := by
      nlinarith [mul_nonneg hB (sub_nonneg.mpr hℓt)]
    have hp := mul_nonneg (sub_nonneg.mpr hc) (sq_nonneg t)
    have hnorm : 1/(1000*ℓ^2) = (1/ℓ^2)/1000 := by ring
    simp only [neg_div]
    rw [hnorm]
    nlinarith

/-- Exponential tails are uniformly dominated by a linear moment budget all the way to zero. -/
theorem berryEsseen_small_exponential_tail {ℓ : ℝ} (hℓ : 0 < ℓ) (hℓ1 : ℓ ≤ 1/100) :
    Real.exp (-1/(1000*ℓ^2)) ≤ ℓ/200 := by
  have he10 : (20000 : ℝ) ≤ Real.exp 10 := by
    simpa using berryEsseen_le_exp_of_check (x := 10) (y := 20000) (n := 48) (by decide +kernel)
  let x := 1/ℓ
  have hx : 100 ≤ x := by
    dsimp [x]
    apply (le_div_iff₀ hℓ).mpr
    nlinarith
  have harg : 10+(x-100)/100 ≤ x^2/1000 := by
    have h := mul_nonneg (sub_nonneg.mpr hx) (show 0 ≤ x+90 by linarith)
    nlinarith
  have he : 200*x ≤ Real.exp (x^2/1000) := by
    calc
      _ = 20000*(1+(x-100)/100) := by ring
      _ ≤ Real.exp 10 * Real.exp ((x-100)/100) := by
        apply mul_le_mul he10
        · linarith [Real.add_one_le_exp ((x-100)/100)]
        · linarith
        · exact (Real.exp_pos _).le
      _ = Real.exp (10+(x-100)/100) := (Real.exp_add _ _).symm
      _ ≤ _ := Real.exp_le_exp.mpr harg
  have he' : 200/ℓ ≤ Real.exp (1/(1000*ℓ^2)) := by
    have hxarg : x^2/1000 = 1/(1000*ℓ^2) := by dsimp [x]; ring
    rw [hxarg] at he
    simpa only [x, mul_one_div] using he
  have hprod := (div_le_iff₀ hℓ).mp he'
  rw [neg_div, Real.exp_neg]
  rw [inv_eq_one_div]
  apply (div_le_iff₀ (Real.exp_pos _)).mpr
  nlinarith

/-- Positive frequency rescaling and restriction give a half-line bound for a finite integral. -/
theorem berryEsseen_integral_scaled_le_Ioi {f : ℝ → ℝ} (hf : Integrable f)
    (hn : ∀ u, 0 ≤ u → 0 ≤ f u) {U τ : ℝ} (hU : 0 < U) (hτ : 0 ≤ τ) :
    (∫ t in (0:ℝ)..τ, U*f (U*t)) ≤ ∫ u in Ioi (0:ℝ), f u := by
  have hg : Integrable (fun t : ℝ => U*f (U*t)) := (hf.comp_mul_left' hU.ne').const_mul U
  calc
    _ ≤ ∫ t in Ioi (0:ℝ), U*f (U*t) := by
      rw [intervalIntegral.integral_of_le hτ]
      apply setIntegral_mono_set hg.integrableOn
      · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
        exact mul_nonneg hU.le (hn _ (mul_nonneg hU.le ht.le))
      · exact Eventually.of_forall (fun t ht => ht.1)
    _ = _ := by
      rw [integral_const_mul, integral_comp_mul_left_Ioi _ 0 hU]
      simp [smul_eq_mul, hU.ne']

/-- The smoothing kernel is uniformly bounded away from its lower-endpoint pole. -/
theorem norm_smoothing_kernel_le_five {t : ℝ} (ht : 1/30 ≤ t) (ht1 : t < 1) :
    ‖berryEsseenSmoothingKernel t‖ ≤ 5 := by
  have ht0 : 0 < t := by linarith
  have h := norm_smoothing_kernel_le_pole_add ht0 ht1
  have hp : 1/(2*Real.pi*t) ≤ (49/10:ℝ) := by
    apply (div_le_iff₀ (by positivity : 0 < 2*Real.pi*t)).mpr
    have hmul := mul_le_mul_of_nonneg_left ht Real.pi_pos.le
    have hpi := Real.pi_gt_d2
    nlinarith
  linarith

/-- The complete high-frequency integral is small uniformly down to zero third moment. -/
theorem berryEsseen_small_high_integral {ℓ : ℝ} (hℓ : 0 < ℓ) (hℓ1 : ℓ ≤ 1/100) :
    2*(∫ t in (1/30:ℝ)..1, ‖berryEsseenSmoothingKernel t‖ *
      berryEsseenMagnitudeBound ℓ ((3/ℓ)*t)) ≤ ℓ/20 := by
  have hcell (t : ℝ) (ht : t ∈ Ioo (1/30:ℝ) 1) :
      ‖berryEsseenSmoothingKernel t‖ * berryEsseenMagnitudeBound ℓ ((3/ℓ)*t) ≤ ℓ/40 := by
    have ht0 : 0 < t := by linarith [ht.1]
    have hlow : 1/(10*ℓ) ≤ (3/ℓ)*t := by
      calc
        _ = (1/10:ℝ)/ℓ := by ring
        _ ≤ (3*t)/ℓ := div_le_div_of_nonneg_right (by linarith [ht.1]) hℓ.le
        _ = _ := by ring
    have hupp : (3/ℓ)*t ≤ 3/ℓ := mul_le_of_le_one_right (by positivity) ht.2.le
    have hm := (berryEsseenMagnitudeBound_small hℓ hlow hupp).trans
      (berryEsseen_small_exponential_tail hℓ hℓ1)
    have h := mul_le_mul (norm_smoothing_kernel_le_five ht.1.le ht.2) hm
      (berryEsseenMagnitudeBound_nonneg _ _) (by norm_num : (0:ℝ) ≤ 5)
    nlinarith
  have h := intervalIntegral.integral_mono_on_of_le_Ioo (by norm_num : (1/30:ℝ) ≤ 1)
    (intervalIntegrable_smoothing_magnitudeBound ℓ (3/ℓ) (by norm_num) (by norm_num))
    (intervalIntegrable_const : IntervalIntegrable (fun _ : ℝ => ℓ/40) volume (1/30) 1) hcell
  rw [intervalIntegral.integral_const] at h
  simp only [smul_eq_mul] at h
  nlinarith

/-- The normal correction contributes at most 0.42 times the moment budget in the small regime. -/
theorem berryEsseen_small_correction_integral {ℓ : ℝ} (hℓ : 0 < ℓ) :
    2*(∫ t in (0:ℝ)..(1/30),
      ‖berryEsseenSmoothingKernel t - Complex.I/(2*Real.pi*t:ℝ)‖ *
        Real.exp (-((3/ℓ)*t)^2/2)) ≤ (21/50:ℝ)*ℓ := by
  let U : ℝ := 3/ℓ
  have hU : 0 < U := by dsimp [U]; positivity
  let f (u : ℝ) := (1/U)*Real.exp (-(1/2:ℝ)*u^2)
  have hf : Integrable f := (integrable_exp_neg_mul_sq (b := (1/2:ℝ)) (by norm_num)).const_mul (1/U)
  have hfin :
      2*(∫ t in (0:ℝ)..(1/30),
        ‖berryEsseenSmoothingKernel t - Complex.I/(2*Real.pi*t:ℝ)‖ * Real.exp (-(U*t)^2/2)) ≤
      ∫ t in (0:ℝ)..(1/30), U*f (U*t) := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_mono_on_of_le_Ioo (by norm_num)
      ((intervalIntegrable_smoothing_correction (by norm_num : (0:ℝ) < 1/30)
        (by norm_num : (1/30:ℝ) < 1)).const_mul 2)
      ((hf.comp_mul_left' hU.ne').const_mul U).intervalIntegrable
    intro t ht
    have hk := norm_smoothing_kernel_correction_le_linear ht.1 (by linarith [ht.2])
    have hc : 2*‖berryEsseenSmoothingKernel t - Complex.I/(2*Real.pi*t:ℝ)‖ ≤ 1 := by linarith [ht.1]
    have h := mul_le_mul_of_nonneg_right hc (Real.exp_pos (-(U*t)^2/2)).le
    convert! h using 1
    · ring
    · dsimp [f]
      rw [show -(1/2:ℝ)*(U*t)^2 = -(U*t)^2/2 by ring]
      field_simp
  have hhalf := berryEsseen_integral_scaled_le_Ioi hf (fun u _ => by dsimp [f]; positivity)
    hU (by norm_num : (0:ℝ) ≤ 1/30)
  have heq : (∫ u in Ioi (0:ℝ), f u) = ℓ*(Real.sqrt (Real.pi/(1/2))/2/3) := by
    dsimp [f]
    rw [integral_const_mul, integral_gaussian_Ioi]
    dsimp [U]
    field_simp
  have hlast := mul_le_mul_of_nonneg_left berryEsseen_gaussian_correction_coefficient hℓ.le
  change _ ≤ (21/50:ℝ)*ℓ
  exact (hfin.trans hhalf).trans (by rw [heq]; nlinarith)

/-- The unbounded normal tail contributes less than one thousandth of the small moment budget. -/
theorem berryEsseen_small_tail_integral {ℓ : ℝ} (hℓ : 0 < ℓ) (hℓ1 : ℓ ≤ 1/100) :
    (∫ t in Ioi (1/30:ℝ), (1/(Real.pi*t))*Real.exp (-((3/ℓ)*t)^2/2)) ≤ ℓ/1000 := by
  have hbase := berryEsseen_smoothing_tail_le (U := 3/ℓ) (τ := 1/30) (by positivity) (by norm_num)
  have ht : (10:ℝ) ≤ (3/ℓ)*(1/30) := by
    have h : 10 ≤ 1/(10*ℓ) := (le_div_iff₀ (by positivity)).mpr (by nlinarith)
    convert! h using 1
    ring
  have he : Real.exp (-((3/ℓ)*(1/30))^2/2) ≤ ℓ/200 := by
    refine (Real.exp_le_exp.mpr ?_).trans (berryEsseen_small_exponential_tail hℓ hℓ1)
    have hpos : 0 ≤ 1/ℓ^2 := by positivity
    have harg : -((3/ℓ)*(1/30))^2/2 = -(1/ℓ^2)/200 := by ring
    have harg' : -1/(1000*ℓ^2) = -(1/ℓ^2)/1000 := by ring
    rw [harg, harg']
    linarith
  have hp : (5:ℝ) ≤ Real.pi*((3/ℓ)*(1/30))^2 := by
    have hsq : (100:ℝ) ≤ ((3/ℓ)*(1/30))^2 := by nlinarith
    have hpi := Real.pi_gt_three
    nlinarith [mul_nonneg (sub_nonneg.mpr hpi.le) (sq_nonneg ((3/ℓ)*(1/30)))]
  refine hbase.trans ?_
  apply (div_le_iff₀ (by positivity : 0 < Real.pi*((3/ℓ)*(1/30))^2)).mpr
  have h := mul_le_mul_of_nonneg_left hp hℓ.le
  nlinarith

/-- The low-frequency term admits an analytic Gaussian moment bound for small third moments. -/
theorem berryEsseen_small_low_integral {ℓ : ℝ} (hℓ : 0 < ℓ) (hℓ1 : ℓ ≤ 1/100) :
    2*(∫ t in (0:ℝ)..(1/30), ‖berryEsseenSmoothingKernel t‖ *
      berryEsseenNormalErrorBound ℓ (1/4) ((3/ℓ)*t)) ≤ ℓ/12+ℓ/1000 := by
  let U : ℝ := 3/ℓ
  have hU : 0 < U := by dsimp [U]; positivity
  let f₂ (u : ℝ) := u^2 * Real.exp (-(11/25:ℝ)*u^2)
  let f₃ (u : ℝ) := u^3 * Real.exp (-(11/25:ℝ)*u^2)
  let G (u : ℝ) := (ℓ/(6*Real.pi))*f₂ u + (ℓ/(96*U))*f₃ u
  have hf₂ : Integrable f₂ := by
    simpa only [Real.rpow_natCast] using
      (integrable_rpow_mul_exp_neg_mul_sq (b := (11/25:ℝ)) (s := (2:ℕ)) (by norm_num) (by norm_num))
  have hf₃ : Integrable f₃ := by
    simpa only [Real.rpow_natCast] using
      (integrable_rpow_mul_exp_neg_mul_sq (b := (11/25:ℝ)) (s := (3:ℕ)) (by norm_num) (by norm_num))
  have hG : Integrable G := (hf₂.const_mul (ℓ/(6*Real.pi))).add (hf₃.const_mul (ℓ/(96*U)))
  have hG0 : ∀ u, 0 ≤ u → 0 ≤ G u := by
    intro u hu
    dsimp [G, f₂, f₃]
    positivity
  have hfin :
      2*(∫ t in (0:ℝ)..(1/30), ‖berryEsseenSmoothingKernel t‖ *
        berryEsseenNormalErrorBound ℓ (1/4) (U*t)) ≤
      ∫ t in (0:ℝ)..(1/30), U*G (U*t) := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_mono_on_of_le_Ioo (by norm_num)
      ((intervalIntegrable_smoothing_normalErrorBound ℓ (1/4) hU (by norm_num) (by norm_num)).const_mul 2)
      ((hG.comp_mul_left' hU.ne').const_mul U).intervalIntegrable
    intro t ht
    have ht0 : 0 < t := ht.1
    have hUt0 : 0 ≤ U*t := by positivity
    have hsmall : ℓ*(U*t) ≤ 1/10 := by
      have heq : ℓ*(U*t) = 3*t := by dsimp [U]; field_simp
      rw [heq]
      linarith [ht.2]
    have hR := berryEsseenNormalErrorBound_small hℓ.le hUt0 hsmall
    have hK := norm_smoothing_kernel_le_pole_add ht.1 (by linarith [ht.2])
    have hmul := mul_le_mul hK hR (berryEsseenNormalErrorBound_nonneg hℓ.le hUt0)
      (by positivity : 0 ≤ 1/(2*Real.pi*t)+1/32)
    calc
      _ ≤ 2*((1/(2*Real.pi*t)+1/32) * (ℓ*(U*t)^3/6*Real.exp (-(11/25:ℝ)*(U*t)^2))) :=
        mul_le_mul_of_nonneg_left hmul (by norm_num)
      _ = _ := by
        dsimp [G, f₂, f₃]
        field_simp
        ring
  have hhalf := berryEsseen_integral_scaled_le_Ioi hG hG0 hU (by norm_num : (0:ℝ) ≤ 1/30)
  have heq : (∫ u in Ioi (0:ℝ), G u) =
      (ℓ/(6*Real.pi))*(Real.sqrt (Real.pi/(11/25))/(4*(11/25))) +
      (ℓ/(96*U))*(1/(2*(11/25)^2)) := by
    dsimp only [G]
    rw [integral_add (hf₂.const_mul _).integrableOn (hf₃.const_mul _).integrableOn,
      integral_const_mul, integral_const_mul]
    rw [show (∫ u in Ioi (0:ℝ), f₂ u) = Real.sqrt (Real.pi/(11/25))/(4*(11/25)) from
      berryEsseen_integral_sq_gaussian (by norm_num)]
    rw [show (∫ u in Ioi (0:ℝ), f₃ u) = 1/(2*(11/25)^2) from
      berryEsseen_integral_cube_gaussian (by norm_num)]
  have hfirst : (ℓ/(6*Real.pi))*(Real.sqrt (Real.pi/(11/25))/(4*(11/25))) ≤ ℓ/12 := by
    have h := mul_le_mul_of_nonneg_left berryEsseen_gaussian_second_coefficient hℓ.le
    convert! h using 1 <;> ring
  have hsecond : (ℓ/(96*U))*(1/(2*(11/25)^2)) ≤ ℓ/1000 := by
    have hsq : ℓ^2 ≤ ℓ/100 := by nlinarith [mul_nonneg hℓ.le (sub_nonneg.mpr hℓ1)]
    have heq : (ℓ/(96*U))*(1/(2*(11/25)^2)) = (625/69696:ℝ)*ℓ^2 := by
      dsimp [U]
      field_simp
      ring
    rw [heq]
    nlinarith
  exact (hfin.trans hhalf).trans (by rw [heq]; linarith)

/-- The complete analytic envelope meets the 0.56 target uniformly on the small-moment regime. -/
theorem berryEsseenCDFErrorBound_small {ℓ : ℝ} (hℓ : 0 < ℓ) (hℓ1 : ℓ ≤ 1/100) :
    berryEsseenCDFErrorBound ℓ (1/4) (3/ℓ) (1/30) ≤ (14/25:ℝ)*ℓ := by
  have hlow := berryEsseen_small_low_integral hℓ hℓ1
  have hhigh := berryEsseen_small_high_integral hℓ hℓ1
  have hcorrection := berryEsseen_small_correction_integral hℓ
  have htail := berryEsseen_small_tail_integral hℓ hℓ1
  unfold berryEsseenCDFErrorBound
  linarith

/-- Berry–Esseen with constant 0.56 for every independent normalized sum whose total third moment
is at most one hundredth; the interval includes arbitrarily small positive moment budgets. -/
theorem berryEsseen_product_cdf_small {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    (hv : (∑ i, ∫ x, x^2 ∂μ i) = 1) {ℓ : ℝ}
    (hℓ : 0 < ℓ) (hℓ1 : ℓ ≤ 1/100)
    (hthird : (∑ i, ∫ x, |x|^3 ∂μ i) ≤ ℓ) (x : ℝ) :
    |cdf ((Measure.pi μ).map (fun z => ∑ i, z i)) x - cdf (gaussianReal 0 1) x| ≤ (14/25:ℝ)*ℓ := by
  have hq : (∑ i, ∫ x, |x|^3 ∂μ i) ≤ (1/4:ℝ)^3 := hthird.trans (by linarith)
  exact (berryEsseen_product_cdf_error_le μ hm hmean hv hthird (by norm_num) hq
    (by positivity : 0 < 3/ℓ) (by norm_num : (0:ℝ) < 1/30) (by norm_num) x).trans
    (berryEsseenCDFErrorBound_small hℓ hℓ1)

/-- Unit total variance forces a strictly positive total third absolute moment. -/
theorem berryEsseen_total_thirdMoment_pos {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hv : (∑ i, ∫ x, x^2 ∂μ i) = 1) :
    0 < ∑ i, ∫ x, |x|^3 ∂μ i := by
  have hex : ∃ i, 0 < ∫ x, x^2 ∂μ i := by
    by_contra! h
    have hs := Finset.sum_nonpos (fun i (_ : i ∈ Finset.univ) => h i)
    rw [hv] at hs
    linarith
  obtain ⟨i, hvi⟩ := hex
  have hsingle : 0 < ∫ x, |x|^3 ∂μ i :=
    (mul_pos hvi (Real.sqrt_pos.mpr hvi)).trans_le
      (secondMoment_mul_sqrt_le_thirdMoment (μ i) (hm i))
  exact hsingle.trans_le (Finset.single_le_sum (f := fun j => ∫ x, |x|^3 ∂μ j)
    (fun j _ => integral_nonneg (fun x => by positivity)) (Finset.mem_univ i))

/-- CDF ranges give the target bound directly for sufficiently large moment budgets. -/
theorem berryEsseen_cdf_large {μ ν : Measure ℝ} {ℓ : ℝ} (hℓ : 25/14 ≤ ℓ) (x : ℝ) :
    |cdf μ x - cdf ν x| ≤ (14/25:ℝ)*ℓ := by
  have hm0 := cdf_nonneg μ x
  have hm1 := cdf_le_one μ x
  have hn0 := cdf_nonneg ν x
  have hn1 := cdf_le_one ν x
  rw [abs_le]
  constructor <;> linarith

private def cotReciprocal (n : ℕ) (x : ℝ) : ℝ := 1/(((n:ℝ)+1)^2-x^2)
private def cotReciprocalD (n : ℕ) (x : ℝ) : ℝ := 2*x/(((n:ℝ)+1)^2-x^2)^2
private def cotReciprocalDD (n : ℕ) (x : ℝ) : ℝ :=
  2/(((n:ℝ)+1)^2-x^2)^2 + 8*x^2/(((n:ℝ)+1)^2-x^2)^3

private theorem cotReciprocal_den_pos (n : ℕ) {x : ℝ} (hx : x ∈ Ioo (-3/4:ℝ) (3/4)) :
    0 < ((n:ℝ)+1)^2-x^2 := by
  have hn : 0 ≤ (n:ℝ) := Nat.cast_nonneg n
  nlinarith [sq_nonneg (x+3/4), mul_nonneg (sub_nonneg.mpr hx.1.le) (sub_nonneg.mpr hx.2.le)]

private theorem cotReciprocal_hasDerivAt (n : ℕ) {x : ℝ}
    (hx : x ∈ Ioo (-3/4:ℝ) (3/4)) : HasDerivAt (cotReciprocal n) (cotReciprocalD n x) x := by
  have hd := cotReciprocal_den_pos n hx
  convert! (((hasDerivAt_id x).pow 2).const_sub (((n:ℝ)+1)^2)).inv hd.ne' using 1
  · ext y
    simp [cotReciprocal, one_div]
  · dsimp [cotReciprocalD]
    ring

private theorem cotReciprocalD_hasDerivAt (n : ℕ) {x : ℝ}
    (hx : x ∈ Ioo (-3/4:ℝ) (3/4)) : HasDerivAt (cotReciprocalD n) (cotReciprocalDD n x) x := by
  have hd := cotReciprocal_den_pos n hx
  have h := ((hasDerivAt_id x).const_mul 2).div
    ((((hasDerivAt_id x).pow 2).const_sub (((n:ℝ)+1)^2)).pow 2) (pow_ne_zero 2 hd.ne')
  convert! h using 1
  dsimp [cotReciprocalDD]
  field_simp [hd.ne']
  ring

private theorem cotReciprocal_inverse_bound (n : ℕ) {x : ℝ}
    (hx : x ∈ Ioo (-3/4:ℝ) (3/4)) :
    (1/(((n:ℝ)+1)^2-x^2)) ≤ (16/7:ℝ)*(1/((n:ℝ)+1)^2) := by
  have hn : 0 ≤ (n:ℝ) := Nat.cast_nonneg n
  have hd := cotReciprocal_den_pos n hx
  have hsq : x^2 ≤ (9/16:ℝ) := by nlinarith [mul_nonneg (sub_nonneg.mpr hx.1.le) (sub_nonneg.mpr hx.2.le)]
  have hn1 : 1 ≤ ((n:ℝ)+1)^2 := by nlinarith
  have hden : (7/16:ℝ)*((n:ℝ)+1)^2 ≤ ((n:ℝ)+1)^2-x^2 := by nlinarith
  have h := one_div_le_one_div_of_le (by positivity : 0 < (7/16:ℝ)*((n:ℝ)+1)^2) hden
  refine h.trans_eq ?_
  field_simp

private theorem cotReciprocal_inverse_pow_bound (n : ℕ) {x : ℝ}
    (hx : x ∈ Ioo (-3/4:ℝ) (3/4)) {k : ℕ} (hk : 1 ≤ k) :
    (1/(((n:ℝ)+1)^2-x^2))^k ≤ (16/7:ℝ)^k*(1/((n:ℝ)+1)^2) := by
  have hn : 0 ≤ (n:ℝ) := Nat.cast_nonneg n
  have hd := cotReciprocal_den_pos n hx
  have hv : 0 ≤ 1/((n:ℝ)+1)^2 := by positivity
  have hv1 : 1/((n:ℝ)+1)^2 ≤ 1 := by
    apply (div_le_iff₀ (by positivity : 0 < ((n:ℝ)+1)^2)).mpr
    nlinarith
  have hpow := pow_le_pow_left₀ (by positivity : 0 ≤ 1/(((n:ℝ)+1)^2-x^2))
    (cotReciprocal_inverse_bound n hx) k
  rw [mul_pow] at hpow
  exact hpow.trans (mul_le_mul_of_nonneg_left (pow_le_of_le_one hv hv1 (by omega)) (by positivity))

private theorem cotReciprocalD_bound (n : ℕ) {x : ℝ}
    (hx : x ∈ Ioo (-3/4:ℝ) (3/4)) :
    ‖cotReciprocalD n x‖ ≤ 8*(1/((n:ℝ)+1)^2) := by
  have hd := cotReciprocal_den_pos n hx
  have hi := cotReciprocal_inverse_pow_bound n hx (k := 2) (by norm_num)
  have habs : |x| ≤ (3/4:ℝ) := abs_le.mpr ⟨by linarith [hx.1], hx.2.le⟩
  have hn : 0 ≤ 1/((n:ℝ)+1)^2 := by positivity
  dsimp [cotReciprocalD]
  norm_num only [abs_div, abs_mul, abs_pow, abs_of_pos hd]
  calc
    _ = 2 * |x| * (1/(((n:ℝ)+1)^2-x^2))^2 := by field_simp [hd.ne']
    _ ≤ 2*(3/4:ℝ)*((16/7:ℝ)^2*(1/((n:ℝ)+1)^2)) := by
      exact mul_le_mul (mul_le_mul_of_nonneg_left habs (by norm_num)) hi (sq_nonneg _) (by norm_num)
    _ ≤ _ := by nlinarith

private theorem cotReciprocalDD_bound (n : ℕ) {x : ℝ}
    (hx : x ∈ Ioo (-3/4:ℝ) (3/4)) :
    ‖cotReciprocalDD n x‖ ≤ 65*(1/((n:ℝ)+1)^2) := by
  have hd := cotReciprocal_den_pos n hx
  have hi2 := cotReciprocal_inverse_pow_bound n hx (k := 2) (by norm_num)
  have hi3 := cotReciprocal_inverse_pow_bound n hx (k := 3) (by norm_num)
  have hn : 0 ≤ 1/((n:ℝ)+1)^2 := by positivity
  have hsq : x^2 ≤ (9/16:ℝ) := by nlinarith [mul_nonneg (sub_nonneg.mpr hx.1.le) (sub_nonneg.mpr hx.2.le)]
  have h0 : 0 ≤ cotReciprocalDD n x := by unfold cotReciprocalDD; positivity
  rw [Real.norm_eq_abs, abs_of_nonneg h0]
  have heq : cotReciprocalDD n x =
      2*(1/(((n:ℝ)+1)^2-x^2))^2 + 8*x^2*(1/(((n:ℝ)+1)^2-x^2))^3 := by
    unfold cotReciprocalDD
    field_simp [hd.ne']
  rw [heq]
  have hprod := mul_le_mul (mul_le_mul_of_nonneg_left hsq (by norm_num : (0:ℝ) ≤ 8))
    hi3 (by positivity : 0 ≤ (1/(((n:ℝ)+1)^2-x^2))^3) (by norm_num)
  nlinarith

/-- The regular reciprocal series underlying the smoothing correction. -/
def berryEsseenCotangentSeries (x : ℝ) : ℝ := ∑' n, cotReciprocal n x

/-- The first derivative series of the regular cotangent correction. -/
def berryEsseenCotangentSeriesD (x : ℝ) : ℝ := ∑' n, cotReciprocalD n x

/-- The second derivative series of the regular cotangent correction. -/
def berryEsseenCotangentSeriesDD (x : ℝ) : ℝ := ∑' n, cotReciprocalDD n x

private theorem summable_cotBase : Summable (fun n : ℕ => 1/((n:ℝ)+1)^2) := by
  have h : HasSum (fun n : ℕ => 1/((n:ℝ)+1)^2) (Real.pi^2/6) := by
    simpa using (hasSum_nat_add_iff' 1).mpr hasSum_zeta_two
  exact h.summable

/-- The reciprocal series may be differentiated throughout a fixed neighborhood of zero. -/
theorem berryEsseenCotangentSeries_hasDerivAt {x : ℝ} (hx : x ∈ Ioo (-3/4:ℝ) (3/4)) :
    HasDerivAt berryEsseenCotangentSeries (berryEsseenCotangentSeriesD x) x := by
  apply hasDerivAt_tsum_of_isPreconnected (summable_cotBase.mul_left 8) isOpen_Ioo
    (convex_Ioo (-3/4:ℝ) (3/4)).isPreconnected
    (fun n y hy => cotReciprocal_hasDerivAt n hy)
    (fun n y hy => cotReciprocalD_bound n hy) (y₀ := (0:ℝ)) (by norm_num)
  · simpa [cotReciprocal] using summable_cotBase
  · exact hx

/-- The derivative series also differentiates term by term. -/
theorem berryEsseenCotangentSeriesD_hasDerivAt {x : ℝ} (hx : x ∈ Ioo (-3/4:ℝ) (3/4)) :
    HasDerivAt berryEsseenCotangentSeriesD (berryEsseenCotangentSeriesDD x) x := by
  apply hasDerivAt_tsum_of_isPreconnected (summable_cotBase.mul_left 65) isOpen_Ioo
    (convex_Ioo (-3/4:ℝ) (3/4)).isPreconnected
    (fun n y hy => cotReciprocalD_hasDerivAt n hy)
    (fun n y hy => cotReciprocalDD_bound n hy) (y₀ := (0:ℝ)) (by norm_num)
  · simp [cotReciprocalD]
  · exact hx


/-- Uniform bounds for the regular series and its first two derivatives on the working interval. -/
theorem berryEsseenCotangentSeries_bounds {x : ℝ} (hx : x ∈ Ioo (-3/4:ℝ) (3/4)) :
    |berryEsseenCotangentSeries x| ≤ 4 ∧
      |berryEsseenCotangentSeriesD x| ≤ 14 ∧ |berryEsseenCotangentSeriesDD x| ≤ 110 := by
  have hs : HasSum (fun n : ℕ => 1/((n:ℝ)+1)^2) (Real.pi^2/6) := by
    simpa using (hasSum_nat_add_iff' 1).mpr hasSum_zeta_two
  have h0 : ‖berryEsseenCotangentSeries x‖ ≤ (16/7:ℝ)*(Real.pi^2/6) := by
    apply tsum_of_norm_bounded (hs.mul_left (16/7))
    intro n
    rw [cotReciprocal, Real.norm_eq_abs, abs_of_pos (one_div_pos.mpr (cotReciprocal_den_pos n hx))]
    exact cotReciprocal_inverse_bound n hx
  have h1 : ‖berryEsseenCotangentSeriesD x‖ ≤ 8*(Real.pi^2/6) :=
    tsum_of_norm_bounded (hs.mul_left 8) (fun n => cotReciprocalD_bound n hx)
  have h2 : ‖berryEsseenCotangentSeriesDD x‖ ≤ 65*(Real.pi^2/6) :=
    tsum_of_norm_bounded (hs.mul_left 65) (fun n => cotReciprocalDD_bound n hx)
  have hpi : Real.pi^2 ≤ 10 := by nlinarith [Real.pi_pos, Real.pi_lt_d2]
  simp only [Real.norm_eq_abs] at h0 h1 h2
  constructor
  · linarith
  constructor <;> linarith

/-- The series representation removes the apparent endpoint singularity of the correction. -/
def berryEsseenRegularCorrection (t : ℝ) : ℝ :=
  (2/Real.pi)*t*(1-t)*berryEsseenCotangentSeries t

/-- First derivative of the regularized smoothing correction. -/
def berryEsseenRegularCorrectionD (t : ℝ) : ℝ :=
  (2/Real.pi)*((1-2*t)*berryEsseenCotangentSeries t + t*(1-t)*berryEsseenCotangentSeriesD t)

/-- Second derivative of the regularized smoothing correction. -/
def berryEsseenRegularCorrectionDD (t : ℝ) : ℝ :=
  (2/Real.pi)*(-2*berryEsseenCotangentSeries t + 2*(1-2*t)*berryEsseenCotangentSeriesD t +
    t*(1-t)*berryEsseenCotangentSeriesDD t)

/-- Differentiation of the regular correction is valid at zero as well as at positive arguments. -/
theorem berryEsseenRegularCorrection_hasDerivAt {t : ℝ} (ht : t ∈ Ioo (-3/4:ℝ) (3/4)) :
    HasDerivAt berryEsseenRegularCorrection (berryEsseenRegularCorrectionD t) t := by
  have h := ((((hasDerivAt_id t).const_mul (2/Real.pi)).mul
    ((hasDerivAt_id t).const_sub 1)).mul (berryEsseenCotangentSeries_hasDerivAt ht))
  convert! h using 1
  dsimp [berryEsseenRegularCorrectionD]
  ring

/-- The regular correction has two explicit derivatives on the numerical working interval. -/
theorem berryEsseenRegularCorrectionD_hasDerivAt {t : ℝ} (ht : t ∈ Ioo (-3/4:ℝ) (3/4)) :
    HasDerivAt berryEsseenRegularCorrectionD (berryEsseenRegularCorrectionDD t) t := by
  have hS := berryEsseenCotangentSeries_hasDerivAt ht
  have hD := berryEsseenCotangentSeriesD_hasDerivAt ht
  have h := (((((hasDerivAt_id t).const_mul 2).const_sub 1).mul hS).add
    (((hasDerivAt_id t).mul ((hasDerivAt_id t).const_sub 1)).mul hD)).const_mul (2/Real.pi)
  convert! h using 1
  dsimp [berryEsseenRegularCorrectionDD]
  ring

/-- Uniform derivative bounds permit rigorous quadrature near the lower endpoint. -/
theorem berryEsseenRegularCorrection_derivative_bounds {t : ℝ} (ht : t ∈ Ico 0 (3/4:ℝ)) :
    |berryEsseenRegularCorrectionD t| ≤ 5 ∧ |berryEsseenRegularCorrectionDD t| ≤ 43 := by
  have hmem : t ∈ Ioo (-3/4:ℝ) (3/4) := ⟨by linarith [ht.1], ht.2⟩
  obtain ⟨hS, hD, hDD⟩ := berryEsseenCotangentSeries_bounds hmem
  have ht0 : 0 ≤ t := ht.1
  have ht1 : t ≤ 1 := by linarith [ht.2]
  have ha : |1-2*t| ≤ 1 := abs_le.mpr ⟨by linarith, by linarith⟩
  have hb0 : 0 ≤ t*(1-t) := mul_nonneg ht0 (sub_nonneg.mpr ht1)
  have hb1 : t*(1-t) ≤ 1/4 := by nlinarith [sq_nonneg (t-1/2)]
  have hnum1 : |(1-2*t)*berryEsseenCotangentSeries t + t*(1-t)*berryEsseenCotangentSeriesD t| ≤ 15/2 := by
    calc
      _ ≤ |1-2*t| * |berryEsseenCotangentSeries t| + |t*(1-t)| * |berryEsseenCotangentSeriesD t| := by
        simpa only [abs_mul] using abs_add_le ((1-2*t)*berryEsseenCotangentSeries t)
          (t*(1-t)*berryEsseenCotangentSeriesD t)
      _ ≤ 1*4+(1/4:ℝ)*14 := by
        rw [abs_of_nonneg hb0]
        exact add_le_add (mul_le_mul ha hS (abs_nonneg _) (by norm_num))
          (mul_le_mul hb1 hD (abs_nonneg _) (by norm_num))
      _ = _ := by norm_num
  have hnum2 : |-2*berryEsseenCotangentSeries t + 2*(1-2*t)*berryEsseenCotangentSeriesD t +
      t*(1-t)*berryEsseenCotangentSeriesDD t| ≤ 127/2 := by
    calc
      _ ≤ |-2*berryEsseenCotangentSeries t + 2*(1-2*t)*berryEsseenCotangentSeriesD t| +
          |t*(1-t)*berryEsseenCotangentSeriesDD t| := abs_add_le _ _
      _ ≤ (|-2*berryEsseenCotangentSeries t| + |2*(1-2*t)*berryEsseenCotangentSeriesD t|) +
          |t*(1-t)*berryEsseenCotangentSeriesDD t| := add_le_add (abs_add_le _ _) le_rfl
      _ = 2*|berryEsseenCotangentSeries t| + 2*|1-2*t| * |berryEsseenCotangentSeriesD t| +
          t*(1-t)*|berryEsseenCotangentSeriesDD t| := by
        rw [abs_mul, abs_mul, abs_mul, abs_mul, abs_of_nonneg hb0]
        norm_num
      _ ≤ 2*4+2*1*14+(1/4:ℝ)*110 := by
        apply add_le_add
        · exact add_le_add (mul_le_mul_of_nonneg_left hS (by norm_num))
            (mul_le_mul (mul_le_mul_of_nonneg_left ha (by norm_num)) hD (abs_nonneg _) (by norm_num))
        · exact mul_le_mul hb1 hDD (abs_nonneg _) (by norm_num)
      _ = _ := by norm_num
  constructor
  · unfold berryEsseenRegularCorrectionD
    rw [abs_mul, abs_of_pos (by positivity : 0 < 2/Real.pi)]
    have h := mul_le_mul_of_nonneg_left hnum1 (by positivity : 0 ≤ 2/Real.pi)
    refine h.trans ?_
    rw [show (2/Real.pi)*(15/2) = 15/Real.pi by ring]
    apply (div_le_iff₀ Real.pi_pos).mpr
    nlinarith [Real.pi_gt_three]
  · unfold berryEsseenRegularCorrectionDD
    rw [abs_mul, abs_of_pos (by positivity : 0 < 2/Real.pi)]
    have h := mul_le_mul_of_nonneg_left hnum2 (by positivity : 0 ≤ 2/Real.pi)
    refine h.trans ?_
    rw [show (2/Real.pi)*(127/2) = 127/Real.pi by ring]
    apply (div_le_iff₀ Real.pi_pos).mpr
    nlinarith [Real.pi_gt_three]

/-- Algebraic derivative bounds for the norm of a planar curve with a linear first coordinate. -/
theorem berryEsseen_norm_derivative_algebra {a b a₁ b₁ b₂ r A B : ℝ}
    (hr : 0 < r) (hr2 : r^2 = a^2+b^2)
    (hA : a₁^2+b₁^2 ≤ A) (hB : |b₂| ≤ B) :
    ((a*a₁+b*b₁)/r)^2 ≤ A ∧
    |(a₁^2+b₁^2+b*b₂)/r - (a*a₁+b*b₁)^2/r^3| ≤ A/r+B := by
  have hA0 : 0 ≤ A := (add_nonneg (sq_nonneg _) (sq_nonneg _)).trans hA
  have hB0 : 0 ≤ B := (abs_nonneg _).trans hB
  have hb : |b| ≤ r := (sq_le_sq₀ (abs_nonneg _) hr.le).mp (by rw [sq_abs, hr2]; nlinarith [sq_nonneg a])
  have hc : (a*a₁+b*b₁)^2 ≤ (a₁^2+b₁^2)*r^2 := by
    rw [hr2]
    nlinarith [sq_nonneg (a*b₁-b*a₁)]
  have hcross : |b*b₂| ≤ r*B := by
    rw [abs_mul]
    exact mul_le_mul hb hB (abs_nonneg _) hr.le
  have hcrossl := mul_le_mul_of_nonneg_right (abs_le.mp hcross).1 (sq_nonneg r)
  have hcrossu := mul_le_mul_of_nonneg_right (abs_le.mp hcross).2 (sq_nonneg r)
  have hAp := mul_le_mul_of_nonneg_right hA (sq_nonneg r)
  constructor
  · rw [div_pow]
    apply (div_le_iff₀ (sq_pos_of_pos hr)).mpr
    nlinarith
  · have heq : (a₁^2+b₁^2+b*b₂)/r - (a*a₁+b*b₁)^2/r^3 =
        ((a₁^2+b₁^2)*r^2 + (b*b₂)*r^2 - (a*a₁+b*b₁)^2)/r^3 := by
      field_simp
    rw [heq, abs_le]
    constructor
    · apply (le_div_iff₀ (pow_pos hr 3)).mpr
      have heq : (-(A/r+B))*r^3 = -A*r^2-B*r^3 := by field_simp; ring
      rw [heq]
      nlinarith [mul_nonneg hA0 (sq_nonneg r)]
    · apply (div_le_iff₀ (pow_pos hr 3)).mpr
      have heq : (A/r+B)*r^3 = A*r^2+B*r^3 := by field_simp
      rw [heq]
      nlinarith [sq_nonneg (a*a₁+b*b₁)]

/-- The regular series agrees with the cotangent correction at every positive working argument. -/
theorem berryEsseenRegularCorrection_eq {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    berryEsseenRegularCorrection t = berryEsseenCotangentCorrection t := by
  rw [berryEsseenCotangentCorrection_series ht ht1]
  change (2/Real.pi)*t*(1-t)*(∑' n : ℕ, 1/(((n:ℝ)+1)^2-t^2)) = _
  ring

/-- A smooth endpoint extension of the norm of the corrected smoothing kernel. -/
def berryEsseenCorrectionNorm (t : ℝ) : ℝ :=
  Real.sqrt ((1-t)^2+berryEsseenRegularCorrection t^2)/2

/-- First derivative of the endpoint extension. -/
def berryEsseenCorrectionNormD (t : ℝ) : ℝ :=
  (t-1+berryEsseenRegularCorrection t*berryEsseenRegularCorrectionD t)/
    (2*Real.sqrt ((1-t)^2+berryEsseenRegularCorrection t^2))

/-- Second derivative of the endpoint extension. -/
def berryEsseenCorrectionNormDD (t : ℝ) : ℝ :=
  (1+berryEsseenRegularCorrectionD t^2+berryEsseenRegularCorrection t*berryEsseenRegularCorrectionDD t)/
      (2*Real.sqrt ((1-t)^2+berryEsseenRegularCorrection t^2)) -
    (t-1+berryEsseenRegularCorrection t*berryEsseenRegularCorrectionD t)^2/
      (2*Real.sqrt ((1-t)^2+berryEsseenRegularCorrection t^2)^3)

private theorem correction_radicand_pos {t : ℝ} (ht : t < 3/4) :
    0 < (1-t)^2+berryEsseenRegularCorrection t^2 := by
  have h : 0 < 1-t := by linarith
  exact add_pos_of_pos_of_nonneg (sq_pos_of_pos h) (sq_nonneg _)

private theorem correction_root_hasDerivAt {t : ℝ} (ht : t ∈ Ioo (-3/4:ℝ) (3/4)) :
    HasDerivAt (fun x : ℝ => Real.sqrt ((1-x)^2+berryEsseenRegularCorrection x^2))
      ((t-1+berryEsseenRegularCorrection t*berryEsseenRegularCorrectionD t)/
        Real.sqrt ((1-t)^2+berryEsseenRegularCorrection t^2)) t := by
  have hC := berryEsseenRegularCorrection_hasDerivAt ht
  have h := ((((hasDerivAt_id t).const_sub 1).pow 2).add (hC.pow 2)).sqrt
    (correction_radicand_pos ht.2).ne'
  convert! h using 1
  dsimp
  ring

/-- The correction-norm extension is differentiable including its lower endpoint. -/
theorem berryEsseenCorrectionNorm_hasDerivAt {t : ℝ} (ht : t ∈ Ioo (-3/4:ℝ) (3/4)) :
    HasDerivAt berryEsseenCorrectionNorm (berryEsseenCorrectionNormD t) t := by
  have h := (correction_root_hasDerivAt ht).div_const 2
  convert! h using 1
  unfold berryEsseenCorrectionNormD
  ring

/-- The correction-norm extension has the explicit second derivative used by quadrature. -/
theorem berryEsseenCorrectionNormD_hasDerivAt {t : ℝ} (ht : t ∈ Ioo (-3/4:ℝ) (3/4)) :
    HasDerivAt berryEsseenCorrectionNormD (berryEsseenCorrectionNormDD t) t := by
  have hC := berryEsseenRegularCorrection_hasDerivAt ht
  have hD := berryEsseenRegularCorrectionD_hasDerivAt ht
  have hroot := correction_root_hasDerivAt ht
  have hpos := Real.sqrt_pos.mpr (correction_radicand_pos ht.2)
  have h := (((hasDerivAt_id t).sub_const 1).add (hC.mul hD)).div
    (hroot.const_mul 2) (by positivity : 2*Real.sqrt ((1-t)^2+berryEsseenRegularCorrection t^2) ≠ 0)
  convert! h using 1
  dsimp [berryEsseenCorrectionNormDD]
  field_simp
  ring

/-- The first two correction-norm derivatives have uniform rational bounds. -/
theorem berryEsseenCorrectionNorm_derivative_bounds {t : ℝ} (ht : t ∈ Ico 0 (3/4:ℝ)) :
    |berryEsseenCorrectionNormD t| ≤ 3 ∧ |berryEsseenCorrectionNormDD t| ≤ 75 := by
  obtain ⟨hD, hDD⟩ := berryEsseenRegularCorrection_derivative_bounds ht
  let r := Real.sqrt ((1-t)^2+berryEsseenRegularCorrection t^2)
  have hr : 0 < r := Real.sqrt_pos.mpr (correction_radicand_pos ht.2)
  have hr2 : r^2 = (1-t)^2+berryEsseenRegularCorrection t^2 := Real.sq_sqrt (correction_radicand_pos ht.2).le
  have hr4 : (1/4:ℝ) ≤ r := by
    have ht1 : 1/4 ≤ 1-t := by linarith [ht.2]
    nlinarith [sq_nonneg (berryEsseenRegularCorrection t)]
  have hA : (-1:ℝ)^2+berryEsseenRegularCorrectionD t^2 ≤ 26 := by
    have hsq := (sq_le_sq₀ (abs_nonneg _) (by norm_num : (0:ℝ) ≤ 5)).mpr hD
    rw [sq_abs] at hsq
    nlinarith
  have h := berryEsseen_norm_derivative_algebra hr hr2 hA hDD
  have heq1 : berryEsseenCorrectionNormD t =
      (((1-t)*(-1)+berryEsseenRegularCorrection t*berryEsseenRegularCorrectionD t)/r)/2 := by
    unfold berryEsseenCorrectionNormD
    dsimp [r]
    ring
  have heq2 : berryEsseenCorrectionNormDD t =
      ((((-1:ℝ)^2+berryEsseenRegularCorrectionD t^2+
        berryEsseenRegularCorrection t*berryEsseenRegularCorrectionDD t)/r) -
        ((1-t)*(-1)+berryEsseenRegularCorrection t*berryEsseenRegularCorrectionD t)^2/r^3)/2 := by
    unfold berryEsseenCorrectionNormDD
    dsimp [r]
    ring
  constructor
  · rw [heq1, abs_div]
    norm_num only [abs_two]
    have hsq := h.1
    rw [← sq_abs] at hsq
    nlinarith [abs_nonneg (((1-t)*(-1)+berryEsseenRegularCorrection t*berryEsseenRegularCorrectionD t)/r)]
  · rw [heq2, abs_div]
    norm_num only [abs_two]
    have hb : (26:ℝ)/r ≤ 104 := (div_le_iff₀ hr).mpr (by nlinarith)
    have hdd := h.2
    linarith

/-- The smooth extension has the same integrand values as the original corrected kernel. -/
theorem berryEsseenCorrectionNorm_eq {t : ℝ} (ht : 0 < t) (ht1 : t < 3/4) :
    berryEsseenCorrectionNorm t =
      ‖berryEsseenSmoothingKernel t - Complex.I/(2*Real.pi*t:ℝ)‖ := by
  have ht1' : t < 1 := by linarith
  have hr : (berryEsseenSmoothingKernel t - Complex.I/(2*Real.pi*t:ℝ)).re = (1-t)/2 := by
    simp only [Complex.sub_re, Complex.div_ofReal_re, Complex.I_re,
      berryEsseenSmoothingKernel, zero_div, sub_zero]
  have hi : (berryEsseenSmoothingKernel t - Complex.I/(2*Real.pi*t:ℝ)).im =
      -berryEsseenRegularCorrection t/2 := by
    rw [berryEsseenRegularCorrection_eq ht ht1']
    simp only [Complex.sub_im, Complex.div_ofReal_im, Complex.I_im, berryEsseenSmoothingKernel,
      berryEsseenCotangentCorrection, Real.cot_eq_cos_div_sin]
    field_simp
    ring
  have h := Complex.sq_norm_sub_sq_re (berryEsseenSmoothingKernel t - Complex.I/(2*Real.pi*t:ℝ))
  rw [hr, hi] at h
  unfold berryEsseenCorrectionNorm
  have hs := Real.sq_sqrt (correction_radicand_pos ht1).le
  have hn := norm_nonneg (berryEsseenSmoothingKernel t - Complex.I/(2*Real.pi*t:ℝ))
  have hr0 := Real.sqrt_nonneg ((1-t)^2+berryEsseenRegularCorrection t^2)
  nlinarith

/-- Explicit derivatives certify composite trapezoidal quadrature with its full error allowance. -/
theorem berryEsseen_integral_le_composite_trapezoid {f f' f'' : ℝ → ℝ} {a b M : ℝ}
    (hab : a < b) (hM : 0 ≤ M)
    (hd : ∀ x ∈ Icc a b, HasDerivAt f (f' x) x)
    (hdd : ∀ x ∈ Icc a b, HasDerivAt f' (f'' x) x)
    (hb : ∀ x ∈ Icc a b, |f'' x| ≤ M) {N : ℕ} (hN : 0 < N) :
    (∫ x in a..b, f x) ≤ trapezoidal_integral f N a b + (b-a)^3*M/(12*N^2) := by
  have huniq := uniqueDiffOn_Icc hab
  have heq : EqOn (derivWithin f (Icc a b)) f' (Icc a b) := by
    intro x hx
    exact (hd x hx).hasDerivWithinAt.derivWithin (huniq x hx)
  have hd1 : DifferentiableOn ℝ f (Icc a b) := fun x hx => (hd x hx).differentiableAt.differentiableWithinAt
  have hd2 : DifferentiableOn ℝ (derivWithin f (Icc a b)) (Icc a b) := by
    apply (show DifferentiableOn ℝ f' (Icc a b) from fun x hx => (hdd x hx).differentiableAt.differentiableWithinAt).congr
    exact heq
  have hsecond : ∀ x, |iteratedDerivWithin 2 f (Icc a b) x| ≤ M := by
    intro x
    by_cases hx : x ∈ Icc a b
    · have hid : iteratedDerivWithin 2 f (Icc a b) x = f'' x := by
        simp only [iteratedDerivWithin_succ', iteratedDerivWithin_zero]
        rw [derivWithin_congr heq (heq hx)]
        exact (hdd x hx).hasDerivWithinAt.derivWithin (huniq x hx)
      rw [hid]
      exact hb x hx
    · rw [iteratedDerivWithin_succ, derivWithin_zero_of_notMem_closure (by rwa [closure_Icc]), abs_zero]
      exact hM
  have h := trapezoidal_error_le (a := a) (b := b) (N := N)
    (by simpa only [uIcc_of_le hab.le] using hd1)
    (by simpa only [uIcc_of_le hab.le] using hd2)
    (by simpa only [uIcc_of_le hab.le] using hsecond) hN
  simp only [trapezoidal_error, abs_of_pos (sub_pos.mpr hab)] at h
  have h := (abs_le.mp h).1
  linarith

/-- The regular correction norm is nonnegative at every point. -/
theorem berryEsseenCorrectionNorm_nonneg (t : ℝ) : 0 ≤ berryEsseenCorrectionNorm t := by
  unfold berryEsseenCorrectionNorm
  positivity

/-- The regular endpoint extension preserves the half-unit bound. -/
theorem berryEsseenCorrectionNorm_le_half {t : ℝ} (ht : t ∈ Ico 0 (3/4:ℝ)) :
    berryEsseenCorrectionNorm t ≤ 1/2 := by
  rcases ht.1.eq_or_lt with h | h
  · subst t
    norm_num [berryEsseenCorrectionNorm, berryEsseenRegularCorrection]
  · rw [berryEsseenCorrectionNorm_eq h ht.2]
    have hk := norm_smoothing_kernel_correction_le_linear h (by linarith [ht.2])
    linarith

/-- Gaussian factors absorb a first power of their argument. -/
theorem berryEsseen_abs_mul_normalExp_le_one (u : ℝ) :
    |u| * Real.exp (-u^2/2) ≤ 1 := by
  have h : |u| ≤ Real.exp (u^2/2) := by
    have he := Real.add_one_le_exp (u^2/2)
    nlinarith [sq_abs u, sq_nonneg (|u|-1)]
  have heq : Real.exp (u^2/2)*Real.exp (-u^2/2) = 1 := by
    rw [← Real.exp_add]
    ring_nf
    exact Real.exp_zero
  exact (mul_le_mul_of_nonneg_right h (Real.exp_pos _).le).trans_eq heq

/-- Gaussian factors also absorb the square of their argument. -/
theorem berryEsseen_sq_mul_normalExp_le_one (u : ℝ) :
    u^2*Real.exp (-u^2/2) ≤ 1 := by
  have he : (2:ℝ) ≤ Real.exp 1 := by linarith [Real.add_one_le_exp 1]
  have hprod := mul_le_mul_of_nonneg_right he (Real.exp_pos (-1)).le
  rw [← Real.exp_add] at hprod
  norm_num at hprod
  have h := Real.mul_exp_neg_le_exp_neg_one (u^2/2)
  have harg : -(u^2/2) = -u^2/2 := by ring
  rw [harg] at h
  nlinarith

/-- A smooth form of the normal-correction integrand, including its lower endpoint. -/
def berryEsseenCorrectionIntegrand (U t : ℝ) : ℝ :=
  2*berryEsseenCorrectionNorm t*Real.exp (-(U*t)^2/2)

/-- First derivative of the normal-correction integrand. -/
def berryEsseenCorrectionIntegrandD (U t : ℝ) : ℝ :=
  2*(berryEsseenCorrectionNormD t-U^2*t*berryEsseenCorrectionNorm t)*Real.exp (-(U*t)^2/2)

/-- Second derivative of the normal-correction integrand. -/
def berryEsseenCorrectionIntegrandDD (U t : ℝ) : ℝ :=
  2*(berryEsseenCorrectionNormDD t-2*U^2*t*berryEsseenCorrectionNormD t+
    (U^4*t^2-U^2)*berryEsseenCorrectionNorm t)*Real.exp (-(U*t)^2/2)

private theorem normal_scaled_exp_hasDerivAt (U t : ℝ) :
    HasDerivAt (fun x : ℝ => Real.exp (-(U*x)^2/2))
      (-U^2*t*Real.exp (-(U*t)^2/2)) t := by
  have h := (((((hasDerivAt_id t).const_mul U).pow 2).neg).div_const 2).exp
  convert! h using 1
  dsimp
  ring

/-- The first derivative formula holds throughout the numerical interval. -/
theorem berryEsseenCorrectionIntegrand_hasDerivAt {t : ℝ} (ht : t ∈ Ioo (-3/4:ℝ) (3/4)) (U : ℝ) :
    HasDerivAt (berryEsseenCorrectionIntegrand U) (berryEsseenCorrectionIntegrandD U t) t := by
  have h := ((berryEsseenCorrectionNorm_hasDerivAt ht).const_mul 2).mul (normal_scaled_exp_hasDerivAt U t)
  convert! h using 1
  dsimp [berryEsseenCorrectionIntegrandD]
  ring

/-- The second derivative formula holds throughout the numerical interval. -/
theorem berryEsseenCorrectionIntegrandD_hasDerivAt {t : ℝ} (ht : t ∈ Ioo (-3/4:ℝ) (3/4)) (U : ℝ) :
    HasDerivAt (berryEsseenCorrectionIntegrandD U) (berryEsseenCorrectionIntegrandDD U t) t := by
  have hc := berryEsseenCorrectionNorm_hasDerivAt ht
  have hd := berryEsseenCorrectionNormD_hasDerivAt ht
  have h := ((hd.sub (((hasDerivAt_id t).const_mul (U^2)).mul hc)).const_mul 2).mul
    (normal_scaled_exp_hasDerivAt U t)
  convert! h using 1
  dsimp [berryEsseenCorrectionIntegrandDD]
  ring

/-- A polynomial in the cutoff bounds the quadrature error coefficient uniformly in frequency. -/
theorem berryEsseenCorrectionIntegrand_second_bound {U t : ℝ} (hU : 0 ≤ U)
    (ht : t ∈ Ico 0 (3/4:ℝ)) :
    |berryEsseenCorrectionIntegrandDD U t| ≤ 150+12*U+U^2 := by
  obtain ⟨hd, hdd⟩ := berryEsseenCorrectionNorm_derivative_bounds ht
  have hc := berryEsseenCorrectionNorm_le_half ht
  have hc0 := berryEsseenCorrectionNorm_nonneg t
  let E := Real.exp (-(U*t)^2/2)
  have he0 : 0 ≤ E := (Real.exp_pos _).le
  have he1 : E ≤ 1 := Real.exp_le_one_iff.mpr (by nlinarith [sq_nonneg (U*t)])
  have hfirst : |(U*t)*E| ≤ 1 := by
    rw [abs_mul, abs_of_nonneg he0]
    exact berryEsseen_abs_mul_normalExp_le_one (U*t)
  have hsecond : (U*t)^2*E ≤ 1 := berryEsseen_sq_mul_normalExp_le_one (U*t)
  have hdiff : |(U*t)^2*E-E| ≤ 1 := by
    rw [abs_le]
    constructor <;> nlinarith [mul_nonneg (sq_nonneg (U*t)) he0]
  have hterm0 : |berryEsseenCorrectionNormDD t*E| ≤ 75 := by
    rw [abs_mul, abs_of_nonneg he0]
    exact (mul_le_mul hdd he1 he0 (by norm_num)).trans_eq (by ring)
  have hterm1 : |2*U*((U*t)*E)*berryEsseenCorrectionNormD t| ≤ 6*U := by
    rw [abs_mul, abs_mul, abs_of_nonneg (by positivity : 0 ≤ 2*U)]
    have h := mul_le_mul (mul_le_mul_of_nonneg_left hfirst (by positivity : 0 ≤ 2*U)) hd
      (abs_nonneg _) (by positivity : 0 ≤ 2*U*1)
    nlinarith
  have hterm2 : |U^2*((U*t)^2*E-E)*berryEsseenCorrectionNorm t| ≤ U^2/2 := by
    rw [abs_mul, abs_mul, abs_of_nonneg (sq_nonneg U), abs_of_nonneg hc0]
    have h := mul_le_mul (mul_le_mul_of_nonneg_left hdiff (sq_nonneg U)) hc hc0 (by positivity : 0 ≤ U^2*1)
    nlinarith
  have heq : berryEsseenCorrectionIntegrandDD U t =
      2*(berryEsseenCorrectionNormDD t*E - 2*U*((U*t)*E)*berryEsseenCorrectionNormD t +
        U^2*((U*t)^2*E-E)*berryEsseenCorrectionNorm t) := by
    unfold berryEsseenCorrectionIntegrandDD
    dsimp [E]
    ring
  rw [heq, abs_mul, abs_two]
  have htri := (abs_add_le (berryEsseenCorrectionNormDD t*E - 2*U*((U*t)*E)*berryEsseenCorrectionNormD t)
    (U^2*((U*t)^2*E-E)*berryEsseenCorrectionNorm t)).trans
    (add_le_add (abs_sub _ _) le_rfl)
  nlinarith

/-- The normal-correction integral is bounded by explicit quadrature and a rational error formula. -/
theorem berryEsseen_correction_quadrature {U τ : ℝ} (hU : 0 ≤ U) (hτ : 0 < τ) (hτ1 : τ < 3/4)
    {N : ℕ} (hN : 0 < N) :
    2*(∫ t in (0:ℝ)..τ, ‖berryEsseenSmoothingKernel t-Complex.I/(2*Real.pi*t:ℝ)‖ *
      Real.exp (-(U*t)^2/2)) ≤
    trapezoidal_integral (berryEsseenCorrectionIntegrand U) N 0 τ +
      τ^3*(150+12*U+U^2)/(12*N^2) := by
  have heq :
      2*(∫ t in (0:ℝ)..τ, ‖berryEsseenSmoothingKernel t-Complex.I/(2*Real.pi*t:ℝ)‖ *
        Real.exp (-(U*t)^2/2)) = ∫ t in (0:ℝ)..τ, berryEsseenCorrectionIntegrand U t := by
    rw [← intervalIntegral.integral_const_mul, intervalIntegral.integral_of_le hτ.le,
      intervalIntegral.integral_of_le hτ.le]
    apply setIntegral_congr_fun measurableSet_Ioc
    intro t ht
    unfold berryEsseenCorrectionIntegrand
    rw [berryEsseenCorrectionNorm_eq ht.1 (ht.2.trans_lt hτ1)]
    ring
  rw [heq]
  have hmem (x : ℝ) (hx : x ∈ Icc 0 τ) : x ∈ Ioo (-3/4:ℝ) (3/4) :=
    ⟨by linarith [hx.1], hx.2.trans_lt hτ1⟩
  simpa only [sub_zero] using berryEsseen_integral_le_composite_trapezoid hτ (by positivity)
    (fun x hx => berryEsseenCorrectionIntegrand_hasDerivAt (hmem x hx) U)
    (fun x hx => berryEsseenCorrectionIntegrandD_hasDerivAt (hmem x hx) U)
    (fun x hx => berryEsseenCorrectionIntegrand_second_bound hU ⟨hx.1, hx.2.trans_lt hτ1⟩) hN

/-- A low-degree rational majorant retains the sine refinement needed for the sharp constant. -/
def berryEsseenSineUpper5 (x : ℝ) : ℝ := x-x^3/6+x^5/120

/-- The sine majorant is rigorous throughout the numerical working range. -/
theorem sin_le_berryEsseenSineUpper5 {x : ℝ} (hx : 0 ≤ x) (hx1 : x ≤ 1) :
    Real.sin x ≤ berryEsseenSineUpper5 x := by
  rcases hx.eq_or_lt with h | hx
  · subst x
    simp [berryEsseenSineUpper5]
  obtain ⟨z, hz, h⟩ := taylor_mean_remainder_lagrange_iteratedDeriv
    (n := 5) (f := Real.sin) (x₀ := 0) (x := x) hx.ne (by fun_prop)
  have hwithin (k : ℕ) : iteratedDerivWithin k Real.sin (uIcc 0 x) 0 = iteratedDeriv k Real.sin 0 :=
    iteratedDerivWithin_eq_iteratedDeriv (uniqueDiffOn_uIcc hx.ne)
      Real.contDiff_sin.contDiffAt (by simp)
  rw [taylor_within_apply] at h
  simp_rw [hwithin] at h
  norm_num [Finset.sum_range_succ, smul_eq_mul] at h
  rw [uIoo_of_lt hx] at hz
  have hsin : 0 ≤ Real.sin z := Real.sin_nonneg_of_nonneg_of_le_pi hz.1.le
    (by linarith [hz.2, Real.pi_gt_three])
  unfold berryEsseenSineUpper5
  nlinarith [mul_nonneg hsin (pow_nonneg hx.le 6)]

/-- The polynomial majorizes the clipped sine as well on this range. -/
theorem clippedSine_le_berryEsseenSineUpper5 {x : ℝ} (hx : 0 ≤ x) (hx1 : x ≤ 1) :
    clippedSine x ≤ berryEsseenSineUpper5 x := by
  rw [clippedSine, min_eq_left (by linarith [Real.pi_gt_three])]
  exact sin_le_berryEsseenSineUpper5 hx hx1

/-- The inner exponent when the third-moment budget is chosen to be an exact cube. -/
def berryEsseenCappedExponent (q u : ℝ) : ℝ :=
  (49581/250000:ℝ)*q^3*u^3 + berryEsseenResidualBump (min (u*q) (250000/148743))

/-- A positive-part polynomial removes the cap from the inner exponent and displays its convexity. -/
theorem berryEsseenCappedExponent_eq (q u : ℝ) :
    berryEsseenCappedExponent q u =
      (u*q)^2/2 + (max (u*q-250000/148743) 0)^2/2 +
        (49581/250000:ℝ)*(max (u*q-250000/148743) 0)^3 := by
  unfold berryEsseenCappedExponent berryEsseenResidualBump
  by_cases h : u*q ≤ 250000/148743
  · rw [min_eq_left h, max_eq_right (sub_nonpos.mpr h)]
    ring
  · rw [min_eq_right (le_of_not_ge h), max_eq_left (sub_nonneg.mpr (le_of_not_ge h))]
    ring

/-- The capped exponent is increasing at nonnegative frequencies. -/
theorem berryEsseenCappedExponent_monotone {q : ℝ} (hq : 0 ≤ q) :
    MonotoneOn (berryEsseenCappedExponent q) (Ici 0) := by
  intro u hu v hv huv
  rw [berryEsseenCappedExponent_eq, berryEsseenCappedExponent_eq]
  have hqu : 0 ≤ u*q := mul_nonneg hu hq
  have hqv : 0 ≤ v*q := mul_nonneg hv hq
  have hmul := mul_le_mul_of_nonneg_right huv hq
  have hmax : max (u*q-250000/148743) 0 ≤ max (v*q-250000/148743) 0 :=
    max_le_max (by linarith) le_rfl
  have hmax0 : 0 ≤ max (u*q-250000/148743) 0 := le_max_right _ _
  gcongr

/-- The capped exponent is convex on the nonnegative half-line. -/
theorem berryEsseenCappedExponent_convex {q : ℝ} (hq : 0 ≤ q) :
    ConvexOn ℝ (Ici 0) (berryEsseenCappedExponent q) := by
  let z : ℝ → ℝ := fun u => u*q
  let w : ℝ → ℝ := fun u => max (u*q-250000/148743) 0
  have hz : ConvexOn ℝ (Ici 0) z := by
    convert! (convexOn_id (convex_Ici (0:ℝ))).smul hq using 1
    ext u
    simp [z, smul_eq_mul, mul_comm]
  have hz0 : ∀ ⦃u⦄, u ∈ Ici (0:ℝ) → 0 ≤ z u := fun u hu => mul_nonneg hu hq
  have hw : ConvexOn ℝ (Ici 0) w := by
    convert! (hz.add_const (-(250000/148743:ℝ))).sup (convexOn_const (0:ℝ) (convex_Ici 0)) using 1
  have hw0 : ∀ ⦃u⦄, u ∈ Ici (0:ℝ) → 0 ≤ w u := fun _ _ => le_max_right _ _
  have h := (((hz.pow hz0 2).smul (by norm_num : (0:ℝ) ≤ 1/2)).add
    ((hw.pow hw0 2).smul (by norm_num : (0:ℝ) ≤ 1/2))).add
    ((hw.pow hw0 3).smul (by norm_num : (0:ℝ) ≤ 49581/250000))
  apply h.congr
  intro u _
  rw [berryEsseenCappedExponent_eq]
  dsimp [z, w]
  ring

/-- The inner exponential is convex, permitting certified trapezoidal prefix integrals. -/
theorem berryEsseenCappedExponential_convex {q : ℝ} (hq : 0 ≤ q) :
    ConvexOn ℝ (Ici 0) (fun u => Real.exp (berryEsseenCappedExponent q u)) := by
  have hc := berryEsseenCappedExponent_convex hq
  refine ⟨hc.1, ?_⟩
  intro x hx y hy a b ha hb hab
  exact (Real.exp_le_exp.mpr (hc.2 hx hy ha hb hab)).trans
    (convexOn_exp.2 (Set.mem_univ _) (Set.mem_univ _) ha hb hab)

/-- The rational polynomial weight in the inner characteristic-function majorant. -/
def berryEsseenInnerWeight (a u : ℝ) : ℝ := a*u^2-a^3*u^4/6+a^5*u^6/120

private def innerWeightD (a u : ℝ) : ℝ := 2*a*u-(2/3:ℝ)*a^3*u^3+(1/20:ℝ)*a^5*u^5
private def innerWeightDD (a u : ℝ) : ℝ := 2*a-2*a^3*u^2+(1/4:ℝ)*a^5*u^4

private theorem innerWeight_hasDerivAt (a u : ℝ) :
    HasDerivAt (berryEsseenInnerWeight a) (innerWeightD a u) u := by
  have h := ((((hasDerivAt_id u).pow 2).const_mul a).sub
    ((((hasDerivAt_id u).pow 4).const_mul (a^3)).div_const 6)).add
    ((((hasDerivAt_id u).pow 6).const_mul (a^5)).div_const 120)
  convert! h using 1
  dsimp [innerWeightD]
  ring

private theorem innerWeightD_hasDerivAt (a u : ℝ) :
    HasDerivAt (innerWeightD a) (innerWeightDD a u) u := by
  have h := (((hasDerivAt_id u).const_mul (2*a)).sub
    (((hasDerivAt_id u).pow 3).const_mul ((2/3:ℝ)*a^3))).add
    (((hasDerivAt_id u).pow 5).const_mul ((1/20:ℝ)*a^5))
  convert! h using 1
  dsimp [innerWeightDD]
  ring

private theorem innerWeightDD_nonneg {a u : ℝ} (ha : 0 ≤ a) (hu : 0 ≤ u) (hau : a*u ≤ 1) :
    0 ≤ innerWeightDD a u := by
  have hsq : (a*u)^2 ≤ 1 := by nlinarith [mul_nonneg ha hu]
  have h := mul_nonneg ha (sub_nonneg.mpr hsq)
  unfold innerWeightDD
  nlinarith [mul_nonneg (pow_nonneg ha 5) (pow_nonneg hu 4)]

private theorem innerWeightD_nonneg {a u : ℝ} (ha : 0 ≤ a) (hu : 0 ≤ u) (hau : a*u ≤ 1) :
    0 ≤ innerWeightD a u := by
  have hsq : (a*u)^2 ≤ 1 := by nlinarith [mul_nonneg ha hu]
  have hf : 0 ≤ 2-(2/3:ℝ)*(a*u)^2+(1/20:ℝ)*(a*u)^4 := by nlinarith [pow_nonneg (mul_nonneg ha hu) 4]
  have h := mul_nonneg (mul_nonneg ha hu) hf
  unfold innerWeightD
  nlinarith

/-- The inner weight is nonnegative on the range where its sine approximation is used. -/
theorem berryEsseenInnerWeight_nonneg {a u : ℝ} (ha : 0 ≤ a) (hu : 0 ≤ u) (hau : a*u ≤ 1) :
    0 ≤ berryEsseenInnerWeight a u := by
  have hsq : (a*u)^2 ≤ 1 := by nlinarith [mul_nonneg ha hu]
  have hf : 0 ≤ 1-(a*u)^2/6+(a*u)^4/120 := by nlinarith [pow_nonneg (mul_nonneg ha hu) 4]
  have h := mul_nonneg (mul_nonneg ha (sq_nonneg u)) hf
  unfold berryEsseenInnerWeight
  nlinarith

/-- Convexity makes every trapezoidal prefix sum an upper bound for the inner integral. -/
theorem berryEsseenInnerWeight_convex {a V : ℝ} (ha : 0 ≤ a) (hV : a*V ≤ 1) :
    ConvexOn ℝ (Icc 0 V) (berryEsseenInnerWeight a) := by
  apply convexOn_of_hasDerivWithinAt2_nonneg (convex_Icc 0 V)
    (by unfold berryEsseenInnerWeight; fun_prop)
    (fun x _ => (innerWeight_hasDerivAt a x).hasDerivWithinAt)
    (fun x _ => (innerWeightD_hasDerivAt a x).hasDerivWithinAt)
  intro x hx
  have hx' : x ∈ Icc 0 V := interior_subset hx
  exact innerWeightDD_nonneg ha hx'.1 ((mul_le_mul_of_nonneg_left hx'.2 ha).trans hV)

/-- The inner weight is increasing on its certified argument range. -/
theorem berryEsseenInnerWeight_monotone {a V : ℝ} (ha : 0 ≤ a) (hV : a*V ≤ 1) :
    MonotoneOn (berryEsseenInnerWeight a) (Icc 0 V) := by
  apply monotoneOn_of_hasDerivWithinAt_nonneg (convex_Icc 0 V)
    (by unfold berryEsseenInnerWeight; fun_prop)
    (fun x _ => (innerWeight_hasDerivAt a x).hasDerivWithinAt)
  intro x hx
  have hx' : x ∈ Icc 0 V := interior_subset hx
  exact innerWeightD_nonneg ha hx'.1 ((mul_le_mul_of_nonneg_left hx'.2 ha).trans hV)

/-- The integrand used for finite rational inner-integral certificates. -/
def berryEsseenInnerMajorant (q u : ℝ) : ℝ :=
  berryEsseenInnerWeight (q^3/4) u * Real.exp (berryEsseenCappedExponent q u)

/-- The polynomial inner majorant dominates the sine-refined integrand. -/
theorem berryEsseenInnerMajorant_ge {q u : ℝ} (hq : 0 ≤ q) (hu : 0 ≤ u) (hu1 : (q^3/4)*u ≤ 1) :
    clippedSine (u*q^3/4)*u*Real.exp ((49581/250000:ℝ)*q^3*u^3+
      berryEsseenResidualBump (min (u*q) (250000/148743))) ≤ berryEsseenInnerMajorant q u := by
  have hs := clippedSine_le_berryEsseenSineUpper5 (by positivity : 0 ≤ u*q^3/4) (by nlinarith)
  have h := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hs hu)
    (Real.exp_pos ((49581/250000:ℝ)*q^3*u^3+berryEsseenResidualBump (min (u*q) (250000/148743)))).le
  convert! h using 1
  unfold berryEsseenInnerMajorant berryEsseenInnerWeight berryEsseenSineUpper5 berryEsseenCappedExponent
  ring

/-- The full polynomial-exponential majorant is convex on the complete low-frequency interval. -/
theorem berryEsseenInnerMajorant_convex {q V : ℝ} (hq : 0 ≤ q) (hV : (q^3/4)*V ≤ 1) :
    ConvexOn ℝ (Icc 0 V) (berryEsseenInnerMajorant q) := by
  have ha : 0 ≤ q^3/4 := by positivity
  have hH := berryEsseenInnerWeight_convex ha hV
  have hHm := berryEsseenInnerWeight_monotone ha hV
  have hE : ConvexOn ℝ (Icc 0 V) (fun u => Real.exp (berryEsseenCappedExponent q u)) :=
    (berryEsseenCappedExponential_convex hq).subset (fun _ hx => hx.1) (convex_Icc 0 V)
  have hEm : MonotoneOn (fun u => Real.exp (berryEsseenCappedExponent q u)) (Icc 0 V) := by
    intro x hx y hy hxy
    exact Real.exp_le_exp.mpr (berryEsseenCappedExponent_monotone hq hx.1 hy.1 hxy)
  exact hH.mul hE
    (fun u hu => berryEsseenInnerWeight_nonneg ha hu.1 ((mul_le_mul_of_nonneg_left hu.2 ha).trans hV))
    (fun _ _ => (Real.exp_pos _).le) (hHm.monovaryOn hEm)

/-- A convex integrand lies below its endpoint chord, so one trapezoid is an upper bound. -/
theorem berryEsseen_convex_integral_le_trapezoid {f : ℝ → ℝ} {a b : ℝ} (hab : a ≤ b)
    (hc : ConvexOn ℝ (Icc a b) f) (hf : IntervalIntegrable f volume a b) :
    (∫ x in a..b, f x) ≤ (b-a)/2*(f a+f b) := by
  rcases hab.eq_or_lt with h | hab
  · simp [h]
  let g (x : ℝ) := ((b-x)*f a+(x-a)*f b)/(b-a)
  have hg : IntervalIntegrable g volume a b := by apply Continuous.intervalIntegrable; unfold g; fun_prop
  have hpoint (x : ℝ) (hx : x ∈ Icc a b) : f x ≤ g x := by
    have hw0 : 0 ≤ (b-x)/(b-a) := div_nonneg (sub_nonneg.mpr hx.2) (sub_pos.mpr hab).le
    have hw1 : 0 ≤ (x-a)/(b-a) := div_nonneg (sub_nonneg.mpr hx.1) (sub_pos.mpr hab).le
    have hsum : (b-x)/(b-a)+(x-a)/(b-a) = 1 := by field_simp; ring
    have hcomb : (b-x)/(b-a)*a+(x-a)/(b-a)*b = x := by field_simp; ring
    have h := hc.2 (left_mem_Icc.mpr hab.le) (right_mem_Icc.mpr hab.le) hw0 hw1 hsum
    simp only [smul_eq_mul, hcomb] at h
    convert! h using 1
    dsimp [g]
    ring
  refine (intervalIntegral.integral_mono_on hab.le hf hg hpoint).trans_eq ?_
  let G (x : ℝ) := ((b*x-x^2/2)*f a+(x^2/2-a*x)*f b)/(b-a)
  have hG (x : ℝ) : HasDerivAt G (g x) x := by
    have h := (((((hasDerivAt_id x).const_mul b).sub (((hasDerivAt_id x).pow 2).div_const 2)).mul_const (f a)).add
      (((((hasDerivAt_id x).pow 2).div_const 2).sub ((hasDerivAt_id x).const_mul a)).mul_const (f b))).div_const (b-a)
    convert! h using 1
    dsimp [g]
    ring
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hG x) hg]
  dsimp [G]
  field_simp
  ring

/-- A finite sequence of convex cells certifies every prefix integral. -/
theorem berryEsseen_convex_integral_le_trapezoids {f : ℝ → ℝ} {n : ℕ} (a : ℕ → ℝ)
    (ha : ∀ i < n, a i ≤ a (i+1))
    (hc : ∀ i < n, ConvexOn ℝ (Icc (a i) (a (i+1))) f)
    (hf : ∀ i < n, IntervalIntegrable f volume (a i) (a (i+1))) :
    (∫ x in a 0..a n, f x) ≤
      ∑ i ∈ Finset.range n, (a (i+1)-a i)/2*(f (a i)+f (a (i+1))) := by
  rw [← intervalIntegral.sum_integral_adjacent_intervals hf]
  exact Finset.sum_le_sum (fun i hi => berryEsseen_convex_integral_le_trapezoid
    (ha i (Finset.mem_range.mp hi)) (hc i (Finset.mem_range.mp hi)) (hf i (Finset.mem_range.mp hi)))

@[fun_prop] theorem continuous_berryEsseenInnerMajorant (q : ℝ) : Continuous (berryEsseenInnerMajorant q) := by
  unfold berryEsseenInnerMajorant berryEsseenInnerWeight berryEsseenCappedExponent berryEsseenResidualBump
  fun_prop

/-- A finite rational-polynomial trapezoidal prefix bounds the actual inner error integral. -/
theorem berryEsseenNormalErrorBound_prefix {q h : ℝ} (hq : 0 ≤ q) (hh : 0 ≤ h) (n : ℕ)
    (hcut : (q^3/4)*((n:ℝ)*h) ≤ 1) :
    berryEsseenNormalErrorBound (q^3) q ((n:ℝ)*h) ≤
      2*Real.exp (-((n:ℝ)*h)^2/2) *
        ∑ i ∈ Finset.range n, h/2*(berryEsseenInnerMajorant q ((i:ℝ)*h)+
          berryEsseenInnerMajorant q (((i:ℝ)+1)*h)) := by
  have hnh : 0 ≤ (n:ℝ)*h := by positivity
  have hconv := berryEsseenInnerMajorant_convex hq hcut
  have hcontinuous := continuous_berryEsseenInnerMajorant q
  have hbase :
      (∫ u in (0:ℝ)..((n:ℝ)*h), clippedSine (u*q^3/4)*u*
        Real.exp ((49581/250000:ℝ)*q^3*u^3+berryEsseenResidualBump (min (u*q) (250000/148743)))) ≤
      ∫ u in (0:ℝ)..((n:ℝ)*h), berryEsseenInnerMajorant q u := by
    apply intervalIntegral.integral_mono_on hnh
      (by apply Continuous.intervalIntegrable; unfold berryEsseenResidualBump; fun_prop)
      (hcontinuous.intervalIntegrable _ _)
    intro u hu
    exact berryEsseenInnerMajorant_ge hq hu.1
      ((mul_le_mul_of_nonneg_left hu.2 (by positivity : 0 ≤ q^3/4)).trans hcut)
  have ha : Monotone (fun i : ℕ => (i:ℝ)*h) := fun i j hij =>
    mul_le_mul_of_nonneg_right (by exact_mod_cast hij) hh
  have hcell : ∀ i < n, Icc ((i:ℝ)*h) (((i+1:ℕ):ℝ)*h) ⊆ Icc 0 ((n:ℝ)*h) := by
    intro i hi u hu
    exact ⟨(by positivity : 0 ≤ (i:ℝ)*h).trans hu.1, hu.2.trans (ha (by omega))⟩
  have htrap := berryEsseen_convex_integral_le_trapezoids (fun i : ℕ => (i:ℝ)*h)
    (fun i _ => ha (Nat.le_succ i))
    (fun i hi => hconv.subset (hcell i hi) (convex_Icc _ _))
    (fun _ _ => hcontinuous.intervalIntegrable _ _)
  have htrap' :
      (∫ u in (0:ℝ)..((n:ℝ)*h), berryEsseenInnerMajorant q u) ≤
      ∑ i ∈ Finset.range n, h/2*(berryEsseenInnerMajorant q ((i:ℝ)*h)+
        berryEsseenInnerMajorant q (((i:ℝ)+1)*h)) := by
    simpa only [Nat.cast_zero, zero_mul, Nat.cast_add, Nat.cast_one, add_mul, add_sub_cancel_left,
      one_mul] using htrap
  unfold berryEsseenNormalErrorBound
  exact mul_le_mul_of_nonneg_left (hbase.trans htrap') (by positivity)

private theorem sin_sub_mul_cos_nonneg {x : ℝ} (hx : x ∈ Icc 0 Real.pi) :
    0 ≤ Real.sin x-x*Real.cos x := by
  have hder (y : ℝ) : HasDerivAt (fun z => Real.sin z-z*Real.cos z) (y*Real.sin y) y := by
    convert! (Real.hasDerivAt_sin y).sub ((hasDerivAt_id y).mul (Real.hasDerivAt_cos y)) using 1
    dsimp
    ring
  have hm : MonotoneOn (fun z => Real.sin z-z*Real.cos z) (Icc 0 Real.pi) := by
    apply monotoneOn_of_hasDerivWithinAt_nonneg (convex_Icc _ _) (by fun_prop)
      (fun y _ => (hder y).hasDerivWithinAt)
    intro y hy
    have hy' : y ∈ Icc 0 Real.pi := interior_subset hy
    exact mul_nonneg hy'.1 (Real.sin_nonneg_of_nonneg_of_le_pi hy'.1 hy'.2)
  simpa using hm (left_mem_Icc.mpr Real.pi_pos.le) hx hx.1

private def kernelImagD (t : ℝ) : ℝ :=
  (-Real.cos (Real.pi*t)/Real.sin (Real.pi*t)-Real.pi*(1-t)/Real.sin (Real.pi*t)^2)/2
private def kernelImagDD (t : ℝ) : ℝ :=
  Real.pi*(Real.sin (Real.pi*t)+Real.pi*(1-t)*Real.cos (Real.pi*t))/Real.sin (Real.pi*t)^3

private theorem kernel_sin_pos {t : ℝ} (ht : t ∈ Ioo 0 1) : 0 < Real.sin (Real.pi*t) :=
  Real.sin_pos_of_pos_of_lt_pi (mul_pos Real.pi_pos ht.1) (by nlinarith [Real.pi_pos, ht.2])

private theorem kernel_cot_hasDerivAt {t : ℝ} (ht : t ∈ Ioo 0 1) :
    HasDerivAt (fun u => Real.cos (Real.pi*u)/Real.sin (Real.pi*u))
      (-Real.pi/Real.sin (Real.pi*t)^2) t := by
  have hc := (Real.hasDerivAt_cos (Real.pi*t)).comp t ((hasDerivAt_id t).const_mul Real.pi)
  have hs := (Real.hasDerivAt_sin (Real.pi*t)).comp t ((hasDerivAt_id t).const_mul Real.pi)
  convert! hc.div hs (kernel_sin_pos ht).ne' using 1
  have h := Real.sin_sq_add_cos_sq (Real.pi*t)
  dsimp
  field_simp [(kernel_sin_pos ht).ne']
  nlinarith

private theorem kernelImag_hasDerivAt {t : ℝ} (ht : t ∈ Ioo 0 1) :
    HasDerivAt (fun u => (berryEsseenSmoothingKernel u).im) (kernelImagD t) t := by
  have h := ((((hasDerivAt_id t).const_sub 1).mul (kernel_cot_hasDerivAt ht)).add_const (1/Real.pi)).div_const 2
  convert! h using 1
  dsimp [kernelImagD]
  ring

private theorem kernelImagD_hasDerivAt {t : ℝ} (ht : t ∈ Ioo 0 1) :
    HasDerivAt kernelImagD (kernelImagDD t) t := by
  have hc := kernel_cot_hasDerivAt ht
  have hs := (Real.hasDerivAt_sin (Real.pi*t)).comp t ((hasDerivAt_id t).const_mul Real.pi)
  have hd := ((((hasDerivAt_id t).const_sub 1).const_mul Real.pi).div (hs.pow 2)
    (pow_ne_zero 2 (kernel_sin_pos ht).ne'))
  have h := (hc.neg.sub hd).div_const 2
  convert! h using 1
  · funext u
    dsimp [kernelImagD]
    ring
  · dsimp [kernelImagDD]
    field_simp [(kernel_sin_pos ht).ne']
    ring

private theorem kernelImagDD_nonneg {t : ℝ} (ht : t ∈ Ioo 0 1) : 0 ≤ kernelImagDD t := by
  have hx : Real.pi*(1-t) ∈ Icc 0 Real.pi := by
    constructor <;> nlinarith [Real.pi_pos, ht.1, ht.2]
  have h := sin_sub_mul_cos_nonneg hx
  rw [show Real.pi*(1-t) = Real.pi-Real.pi*t by ring, Real.sin_pi_sub, Real.cos_pi_sub] at h
  unfold kernelImagDD
  apply div_nonneg _ (pow_nonneg (kernel_sin_pos ht).le 3)
  exact mul_nonneg Real.pi_pos.le (by nlinarith)

/-- The imaginary smoothing weight is nonnegative throughout the open cutoff interval. -/
theorem berryEsseenSmoothingKernel_im_nonneg {t : ℝ} (ht : t ∈ Ioo 0 1) :
    0 ≤ (berryEsseenSmoothingKernel t).im := by
  have hC := (berryEsseenCotangentCorrection_bounds (sub_pos.mpr ht.2) (by linarith [ht.1])).1
  have hi : (berryEsseenSmoothingKernel t).im =
      ((1-t)/(2*t))*berryEsseenCotangentCorrection (1-t) := by
    have hid : (berryEsseenSmoothingKernel t).im =
        (1/(Real.pi*t)-berryEsseenCotangentCorrection t)/2 := by
      simp only [berryEsseenSmoothingKernel, berryEsseenCotangentCorrection, Real.cot_eq_cos_div_sin]
      field_simp [ht.1.ne']
      ring
    rw [hid, berryEsseenCotangentCorrection_reflect ht.1 ht.2]
    ring
  rw [hi]
  exact mul_nonneg (div_nonneg (sub_nonneg.mpr ht.2.le) (by linarith [ht.1])) hC

/-- Convexity permits a rational chord enclosure of the smoothing kernel on every frequency cell. -/
theorem berryEsseenSmoothingKernel_norm_convex :
    ConvexOn ℝ (Ioo 0 1) (fun t => ‖berryEsseenSmoothingKernel t‖) := by
  have him : ConvexOn ℝ (Ioo 0 1) (fun t => (berryEsseenSmoothingKernel t).im) := by
    apply convexOn_of_hasDerivWithinAt2_nonneg (convex_Ioo _ _)
      (fun t ht => (kernelImag_hasDerivAt ht).continuousAt.continuousWithinAt)
      (fun t ht => (kernelImag_hasDerivAt (interior_subset ht)).hasDerivWithinAt)
      (fun t ht => (kernelImagD_hasDerivAt (interior_subset ht)).hasDerivWithinAt)
    exact fun t ht => kernelImagDD_nonneg (interior_subset ht)
  refine ⟨convex_Ioo _ _, ?_⟩
  intro x hx y hy a b ha hb hab
  have hz := (convex_Ioo (0:ℝ) 1) hx hy ha hb hab
  have hi := him.2 hx hy ha hb hab
  simp only [smul_eq_mul] at hi hz ⊢
  let z : ℂ := a • berryEsseenSmoothingKernel x+b • berryEsseenSmoothingKernel y
  have hre : (berryEsseenSmoothingKernel (a*x+b*y)).re = z.re := by
    simp only [z, berryEsseenSmoothingKernel, Complex.add_re, Complex.real_smul, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
    nlinarith
  have himz : z.im = a*(berryEsseenSmoothingKernel x).im+b*(berryEsseenSmoothingKernel y).im := by
    simp [z]
  have hnorm : ‖berryEsseenSmoothingKernel (a*x+b*y)‖ ≤ ‖z‖ := by
    rw [Complex.norm_eq_sqrt_sq_add_sq, Complex.norm_eq_sqrt_sq_add_sq, hre, himz]
    apply Real.sqrt_le_sqrt
    have h0 := berryEsseenSmoothingKernel_im_nonneg hz
    have hsq := (sq_le_sq₀ h0 (h0.trans hi)).mpr hi
    linarith
  refine hnorm.trans ?_
  exact (norm_add_le _ _).trans_eq (by simp [Real.norm_eq_abs, abs_of_nonneg ha, abs_of_nonneg hb])

/-- A cubic exponential is bounded by its endpoint chord times an explicit quadratic correction. -/
theorem berryEsseen_exp_cubic_le_chord {A B x y a b : ℝ}
    (hA : 0 ≤ A) (hB : 0 ≤ B) (hx : 0 ≤ x) (hy : 0 ≤ y)
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a+b=1) :
    Real.exp (-A*(a*x+b*y)^2+B*(a*x+b*y)^3) ≤
      Real.exp (A*(x-y)^2/4) *
        (a*Real.exp (-A*x^2+B*x^3)+b*Real.exp (-A*y^2+B*y^3)) := by
  have hc : ConvexOn ℝ (Ici 0) (fun t : ℝ => t^3) :=
    (convexOn_id (convex_Ici (0:ℝ))).pow (fun _ ht => ht) 3
  have hc' := hc.2 hx hy ha hb hab
  simp only [smul_eq_mul] at hc'
  have hprod : a*b ≤ 1/4 := by nlinarith [sq_nonneg (a-b)]
  have hidentity : (a*x+b*y)^2 = a*x^2+b*y^2-a*b*(x-y)^2 := by
    linear_combination (a*x^2+b*y^2)*hab
  have hp : -A*(a*x+b*y)^2+B*(a*x+b*y)^3 ≤
      a*(-A*x^2+B*x^3)+b*(-A*y^2+B*y^3)+A*(x-y)^2/4 := by
    have h1 := mul_le_mul_of_nonneg_left hc' hB
    have h2 := mul_le_mul_of_nonneg_right hprod (mul_nonneg hA (sq_nonneg (x-y)))
    rw [hidentity]
    nlinarith
  calc
    _ ≤ Real.exp (a*(-A*x^2+B*x^3)+b*(-A*y^2+B*y^3)+A*(x-y)^2/4) := Real.exp_le_exp.mpr hp
    _ = Real.exp (A*(x-y)^2/4)*Real.exp (a*(-A*x^2+B*x^3)+b*(-A*y^2+B*y^3)) := by rw [Real.exp_add]; ring
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (convexOn_exp.2 (mem_univ _) (mem_univ _) ha hb hab) (Real.exp_pos _).le

/-- The Gaussian chord correction is quadratic in the mesh width. -/
theorem berryEsseen_exp_gaussian_le_chord {x y a b : ℝ}
    (hx : 0 ≤ x) (hy : 0 ≤ y) (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a+b=1) :
    Real.exp (-(a*x+b*y)^2/2) ≤
      Real.exp ((x-y)^2/8)*(a*Real.exp (-x^2/2)+b*Real.exp (-y^2/2)) := by
  convert! berryEsseen_exp_cubic_le_chord (A := 1/2) (B := 0) (by norm_num) (by norm_num)
    hx hy ha hb hab using 1 <;> ring_nf

/-- The integral majorant is represented by a continuous primitive. -/
def berryEsseenInnerPrimitive (q u : ℝ) : ℝ := ∫ v in (0:ℝ)..u, berryEsseenInnerMajorant q v

@[fun_prop] theorem continuous_berryEsseenInnerPrimitive (q : ℝ) : Continuous (berryEsseenInnerPrimitive q) :=
  (intervalIntegral.differentiable_integral_of_continuous (continuous_berryEsseenInnerMajorant q)).continuous

theorem berryEsseenInnerPrimitive_hasDerivAt (q u : ℝ) :
    HasDerivAt (berryEsseenInnerPrimitive q) (berryEsseenInnerMajorant q u) u :=
  intervalIntegral.integral_hasDerivAt_right
    ((continuous_berryEsseenInnerMajorant q).intervalIntegrable _ _)
    (continuous_berryEsseenInnerMajorant q).aestronglyMeasurable.stronglyMeasurableAtFilter
    (continuous_berryEsseenInnerMajorant q).continuousAt

/-- Monotonicity of the polynomial-exponential weight gives convexity of its primitive. -/
theorem berryEsseenInnerPrimitive_convex {q V : ℝ} (hq : 0 ≤ q) (hV : (q^3/4)*V ≤ 1) :
    ConvexOn ℝ (Icc 0 V) (berryEsseenInnerPrimitive q) := by
  have hm : MonotoneOn (berryEsseenInnerMajorant q) (Icc 0 V) := by
    intro x hx y hy hxy
    have hH := berryEsseenInnerWeight_monotone (by positivity : 0 ≤ q^3/4) hV hx hy hxy
    have hE := Real.exp_le_exp.mpr (berryEsseenCappedExponent_monotone hq hx.1 hy.1 hxy)
    exact mul_le_mul hH hE (Real.exp_pos _).le
      (berryEsseenInnerWeight_nonneg (by positivity) hy.1
        ((mul_le_mul_of_nonneg_left hy.2 (by positivity : 0 ≤ q^3/4)).trans hV))
  apply MonotoneOn.convexOn_of_deriv (convex_Icc _ _)
    (continuous_berryEsseenInnerPrimitive q).continuousOn
    (fun x _ => (berryEsseenInnerPrimitive_hasDerivAt q x).differentiableAt.differentiableWithinAt)
  intro x hx y hy hxy
  rw [(berryEsseenInnerPrimitive_hasDerivAt q x).deriv, (berryEsseenInnerPrimitive_hasDerivAt q y).deriv]
  exact hm (interior_subset hx) (interior_subset hy) hxy

theorem berryEsseenInnerPrimitive_nonneg {q u : ℝ} (hq : 0 ≤ q) (hu : 0 ≤ u) (hcut : (q^3/4)*u ≤ 1) :
    0 ≤ berryEsseenInnerPrimitive q u := by
  apply intervalIntegral.integral_nonneg hu
  intro x hx
  exact mul_nonneg (berryEsseenInnerWeight_nonneg (by positivity) hx.1
    ((mul_le_mul_of_nonneg_left hx.2 (by positivity : 0 ≤ q^3/4)).trans hcut)) (Real.exp_pos _).le

/-- Linear interpolation in the unit interval. -/
def berryEsseenChord (v₀ v₁ s : ℝ) : ℝ := (1-s)*v₀+s*v₁

/-- The exact integral of a product of two endpoint chords. -/
def berryEsseenChordIntegral2 (f₀ f₁ g₀ g₁ : ℝ) : ℝ :=
  (2*f₀*g₀+f₀*g₁+f₁*g₀+2*f₁*g₁)/6

/-- The exact integral of a product of three endpoint chords. -/
def berryEsseenChordIntegral3 (f₀ f₁ g₀ g₁ h₀ h₁ : ℝ) : ℝ :=
  (3*f₀*g₀*h₀+f₀*g₀*h₁+f₀*g₁*h₀+f₁*g₀*h₀+
    f₀*g₁*h₁+f₁*g₀*h₁+f₁*g₁*h₀+3*f₁*g₁*h₁)/12

private theorem integral_cubic (a b c d : ℝ) :
    (∫ s in (0:ℝ)..1, a+b*s+c*s^2+d*s^3) = a+b/2+c/3+d/4 := by
  let F (s : ℝ) := a*s+b*s^2/2+c*s^3/3+d*s^4/4
  have hd (s : ℝ) : HasDerivAt F (a+b*s+c*s^2+d*s^3) s := by
    have h := ((((hasDerivAt_id s).const_mul a).add
      ((((hasDerivAt_id s).pow 2).const_mul b).div_const 2)).add
      ((((hasDerivAt_id s).pow 3).const_mul c).div_const 3)).add
      ((((hasDerivAt_id s).pow 4).const_mul d).div_const 4)
    convert! h using 1
    dsimp
    ring
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun s _ => hd s) (by apply Continuous.intervalIntegrable; fun_prop)]
  dsimp [F]
  ring

theorem berryEsseen_integral_chords2 (f₀ f₁ g₀ g₁ : ℝ) :
    (∫ s in (0:ℝ)..1, berryEsseenChord f₀ f₁ s*berryEsseenChord g₀ g₁ s) =
      berryEsseenChordIntegral2 f₀ f₁ g₀ g₁ := by
  have heq (s : ℝ) : berryEsseenChord f₀ f₁ s*berryEsseenChord g₀ g₁ s =
      f₀*g₀+(f₀*g₁+f₁*g₀-2*f₀*g₀)*s+(f₀*g₀-f₀*g₁-f₁*g₀+f₁*g₁)*s^2+0*s^3 := by
    unfold berryEsseenChord
    ring
  simp_rw [heq]
  rw [integral_cubic]
  unfold berryEsseenChordIntegral2
  ring

theorem berryEsseen_integral_chords3 (f₀ f₁ g₀ g₁ h₀ h₁ : ℝ) :
    (∫ s in (0:ℝ)..1, berryEsseenChord f₀ f₁ s*berryEsseenChord g₀ g₁ s*berryEsseenChord h₀ h₁ s) =
      berryEsseenChordIntegral3 f₀ f₁ g₀ g₁ h₀ h₁ := by
  have heq (s : ℝ) : berryEsseenChord f₀ f₁ s*berryEsseenChord g₀ g₁ s*berryEsseenChord h₀ h₁ s =
      f₀*g₀*h₀+
      (f₀*g₀*h₁+f₀*g₁*h₀+f₁*g₀*h₀-3*f₀*g₀*h₀)*s+
      (3*f₀*g₀*h₀-2*(f₀*g₀*h₁+f₀*g₁*h₀+f₁*g₀*h₀)+f₀*g₁*h₁+f₁*g₀*h₁+f₁*g₁*h₀)*s^2+
      (-f₀*g₀*h₀+f₀*g₀*h₁+f₀*g₁*h₀+f₁*g₀*h₀-f₀*g₁*h₁-f₁*g₀*h₁-f₁*g₁*h₀+f₁*g₁*h₁)*s^3 := by
    unfold berryEsseenChord
    ring
  simp_rw [heq]
  rw [integral_cubic]
  unfold berryEsseenChordIntegral3
  ring

theorem berryEsseenChord_nonneg {f₀ f₁ s : ℝ} (hf₀ : 0 ≤ f₀) (hf₁ : 0 ≤ f₁) (hs : s ∈ Icc 0 1) :
    0 ≤ berryEsseenChord f₀ f₁ s := by
  exact add_nonneg (mul_nonneg (sub_nonneg.mpr hs.2) hf₀) (mul_nonneg hs.1 hf₁)

theorem berryEsseenChord_mono {f₀ f₁ g₀ g₁ s : ℝ} (h₀ : f₀ ≤ g₀) (h₁ : f₁ ≤ g₁) (hs : s ∈ Icc 0 1) :
    berryEsseenChord f₀ f₁ s ≤ berryEsseenChord g₀ g₁ s := by
  exact add_le_add (mul_le_mul_of_nonneg_left h₀ (sub_nonneg.mpr hs.2)) (mul_le_mul_of_nonneg_left h₁ hs.1)

/-- A convex function admits a cell enclosure from any certified endpoint upper bounds. -/
theorem berryEsseen_convex_le_chord {f : ℝ → ℝ} {a b f₀ f₁ s : ℝ} (hab : a ≤ b)
    (hc : ConvexOn ℝ (Icc a b) f) (hf₀ : f a ≤ f₀) (hf₁ : f b ≤ f₁) (hs : s ∈ Icc 0 1) :
    f (a+(b-a)*s) ≤ berryEsseenChord f₀ f₁ s := by
  have h := hc.2 (left_mem_Icc.mpr hab) (right_mem_Icc.mpr hab)
    (sub_nonneg.mpr hs.2) hs.1 (by ring : 1-s+s=1)
  simp only [smul_eq_mul, show (1-s)*a+s*b = a+(b-a)*s by ring] at h
  exact h.trans (berryEsseenChord_mono hf₀ hf₁ hs)

/-- Two positive chord enclosures give an exact rational upper quadrature formula. -/
theorem berryEsseen_integral_le_chords2 {f g : ℝ → ℝ} {a b f₀ f₁ g₀ g₁ : ℝ}
    (hab : a ≤ b)
    (hfg : IntervalIntegrable (fun x => f x*g x) volume a b)
    (hgn : ∀ x ∈ Icc a b, 0 ≤ g x)
    (hf₀ : 0 ≤ f₀) (hf₁ : 0 ≤ f₁)
    (hfc : ∀ s ∈ Icc (0:ℝ) 1, f (a+(b-a)*s) ≤ berryEsseenChord f₀ f₁ s)
    (hgc : ∀ s ∈ Icc (0:ℝ) 1, g (a+(b-a)*s) ≤ berryEsseenChord g₀ g₁ s) :
    (∫ x in a..b, f x*g x) ≤ (b-a)*berryEsseenChordIntegral2 f₀ f₁ g₀ g₁ := by
  rcases hab.eq_or_lt with h | hab
  · simp [h]
  have heq := intervalIntegral.smul_integral_comp_add_mul (fun x => f x*g x)
    (a := (0:ℝ)) (b := 1) (b-a) a
  simp only [mul_zero, add_zero, mul_one, add_sub_cancel, smul_eq_mul] at heq
  rw [← heq]
  apply mul_le_mul_of_nonneg_left _ (sub_pos.mpr hab).le
  rw [← berryEsseen_integral_chords2]
  apply intervalIntegral.integral_mono_on (by norm_num : (0:ℝ) ≤ 1)
    (by simpa only [sub_self, zero_div, div_self (sub_pos.mpr hab).ne'] using
      (hfg.comp_add_left a).comp_mul_left (c := b-a))
    (by apply Continuous.intervalIntegrable; unfold berryEsseenChord; fun_prop)
  intro s hs
  have hx : a+(b-a)*s ∈ Icc a b := by constructor <;> nlinarith [hs.1, hs.2]
  exact mul_le_mul (hfc s hs) (hgc s hs) (hgn _ hx) (berryEsseenChord_nonneg hf₀ hf₁ hs)

/-- Three positive chord enclosures handle the nested low-frequency integral. -/
theorem berryEsseen_integral_le_chords3 {f g k : ℝ → ℝ} {a b f₀ f₁ g₀ g₁ k₀ k₁ : ℝ}
    (hab : a ≤ b) (hfgk : IntervalIntegrable (fun x => f x*g x*k x) volume a b)
    (hgn : ∀ x ∈ Icc a b, 0 ≤ g x) (hkn : ∀ x ∈ Icc a b, 0 ≤ k x)
    (hf₀ : 0 ≤ f₀) (hf₁ : 0 ≤ f₁) (hg₀ : 0 ≤ g₀) (hg₁ : 0 ≤ g₁)
    (hfc : ∀ s ∈ Icc (0:ℝ) 1, f (a+(b-a)*s) ≤ berryEsseenChord f₀ f₁ s)
    (hgc : ∀ s ∈ Icc (0:ℝ) 1, g (a+(b-a)*s) ≤ berryEsseenChord g₀ g₁ s)
    (hkc : ∀ s ∈ Icc (0:ℝ) 1, k (a+(b-a)*s) ≤ berryEsseenChord k₀ k₁ s) :
    (∫ x in a..b, f x*g x*k x) ≤ (b-a)*berryEsseenChordIntegral3 f₀ f₁ g₀ g₁ k₀ k₁ := by
  rcases hab.eq_or_lt with h | hab
  · simp [h]
  have heq := intervalIntegral.smul_integral_comp_add_mul (fun x => f x*g x*k x)
    (a := (0:ℝ)) (b := 1) (b-a) a
  simp only [mul_zero, add_zero, mul_one, add_sub_cancel, smul_eq_mul] at heq
  rw [← heq]
  apply mul_le_mul_of_nonneg_left _ (sub_pos.mpr hab).le
  rw [← berryEsseen_integral_chords3]
  apply intervalIntegral.integral_mono_on (by norm_num : (0:ℝ) ≤ 1)
    (by simpa only [sub_self, zero_div, div_self (sub_pos.mpr hab).ne'] using
      (hfgk.comp_add_left a).comp_mul_left (c := b-a))
    (by apply Continuous.intervalIntegrable; unfold berryEsseenChord; fun_prop)
  intro s hs
  have hx : a+(b-a)*s ∈ Icc a b := by constructor <;> nlinarith [hs.1, hs.2]
  have hprod := mul_le_mul (hfc s hs) (hgc s hs) (hgn _ hx) (berryEsseenChord_nonneg hf₀ hf₁ hs)
  exact mul_le_mul hprod (hkc s hs) (hkn _ hx)
    (mul_nonneg (berryEsseenChord_nonneg hf₀ hf₁ hs) (berryEsseenChord_nonneg hg₀ hg₁ hs))

private def tailD (U t : ℝ) : ℝ := -(U^2+1/t^2)*Real.exp (-(U*t)^2/2)/Real.pi
private def tailDD (U t : ℝ) : ℝ := (U^4*t+U^2/t+2/t^3)*Real.exp (-(U*t)^2/2)/Real.pi

private theorem tail_hasDerivAt (U : ℝ) {t : ℝ} (ht : 0 < t) :
    HasDerivAt (fun s : ℝ => (1/(Real.pi*s))*Real.exp (-(U*s)^2/2)) (tailD U t) t := by
  have he := (((((hasDerivAt_id t).const_mul U).pow 2).neg).div_const 2).exp
  have hi := (hasDerivAt_const t (1:ℝ)).div ((hasDerivAt_id t).const_mul Real.pi)
    (mul_ne_zero Real.pi_ne_zero ht.ne')
  convert! hi.mul he using 1
  dsimp [tailD]
  field_simp
  ring

private theorem tailD_hasDerivAt (U : ℝ) {t : ℝ} (ht : 0 < t) :
    HasDerivAt (tailD U) (tailDD U t) t := by
  have he := (((((hasDerivAt_id t).const_mul U).pow 2).neg).div_const 2).exp
  have hi := (hasDerivAt_const t (1:ℝ)).div ((hasDerivAt_id t).pow 2) (pow_ne_zero 2 ht.ne')
  have h := ((((hi.const_add (U^2)).neg).mul he).div_const Real.pi)
  convert! h using 1
  dsimp [tailDD]
  field_simp
  ring

/-- The normal tail integrand is convex at every positive frequency. -/
theorem berryEsseen_normal_tail_convex (U : ℝ) :
    ConvexOn ℝ (Ioi 0) (fun t : ℝ => (1/(Real.pi*t))*Real.exp (-(U*t)^2/2)) := by
  apply convexOn_of_hasDerivWithinAt2_nonneg (convex_Ioi (0:ℝ))
    (fun t ht => (tail_hasDerivAt U ht).continuousAt.continuousWithinAt)
    (fun t ht => (tail_hasDerivAt U (interior_subset ht)).hasDerivWithinAt)
    (fun t ht => (tailD_hasDerivAt U (interior_subset ht)).hasDerivWithinAt)
  intro t ht
  have ht0 : 0 < t := interior_subset ht
  dsimp [tailDD]
  positivity

/-- Convex trapezoids and a final analytic remainder certify the infinite normal tail. -/
theorem berryEsseen_tail_quadrature {U : ℝ} (hU : 0 < U) {n : ℕ} (a : ℕ → ℝ)
    (hapos : 0 < a 0) (ha : Monotone a) :
    (∫ t in Ioi (a 0), (1/(Real.pi*t))*Real.exp (-(U*t)^2/2)) ≤
      (∑ i ∈ Finset.range n, (a (i+1)-a i)/2 *
        ((1/(Real.pi*a i))*Real.exp (-(U*a i)^2/2)+
         (1/(Real.pi*a (i+1)))*Real.exp (-(U*a (i+1))^2/2)))+
      Real.exp (-(U*a n)^2/2)/(Real.pi*(U*a n)^2) := by
  let f (t : ℝ) := (1/(Real.pi*t))*Real.exp (-(U*t)^2/2)
  have hp (i : ℕ) : 0 < a i := hapos.trans_le (ha (Nat.zero_le _))
  have hsubset (i : ℕ) : Icc (a i) (a (i+1)) ⊆ Ioi 0 := fun t ht => (hp i).trans_le ht.1
  have hc (i : ℕ) : ConvexOn ℝ (Icc (a i) (a (i+1))) f :=
    (berryEsseen_normal_tail_convex U).subset (hsubset i) (convex_Icc _ _)
  have hf (i : ℕ) : IntervalIntegrable f volume (a i) (a (i+1)) := by
    apply ContinuousOn.intervalIntegrable_of_Icc (ha (Nat.le_succ _))
    exact fun t ht => (tail_hasDerivAt U (hsubset i ht)).continuousAt.continuousWithinAt
  have htrap := berryEsseen_convex_integral_le_trapezoids (n := n) a
    (fun i _ => ha (Nat.le_succ _)) (fun i _ => hc i) (fun i _ => hf i)
  have htail := berryEsseen_smoothing_tail_le hU (hp n)
  have hsplit := intervalIntegral.integral_Ioi_sub_Ioi
    (integrableOn_normal_smoothing_tail hU.ne' hapos) (ha (Nat.zero_le n))
  dsimp [f] at htrap
  linarith

/-- One upward-rounded fixed-point square, computed entirely with natural numbers. -/
def berryEsseenSquareUp (S a : ℕ) : ℕ := a*a/S+1

/-- Repeated fixed-point squaring keeps every intermediate denominator bounded. -/
def berryEsseenPowTwoUp (S : ℕ) : ℕ → ℕ → ℕ
  | 0, a => a
  | n+1, a => berryEsseenSquareUp S (berryEsseenPowTwoUp S n a)

private theorem nat_div_upper (m : ℕ) {n : ℕ} (hn : 0 < n) :
    (m:ℝ)/(n:ℝ) ≤ (m/n+1:ℕ) := by
  have hmod := Nat.mod_lt m hn
  have hdiv := Nat.div_add_mod m n
  have hnat : m ≤ (m/n+1)*n := by nlinarith
  have hnR : (0:ℝ) < n := by exact_mod_cast hn
  apply (div_le_iff₀ hnR).mpr
  exact_mod_cast hnat

/-- Upward integer rounding preserves a real square upper bound. -/
theorem berryEsseenSquareUp_correct {S a : ℕ} (hS : 0 < S) :
    ((a:ℝ)/S)^2 ≤ (berryEsseenSquareUp S a:ℝ)/S := by
  have h := nat_div_upper (a*a) hS
  have hSR : (0:ℝ) < S := by exact_mod_cast hS
  have h' := (div_le_div_of_nonneg_right h hSR.le)
  convert! h' using 1
  simp only [Nat.cast_mul]
  field_simp

/-- Every fixed-point squaring stage has a kernel-checked enclosure theorem. -/
theorem berryEsseenPowTwoUp_correct {S a : ℕ} (hS : 0 < S) (n : ℕ) {x : ℝ}
    (hx : 0 ≤ x) (ha : x ≤ (a:ℝ)/S) :
    x^(2^n) ≤ (berryEsseenPowTwoUp S n a:ℝ)/S := by
  induction n with
  | zero => simpa [berryEsseenPowTwoUp] using ha
  | succ n ih =>
    rw [pow_succ, pow_mul]
    exact (pow_le_pow_left₀ (pow_nonneg hx _) ih 2).trans (berryEsseenSquareUp_correct hS)

/-- A positive reciprocal gives an elementary upper bound for a small exponential. -/
theorem berryEsseen_exp_le_reciprocal {z : ℝ} (hz : z < 1) :
    Real.exp z ≤ 1/(1-z) := by
  have h := Real.add_one_le_exp (-z)
  have hp := mul_le_mul_of_nonneg_right h (Real.exp_pos z).le
  have he : Real.exp (-z)*Real.exp z = 1 := by rw [← Real.exp_add]; simp
  rw [he] at hp
  apply (le_div_iff₀ (sub_pos.mpr hz)).mpr
  nlinarith

/-- Forty small-denominator squarings suffice for the numerical working interval. -/
def berryEsseenExpCodeUpper (a : ℤ) : ℕ :=
  berryEsseenPowTwoUp (2^100) 40 ((2^100*2^80)/((2^80:ℤ)-a).toNat+1)

/-- The integer exponential evaluator is sound for every encoded argument below its scaling limit. -/
theorem berryEsseenExpCodeUpper_correct (a : ℤ) (ha : a < 2^80) :
    Real.exp ((a:ℝ)/2^40) ≤ (berryEsseenExpCodeUpper a:ℝ)/2^100 := by
  have hd : (0:ℤ) < 2^80-a := by linarith
  have hdn : 0 < ((2^80:ℤ)-a).toNat := by omega
  have hcast : (((2^80:ℤ)-a).toNat:ℝ) = 2^80-(a:ℝ) := by
    rw [← Int.cast_natCast, Int.toNat_of_nonneg hd.le]
    push_cast
    norm_num
  have haz : (a:ℝ)/2^80 < 1 := by
    apply (div_lt_iff₀ (by norm_num : (0:ℝ) < 2^80)).mpr
    exact_mod_cast ha
  have hbase := berryEsseen_exp_le_reciprocal haz
  have hround := nat_div_upper (2^100*2^80) hdn
  rw [hcast] at hround
  norm_num only [Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] at hround
  have hinitial : Real.exp ((a:ℝ)/2^80) ≤
      (((2^100*2^80)/((2^80:ℤ)-a).toNat+1:ℕ):ℝ)/2^100 := by
    refine hbase.trans ?_
    have h' := div_le_div_of_nonneg_right hround (by norm_num : (0:ℝ) ≤ 2^100)
    convert! h' using 1
    have hdR : (0:ℝ) < 2^80-(a:ℝ) := by exact_mod_cast hd
    norm_num at hdR
    field_simp [hdR.ne']
    ring
  have hp := berryEsseenPowTwoUp_correct (a := (2^100*2^80)/((2^80:ℤ)-a).toNat+1)
    (by norm_num : 0 < (2:ℕ)^100) 40
    (Real.exp_pos ((a:ℝ)/2^80)).le (by simpa only [Nat.cast_pow, Nat.cast_ofNat] using hinitial)
  unfold berryEsseenExpCodeUpper
  convert! hp using 1
  · rw [← Real.exp_nat_mul]
    congr 1
    norm_num
    ring
  · norm_num

/-- Rational inputs are rounded upward on a dyadic grid; very negative inputs are harmlessly clamped. -/
def berryEsseenExpArgumentCode (x : ℚ) : ℤ := ⌈max x (-40)*2^40⌉

/-- A computable rational exponential enclosure with bounded intermediate denominators. -/
def berryEsseenExpUpper (x : ℚ) : ℚ :=
  (berryEsseenExpCodeUpper (berryEsseenExpArgumentCode x):ℚ)/2^100

/-- Correctness of the rational exponential upper evaluator. -/
theorem berryEsseenExpUpper_correct (x : ℚ)
    (hx : berryEsseenExpArgumentCode x < 2^80) : Real.exp (x:ℝ) ≤ (berryEsseenExpUpper x:ℝ) := by
  have hceil : max x (-40)*2^40 ≤ (berryEsseenExpArgumentCode x:ℚ) := Int.le_ceil _
  have hle : x ≤ (berryEsseenExpArgumentCode x:ℚ)/2^40 := by
    apply (le_div_iff₀ (by norm_num : (0:ℚ) < 2^40)).mpr
    exact (mul_le_mul_of_nonneg_right (le_max_left x (-40)) (by norm_num)).trans hceil
  have hleR : (x:ℝ) ≤ (berryEsseenExpArgumentCode x:ℝ)/2^40 := by exact_mod_cast hle
  refine (Real.exp_le_exp.mpr hleR).trans ?_
  convert! berryEsseenExpCodeUpper_correct (berryEsseenExpArgumentCode x) hx using 1
  simp only [berryEsseenExpUpper, Rat.cast_div, Rat.cast_natCast, Rat.cast_pow, Rat.cast_ofNat]

/-- The evaluator's scaling condition holds throughout the working range. -/
theorem berryEsseenExpArgumentCode_lt {x : ℚ} (hx : x ≤ 40) :
    berryEsseenExpArgumentCode x < 2^80 := by
  have hmax : max x (-40) ≤ 40 := max_le hx (by norm_num)
  have hceil := Int.ceil_lt_add_one (max x (-40)*2^40)
  have hupper := mul_le_mul_of_nonneg_right hmax (by norm_num : (0:ℚ) ≤ 2^40)
  have h : (berryEsseenExpArgumentCode x:ℚ) < 2^80 := by
    change (⌈max x (-40)*2^40⌉:ℚ) < 2^80
    linarith
  exact_mod_cast h

/-- No numerical hypothesis is needed beyond the documented upper argument limit. -/
theorem berryEsseen_exp_le_fast_upper {x : ℚ} (hx : x ≤ 40) :
    Real.exp (x:ℝ) ≤ (berryEsseenExpUpper x:ℝ) :=
  berryEsseenExpUpper_correct x (berryEsseenExpArgumentCode_lt hx)

/-- The explicit polynomial primitive bounds the characteristic-function error envelope. -/
theorem berryEsseenNormalErrorBound_le_primitive {q u : ℝ}
    (hq : 0 ≤ q) (hu : 0 ≤ u) (hcut : (q^3/4)*u ≤ 1) :
    berryEsseenNormalErrorBound (q^3) q u ≤ 2*Real.exp (-u^2/2)*berryEsseenInnerPrimitive q u := by
  unfold berryEsseenNormalErrorBound berryEsseenInnerPrimitive
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  apply intervalIntegral.integral_mono_on hu
    (by apply Continuous.intervalIntegrable; unfold berryEsseenResidualBump; fun_prop)
    ((continuous_berryEsseenInnerMajorant q).intervalIntegrable _ _)
  intro v hv
  exact berryEsseenInnerMajorant_ge hq hv.1
    ((mul_le_mul_of_nonneg_left hv.2 (by positivity : 0 ≤ q^3/4)).trans hcut)

/-- Convex trapezoidal prefixes bound the primitive at every mesh point. -/
theorem berryEsseenInnerPrimitive_prefix {q h : ℝ} (hq : 0 ≤ q) (hh : 0 ≤ h) (n : ℕ)
    (hcut : (q^3/4)*((n:ℝ)*h) ≤ 1) :
    berryEsseenInnerPrimitive q ((n:ℝ)*h) ≤
      ∑ i ∈ Finset.range n, h/2*(berryEsseenInnerMajorant q ((i:ℝ)*h)+
        berryEsseenInnerMajorant q (((i:ℝ)+1)*h)) := by
  have hconv := berryEsseenInnerMajorant_convex hq hcut
  have ha : Monotone (fun i : ℕ => (i:ℝ)*h) := fun i j hij =>
    mul_le_mul_of_nonneg_right (by exact_mod_cast hij) hh
  have hcell : ∀ i < n, Icc ((i:ℝ)*h) (((i+1:ℕ):ℝ)*h) ⊆ Icc 0 ((n:ℝ)*h) := by
    intro i hi u hu
    exact ⟨(by positivity : 0 ≤ (i:ℝ)*h).trans hu.1, hu.2.trans (ha (by omega))⟩
  have ht := berryEsseen_convex_integral_le_trapezoids (fun i : ℕ => (i:ℝ)*h)
    (fun i _ => ha (Nat.le_succ i))
    (fun i hi => hconv.subset (hcell i hi) (convex_Icc _ _))
    (fun _ _ => (continuous_berryEsseenInnerMajorant q).intervalIntegrable _ _)
  simpa only [berryEsseenInnerPrimitive, Nat.cast_zero, zero_mul, Nat.cast_add, Nat.cast_one,
    add_mul, add_sub_cancel_left, one_mul] using ht

/-- A simple endpoint bound handles the cell adjacent to the kernel pole. -/
theorem berryEsseenInnerPrimitive_le_endpoint {q u V : ℝ} (hq : 0 ≤ q)
    (hu : 0 ≤ u) (huV : u ≤ V) (hcut : (q^3/4)*V ≤ 1) :
    berryEsseenInnerPrimitive q u ≤ u*berryEsseenInnerMajorant q V := by
  have hV := hu.trans huV
  have hF : 0 ≤ berryEsseenInnerMajorant q V :=
    mul_nonneg (berryEsseenInnerWeight_nonneg (by positivity) hV hcut) (Real.exp_pos _).le
  have hconv := berryEsseenInnerMajorant_convex hq hcut
  have hf0 : berryEsseenInnerMajorant q 0 = 0 := by simp [berryEsseenInnerMajorant, berryEsseenInnerWeight]
  have hpoint (v : ℝ) (hv : v ∈ Icc 0 u) : berryEsseenInnerMajorant q v ≤ berryEsseenInnerMajorant q V := by
    have h := hconv.le_max_of_mem_Icc (left_mem_Icc.mpr hV) (right_mem_Icc.mpr hV) ⟨hv.1, hv.2.trans huV⟩
    simpa only [hf0, max_eq_right hF] using h
  have h := intervalIntegral.integral_mono_on hu
    ((continuous_berryEsseenInnerMajorant q).intervalIntegrable _ _) (intervalIntegrable_const (μ := volume) (a := 0) (b := u)) hpoint
  simpa only [berryEsseenInnerPrimitive, intervalIntegral.integral_const, sub_zero, smul_eq_mul] using h

/-- Analytic cancellation bounds the first low-frequency cell, including its singular endpoint. -/
theorem berryEsseen_low_first_cell {q U h : ℝ} (hq : 0 ≤ q) (hU : 0 < U)
    (hh : 0 < h) (hh1 : h < 1) (hcut : (q^3/4)*(U*h) ≤ 1) :
    2*(∫ t in (0:ℝ)..h, ‖berryEsseenSmoothingKernel t‖*berryEsseenNormalErrorBound (q^3) q (U*t)) ≤
      4*U*berryEsseenInnerMajorant q (U*h)*(h/(2*Real.pi)+h^2/64) := by
  let F := berryEsseenInnerMajorant q (U*h)
  let G (t : ℝ) := 4*U*F*(1/(2*Real.pi)+t/32)
  have hF : 0 ≤ F := mul_nonneg
    (berryEsseenInnerWeight_nonneg (by positivity) (by positivity) hcut) (Real.exp_pos _).le
  have hG : IntervalIntegrable G volume 0 h := by apply Continuous.intervalIntegrable; unfold G; fun_prop
  have hb :
      2*(∫ t in (0:ℝ)..h, ‖berryEsseenSmoothingKernel t‖*berryEsseenNormalErrorBound (q^3) q (U*t)) ≤
        ∫ t in (0:ℝ)..h, G t := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_mono_on_of_le_Ioo hh.le
      ((intervalIntegrable_smoothing_normalErrorBound (q^3) q hU hh hh1).const_mul 2) hG
    intro t ht
    have hut : 0 ≤ U*t := mul_nonneg hU.le ht.1.le
    have huth : U*t ≤ U*h := mul_le_mul_of_nonneg_left ht.2.le hU.le
    have hcut' := (mul_le_mul_of_nonneg_left huth (by positivity : 0 ≤ q^3/4)).trans hcut
    have hI := berryEsseenInnerPrimitive_le_endpoint hq hut huth hcut
    have hI0 := berryEsseenInnerPrimitive_nonneg hq hut hcut'
    have he : Real.exp (-(U*t)^2/2) ≤ 1 := Real.exp_le_one_iff.mpr (by nlinarith [sq_nonneg (U*t)])
    have hR : berryEsseenNormalErrorBound (q^3) q (U*t) ≤ 2*(U*t)*F := by
      have hbase := berryEsseenNormalErrorBound_le_primitive hq hut hcut'
      have h1 := mul_le_mul_of_nonneg_right he hI0
      dsimp [F] at *
      nlinarith
    have hK := norm_smoothing_kernel_le_pole_add ht.1 (ht.2.trans hh1)
    have h1 := mul_le_mul_of_nonneg_left hR (norm_nonneg (berryEsseenSmoothingKernel t))
    have h2 := mul_le_mul_of_nonneg_right hK (by positivity : 0 ≤ 2*(U*t)*F)
    have hEq : (1/(2*Real.pi*t)+1/32)*(2*(U*t)*F)*2 = G t := by
      dsimp [G]
      field_simp [ht.1.ne']
      ring
    rw [← hEq]
    nlinarith
  refine hb.trans_eq ?_
  let H (t : ℝ) := 4*U*F*(t/(2*Real.pi)+t^2/64)
  have hH (t : ℝ) : HasDerivAt H (G t) t := by
    have hd := (((hasDerivAt_id t).div_const (2*Real.pi)).add
      (((hasDerivAt_id t).pow 2).div_const 64)).const_mul (4*U*F)
    convert! hd using 1
    dsimp [G]
    ring
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hH t) hG]
  dsimp [H, F]
  ring

/-- Away from its pole, the complex smoothing kernel is continuous. -/
theorem continuousOn_berryEsseenSmoothingKernel : ContinuousOn berryEsseenSmoothingKernel (Ioo 0 1) := by
  intro t ht
  have hs : Real.sin (Real.pi*t) ≠ 0 :=
    (Real.sin_pos_of_pos_of_lt_pi (mul_pos Real.pi_pos ht.1) (by nlinarith [Real.pi_pos, ht.2])).ne'
  apply ContinuousAt.continuousWithinAt
  have hc : ContinuousAt (fun u : ℝ => (((1-u)/2:ℝ):ℂ)+
      ((((1-u)*(Real.cos (Real.pi*u)/Real.sin (Real.pi*u))+1/Real.pi)/2:ℝ):ℂ)*Complex.I) t := by fun_prop
  convert! hc using 1
  funext u
  apply Complex.ext <;> simp only [berryEsseenSmoothingKernel, Complex.add_re, Complex.add_im,
    Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im,
    mul_zero, mul_one, add_zero, zero_add, sub_zero]

/-- A selected cubic characteristic-function majorant admits a certified cell integral. -/
theorem berryEsseen_high_cell {ell U A B a b k₀ k₁ e₀ e₁ : ℝ}
    (ha : 0 < a) (hab : a ≤ b) (hb : b < 1) (hU : 0 ≤ U)
    (hA : 0 ≤ A) (hB : 0 ≤ B) (hell : 0 ≤ ell)
    (hM : ∀ t ∈ Icc a b, berryEsseenMagnitudeBound ell (U*t) ≤ Real.exp (-A*(U*t)^2+2*B*ell*(U*t)^3))
    (hk₀ : ‖berryEsseenSmoothingKernel a‖ ≤ k₀) (hk₁ : ‖berryEsseenSmoothingKernel b‖ ≤ k₁)
    (he₀ : Real.exp (-A*(U*a)^2+2*B*ell*(U*a)^3) ≤ e₀)
    (he₁ : Real.exp (-A*(U*b)^2+2*B*ell*(U*b)^3) ≤ e₁) :
    2*(∫ t in a..b, ‖berryEsseenSmoothingKernel t‖*berryEsseenMagnitudeBound ell (U*t)) ≤
      2*(b-a)*Real.exp (A*(U*(b-a))^2/4)*berryEsseenChordIntegral2 k₀ k₁ e₀ e₁ := by
  let E := Real.exp (A*(U*(b-a))^2/4)
  have hsub : Icc a b ⊆ Ioo 0 1 := fun t ht => ⟨ha.trans_le ht.1, ht.2.trans_lt hb⟩
  have hcont : ContinuousOn (fun t => ‖berryEsseenSmoothingKernel t‖*berryEsseenMagnitudeBound ell (U*t)) (Icc a b) :=
    (continuousOn_berryEsseenSmoothingKernel.norm.mono hsub).mul (by fun_prop)
  have hKconv := berryEsseenSmoothingKernel_norm_convex.subset hsub (convex_Icc _ _)
  have hgc (s : ℝ) (hs : s ∈ Icc 0 1) :
      berryEsseenMagnitudeBound ell (U*(a+(b-a)*s)) ≤ berryEsseenChord (E*e₀) (E*e₁) s := by
    have hx : a+(b-a)*s ∈ Icc a b := by constructor <;> nlinarith [hs.1, hs.2]
    have hc := berryEsseen_exp_cubic_le_chord hA (by positivity : 0 ≤ 2*B*ell)
      (mul_nonneg hU ha.le) (mul_nonneg hU (ha.le.trans hab))
      (sub_nonneg.mpr hs.2) hs.1 (by ring : 1-s+s=1)
    have hce : Real.exp (-A*(U*(a+(b-a)*s))^2+2*B*ell*(U*(a+(b-a)*s))^3) ≤
        E*berryEsseenChord (Real.exp (-A*(U*a)^2+2*B*ell*(U*a)^3))
          (Real.exp (-A*(U*b)^2+2*B*ell*(U*b)^3)) s := by
      convert! hc using 1 <;> (try dsimp [E, berryEsseenChord]) <;> ring_nf
    have hendpoint := mul_le_mul_of_nonneg_left (berryEsseenChord_mono he₀ he₁ hs) (by dsimp [E]; positivity : 0 ≤ E)
    refine (hM _ hx).trans (hce.trans ?_)
    convert! hendpoint using 1
    unfold berryEsseenChord
    ring
  have hquad := berryEsseen_integral_le_chords2 hab (hcont.intervalIntegrable_of_Icc hab)
    (fun t _ => berryEsseenMagnitudeBound_nonneg ell (U*t))
    ((norm_nonneg _).trans hk₀) ((norm_nonneg _).trans hk₁)
    (fun s hs => berryEsseen_convex_le_chord hab hKconv hk₀ hk₁ hs) hgc
  have h := mul_le_mul_of_nonneg_left hquad (by norm_num : (0:ℝ) ≤ 2)
  convert! h using 1
  unfold berryEsseenChordIntegral2
  try dsimp [E]
  ring

/-- The final high-frequency cell has a quadratic bound independent of endpoint values. -/
theorem berryEsseen_high_last_cell {ell U a : ℝ} (ha : 1/2 ≤ a) (ha1 : a < 1) :
    2*(∫ t in a..1, ‖berryEsseenSmoothingKernel t‖*berryEsseenMagnitudeBound ell (U*t)) ≤
      (61/100:ℝ)*(1-a)^2 := by
  have ha0 : 0 < a := by linarith
  have hmain := intervalIntegrable_smoothing_magnitudeBound ell U ha0 ha1
  have hb : (∫ t in a..1, ‖berryEsseenSmoothingKernel t‖*berryEsseenMagnitudeBound ell (U*t)) ≤
      ∫ t in a..1, (61/100:ℝ)*(1-t) := by
    apply intervalIntegral.integral_mono_on_of_le_Ioo ha1.le hmain
      (by apply Continuous.intervalIntegrable; fun_prop)
    intro t ht
    have hM : berryEsseenMagnitudeBound ell (U*t) ≤ 1 := min_le_left _ _
    have hmul := mul_le_mul_of_nonneg_left hM (norm_nonneg (berryEsseenSmoothingKernel t))
    simp only [mul_one] at hmul
    exact hmul.trans (norm_smoothing_kernel_high_le (ha.trans ht.1.le) ht.2)
  have heq : (∫ t in a..1, (61/100:ℝ)*(1-t)) = (61/200:ℝ)*(1-a)^2 := by
    have hd (t : ℝ) : HasDerivAt (fun x : ℝ => (61/100:ℝ)*(x-x^2/2)) ((61/100:ℝ)*(1-t)) t := by
      convert! ((hasDerivAt_id t).sub (((hasDerivAt_id t).pow 2).div_const 2)).const_mul (61/100:ℝ) using 1
      dsimp
      ring
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hd t)
      (by apply Continuous.intervalIntegrable; fun_prop)]
    ring
  rw [heq] at hb
  linarith

/-- Endpoint values and convex inner prefixes certify each nonsingular low-frequency cell. -/
theorem berryEsseen_low_cell {q U a b k₀ k₁ e₀ e₁ i₀ i₁ : ℝ}
    (hq : 0 ≤ q) (hU : 0 ≤ U) (ha : 0 < a) (hab : a ≤ b) (hb : b < 1)
    (hcut : (q^3/4)*(U*b) ≤ 1)
    (hk₀ : ‖berryEsseenSmoothingKernel a‖ ≤ k₀) (hk₁ : ‖berryEsseenSmoothingKernel b‖ ≤ k₁)
    (he₀ : Real.exp (-(U*a)^2/2) ≤ e₀) (he₁ : Real.exp (-(U*b)^2/2) ≤ e₁)
    (hi₀ : berryEsseenInnerPrimitive q (U*a) ≤ i₀) (hi₁ : berryEsseenInnerPrimitive q (U*b) ≤ i₁) :
    2*(∫ t in a..b, ‖berryEsseenSmoothingKernel t‖*berryEsseenNormalErrorBound (q^3) q (U*t)) ≤
      4*(b-a)*Real.exp ((U*(b-a))^2/8)*berryEsseenChordIntegral3 k₀ k₁ e₀ e₁ i₀ i₁ := by
  let E := Real.exp ((U*(b-a))^2/8)
  have hsub : Icc a b ⊆ Ioo 0 1 := fun t ht => ⟨ha.trans_le ht.1, ht.2.trans_lt hb⟩
  have hK : ContinuousOn (fun t => ‖berryEsseenSmoothingKernel t‖) (Icc a b) :=
    continuousOn_berryEsseenSmoothingKernel.norm.mono hsub
  have htrip : ContinuousOn (fun t => ‖berryEsseenSmoothingKernel t‖*Real.exp (-(U*t)^2/2)*
      berryEsseenInnerPrimitive q (U*t)) (Icc a b) := (hK.mul (by fun_prop)).mul (by fun_prop)
  have hbase : ContinuousOn (fun t => ‖berryEsseenSmoothingKernel t‖*
      berryEsseenNormalErrorBound (q^3) q (U*t)) (Icc a b) := hK.mul (by fun_prop)
  have hactual :
      2*(∫ t in a..b, ‖berryEsseenSmoothingKernel t‖*berryEsseenNormalErrorBound (q^3) q (U*t)) ≤
        4*(∫ t in a..b, ‖berryEsseenSmoothingKernel t‖*Real.exp (-(U*t)^2/2)*berryEsseenInnerPrimitive q (U*t)) := by
    rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_mono_on hab
      ((hbase.intervalIntegrable_of_Icc hab).const_mul 2) ((htrip.intervalIntegrable_of_Icc hab).const_mul 4)
    intro t ht
    have ht0 := ha.le.trans ht.1
    have htc := (mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_left ht.2 hU) (by positivity : 0 ≤ q^3/4)).trans hcut
    have hR := berryEsseenNormalErrorBound_le_primitive hq (mul_nonneg hU ht0) htc
    have h := mul_le_mul_of_nonneg_left hR (by positivity : 0 ≤ 2*‖berryEsseenSmoothingKernel t‖)
    convert! h using 1 <;> ring
  have hKconv := berryEsseenSmoothingKernel_norm_convex.subset hsub (convex_Icc _ _)
  have hgc (s : ℝ) (hs : s ∈ Icc 0 1) :
      Real.exp (-(U*(a+(b-a)*s))^2/2) ≤ berryEsseenChord (E*e₀) (E*e₁) s := by
    have hc := berryEsseen_exp_gaussian_le_chord (mul_nonneg hU ha.le)
      (mul_nonneg hU (ha.le.trans hab)) (sub_nonneg.mpr hs.2) hs.1 (by ring : 1-s+s=1)
    have hce : Real.exp (-(U*(a+(b-a)*s))^2/2) ≤
        E*berryEsseenChord (Real.exp (-(U*a)^2/2)) (Real.exp (-(U*b)^2/2)) s := by
      convert! hc using 1 <;> (try dsimp [E, berryEsseenChord]) <;> ring_nf
    have hendpoint := mul_le_mul_of_nonneg_left (berryEsseenChord_mono he₀ he₁ hs) (by dsimp [E]; positivity : 0 ≤ E)
    refine hce.trans ?_
    convert! hendpoint using 1
    unfold berryEsseenChord
    ring
  have hkc (s : ℝ) (hs : s ∈ Icc 0 1) :
      berryEsseenInnerPrimitive q (U*(a+(b-a)*s)) ≤ berryEsseenChord i₀ i₁ s := by
    have hI := (berryEsseenInnerPrimitive_convex hq hcut).subset
      (fun t (ht : t ∈ Icc (U*a) (U*b)) => ⟨(mul_nonneg hU ha.le).trans ht.1, ht.2⟩) (convex_Icc _ _)
    have h := berryEsseen_convex_le_chord (mul_le_mul_of_nonneg_left hab hU) hI hi₀ hi₁ hs
    convert! h using 1
    congr 1
    ring
  have hquad := berryEsseen_integral_le_chords3 hab (htrip.intervalIntegrable_of_Icc hab)
    (fun t _ => (Real.exp_pos _).le)
    (fun t ht => berryEsseenInnerPrimitive_nonneg hq (mul_nonneg hU (ha.le.trans ht.1))
      ((mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left ht.2 hU) (by positivity : 0 ≤ q^3/4)).trans hcut))
    ((norm_nonneg _).trans hk₀) ((norm_nonneg _).trans hk₁)
    (mul_nonneg (Real.exp_pos _).le ((Real.exp_pos _).le.trans he₀))
    (mul_nonneg (Real.exp_pos _).le ((Real.exp_pos _).le.trans he₁))
    (fun s hs => berryEsseen_convex_le_chord hab hKconv hk₀ hk₁ hs) hgc hkc
  refine hactual.trans ?_
  have h := mul_le_mul_of_nonneg_left hquad (by norm_num : (0:ℝ) ≤ 4)
  convert! h using 1
  unfold berryEsseenChordIntegral3
  try dsimp [E]
  ring

/-- Downward dyadic rounding controls denominator growth in the numerical certificate. -/
def berryEsseenRoundDown (x : ℚ) : ℚ := (⌊x*2^80⌋:ℚ)/2^80
/-- Upward dyadic rounding preserves upper enclosures. -/
def berryEsseenRoundUp (x : ℚ) : ℚ := (⌈x*2^80⌉:ℚ)/2^80

theorem berryEsseenRoundDown_le (x : ℚ) : (berryEsseenRoundDown x:ℝ) ≤ (x:ℝ) := by
  have h : berryEsseenRoundDown x ≤ x :=
    (div_le_iff₀ (by norm_num : (0:ℚ) < 2^80)).mpr (Int.floor_le _)
  exact_mod_cast h

theorem berryEsseen_le_roundUp (x : ℚ) : (x:ℝ) ≤ (berryEsseenRoundUp x:ℝ) := by
  have h : x ≤ berryEsseenRoundUp x :=
    (le_div_iff₀ (by norm_num : (0:ℚ) < 2^80)).mpr (Int.le_ceil _)
  exact_mod_cast h

/-- A rational interval used by the finite numerical certificate. -/
structure BerryEsseenInterval where
  lo : ℚ
  hi : ℚ
  deriving DecidableEq

namespace BerryEsseenInterval

def Contains (I : BerryEsseenInterval) (x : ℝ) : Prop := (I.lo:ℝ) ≤ x ∧ x ≤ (I.hi:ℝ)

def point (x : ℚ) : BerryEsseenInterval := ⟨x,x⟩
def rounded (lo hi : ℚ) : BerryEsseenInterval := ⟨berryEsseenRoundDown lo,berryEsseenRoundUp hi⟩
def add (I J : BerryEsseenInterval) : BerryEsseenInterval := rounded (I.lo+J.lo) (I.hi+J.hi)
def neg (I : BerryEsseenInterval) : BerryEsseenInterval := ⟨-I.hi,-I.lo⟩
def sub (I J : BerryEsseenInterval) : BerryEsseenInterval := I.add J.neg

def mul (I J : BerryEsseenInterval) : BerryEsseenInterval :=
  rounded (min (min (I.lo*J.lo) (I.hi*J.lo)) (min (I.lo*J.hi) (I.hi*J.hi)))
    (max (max (I.lo*J.lo) (I.hi*J.lo)) (max (I.lo*J.hi) (I.hi*J.hi)))

def inv (I : BerryEsseenInterval) : BerryEsseenInterval := rounded (1/I.hi) (1/I.lo)
def div (I J : BerryEsseenInterval) : BerryEsseenInterval := I.mul J.inv

theorem point_contains (x : ℚ) : (point x).Contains (x:ℝ) := ⟨le_rfl,le_rfl⟩

theorem rounded_contains {lo hi : ℚ} {x : ℝ} (hl : (lo:ℝ) ≤ x) (hh : x ≤ (hi:ℝ)) :
    (rounded lo hi).Contains x :=
  ⟨(berryEsseenRoundDown_le lo).trans hl, hh.trans (berryEsseen_le_roundUp hi)⟩

theorem add_contains {I J : BerryEsseenInterval} {x y : ℝ} (hx : I.Contains x) (hy : J.Contains y) :
    (I.add J).Contains (x+y) := by
  apply rounded_contains <;> push_cast
  · exact add_le_add hx.1 hy.1
  · exact add_le_add hx.2 hy.2

theorem neg_contains {I : BerryEsseenInterval} {x : ℝ} (hx : I.Contains x) : I.neg.Contains (-x) := by
  constructor <;> simp only [neg, Rat.cast_neg]
  · exact neg_le_neg hx.2
  · exact neg_le_neg hx.1

theorem sub_contains {I J : BerryEsseenInterval} {x y : ℝ} (hx : I.Contains x) (hy : J.Contains y) :
    (I.sub J).Contains (x-y) := by simpa only [sub, sub_eq_add_neg] using add_contains hx (neg_contains hy)

private theorem mul_endpoint {a b x c : ℝ} (hx : x ∈ Icc a b) :
    min (a*c) (b*c) ≤ x*c ∧ x*c ≤ max (a*c) (b*c) := by
  rcases le_or_gt 0 c with hc | hc
  · exact ⟨(min_le_left _ _).trans (mul_le_mul_of_nonneg_right hx.1 hc),
      (mul_le_mul_of_nonneg_right hx.2 hc).trans (le_max_right _ _)⟩
  · exact ⟨(min_le_right _ _).trans (mul_le_mul_of_nonpos_right hx.2 hc.le),
      (mul_le_mul_of_nonpos_right hx.1 hc.le).trans (le_max_left _ _)⟩

theorem mul_contains {I J : BerryEsseenInterval} {x y : ℝ} (hx : I.Contains x) (hy : J.Contains y) :
    (I.mul J).Contains (x*y) := by
  have h0 := mul_endpoint (c := x) hy
  have h1 := mul_endpoint (c := (J.lo:ℝ)) hx
  have h2 := mul_endpoint (c := (J.hi:ℝ)) hx
  have h3 : min (x*(J.lo:ℝ)) (x*(J.hi:ℝ)) ≤ x*y ∧ x*y ≤ max (x*(J.lo:ℝ)) (x*(J.hi:ℝ)) := by
    simpa only [mul_comm] using h0
  apply rounded_contains <;> push_cast
  · exact (min_le_min h1.1 h2.1).trans h3.1
  · exact h3.2.trans (max_le_max h1.2 h2.2)

theorem inv_contains {I : BerryEsseenInterval} {x : ℝ} (hx : I.Contains x) (hI : 0 < I.lo) :
    I.inv.Contains (1/x) := by
  have hl : (0:ℝ) < I.lo := by exact_mod_cast hI
  have hxp := hl.trans_le hx.1
  apply rounded_contains <;> push_cast
  · exact one_div_le_one_div_of_le hxp hx.2
  · exact one_div_le_one_div_of_le hl hx.1

theorem div_contains {I J : BerryEsseenInterval} {x y : ℝ} (hx : I.Contains x) (hy : J.Contains y)
    (hJ : 0 < J.lo) : (I.div J).Contains (x/y) := by
  simpa only [div, div_eq_mul_inv, one_div, one_mul] using mul_contains hx (inv_contains hy hJ)

end BerryEsseenInterval

/-- A rounded square root is computed by natural-number square root. -/
def berryEsseenSqrtUpper (x : ℚ) : ℚ :=
  ((Nat.sqrt (⌈x*2^160⌉:ℤ).toNat+1:ℕ):ℚ)/2^80

/-- The square-root enclosure is sound even if its rational input is negative. -/
theorem berryEsseenSqrtUpper_correct (x : ℚ) : Real.sqrt (x:ℝ) ≤ (berryEsseenSqrtUpper x:ℝ) := by
  have hceil : x*2^160 ≤ ((⌈x*2^160⌉:ℤ).toNat:ℚ) :=
    (Int.le_ceil _).trans (by exact_mod_cast (show (⌈x*2^160⌉:ℤ) ≤ ((⌈x*2^160⌉:ℤ).toNat:ℤ) by omega))
  have hsq := Nat.lt_succ_sqrt' (⌈x*2^160⌉:ℤ).toNat
  have hsqR : (((⌈x*2^160⌉:ℤ).toNat:ℕ):ℝ) ≤ ((Nat.sqrt (⌈x*2^160⌉:ℤ).toNat+1:ℕ):ℝ)^2 := by
    exact_mod_cast hsq.le
  have hcR : (x:ℝ)*2^160 ≤ (((⌈x*2^160⌉:ℤ).toNat:ℕ):ℝ) := by exact_mod_cast hceil
  have hvalue : (berryEsseenSqrtUpper x:ℝ) = ((Nat.sqrt (⌈x*2^160⌉:ℤ).toNat+1:ℕ):ℝ)/2^80 := by
    simp only [berryEsseenSqrtUpper, Rat.cast_div, Rat.cast_natCast, Rat.cast_pow, Rat.cast_ofNat]
  rw [hvalue]
  apply (Real.sqrt_le_iff).mpr
  constructor
  · positivity
  · have h := hcR.trans hsqR
    apply (le_div_iff₀ (by norm_num : (0:ℝ) < 2^160)).mpr at h
    convert! h using 1
    norm_num
    ring

namespace BerryEsseenInterval

/-- A rational absolute-value upper bound needs no square-root computation. -/
def absUpper (I : BerryEsseenInterval) : ℚ := max |I.lo| |I.hi|

theorem abs_le_absUpper {I : BerryEsseenInterval} {x : ℝ} (hx : I.Contains x) :
    |x| ≤ (I.absUpper:ℝ) := by
  have hl : |(I.lo:ℝ)| ≤ (I.absUpper:ℝ) := by
    exact_mod_cast (le_max_left |I.lo| |I.hi|)
  have hh : |(I.hi:ℝ)| ≤ (I.absUpper:ℝ) := by
    exact_mod_cast (le_max_right |I.lo| |I.hi|)
  exact abs_le.mpr ⟨(neg_le_neg hl).trans ((neg_abs_le _).trans hx.1),
    hx.2.trans ((le_abs_self _).trans hh)⟩

def normUpper (I J : BerryEsseenInterval) : ℚ := berryEsseenSqrtUpper (I.absUpper^2+J.absUpper^2)

/-- Two real interval enclosures certify a complex norm from rational data. -/
theorem norm_le_normUpper {I J : BerryEsseenInterval} {z : ℂ}
    (hr : I.Contains z.re) (hi : J.Contains z.im) : ‖z‖ ≤ (I.normUpper J:ℝ) := by
  have hR := abs_le_absUpper hr
  have hI := abs_le_absUpper hi
  have hRs := (sq_le_sq₀ (abs_nonneg _) ((abs_nonneg _).trans hR)).mpr hR
  have hIs := (sq_le_sq₀ (abs_nonneg _) ((abs_nonneg _).trans hI)).mpr hI
  rw [sq_abs] at hRs hIs
  rw [Complex.norm_eq_sqrt_sq_add_sq]
  have hsq : z.re^2+z.im^2 ≤ ((I.absUpper^2+J.absUpper^2:ℚ):ℝ) := by
    push_cast
    exact add_le_add hRs hIs
  exact (Real.sqrt_le_sqrt hsq).trans (berryEsseenSqrtUpper_correct _)

end BerryEsseenInterval

/-- A Taylor enclosure is rounded immediately, so later table construction uses small denominators. -/
def berryEsseenTrigTaylorInterval (imaginary : Bool) (x : ℚ) (n : ℕ) : BerryEsseenInterval :=
  BerryEsseenInterval.rounded
    (berryEsseenTrigTaylor imaginary x n-|x|^n/n.factorial*2)
    (berryEsseenTrigTaylor imaginary x n+|x|^n/n.factorial*2)

/-- The computed Taylor interval contains the actual sine or cosine. -/
theorem berryEsseenTrigTaylorInterval_correct (imaginary : Bool) (x : ℚ) (n : ℕ)
    (hx : |x|/(n+1) ≤ 1/2) :
    (berryEsseenTrigTaylorInterval imaginary x n).Contains
      (if imaginary then Real.sin (x:ℝ) else Real.cos (x:ℝ)) := by
  have hc : berryEsseenTrigCheck imaginary x
      (berryEsseenTrigTaylor imaginary x n-|x|^n/n.factorial*2)
      (berryEsseenTrigTaylor imaginary x n+|x|^n/n.factorial*2) n := ⟨hx,le_rfl,le_rfl⟩
  have h := berryEsseen_trig_mem_of_check hc
  exact BerryEsseenInterval.rounded_contains h.1 h.2

/-- A rational change in argument widens the enclosure by the same amount. -/
theorem berryEsseen_trig_interval_shift {I : BerryEsseenInterval} {x y : ℝ} {d : ℚ}
    (imaginary : Bool) (hI : I.Contains (if imaginary then Real.sin x else Real.cos x))
    (hxy : |y-x| ≤ (d:ℝ)) :
    (I.add ⟨-d,d⟩).Contains (if imaginary then Real.sin y else Real.cos y) := by
  have hb : |(if imaginary then Real.sin y else Real.cos y)-
      (if imaginary then Real.sin x else Real.cos x)| ≤ (d:ℝ) := by
    cases imaginary
    · exact (Real.abs_cos_sub_cos_le y x).trans hxy
    · exact (Real.abs_sin_sub_sin_le y x).trans hxy
  have hd : (⟨-d,d⟩:BerryEsseenInterval).Contains
      ((if imaginary then Real.sin y else Real.cos y)-(if imaginary then Real.sin x else Real.cos x)) := by
    simpa only [BerryEsseenInterval.Contains, Rat.cast_neg] using abs_le.mp hb
  have h := BerryEsseenInterval.add_contains hI hd
  convert! h using 1
  ring

/-- One interval rotation advances both trigonometric values by the fixed mesh angle. -/
def berryEsseenTrigRotate (S C : BerryEsseenInterval) (state : BerryEsseenInterval × BerryEsseenInterval) :
    BerryEsseenInterval × BerryEsseenInterval :=
  ((state.1.mul C).add (state.2.mul S), (state.2.mul C).sub (state.1.mul S))

/-- Interval rotation contains the exact sine/cosine addition formulas. -/
theorem berryEsseenTrigRotate_correct {S C : BerryEsseenInterval}
    {state : BerryEsseenInterval × BerryEsseenInterval} {x theta : ℝ}
    (hS : S.Contains (Real.sin theta)) (hC : C.Contains (Real.cos theta))
    (hs : state.1.Contains (Real.sin x)) (hc : state.2.Contains (Real.cos x)) :
    (berryEsseenTrigRotate S C state).1.Contains (Real.sin (x+theta)) ∧
      (berryEsseenTrigRotate S C state).2.Contains (Real.cos (x+theta)) := by
  rw [Real.sin_add, Real.cos_add]
  exact ⟨BerryEsseenInterval.add_contains (BerryEsseenInterval.mul_contains hs hC)
      (BerryEsseenInterval.mul_contains hc hS),
    BerryEsseenInterval.sub_contains (BerryEsseenInterval.mul_contains hc hC)
      (BerryEsseenInterval.mul_contains hs hS)⟩

/-- A single scan constructs all reusable trigonometric interval values. -/
def berryEsseenTrigTable (S C : BerryEsseenInterval) (n : ℕ) : List (BerryEsseenInterval × BerryEsseenInterval) :=
  (List.replicate n ()).scanl (fun state _ => berryEsseenTrigRotate S C state)
    (BerryEsseenInterval.point 0, BerryEsseenInterval.point 1)

@[simp] theorem berryEsseenTrigTable_length (S C : BerryEsseenInterval) (n : ℕ) :
    (berryEsseenTrigTable S C n).length = n+1 := by simp [berryEsseenTrigTable]

/-- Every entry of the shared trigonometric table is a proved enclosure. -/
theorem berryEsseenTrigTable_correct {S C : BerryEsseenInterval} {theta : ℝ}
    (hS : S.Contains (Real.sin theta)) (hC : C.Contains (Real.cos theta))
    (n : ℕ) (i : ℕ) (hi : i ≤ n) :
    ((berryEsseenTrigTable S C n)[i]'(by simp; omega)).1.Contains (Real.sin ((i:ℝ)*theta)) ∧
      ((berryEsseenTrigTable S C n)[i]'(by simp; omega)).2.Contains (Real.cos ((i:ℝ)*theta)) := by
  induction i with
  | zero => simp [berryEsseenTrigTable, BerryEsseenInterval.point, BerryEsseenInterval.Contains]
  | succ i ih =>
    have ih' := ih (by omega)
    have hstep := berryEsseenTrigRotate_correct hS hC ih'.1 ih'.2
    simp only [berryEsseenTrigTable, List.getElem_succ_scanl] at ⊢
    simpa only [berryEsseenTrigTable, Nat.cast_add, Nat.cast_one, add_mul, one_mul] using hstep

/-- A fixed rational interval for pi, certified by the library's exact bounds. -/
def berryEsseenPiInterval : BerryEsseenInterval := ⟨3.14159265358979323846,3.14159265358979323847⟩

theorem berryEsseenPiInterval_correct : berryEsseenPiInterval.Contains Real.pi := by
  constructor
  · convert! Real.pi_gt_d20.le using 1
  · convert! Real.pi_lt_d20.le using 1

/-- The single mesh-angle enclosure from which every table entry is generated. -/
def berryEsseenMeshTrigInterval (imaginary : Bool) (N : ℕ) : BerryEsseenInterval :=
  let x : ℚ := berryEsseenPiInterval.lo/N
  let d : ℚ := (berryEsseenPiInterval.hi-berryEsseenPiInterval.lo)/N
  (berryEsseenTrigTaylorInterval imaginary x 12).add ⟨-d,d⟩

/-- Exact Taylor and pi bounds certify the starting rotation angle. -/
theorem berryEsseenMeshTrigInterval_correct (imaginary : Bool) {N : ℕ} (hN : 0 < N) :
    (berryEsseenMeshTrigInterval imaginary N).Contains
      (if imaginary then Real.sin (Real.pi/N) else Real.cos (Real.pi/N)) := by
  let x : ℚ := berryEsseenPiInterval.lo/N
  let d : ℚ := (berryEsseenPiInterval.hi-berryEsseenPiInterval.lo)/N
  have hNQ : (1:ℚ) ≤ N := by exact_mod_cast hN
  have hNR : (0:ℝ) < N := by exact_mod_cast hN
  have hx0 : 0 ≤ x := by dsimp [x, berryEsseenPiInterval]; positivity
  have hx4 : x ≤ 4 := by
    have h : x ≤ berryEsseenPiInterval.lo := by
      dsimp [x]
      exact div_le_self (by norm_num [berryEsseenPiInterval]) hNQ
    exact h.trans (by norm_num [berryEsseenPiInterval])
  have hsmall : |x|/(12+1:ℚ) ≤ 1/2 := by
    rw [abs_of_nonneg hx0]
    norm_num
    linarith
  have ht := berryEsseenTrigTaylorInterval_correct imaginary x 12 hsmall
  have hd0 : (0:ℝ) ≤ (d:ℝ) := by
    have : (0:ℚ) ≤ d := by dsimp [d, berryEsseenPiInterval]; positivity
    exact_mod_cast this
  have hlow : (x:ℝ) ≤ Real.pi/N := by
    have h := div_le_div_of_nonneg_right berryEsseenPiInterval_correct.1 hNR.le
    simpa only [x, Rat.cast_div, Rat.cast_natCast] using h
  have hhigh : Real.pi/N ≤ (x:ℝ)+(d:ℝ) := by
    have h := div_le_div_of_nonneg_right berryEsseenPiInterval_correct.2 hNR.le
    have heq : x+d = berryEsseenPiInterval.hi/N := by dsimp [x,d]; ring
    rw [← Rat.cast_add, heq]
    simpa only [Rat.cast_div, Rat.cast_natCast] using h
  have hxy : |Real.pi/N-(x:ℝ)| ≤ (d:ℝ) := abs_le.mpr ⟨by linarith, by linarith⟩
  exact berryEsseen_trig_interval_shift imaginary ht hxy

/-- The concrete reusable sine/cosine table for a uniform frequency mesh. -/
def berryEsseenMeshTrigTable (N : ℕ) : List (BerryEsseenInterval × BerryEsseenInterval) :=
  berryEsseenTrigTable (berryEsseenMeshTrigInterval true N) (berryEsseenMeshTrigInterval false N) N

@[simp] theorem berryEsseenMeshTrigTable_length (N : ℕ) : (berryEsseenMeshTrigTable N).length = N+1 := by
  simp [berryEsseenMeshTrigTable]

/-- The table contains sin and cos at the exact pi-scaled rational mesh points. -/
theorem berryEsseenMeshTrigTable_correct {N : ℕ} (hN : 0 < N) (i : ℕ) (hi : i ≤ N) :
    ((berryEsseenMeshTrigTable N)[i]'(by simp; omega)).1.Contains (Real.sin (Real.pi*((i:ℝ)/N))) ∧
      ((berryEsseenMeshTrigTable N)[i]'(by simp; omega)).2.Contains (Real.cos (Real.pi*((i:ℝ)/N))) := by
  have h := berryEsseenTrigTable_correct (berryEsseenMeshTrigInterval_correct true hN)
    (berryEsseenMeshTrigInterval_correct false hN) N i hi
  rw [show (i:ℝ)*(Real.pi/N) = Real.pi*((i:ℝ)/N) by ring] at h
  simpa only [berryEsseenMeshTrigTable] using h

/-- The real smoothing weight is rational at a rational mesh point. -/
def berryEsseenKernelRealInterval (t : ℚ) : BerryEsseenInterval := BerryEsseenInterval.point ((1-t)/2)

/-- Interval arithmetic encloses the imaginary smoothing weight from a certified sine/cosine pair. -/
def berryEsseenKernelImagInterval (t : ℚ) (S C : BerryEsseenInterval) : BerryEsseenInterval :=
  (((BerryEsseenInterval.point (1-t)).mul (C.div S)).add berryEsseenPiInterval.inv).div (BerryEsseenInterval.point 2)

/-- A rational enclosure of the pole subtracted in the normal correction. -/
def berryEsseenKernelPoleInterval (t : ℚ) : BerryEsseenInterval :=
  BerryEsseenInterval.rounded (1/(2*berryEsseenPiInterval.hi*t)) (1/(2*berryEsseenPiInterval.lo*t))

/-- The corrected imaginary weight is evaluated with the same certified arithmetic. -/
def berryEsseenKernelCorrectionInterval (t : ℚ) (S C : BerryEsseenInterval) : BerryEsseenInterval :=
  (berryEsseenKernelImagInterval t S C).sub (berryEsseenKernelPoleInterval t)

theorem berryEsseenKernelRealInterval_correct (t : ℚ) :
    (berryEsseenKernelRealInterval t).Contains (berryEsseenSmoothingKernel (t:ℝ)).re := by
  simpa only [berryEsseenKernelRealInterval, berryEsseenSmoothingKernel, Rat.cast_div, Rat.cast_sub,
    Rat.cast_one, Rat.cast_ofNat] using BerryEsseenInterval.point_contains ((1-t)/2)

theorem berryEsseenKernelImagInterval_correct (t : ℚ) {S C : BerryEsseenInterval}
    (hS : S.Contains (Real.sin (Real.pi*(t:ℝ)))) (hC : C.Contains (Real.cos (Real.pi*(t:ℝ))))
    (hS0 : 0 < S.lo) :
    (berryEsseenKernelImagInterval t S C).Contains (berryEsseenSmoothingKernel (t:ℝ)).im := by
  have hI := BerryEsseenInterval.inv_contains berryEsseenPiInterval_correct (by norm_num [berryEsseenPiInterval])
  have hc := BerryEsseenInterval.div_contains hC hS hS0
  have h := BerryEsseenInterval.div_contains
    (BerryEsseenInterval.add_contains
      (BerryEsseenInterval.mul_contains (BerryEsseenInterval.point_contains (1-t)) hc) hI)
    (BerryEsseenInterval.point_contains 2) (by norm_num [BerryEsseenInterval.point])
  simpa only [berryEsseenKernelImagInterval, berryEsseenSmoothingKernel, Rat.cast_sub, Rat.cast_one,
    Rat.cast_ofNat] using h

theorem berryEsseenKernelPoleInterval_correct {t : ℚ} (ht : 0 < t) :
    (berryEsseenKernelPoleInterval t).Contains (1/(2*Real.pi*(t:ℝ))) := by
  have htR : (0:ℝ) < t := by exact_mod_cast ht
  have hpiL : (0:ℝ) < berryEsseenPiInterval.lo := by norm_num [berryEsseenPiInterval]
  have hlow : 2*(berryEsseenPiInterval.lo:ℝ)*(t:ℝ) ≤ 2*Real.pi*(t:ℝ) := by
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left berryEsseenPiInterval_correct.1 (by norm_num)) htR.le
  have hhigh : 2*Real.pi*(t:ℝ) ≤ 2*(berryEsseenPiInterval.hi:ℝ)*(t:ℝ) := by
    exact mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left berryEsseenPiInterval_correct.2 (by norm_num)) htR.le
  apply BerryEsseenInterval.rounded_contains <;> push_cast
  · exact one_div_le_one_div_of_le (by positivity) hhigh
  · exact one_div_le_one_div_of_le (by positivity) hlow

/-- The interval construction encloses the original corrected kernel, not an assumed approximation. -/
theorem berryEsseenKernelCorrectionInterval_correct {t : ℚ} (ht : 0 < t) {S C : BerryEsseenInterval}
    (hS : S.Contains (Real.sin (Real.pi*(t:ℝ)))) (hC : C.Contains (Real.cos (Real.pi*(t:ℝ))))
    (hS0 : 0 < S.lo) :
    (berryEsseenKernelCorrectionInterval t S C).Contains
      (berryEsseenSmoothingKernel (t:ℝ)-Complex.I/(2*Real.pi*(t:ℝ):ℝ)).im := by
  have h := BerryEsseenInterval.sub_contains (berryEsseenKernelImagInterval_correct t hS hC hS0)
    (berryEsseenKernelPoleInterval_correct ht)
  simpa only [berryEsseenKernelCorrectionInterval, Complex.sub_im, Complex.div_ofReal_im, Complex.I_im] using h

/-- Finite rational conditions suffice to certify a complex norm upper bound. -/
def berryEsseenIntervalNormCheck (I J : BerryEsseenInterval) (b : ℚ) : Prop :=
  0 ≤ b ∧ I.absUpper^2+J.absUpper^2 ≤ b^2

instance (I J : BerryEsseenInterval) (b : ℚ) : Decidable (berryEsseenIntervalNormCheck I J b) := by
  unfold berryEsseenIntervalNormCheck
  infer_instance

theorem berryEsseenIntervalNormCheck_correct {I J : BerryEsseenInterval} {z : ℂ} {b : ℚ}
    (hr : I.Contains z.re) (hi : J.Contains z.im) (hb : berryEsseenIntervalNormCheck I J b) :
    ‖z‖ ≤ (b:ℝ) := by
  have hR := BerryEsseenInterval.abs_le_absUpper hr
  have hI := BerryEsseenInterval.abs_le_absUpper hi
  have hRs := (sq_le_sq₀ (abs_nonneg _) ((abs_nonneg _).trans hR)).mpr hR
  have hIs := (sq_le_sq₀ (abs_nonneg _) ((abs_nonneg _).trans hI)).mpr hI
  rw [sq_abs] at hRs hIs
  have hb0 : (0:ℝ) ≤ b := by exact_mod_cast hb.1
  have hbs : (I.absUpper:ℝ)^2+(J.absUpper:ℝ)^2 ≤ (b:ℝ)^2 := by exact_mod_cast hb.2
  have hnorm := Complex.sq_norm_sub_sq_re z
  nlinarith [norm_nonneg z]

/-- Point certificates establish both smoothing weights used by the final row checker. -/
theorem berryEsseen_kernel_point_certificate {t k c : ℚ} (ht : 0 < t) {S C : BerryEsseenInterval}
    (hS : S.Contains (Real.sin (Real.pi*(t:ℝ)))) (hC : C.Contains (Real.cos (Real.pi*(t:ℝ))))
    (hS0 : 0 < S.lo)
    (hk : berryEsseenIntervalNormCheck (berryEsseenKernelRealInterval t) (berryEsseenKernelImagInterval t S C) k)
    (hc : berryEsseenIntervalNormCheck (berryEsseenKernelRealInterval t) (berryEsseenKernelCorrectionInterval t S C) c) :
    ‖berryEsseenSmoothingKernel (t:ℝ)‖ ≤ (k:ℝ) ∧
      ‖berryEsseenSmoothingKernel (t:ℝ)-Complex.I/(2*Real.pi*(t:ℝ):ℝ)‖ ≤ (c:ℝ) := by
  constructor
  · exact berryEsseenIntervalNormCheck_correct (berryEsseenKernelRealInterval_correct t)
      (berryEsseenKernelImagInterval_correct t hS hC hS0) hk
  · apply berryEsseenIntervalNormCheck_correct _ (berryEsseenKernelCorrectionInterval_correct ht hS hC hS0) hc
    simpa only [Complex.sub_re, Complex.div_ofReal_re, Complex.I_re, zero_div, sub_zero] using
      berryEsseenKernelRealInterval_correct t

namespace BerryEsseenInterval

/-- Containment of rational endpoints can be checked without evaluating any real function. -/
def Encloses (I J : BerryEsseenInterval) : Prop := I.lo ≤ J.lo ∧ J.hi ≤ I.hi

instance (I J : BerryEsseenInterval) : Decidable (I.Encloses J) := by unfold Encloses; infer_instance

theorem encloses_contains {I J : BerryEsseenInterval} {x : ℝ} (hIJ : I.Encloses J) (hx : J.Contains x) :
    I.Contains x := by
  have hl : (I.lo:ℝ) ≤ J.lo := by exact_mod_cast hIJ.1
  have hh : (J.hi:ℝ) ≤ I.hi := by exact_mod_cast hIJ.2
  exact ⟨hl.trans hx.1, hx.2.trans hh⟩

end BerryEsseenInterval

/-- Locally checked rotations certify an externally supplied sequence of interval witnesses. -/
theorem berryEsseenTrigSequence_correct {S C : BerryEsseenInterval} {theta : ℝ}
    (hS : S.Contains (Real.sin theta)) (hC : C.Contains (Real.cos theta))
    (state : ℕ → BerryEsseenInterval × BerryEsseenInterval) (n : ℕ)
    (hzero : (state 0).1.Contains 0 ∧ (state 0).2.Contains 1)
    (hstep : ∀ i < n, (state (i+1)).1.Encloses (berryEsseenTrigRotate S C (state i)).1 ∧
      (state (i+1)).2.Encloses (berryEsseenTrigRotate S C (state i)).2)
    (i : ℕ) (hi : i ≤ n) :
    (state i).1.Contains (Real.sin ((i:ℝ)*theta)) ∧ (state i).2.Contains (Real.cos ((i:ℝ)*theta)) := by
  induction i with
  | zero => simpa only [Nat.cast_zero, zero_mul, Real.sin_zero, Real.cos_zero] using hzero
  | succ i ih =>
    have hprev := ih (by omega)
    have hrot := berryEsseenTrigRotate_correct hS hC hprev.1 hprev.2
    have hnext := hstep i (by omega)
    simpa only [Nat.cast_add, Nat.cast_one, add_mul, one_mul] using
      And.intro (BerryEsseenInterval.encloses_contains hnext.1 hrot.1)
        (BerryEsseenInterval.encloses_contains hnext.2 hrot.2)

/-- Integer witnesses keep the numerical table compact and every local check inexpensive. -/
structure BerryEsseenKernelWitness where
  sinLo : ℤ
  sinHi : ℤ
  cosLo : ℤ
  cosHi : ℤ
  kernel : ℕ
  correction : ℕ
  deriving DecidableEq, Inhabited

namespace BerryEsseenKernelWitness

def state (w : BerryEsseenKernelWitness) : BerryEsseenInterval × BerryEsseenInterval :=
  (⟨(w.sinLo:ℚ)/2^80,(w.sinHi:ℚ)/2^80⟩,⟨(w.cosLo:ℚ)/2^80,(w.cosHi:ℚ)/2^80⟩)

def Initial (w : BerryEsseenKernelWitness) : Prop :=
  w.sinLo ≤ 0 ∧ 0 ≤ w.sinHi ∧ w.cosLo ≤ 2^80 ∧ 2^80 ≤ w.cosHi
instance (w : BerryEsseenKernelWitness) : Decidable w.Initial := by unfold Initial; infer_instance

def Step (S C : BerryEsseenInterval) (w v : BerryEsseenKernelWitness) : Prop :=
  v.state.1.Encloses (berryEsseenTrigRotate S C w.state).1 ∧
    v.state.2.Encloses (berryEsseenTrigRotate S C w.state).2
instance (S C : BerryEsseenInterval) (w v : BerryEsseenKernelWitness) : Decidable (Step S C w v) := by
  unfold Step
  infer_instance

def Point (N i : ℕ) (w : BerryEsseenKernelWitness) : Prop :=
  let t : ℚ := i/N
  0 < w.state.1.lo ∧
    berryEsseenIntervalNormCheck (berryEsseenKernelRealInterval t)
      (berryEsseenKernelImagInterval t w.state.1 w.state.2) ((w.kernel:ℚ)/10^12) ∧
    berryEsseenIntervalNormCheck (berryEsseenKernelRealInterval t)
      (berryEsseenKernelCorrectionInterval t w.state.1 w.state.2) ((w.correction:ℚ)/10^12)
instance (N i : ℕ) (w : BerryEsseenKernelWitness) : Decidable (Point N i w) := by unfold Point; infer_instance

theorem initial_correct {w : BerryEsseenKernelWitness} (h : w.Initial) :
    w.state.1.Contains 0 ∧ w.state.2.Contains 1 := by
  have h1 : (w.sinLo:ℝ) ≤ 0 := by exact_mod_cast h.1
  have h2 : (0:ℝ) ≤ w.sinHi := by exact_mod_cast h.2.1
  have h3 : (w.cosLo:ℝ) ≤ 2^80 := by exact_mod_cast h.2.2.1
  have h4 : (2:ℝ)^80 ≤ w.cosHi := by exact_mod_cast h.2.2.2
  dsimp [state, BerryEsseenInterval.Contains]
  push_cast
  exact ⟨⟨div_nonpos_of_nonpos_of_nonneg h1 (by norm_num), div_nonneg h2 (by norm_num)⟩,
    ⟨(div_le_one (by norm_num)).mpr h3, (one_le_div (by norm_num)).mpr h4⟩⟩

end BerryEsseenKernelWitness

/-- Only independent local arithmetic checks are reduced by the kernel. -/
def berryEsseenKernelWitnessCheck (N : ℕ) (step : BerryEsseenKernelWitness) (data : Array BerryEsseenKernelWitness) : Bool :=
  decide (step.state.1.Encloses (berryEsseenMeshTrigInterval true N)) &&
    decide (step.state.2.Encloses (berryEsseenMeshTrigInterval false N)) &&
    (data.size == N+1) && decide data[0]!.Initial &&
    (List.range N).all (fun i => decide (BerryEsseenKernelWitness.Step
      step.state.1 step.state.2 data[i]! data[i+1]!)) &&
    (List.range (N-1)).all (fun i => decide (BerryEsseenKernelWitness.Point N (i+1) data[i+1]!))

/-- A successful finite witness check certifies every interior mesh point used by quadrature. -/
theorem berryEsseenKernelWitnessCheck_correct {N : ℕ} (hN : 0 < N)
    (step : BerryEsseenKernelWitness) (data : Array BerryEsseenKernelWitness)
    (hcheck : berryEsseenKernelWitnessCheck N step data = true)
    (i : ℕ) (hi0 : 0 < i) (hiN : i < N) :
    ‖berryEsseenSmoothingKernel ((i:ℝ)/N)‖ ≤ ((data[i]!).kernel:ℝ)/10^12 ∧
      ‖berryEsseenSmoothingKernel ((i:ℝ)/N)-Complex.I/(2*Real.pi*((i:ℝ)/N):ℝ)‖ ≤
        ((data[i]!).correction:ℝ)/10^12 := by
  simp only [berryEsseenKernelWitnessCheck, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hcheck
  obtain ⟨⟨⟨⟨⟨hS,hC⟩,_hsize⟩,hzero⟩,hstep⟩,hpoint⟩ := hcheck
  have hs := BerryEsseenInterval.encloses_contains hS (berryEsseenMeshTrigInterval_correct true hN)
  have hc := BerryEsseenInterval.encloses_contains hC (berryEsseenMeshTrigInterval_correct false hN)
  have hsteps (j : ℕ) (hj : j < N) :
      (data[j+1]!).state.1.Encloses (berryEsseenTrigRotate step.state.1 step.state.2 (data[j]!).state).1 ∧
        (data[j+1]!).state.2.Encloses (berryEsseenTrigRotate step.state.1 step.state.2 (data[j]!).state).2 := by
    exact of_decide_eq_true (List.all_eq_true.mp hstep j (List.mem_range.mpr hj))
  have hseq := berryEsseenTrigSequence_correct hs hc (fun j => (data[j]!).state) N
    (BerryEsseenKernelWitness.initial_correct hzero) hsteps i hiN.le
  have harg : (i:ℝ)*(Real.pi/N) = Real.pi*(((i:ℚ)/N:ℚ):ℝ) := by push_cast; ring
  rw [harg] at hseq
  have hpraw := of_decide_eq_true (List.all_eq_true.mp hpoint (i-1) (List.mem_range.mpr (by omega)))
  have hp : BerryEsseenKernelWitness.Point N i data[i]! := by
    simpa only [Nat.sub_add_cancel (by omega : 1 ≤ i)] using hpraw
  have ht : (0:ℚ) < (i:ℚ)/N := by positivity
  have h := berryEsseen_kernel_point_certificate ht hseq.1 hseq.2 hp.1 hp.2.1 hp.2.2
  simpa only [Rat.cast_div, Rat.cast_natCast, Rat.cast_pow, Rat.cast_ofNat] using h

/-- A linear traversal avoids repeated indexing while the kernel checks the witness table. -/
def berryEsseenKernelWitnessListCheck (N : ℕ) (step : BerryEsseenKernelWitness) (data : List BerryEsseenKernelWitness) : Bool :=
  decide (step.state.1.Encloses (berryEsseenMeshTrigInterval true N)) &&
    decide (step.state.2.Encloses (berryEsseenMeshTrigInterval false N)) &&
    (data.length == N+1) && decide data.head!.Initial &&
    (data.zip data.tail).all (fun pair => decide
      (BerryEsseenKernelWitness.Step step.state.1 step.state.2 pair.1 pair.2)) &&
    ((List.range (N-1)).zip data.tail).all (fun pair => decide
      (BerryEsseenKernelWitness.Point N (pair.1+1) pair.2))

/-- Linear list verification implies the already-proved pointwise array certificate. -/
theorem berryEsseenKernelWitnessListCheck_sound {N : ℕ} (step : BerryEsseenKernelWitness)
    (data : List BerryEsseenKernelWitness) (h : berryEsseenKernelWitnessListCheck N step data = true) :
    berryEsseenKernelWitnessCheck N step data.toArray = true := by
  simp only [berryEsseenKernelWitnessListCheck, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨⟨hS,hC⟩,hlen⟩,hzero⟩,hstep⟩,hpoint⟩ := h
  simp only [berryEsseenKernelWitnessCheck, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, List.size_toArray]
  refine ⟨⟨⟨⟨⟨hS,hC⟩,hlen⟩,?_⟩,?_⟩,?_⟩
  · simpa only [List.getElem!_toArray, List.head!_eq_getElem!] using hzero
  · apply List.all_eq_true.mpr
    intro i hi
    have hiN := List.mem_range.mp hi
    have hi0 : i < data.length := by omega
    have hi1 : i+1 < data.length := by omega
    have hiz : i < (data.zip data.tail).length := by simp only [List.length_zip, List.length_tail]; omega
    have hv := of_decide_eq_true (List.all_eq_true.mp hstep _ (List.getElem_mem hiz))
    rw [decide_eq_true_eq]
    simpa only [List.getElem_zip, List.getElem_tail, List.getElem!_toArray,
      getElem!_pos data i hi0, getElem!_pos data (i+1) hi1] using hv
  · apply List.all_eq_true.mpr
    intro i hi
    have hiN := List.mem_range.mp hi
    have hi1 : i+1 < data.length := by omega
    have hiz : i < ((List.range (N-1)).zip data.tail).length := by
      simp only [List.length_zip, List.length_range, List.length_tail]
      omega
    have hv := of_decide_eq_true (List.all_eq_true.mp hpoint _ (List.getElem_mem hiz))
    rw [decide_eq_true_eq]
    simpa only [List.getElem_zip, List.getElem_tail, List.getElem_range, List.getElem!_toArray,
      getElem!_pos data (i+1) hi1] using hv

/-- Endpoint coverage yields an adjacent parameter box, without any search assumption. -/
theorem berryEsseen_exists_parameter_box (f : ℕ → ℝ) {x : ℝ}
    (hfirst : f 0 < x) (n : ℕ) (hlast : x ≤ f n) :
    ∃ i < n, f i ≤ x ∧ x ≤ f (i+1) := by
  induction n with
  | zero => linarith
  | succ n ih =>
    by_cases hn : x ≤ f n
    · obtain ⟨i,hi,hl,hu⟩ := ih hn
      exact ⟨i,by omega,hl,hu⟩
    · exact ⟨n,Nat.lt_succ_self n,(lt_of_not_ge hn).le,hlast⟩

/-- Certified rows covering the bounded moment range complete the normalized CDF bound. -/
theorem berryEsseen_product_cdf_of_parameter_cover (q : ℕ → ℝ) (n : ℕ)
    (hfirst : (q 0)^3 ≤ 1/100) (hlast : 25/14 ≤ (q n)^3)
    (hrows : ∀ i < n, 0 ≤ q (i+1) ∧ ∃ U τ : ℝ, 0 < U ∧ 0 < τ ∧ τ < 1 ∧
      berryEsseenCDFErrorBound ((q (i+1))^3) (q (i+1)) U τ ≤ (14/25:ℝ)*(q i)^3)
    {ι : Type*} [Fintype ι] (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    (hv : (∑ i, ∫ x, x^2 ∂μ i) = 1) {ell : ℝ}
    (hthird : (∑ i, ∫ x, |x|^3 ∂μ i) ≤ ell) (x : ℝ) :
    |cdf ((Measure.pi μ).map (fun z => ∑ i, z i)) x-cdf (gaussianReal 0 1) x| ≤ (14/25:ℝ)*ell := by
  have hell : 0 < ell := (berryEsseen_total_thirdMoment_pos μ hm hv).trans_le hthird
  by_cases hsmall : ell ≤ 1/100
  · exact berryEsseen_product_cdf_small μ hm hmean hv hell hsmall hthird x
  by_cases hlarge : 25/14 ≤ ell
  · exact berryEsseen_cdf_large hlarge x
  obtain ⟨i,hi,hlo,hhi⟩ := berryEsseen_exists_parameter_box (fun j => (q j)^3)
    (hfirst.trans_lt (lt_of_not_ge hsmall)) n ((lt_of_not_ge hlarge).le.trans hlast)
  obtain ⟨hq,U,τ,hU,hτ,hτ1,hbound⟩ := hrows i hi
  have hbudget := hthird.trans hhi
  exact (berryEsseen_product_cdf_error_le μ hm hmean hv hbudget hq hbudget hU hτ hτ1 x).trans
    (hbound.trans (mul_le_mul_of_nonneg_left hlo (by norm_num : (0:ℝ) ≤ 14/25)))

