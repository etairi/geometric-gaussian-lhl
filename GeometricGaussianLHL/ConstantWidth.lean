end BerryEsseenSmoothingKernel

section GaussianNormalComparison

/-!
## Normal approximation for the Gaussian test function

Integration by parts converts a uniform CDF bound into a test-function error.
For the Gaussian test function the integral of the absolute derivative is two,
and its expectation under a centered normal law has an exact closed form.
These lemmas apply the analytic and certified numerical CDF bounds to
the Gaussian test function used by the contraction theorem below.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
open MeasureTheory ProbabilityTheory Set Filter
open scoped Topology NNReal

namespace GeometricGaussianLHL

/-- Fubini's form of integration by parts against a cumulative distribution function. -/
theorem integral_tail_eq_integral_cdf_mul (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {h : ℝ → ℝ} (hi : Integrable h) :
    (∫ x, ∫ t in Ici x, h t ∂volume ∂μ) = ∫ t, cdf μ t * h t := by
  let k : ℝ → ℝ → ℝ := fun x t => if x ≤ t then h t else 0
  have hk : Integrable (Function.uncurry k) (μ.prod volume) := by
    exact (hi.comp_snd μ).indicator (measurableSet_le measurable_fst measurable_snd)
  have hleft (x : ℝ) : (∫ t, k x t) = ∫ t in Ici x, h t := by
    exact integral_indicator measurableSet_Ici
  have hright (t : ℝ) : (∫ x, k x t ∂μ) = cdf μ t * h t := by
    change (∫ x, (Iic t).indicator (fun _ => h t) x ∂μ) = _
    rw [integral_indicator_const _ measurableSet_Iic, smul_eq_mul, cdf_eq_real]
  simp_rw [← hleft, integral_integral_swap hk, hright]

/-- Integration by parts for a differentiable test function vanishing at positive infinity. -/
theorem integral_eq_neg_integral_cdf_mul_deriv (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {f h : ℝ → ℝ} (hd : ∀ x, HasDerivAt f (h x) x) (hi : Integrable h)
    (hlim : Tendsto f atTop (𝓝 0)) :
    (∫ x, f x ∂μ) = -(∫ t, cdf μ t * h t) := by
  have htail (x : ℝ) : (∫ t in Ici x, h t) = -f x := by
    rw [integral_Ici_eq_integral_Ioi]
    simpa only [zero_sub] using
      integral_Ioi_of_hasDerivAt_of_tendsto' (fun t _ => hd t) hi.integrableOn hlim
  have he := integral_tail_eq_integral_cdf_mul μ hi
  simp_rw [htail, integral_neg] at he
  linarith

/-- A uniform CDF error controls differentiable test functions by the integral
of the absolute derivative. This does not assume either law has a density. -/
theorem integral_test_error_of_cdf_error (μ ν : Measure ℝ)
    [IsProbabilityMeasure μ] [IsProbabilityMeasure ν] {f h : ℝ → ℝ} {δ : ℝ}
    (hd : ∀ x, HasDerivAt f (h x) x) (hi : Integrable h)
    (hlim : Tendsto f atTop (𝓝 0)) (hcdf : ∀ t, |cdf μ t - cdf ν t| ≤ δ) :
    |(∫ x, f x ∂μ) - ∫ x, f x ∂ν| ≤ δ * ∫ t, |h t| := by
  have hb (ρ : Measure ℝ) : Integrable (fun t => cdf ρ t * h t) :=
    hi.bdd_mul (monotone_cdf ρ).measurable.aestronglyMeasurable
      (ae_of_all _ (fun t => by
        rw [Real.norm_eq_abs, abs_of_nonneg (cdf_nonneg ρ t)]
        exact cdf_le_one ρ t))
  rw [integral_eq_neg_integral_cdf_mul_deriv μ hd hi hlim,
    integral_eq_neg_integral_cdf_mul_deriv ν hd hi hlim, neg_sub_neg,
    abs_sub_comm, ← integral_sub (hb μ) (hb ν)]
  calc
    _ ≤ ∫ t, |cdf μ t * h t - cdf ν t * h t| :=
      by simpa only [Real.norm_eq_abs] using
        norm_integral_le_integral_norm (fun t => cdf μ t * h t - cdf ν t * h t)
    _ ≤ ∫ t, δ * |h t| := by
      apply integral_mono ((hb μ).sub (hb ν)).abs (hi.abs.const_mul δ)
      intro t
      change |cdf μ t * h t - cdf ν t * h t| ≤ δ * |h t|
      rw [← sub_mul, abs_mul]
      exact mul_le_mul_of_nonneg_right (hcdf t) (abs_nonneg _)
    _ = _ := integral_const_mul _ _

theorem gaussian_test_hasDerivAt (a x : ℝ) :
    HasDerivAt (fun u : ℝ => Real.exp (-a * u ^ 2))
      ((-2 * a * x) * Real.exp (-a * x ^ 2)) x := by
  convert (((hasDerivAt_id x).pow 2).const_mul (-a)).exp using 1 <;>
    simp only [Pi.pow_apply, id_eq, Nat.cast_ofNat]
  ring

theorem gaussian_test_tendsto_zero {a : ℝ} (ha : 0 < a) :
    Tendsto (fun x : ℝ => Real.exp (-a * x ^ 2)) atTop (𝓝 0) := by
  have h := Real.tendsto_exp_neg_atTop_nhds_zero.comp
    ((tendsto_pow_atTop (by norm_num : (2 : ℕ) ≠ 0)).const_mul_atTop ha)
  simpa only [Function.comp_def, neg_mul] using h

theorem gaussian_test_deriv_integrable {a : ℝ} (ha : 0 < a) :
    Integrable (fun x : ℝ => (-2 * a * x) * Real.exp (-a * x ^ 2)) := by
  simpa only [mul_assoc] using (integrable_mul_exp_neg_mul_sq ha).const_mul (-2 * a)

/-- The Gaussian test function has total variation exactly two, at every positive width. -/
theorem gaussian_test_integral_abs_deriv {a : ℝ} (ha : 0 < a) :
    (∫ x : ℝ, |(-2 * a * x) * Real.exp (-a * x ^ 2)|) = 2 := by
  let h : ℝ → ℝ := fun x => (-2 * a * x) * Real.exp (-a * x ^ 2)
  have hi : Integrable h := gaussian_test_deriv_integrable ha
  have hpos : (∫ x in Ioi (0 : ℝ), h x) = -1 := by
    have he := integral_Ioi_of_hasDerivAt_of_tendsto'
      (a := (0 : ℝ)) (fun x _ => gaussian_test_hasDerivAt a x)
      hi.integrableOn (gaussian_test_tendsto_zero ha)
    simpa [h] using he
  have habs : (∫ x in Ioi (0 : ℝ), |h x|) = 1 := by
    calc
      _ = ∫ x in Ioi (0 : ℝ), -h x := by
        apply setIntegral_congr_fun measurableSet_Ioi
        intro x hx
        apply abs_of_nonpos
        dsimp [h]
        exact mul_nonpos_of_nonpos_of_nonneg
          (mul_nonpos_of_nonpos_of_nonneg (by nlinarith : -2 * a ≤ 0) hx.le)
          (Real.exp_pos _).le
      _ = _ := by rw [integral_neg, hpos]; norm_num
  have heven : (∫ x in Iic (0 : ℝ), |h x|) = ∫ x in Ioi (0 : ℝ), |h x| := by
    have he := integral_comp_neg_Ioi (0 : ℝ) (fun x => |h x|)
    simp only [neg_zero] at he
    rw [← he]
    congr 1
    ext x
    simp [h, ← neg_mul, abs_neg]
  have hsplit := integral_add_compl (s := Ioi (0 : ℝ)) measurableSet_Ioi hi.abs
  rw [compl_Ioi, habs, heven, habs] at hsplit
  exact hsplit.symm.trans (by norm_num)

/-- The exact bounded-test comparison used after Berry–Esseen. -/
theorem gaussian_test_error_of_cdf_error (μ ν : Measure ℝ)
    [IsProbabilityMeasure μ] [IsProbabilityMeasure ν] {a δ : ℝ} (ha : 0 < a)
    (hcdf : ∀ t, |cdf μ t - cdf ν t| ≤ δ) :
    |(∫ x, Real.exp (-a * x ^ 2) ∂μ) - ∫ x, Real.exp (-a * x ^ 2) ∂ν| ≤ 2 * δ := by
  have he := integral_test_error_of_cdf_error μ ν (gaussian_test_hasDerivAt a)
    (gaussian_test_deriv_integrable ha) (gaussian_test_tendsto_zero ha) hcdf
  rw [gaussian_test_integral_abs_deriv ha] at he
  simpa only [mul_comm] using he

/-- The Gaussian test-function integral against a centered normal law, including zero variance. -/
theorem gaussian_test_integral_normal {a : ℝ} (ha : 0 < a) (v : ℝ≥0) :
    (∫ x : ℝ, Real.exp (-a * x ^ 2) ∂gaussianReal 0 v) =
      1 / Real.sqrt (1 + 2 * a * (v : ℝ)) := by
  by_cases hv : v = 0
  · simp [hv]
  have hv0 : (0 : ℝ) < v := by exact_mod_cast (pos_iff_ne_zero.mpr hv)
  have hb : 0 < a + 1 / (2 * (v : ℝ)) := by positivity
  rw [integral_gaussianReal_eq_integral_smul hv]
  have he (x : ℝ) : gaussianPDFReal 0 v x • Real.exp (-a * x ^ 2) =
      (1 / Real.sqrt (2 * Real.pi * (v : ℝ))) *
        Real.exp (-(a + 1 / (2 * (v : ℝ))) * x ^ 2) := by
    simp only [gaussianPDFReal, sub_zero, smul_eq_mul, mul_assoc, ← Real.exp_add]
    congr 2 <;> simp only [div_eq_mul_inv] <;> ring
  simp_rw [he]
  rw [integral_const_mul, integral_gaussian]
  calc
    _ = Real.sqrt ((2 * Real.pi * (v : ℝ))⁻¹ * (Real.pi / (a + 1 / (2 * (v : ℝ))))) := by
      rw [Real.sqrt_mul (x := (2 * Real.pi * (v : ℝ))⁻¹) (by positivity), Real.sqrt_inv]
      simp only [one_div]
    _ = Real.sqrt ((1 + 2 * a * (v : ℝ))⁻¹) := by
      congr 1
      field_simp
      ring
    _ = _ := by simp only [Real.sqrt_inv, one_div]

/-- A CDF comparison with a centered normal law yields the paper's Gaussian test bound. -/
theorem gaussian_test_integral_le_of_normal_cdf_error (μ : Measure ℝ)
    [IsProbabilityMeasure μ] {a δ : ℝ} (ha : 0 < a) (v : ℝ≥0)
    (hcdf : ∀ t, |cdf μ t - cdf (gaussianReal 0 v) t| ≤ δ) :
    (∫ x : ℝ, Real.exp (-a * x ^ 2) ∂μ) ≤
      1 / Real.sqrt (1 + 2 * a * (v : ℝ)) + 2 * δ := by
  have he := gaussian_test_error_of_cdf_error μ (gaussianReal 0 v) ha hcdf
  rw [gaussian_test_integral_normal ha v] at he
  linarith [(le_abs_self ((∫ x : ℝ, Real.exp (-a * x ^ 2) ∂μ) -
    1 / Real.sqrt (1 + 2 * a * (v : ℝ))))]


