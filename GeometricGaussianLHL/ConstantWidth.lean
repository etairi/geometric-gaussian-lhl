  · have hl0 : (51 / 20) ≤ x := (lt_of_not_ge hs0).le
    by_cases hs1 : x ≤ (153 / 40)
    · exact cosineMajorantGap_nonneg_1 x hl0 hs1
    · have hl1 : (153 / 40) ≤ x := (lt_of_not_ge hs1).le
      by_cases hs2 : x ≤ (357 / 80)
      · by_cases hs3 : x ≤ (663 / 160)
        · by_cases hs4 : x ≤ (255 / 64)
          · exact cosineMajorantGap_nonneg_2 x hl1 hs4
          · have hl4 : (255 / 64) ≤ x := (lt_of_not_ge hs4).le
