  by_cases hx7 : x ≤ 7
  · have hr := cosineTangentResidual_nonneg hθ0 hθ1 hx hx7
    have hg := cosine_tangent_gap_identity θ x
    have hp : 0 ≤ x ^ 2 * (x - θ) ^ 2 * cosineTangentResidual θ x := by positivity
    linarith [cos_le_cosineUpper28 x]
  · have hb := berryEsseenTangentB_nonneg hθ0 hθ1
    have hg := cosineTangentLargeGap_nonneg hθ0 hθ1
    have hid : cosineTangentLargeGap θ = 7 * berryEsseenTangentB θ - berryEsseenTangentA θ := by
      unfold cosineTangentLargeGap berryEsseenTangentA berryEsseenTangentB
      ring
    have hfactor : 0 ≤ berryEsseenTangentB θ * x - berryEsseenTangentA θ := by
      rw [hid] at hg
      nlinarith
    have hp := mul_nonneg (sq_nonneg x) hfactor
    nlinarith [Real.cos_le_one x]

/-- A continuum of certified quadratic-cubic cosine bounds, with polynomial coefficients.
The polynomial identities and Bernstein positivity certificates use exact rational arithmetic. -/
theorem cos_le_berryEsseenTangent {θ : ℝ} (hθ0 : 4 ≤ θ) (hθ1 : θ ≤ 25 / 4) (x : ℝ) :
    Real.cos x ≤ 1 - berryEsseenTangentA θ * x ^ 2 + berryEsseenTangentB θ * |x| ^ 3 := by
  simpa only [Real.cos_abs, sq_abs] using cos_le_tangent_of_nonneg hθ0 hθ1 (abs_nonneg x)

