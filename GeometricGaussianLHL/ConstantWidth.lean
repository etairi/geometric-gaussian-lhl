private theorem cosineMajorantGap_nonneg {x : ℝ} (hx : 0 ≤ x) (hx1 : x ≤ 51 / 10) :
    0 ≤ cosineMajorantGap x := by
  by_cases hs0 : x ≤ (51 / 20)
