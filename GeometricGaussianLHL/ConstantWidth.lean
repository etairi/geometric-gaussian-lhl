    (hind : iIndepFun X P) (hm : ∀ i, MemLp (X i) 3 P)
    (hmean : ∀ i, (∫ w, X i w ∂P)=0)
    (v : ℝ≥0) (hv : (∑ i, ∫ w, (X i w)^2 ∂P)=(v:ℝ)) (x : ℝ) :
    |cdf (P.map (fun w => ∑ i,X i w)) x-cdf (gaussianReal 0 v) x| ≤
      (14/25:ℝ)*(∑ i, ∫ w, |X i w|^3 ∂P)/(Real.sqrt (v:ℝ))^3 :=
  berryEsseen_independent_cdf_of_certified_interval berryEsseen_universal_parameter_certificate
    (by norm_num) (by norm_num) P X hind hm hmean v hv x

/-- The actual independent-sum CDF bound required by the manuscript. -/
theorem berryEsseen_product_cdf_at_paper_budget {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i)=0)
    (hv : (∑ i, ∫ x, x^2 ∂μ i)=1)
    (hthird : (∑ i, ∫ x, |x|^3 ∂μ i) ≤ 4/5) (x : ℝ) :
    |cdf ((Measure.pi μ).map (fun z => ∑ i,z i)) x-cdf (gaussianReal 0 1) x| ≤ 56/125 := by
  simpa only [show (14/25:ℝ)*(4/5)=56/125 by norm_num] using
    berryEsseen_product_cdf μ hm hmean hv hthird x

