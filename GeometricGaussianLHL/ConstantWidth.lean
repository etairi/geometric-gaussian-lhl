        · have hl3 : (663 / 160) ≤ x := (lt_of_not_ge hs3).le
          exact cosineMajorantGap_nonneg_7 x hl3 hs2
      · have hl2 : (357 / 80) ≤ x := (lt_of_not_ge hs2).le
        exact cosineMajorantGap_nonneg_8 x hl2 hx1


/-- A rational sharp cubic majorant for the cosine remainder, certified by a Taylor bound and
exact polynomial positivity on nine intervals. -/
theorem cosine_cubic_remainder_le (x : ℝ) :
    |Real.cos x - 1 + x ^ 2 / 2| ≤ (49581 / 500000 : ℝ) * |x| ^ 3 := by
  have hpos (y : ℝ) (hy : 0 ≤ y) :
      Real.cos y - 1 + y ^ 2 / 2 ≤ (49581 / 500000 : ℝ) * y ^ 3 := by
    by_cases hy1 : y ≤ 51 / 10
    · have hc := cos_le_cosineUpper20 y
      have hg := cosineMajorantGap_nonneg hy hy1
      have heq : cosineUpper20 y - 1 + y ^ 2 / 2 =
          (49581 / 500000 : ℝ) * y ^ 3 - y ^ 3 * cosineMajorantGap y := by
        unfold cosineUpper20 cosineMajorantGap
        ring
      have hn := mul_nonneg (pow_nonneg hy 3) hg
      linarith
    · have hlarge : (1 / 2 : ℝ) ≤ (49581 / 500000 : ℝ) * y := by linarith
      have h := mul_le_mul_of_nonneg_left hlarge (sq_nonneg y)
      nlinarith [Real.cos_le_one y]
  have h := hpos |x| (abs_nonneg x)
  rw [Real.cos_abs, sq_abs] at h
  rw [abs_of_nonneg (by linarith [Real.one_sub_sq_div_two_le_cos (x := x)])]
  exact h

/-- The certified cosine remainder gives a squared characteristic-function bound without
an assumed trigonometric majorant. -/
theorem norm_charFun_sq_le_cubic (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : ∫ x, x ∂μ = 0) (t : ℝ) :
    ‖charFun μ t‖ ^ 2 ≤ 1 - (∫ x, x ^ 2 ∂μ) * t ^ 2 +
      2 * (49581 / 500000 : ℝ) *
        ((∫ x, |x| ^ 3 ∂μ) + (∫ x, x ^ 2 ∂μ) * ∫ x, |x| ∂μ) * |t| ^ 3 := by
  apply norm_charFun_sq_le_of_cos_majorant μ hm hmean (by norm_num)
  intro x
  have h := (le_abs_self (Real.cos x - 1 + x ^ 2 / 2)).trans (cosine_cubic_remainder_le x)
  linarith

/-- The certified cubic characteristic-function envelope for a centered law with finite third
absolute moment. -/
theorem norm_charFun_le_exp_cubic (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : ∫ x, x ∂μ = 0) (t : ℝ) :
    ‖charFun μ t‖ ≤ Real.exp (-(∫ x, x ^ 2 ∂μ) * t ^ 2 / 2 +
      (49581 / 500000 : ℝ) *
        ((∫ x, |x| ^ 3 ∂μ) + (∫ x, x ^ 2 ∂μ) * ∫ x, |x| ∂μ) * |t| ^ 3) := by
  apply norm_charFun_le_exp_of_cos_majorant μ hm hmean (by norm_num)
  intro x
  have h := (le_abs_self (Real.cos x - 1 + x ^ 2 / 2)).trans (cosine_cubic_remainder_le x)
  linarith


/-- The first absolute moment is bounded by the square root of the second moment. -/
theorem integral_abs_le_sqrt_secondMoment (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) :
    (∫ x, |x| ∂μ) ≤ Real.sqrt (∫ x, x ^ 2 ∂μ) := by
  let m := ∫ x, |x| ∂μ
  have h1 : Integrable (fun x : ℝ => |x|) μ := (hm.integrable (by norm_num)).abs
  have h2 : Integrable (fun x : ℝ => x ^ 2) μ := hm.integrable_sq
  have hnon : 0 ≤ ∫ x, x ^ 2 - 2 * m * |x| + m ^ 2 ∂μ := by
    apply integral_nonneg
    intro x
    change 0 ≤ x ^ 2 - 2 * m * |x| + m ^ 2
    nlinarith [sq_nonneg (|x| - m), sq_abs x]
  erw [integral_add (h2.sub (h1.const_mul (2 * m))) (integrable_const _),
    integral_sub h2 (h1.const_mul (2 * m)), integral_const_mul, integral_const] at hnon
  simp only [probReal_univ, one_smul] at hnon
  have hv : 0 ≤ ∫ x, x ^ 2 ∂μ := integral_nonneg (fun x => sq_nonneg x)
  have hs := Real.sq_sqrt hv
  have hm0 : 0 ≤ m := integral_nonneg (fun x => abs_nonneg x)
  have hs0 := Real.sqrt_nonneg (∫ x, x ^ 2 ∂μ)
  change m ≤ _
  change 0 ≤ (∫ x, x ^ 2 ∂μ) - 2 * m * m + m ^ 2 at hnon
  nlinarith

/-- The Lyapunov moment inequality, in a form without real fractional powers. -/
theorem secondMoment_mul_sqrt_le_thirdMoment (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) :
    (∫ x, x ^ 2 ∂μ) * Real.sqrt (∫ x, x ^ 2 ∂μ) ≤ ∫ x, |x| ^ 3 ∂μ := by
  let v := ∫ x, x ^ 2 ∂μ
  let s := Real.sqrt v
  have hv : 0 ≤ v := integral_nonneg (fun x => sq_nonneg x)
  have hs : s ^ 2 = v := Real.sq_sqrt hv
  have hs0 : 0 ≤ s := Real.sqrt_nonneg _
  have h2 : Integrable (fun x : ℝ => x ^ 2) μ :=
    (hm.mono_exponent (by norm_num : (2 : ENNReal) ≤ 3)).integrable_sq
  have h3 : Integrable (fun x : ℝ => |x| ^ 3) μ := by
    simpa only [id_eq, Real.norm_eq_abs] using hm.integrable_norm_pow'
  have hnon : 0 ≤ ∫ x, |x| ^ 3 - (3 * s / 2) * x ^ 2 + s ^ 3 / 2 ∂μ := by
    apply integral_nonneg
    intro x
    change 0 ≤ |x| ^ 3 - (3 * s / 2) * x ^ 2 + s ^ 3 / 2
    have hp := mul_nonneg (sq_nonneg (|x| - s)) (add_nonneg (abs_nonneg x) (by positivity : 0 ≤ s / 2))
    nlinarith [sq_abs x]
  erw [integral_add (h3.sub (h2.const_mul (3 * s / 2))) (integrable_const _),
    integral_sub h3 (h2.const_mul (3 * s / 2)), integral_const_mul, integral_const] at hnon
  simp only [probReal_univ, one_smul] at hnon
  change v * s ≤ _
  change 0 ≤ (∫ x, |x| ^ 3 ∂μ) - (3 * s / 2) * v + s ^ 3 / 2 at hnon
  have hs3 : s ^ 3 = v * s := by rw [pow_succ, hs]
  nlinarith [hs3]

/-- A product of the first and second absolute moments is bounded by the third. -/
theorem secondMoment_mul_firstMoment_le_thirdMoment (μ : Measure ℝ)
    [IsProbabilityMeasure μ] (hm : MemLp id 3 μ) :
    (∫ x, x ^ 2 ∂μ) * (∫ x, |x| ∂μ) ≤ ∫ x, |x| ^ 3 ∂μ := by
  exact (mul_le_mul_of_nonneg_left
    (integral_abs_le_sqrt_secondMoment μ (hm.mono_exponent (by norm_num)))
    (integral_nonneg (fun x => sq_nonneg x))).trans
      (secondMoment_mul_sqrt_le_thirdMoment μ hm)

/-- The cubic envelope in terms of the variance and third absolute moment alone. -/
theorem norm_charFun_le_exp_thirdMoment (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : ∫ x, x ∂μ = 0) (t : ℝ) :
    ‖charFun μ t‖ ≤ Real.exp (-(∫ x, x ^ 2 ∂μ) * t ^ 2 / 2 +
      (49581 / 250000 : ℝ) * (∫ x, |x| ^ 3 ∂μ) * |t| ^ 3) := by
  refine (norm_charFun_le_exp_cubic μ hm hmean t).trans (Real.exp_le_exp.mpr ?_)
  have h := secondMoment_mul_firstMoment_le_thirdMoment μ hm
  have hp := mul_le_mul_of_nonneg_right h (by positivity : 0 ≤ |t| ^ 3)
  nlinarith

/-- The cubic characteristic-function envelope for any finite product of centered laws. -/
theorem norm_charFun_product_sum_le_exp_cubic {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, ∫ x, x ∂μ i = 0) (t : ℝ) :
    ‖charFun ((Measure.pi μ).map (fun z => ∑ i, z i)) t‖ ≤
      Real.exp (-(∑ i, ∫ x, x ^ 2 ∂μ i) * t ^ 2 / 2 +
        (49581 / 250000 : ℝ) * (∑ i, ∫ x, |x| ^ 3 ∂μ i) * |t| ^ 3) := by
  rw [charFun_map_sum_pi_eq_prod]
  simp only [Finset.prod_apply, norm_prod]
  calc
    _ ≤ ∏ i, Real.exp (-(∫ x, x ^ 2 ∂μ i) * t ^ 2 / 2 +
        (49581 / 250000 : ℝ) * (∫ x, |x| ^ 3 ∂μ i) * |t| ^ 3) :=
      Finset.prod_le_prod (fun _ _ => norm_nonneg _)
        (fun i _ => norm_charFun_le_exp_thirdMoment (μ i) (hm i) (hmean i) t)
    _ = _ := by
      rw [← Real.exp_sum]
      congr 1
      rw [Finset.sum_add_distrib, ← Finset.sum_div, ← Finset.sum_mul, Finset.sum_neg_distrib,
        ← Finset.sum_mul, ← Finset.mul_sum]

/-- The normalized finite-sum envelope depends only on its Lyapunov fraction. -/
theorem norm_charFun_product_sum_le_exp_normalized {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, ∫ x, x ∂μ i = 0)
    (hvariance : (∑ i, ∫ x, x ^ 2 ∂μ i) = 1) {ℓ : ℝ}
    (hthird : (∑ i, ∫ x, |x| ^ 3 ∂μ i) ≤ ℓ) (t : ℝ) :
    ‖charFun ((Measure.pi μ).map (fun z => ∑ i, z i)) t‖ ≤
      Real.exp (-t ^ 2 / 2 + (49581 / 250000 : ℝ) * ℓ * |t| ^ 3) := by
  refine (norm_charFun_product_sum_le_exp_cubic μ hm hmean t).trans ?_
  rw [hvariance]
  apply Real.exp_le_exp.mpr
  simp only [neg_mul, one_mul]
  gcongr

/-- Any global quadratic-cubic cosine majorant gives a squared characteristic-function bound. -/
theorem norm_charFun_sq_le_of_quadratic_cubic_majorant (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : ∫ x, x ∂μ = 0) {a κ : ℝ} (hκ : 0 ≤ κ)
    (hcos : ∀ x : ℝ, Real.cos x ≤ 1 - a * x ^ 2 + κ * |x| ^ 3) (t : ℝ) :
    ‖charFun μ t‖ ^ 2 ≤ 1 - 2 * a * (∫ x, x ^ 2 ∂μ) * t ^ 2 +
      2 * κ * ((∫ x, |x| ^ 3 ∂μ) + (∫ x, x ^ 2 ∂μ) * ∫ x, |x| ∂μ) * |t| ^ 3 := by
  have hp : MemLp (fun z : ℝ × ℝ => z.1 - z.2) 3 (μ.prod μ) :=
    (hm.comp_fst μ).sub (hm.comp_snd μ)
  have h2 : Integrable (fun z : ℝ × ℝ => (z.1 - z.2) ^ 2) (μ.prod μ) :=
    (hp.mono_exponent (by norm_num : (2 : ENNReal) ≤ 3)).integrable_sq
  have h3 : Integrable (fun z : ℝ × ℝ => |z.1 - z.2| ^ 3) (μ.prod μ) := by
    simpa only [Real.norm_eq_abs] using hp.integrable_norm_pow'
  have hc : Integrable (fun z : ℝ × ℝ => Real.cos (t * (z.1 - z.2))) (μ.prod μ) := by
    apply Integrable.mono' (integrable_const (1 : ℝ)) (by fun_prop)
    filter_upwards [] with z
    exact Real.abs_cos_le_one _
  let g (z : ℝ × ℝ) := 1 - (a * t ^ 2) * (z.1 - z.2) ^ 2 +
    (κ * |t| ^ 3) * |z.1 - z.2| ^ 3
  have hg : Integrable g (μ.prod μ) :=
    ((integrable_const 1).sub (h2.const_mul (a * t ^ 2))).add (h3.const_mul (κ * |t| ^ 3))
  have hmajor : ∀ z : ℝ × ℝ, Real.cos (t * (z.1 - z.2)) ≤ g z := by
    intro z
    convert hcos (t * (z.1 - z.2)) using 1
    dsimp [g]
    rw [abs_mul, mul_pow, mul_pow]
    ring
  rw [norm_charFun_sq_eq_integral_cos_sub]
  refine (integral_mono hc hg hmajor).trans ?_
  have hig : (∫ z, g z ∂μ.prod μ) =
      1 - 2 * a * (∫ x, x ^ 2 ∂μ) * t ^ 2 +
        (κ * |t| ^ 3) * ∫ z : ℝ × ℝ, |z.1 - z.2| ^ 3 ∂μ.prod μ := by
    dsimp [g]
    erw [integral_add ((integrable_const 1).sub (h2.const_mul (a * t ^ 2)))
      (h3.const_mul (κ * |t| ^ 3)),
      integral_sub (integrable_const 1) (h2.const_mul (a * t ^ 2)), integral_const_mul,
      integral_const_mul, integral_symmetrized_sq μ (hm.mono_exponent (by norm_num)) hmean]
    simp only [integral_const, probReal_univ, smul_eq_mul, one_mul]
    ring
  rw [hig]
  have h := mul_le_mul_of_nonneg_left (integral_symmetrized_abs_cube_le μ hm hmean)
    (mul_nonneg hκ (by positivity : 0 ≤ |t| ^ 3))
  nlinarith

/-- The exponential characteristic-function envelope obtained from a cubic
cosine majorant. -/
theorem norm_charFun_le_exp_of_quadratic_cubic_majorant (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : ∫ x, x ∂μ = 0) {a κ : ℝ} (hκ : 0 ≤ κ)
    (hcos : ∀ x : ℝ, Real.cos x ≤ 1 - a * x ^ 2 + κ * |x| ^ 3) (t : ℝ) :
    ‖charFun μ t‖ ≤ Real.exp (-a * (∫ x, x ^ 2 ∂μ) * t ^ 2 +
      κ * ((∫ x, |x| ^ 3 ∂μ) + (∫ x, x ^ 2 ∂μ) * ∫ x, |x| ∂μ) * |t| ^ 3) := by
  let b := -a * (∫ x, x ^ 2 ∂μ) * t ^ 2 +
    κ * ((∫ x, |x| ^ 3 ∂μ) + (∫ x, x ^ 2 ∂μ) * ∫ x, |x| ∂μ) * |t| ^ 3
  have h := norm_charFun_sq_le_of_quadratic_cubic_majorant μ hm hmean hκ hcos t
  have hsq : ‖charFun μ t‖ ^ 2 ≤ Real.exp b ^ 2 := by
    have he := Real.add_one_le_exp (2 * b)
    rw [show 2 * b = b + b by ring, Real.exp_add] at he
    dsimp [b] at he ⊢
    nlinarith
  exact (sq_le_sq₀ (norm_nonneg _) (Real.exp_pos _).le).mp hsq

/-- A quadratic-cubic cosine majorant gives a product characteristic-function envelope.
Different valid majorants can be selected at different frequencies. -/
theorem norm_charFun_product_sum_le_of_quadratic_cubic_majorant
    {ι : Type*} [Fintype ι] (μ : ι → Measure ℝ)
    [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, ∫ x, x ∂μ i = 0)
    {a κ : ℝ} (hκ : 0 ≤ κ)
    (hcos : ∀ x : ℝ, Real.cos x ≤ 1 - a * x ^ 2 + κ * |x| ^ 3) (t : ℝ) :
    ‖charFun ((Measure.pi μ).map (fun z => ∑ i, z i)) t‖ ≤
      Real.exp (-a * (∑ i, ∫ x, x ^ 2 ∂μ i) * t ^ 2 +
        2 * κ * (∑ i, ∫ x, |x| ^ 3 ∂μ i) * |t| ^ 3) := by
  have hsingle (i : ι) : ‖charFun (μ i) t‖ ≤
      Real.exp (-a * (∫ x, x ^ 2 ∂μ i) * t ^ 2 +
        2 * κ * (∫ x, |x| ^ 3 ∂μ i) * |t| ^ 3) := by
    refine (norm_charFun_le_exp_of_quadratic_cubic_majorant (μ i) (hm i)
      (hmean i) hκ hcos t).trans (Real.exp_le_exp.mpr ?_)
    have h := secondMoment_mul_firstMoment_le_thirdMoment (μ i) (hm i)
    have hp := mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_right h (by positivity : 0 ≤ |t| ^ 3)) hκ
    nlinarith
  rw [charFun_map_sum_pi_eq_prod]
  simp only [Finset.prod_apply, norm_prod]
  calc
    _ ≤ ∏ i, Real.exp (-a * (∫ x, x ^ 2 ∂μ i) * t ^ 2 +
        2 * κ * (∫ x, |x| ^ 3 ∂μ i) * |t| ^ 3) :=
      Finset.prod_le_prod (fun _ _ => norm_nonneg _) (fun i _ => hsingle i)
    _ = _ := by
      rw [← Real.exp_sum]
      congr 1
      rw [Finset.sum_add_distrib, ← Finset.sum_mul, ← Finset.mul_sum,
        ← Finset.sum_mul, ← Finset.mul_sum]

/-- Integrating the normal characteristic-function differential equation gives an exact
representation of the error in terms of its differential residual. -/
theorem normal_comparison_integrating_factor {f : ℝ → ℂ}
    (hf : ContDiff ℝ 1 f) (hzero : f 0 = 1) (t : ℝ) :
    f t - (Real.exp (-t ^ 2 / 2) : ℂ) =
      (Real.exp (-t ^ 2 / 2) : ℂ) *
        ∫ u in (0 : ℝ)..t, (Real.exp (u ^ 2 / 2) : ℂ) * (deriv f u + u * f u) := by
  have hd (u : ℝ) : HasDerivAt
      (fun x : ℝ => (Real.exp (x ^ 2 / 2) : ℂ) * f x)
      ((Real.exp (u ^ 2 / 2) : ℂ) * (deriv f u + u * f u)) u := by
    have he := ((((hasDerivAt_id u).pow 2).div_const 2).exp).ofReal_comp
    have hh := he.mul ((hf.differentiable (by norm_num)).differentiableAt.hasDerivAt)
    dsimp at hh
    exact hh.congr_deriv (by push_cast; ring)
  have hc : Continuous (fun u : ℝ =>
      (Real.exp (u ^ 2 / 2) : ℂ) * (deriv f u + u * f u)) := by
    have hdf : Continuous (deriv f) := hf.continuous_deriv (by norm_num)
    fun_prop
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun u _ => hd u)
    (hc.intervalIntegrable 0 t)]
  simp only [zero_pow, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_div,
    Real.exp_zero, Complex.ofReal_one, hzero, one_mul]
  have he : (Real.exp (-t ^ 2 / 2) : ℂ) * (Real.exp (t ^ 2 / 2) : ℂ) = 1 := by
    rw [← Complex.ofReal_mul, ← Real.exp_add,
      show -t ^ 2 / 2 + t ^ 2 / 2 = 0 by ring, Real.exp_zero, Complex.ofReal_one]
  calc
    _ = ((Real.exp (-t ^ 2 / 2) : ℂ) * (Real.exp (t ^ 2 / 2) : ℂ)) * f t -
        (Real.exp (-t ^ 2 / 2) : ℂ) := by rw [he, one_mul]
    _ = _ := by ring

/-- The integral residual bound for comparison with the normal characteristic function. -/
theorem norm_normal_comparison_le_integral_residual {f : ℝ → ℂ}
    (hf : ContDiff ℝ 1 f) (hzero : f 0 = 1) {t : ℝ} (ht : 0 ≤ t) :
    ‖f t - (Real.exp (-t ^ 2 / 2) : ℂ)‖ ≤ Real.exp (-t ^ 2 / 2) *
      ∫ u in (0 : ℝ)..t, Real.exp (u ^ 2 / 2) * ‖deriv f u + u * f u‖ := by
  rw [normal_comparison_integrating_factor hf hzero, norm_mul]
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
  apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
  have h := intervalIntegral.norm_integral_le_integral_norm (μ := volume) ht
    (f := fun u : ℝ => (Real.exp (u ^ 2 / 2) : ℂ) * (deriv f u + u * f u))
  simpa only [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (Real.exp_pos _)] using h

/-- The actual characteristic function satisfies the integral differential-residual estimate
whenever its first absolute moment is finite. -/
theorem charFun_normal_error_le_integral_residual (μ : Measure ℝ)
    [IsProbabilityMeasure μ] (hm : MemLp id 1 μ) {t : ℝ} (ht : 0 ≤ t) :
    ‖charFun μ t - (Real.exp (-t ^ 2 / 2) : ℂ)‖ ≤ Real.exp (-t ^ 2 / 2) *
      ∫ u in (0 : ℝ)..t, Real.exp (u ^ 2 / 2) *
        ‖deriv (charFun μ) u + u * charFun μ u‖ :=
  norm_normal_comparison_le_integral_residual (contDiff_charFun (n := 1) (by simpa using hm)) (by simp) ht


/-- Weight a real law by its squared coordinate and normalize by its second moment. -/
def squareBiasMeasure (μ : Measure ℝ) : Measure ℝ :=
  μ.withDensity (fun x => ENNReal.ofReal (x ^ 2 / (∫ y, y ^ 2 ∂μ)))

/-- The zero-bias law is obtained by scaling the square-biased coordinate by an independent
uniform variable on the unit interval. Its zero-bias identity requires a centered input law. -/
def zeroBiasMeasure (μ : Measure ℝ) : Measure ℝ :=
  ((squareBiasMeasure μ).prod (volume.restrict (Icc (0 : ℝ) 1))).map
    (fun z : ℝ × ℝ => z.2 * z.1)

theorem isProbabilityMeasure_squareBiasMeasure (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) (hv : 0 < ∫ x, x ^ 2 ∂μ) :
    IsProbabilityMeasure (squareBiasMeasure μ) := by
  constructor
  have h2 : Integrable (fun x : ℝ => x ^ 2) μ := hm.integrable_sq
  rw [squareBiasMeasure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
    ← ofReal_integral_eq_lintegral_ofReal (h2.div_const _)
      (Filter.Eventually.of_forall (fun x => div_nonneg (sq_nonneg x) hv.le)),
    integral_div]
  simp [hv.ne']

private theorem unitInterval_restrict_probability :
    IsProbabilityMeasure (volume.restrict (Icc (0 : ℝ) 1)) := by
  constructor
  simp

theorem isProbabilityMeasure_zeroBiasMeasure (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) (hv : 0 < ∫ x, x ^ 2 ∂μ) :
    IsProbabilityMeasure (zeroBiasMeasure μ) := by
  let := isProbabilityMeasure_squareBiasMeasure μ hm hv
  let := unitInterval_restrict_probability
  unfold zeroBiasMeasure
  exact (Measure.isProbabilityMeasure_map_iff (by fun_prop)).2 inferInstance

/-- The characteristic function of the concrete zero-bias law. -/
theorem charFun_zeroBiasMeasure (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) (hv : 0 < ∫ x, x ^ 2 ∂μ) (t : ℝ) :
    charFun (zeroBiasMeasure μ) t =
      ((∫ x : ℝ, x ^ 2 ∂μ : ℝ) : ℂ)⁻¹ *
        ∫ x : ℝ, (x : ℂ) ^ 2 * (∫ u in (0 : ℝ)..1,
          Complex.exp ((t * (u * x) : ℝ) * Complex.I)) ∂μ := by
  let := isProbabilityMeasure_squareBiasMeasure μ hm hv
  let := unitInterval_restrict_probability
  have hi : Integrable (fun z : ℝ × ℝ =>
      Complex.exp ((t * (z.2 * z.1) : ℝ) * Complex.I))
      ((squareBiasMeasure μ).prod (volume.restrict (Icc (0 : ℝ) 1))) := by
    apply Integrable.mono' (integrable_const (1 : ℝ)) (by fun_prop)
    filter_upwards [] with z
    simp [Complex.norm_exp]
  rw [charFun_apply_real, zeroBiasMeasure, integral_map (by fun_prop) (by fun_prop),
    ]
  simp only [Complex.ofReal_mul] at hi ⊢
  rw [integral_prod _ hi, squareBiasMeasure,
    integral_withDensity_eq_integral_toReal_smul (by fun_prop)
      (Filter.Eventually.of_forall (fun _ => ENNReal.ofReal_lt_top))]
  simp only [ENNReal.toReal_ofReal (div_nonneg (sq_nonneg _) hv.le),
    Complex.real_smul, Complex.ofReal_div, Complex.ofReal_pow]
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with x
  rw [intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1), ← integral_Icc_eq_integral_Ioc]
  ring

private theorem mul_integral_cexp_unit (a : ℂ) :
    a * (∫ u in (0 : ℝ)..1, Complex.exp ((u : ℂ) * a)) = Complex.exp a - 1 := by
  have hd (u : ℝ) : HasDerivAt (fun v : ℝ => Complex.exp ((v : ℂ) * a))
      (a * Complex.exp ((u : ℂ) * a)) u := by
    convert (((hasDerivAt_id u).ofReal_comp.mul_const a).cexp) using 1 <;> simp; ring
  rw [← intervalIntegral.integral_const_mul]
  have h := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun u _ => hd u)
    (show IntervalIntegrable (fun u : ℝ => a * Complex.exp ((u : ℂ) * a)) volume 0 1 from
      (by fun_prop : Continuous (fun u : ℝ => a * Complex.exp ((u : ℂ) * a))).intervalIntegrable _ _)
  simpa only [Complex.ofReal_one, one_mul, Complex.ofReal_zero, zero_mul, Complex.exp_zero] using h

/-- The characteristic function of the zero-bias law supplies the exact differential equation
for a centered characteristic function, including frequency zero. -/
theorem deriv_charFun_eq_zeroBias (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) (hv : 0 < ∫ x, x ^ 2 ∂μ)
    (hmean : ∫ x, x ∂μ = 0) (t : ℝ) :
    deriv (charFun μ) t =
      -((∫ x : ℝ, x ^ 2 ∂μ : ℝ) : ℂ) * t * charFun (zeroBiasMeasure μ) t := by
  let v : ℝ := ∫ x, x ^ 2 ∂μ
  have hvC : (v : ℂ) ≠ 0 := by exact_mod_cast hv.ne'
  have h1 : Integrable (fun x : ℝ => x) μ := hm.integrable (by norm_num)
  have hi : Integrable (fun x : ℝ =>
      (x : ℂ) * Complex.exp ((t * x : ℝ) * Complex.I)) μ := by
    apply h1.norm.mono' (by fun_prop)
    filter_upwards [] with x
    simp [Complex.norm_exp]
  have hid (x : ℝ) : (t : ℂ) * (x : ℂ) ^ 2 *
      (∫ u in (0 : ℝ)..1, Complex.exp ((t * (u * x) : ℝ) * Complex.I)) =
      -Complex.I * ((x : ℂ) * (Complex.exp ((t * x : ℝ) * Complex.I) - 1)) := by
    have h := mul_integral_cexp_unit ((t * x : ℝ) * Complex.I)
    have heq : (fun u : ℝ => Complex.exp ((u : ℂ) * ((t * x : ℝ) * Complex.I))) =
        (fun u : ℝ => Complex.exp ((t * (u * x) : ℝ) * Complex.I)) := by
      ext u
      congr 1
      push_cast
      ring
    rw [heq] at h
    generalize hJ : (∫ u in (0 : ℝ)..1, Complex.exp ((t * (u * x) : ℝ) * Complex.I)) = J at h ⊢
    calc
      _ = (-Complex.I * (x : ℂ)) * (((t * x : ℝ) * Complex.I) * J) := by
        push_cast
        ring_nf
        simp [Complex.I_sq]
      _ = _ := by rw [h]; ring
  have hmain : (v : ℂ) * (t : ℂ) * charFun (zeroBiasMeasure μ) t =
      -Complex.I * ∫ x : ℝ, (x : ℂ) * Complex.exp ((t * x : ℝ) * Complex.I) ∂μ := by
    rw [charFun_zeroBiasMeasure μ hm hv]
    change (v : ℂ) * (t : ℂ) * ((v : ℂ)⁻¹ * _) = _
    have hcancel (J : ℂ) : (v : ℂ) * (t : ℂ) * ((v : ℂ)⁻¹ * J) = (t : ℂ) * J := by
      field_simp
    rw [hcancel]
    rw [← integral_const_mul]
    calc
      _ = ∫ x : ℝ, -Complex.I * ((x : ℂ) *
          (Complex.exp ((t * x : ℝ) * Complex.I) - 1)) ∂μ := by
        apply integral_congr_ae
        filter_upwards [] with x
        simpa only [mul_assoc] using hid x
      _ = -Complex.I * ((∫ x : ℝ, (x : ℂ) *
          Complex.exp ((t * x : ℝ) * Complex.I) ∂μ) - ∫ x : ℝ, (x : ℂ) ∂μ) := by
        rw [integral_const_mul]
        congr 1
        simp only [mul_sub, mul_one]
        erw [integral_sub hi h1.ofReal]
        rfl
      _ = _ := by rw [integral_complex_ofReal, hmean]; simp
  have hd := iteratedDeriv_charFun (n := 1) (t := t)
    (hm.mono_exponent (by norm_num))
  simp only [iteratedDeriv_one, pow_one] at hd
  rw [hd]
  change Complex.I * _ = -(v : ℂ) * (t : ℂ) * charFun (zeroBiasMeasure μ) t
  rw [show -(v : ℂ) * (t : ℂ) * charFun (zeroBiasMeasure μ) t =
      -((v : ℂ) * (t : ℂ) * charFun (zeroBiasMeasure μ) t) by ring, hmain]
  simp only [neg_mul, neg_neg, Complex.ofReal_mul]

/-- The normal error is bounded by the difference between the original and zero-bias
characteristic functions, with the Gaussian integrating factor. -/
theorem charFun_normal_error_le_zeroBias_integral (μ : Measure ℝ)
    [IsProbabilityMeasure μ] (hm : MemLp id 2 μ)
    (hvariance : (∫ x, x ^ 2 ∂μ) = 1) (hmean : ∫ x, x ∂μ = 0)
    {t : ℝ} (ht : 0 ≤ t) :
    ‖charFun μ t - (Real.exp (-t ^ 2 / 2) : ℂ)‖ ≤ Real.exp (-t ^ 2 / 2) *
      ∫ u in (0 : ℝ)..t, Real.exp (u ^ 2 / 2) * u *
        ‖charFun μ u - charFun (zeroBiasMeasure μ) u‖ := by
  refine (charFun_normal_error_le_integral_residual μ
    (hm.mono_exponent (by norm_num)) ht).trans_eq ?_
  congr 1
  apply intervalIntegral.integral_congr
  intro u hu
  rw [uIcc_of_le ht] at hu
  dsimp only
  rw [deriv_charFun_eq_zeroBias μ hm (by rw [hvariance]; norm_num) hmean u, hvariance]
  have heq : -(1 : ℂ) * (u : ℂ) * charFun (zeroBiasMeasure μ) u + u * charFun μ u =
      (u : ℂ) * (charFun μ u - charFun (zeroBiasMeasure μ) u) := by ring
  rw [Complex.ofReal_one, heq, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg hu.1]
  ring

/-- The increasing concave extension of sine beyond its first maximum. -/
def clippedSine (x : ℝ) : ℝ := Real.sin (min x (Real.pi / 2))

@[fun_prop] theorem continuous_clippedSine : Continuous clippedSine := by
  unfold clippedSine
  fun_prop

theorem concaveOn_clippedSine : ConcaveOn ℝ (Ici 0) clippedSine := by
  have hmin : ConcaveOn ℝ (Ici (0 : ℝ)) (fun x : ℝ => min x (Real.pi / 2)) :=
    (concaveOn_id (convex_Ici 0)).inf (concaveOn_const (Real.pi / 2) (convex_Ici 0))
  have himage : (fun x : ℝ => min x (Real.pi / 2)) '' Ici 0 = Icc 0 (Real.pi / 2) := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact ⟨le_min hx (by positivity), min_le_right _ _⟩
    · intro hy
      exact ⟨y, hy.1, min_eq_left hy.2⟩
  have hsin : ConcaveOn ℝ ((fun x : ℝ => min x (Real.pi / 2)) '' Ici 0) Real.sin := by
    rw [himage]
    exact strictConcaveOn_sin_Icc.concaveOn.subset
      (fun x hx => ⟨hx.1, hx.2.trans (by linarith [Real.pi_pos])⟩) (convex_Icc _ _)
  have hmono : MonotoneOn Real.sin ((fun x : ℝ => min x (Real.pi / 2)) '' Ici 0) := by
    rw [himage]
    exact Real.monotoneOn_sin.mono (fun x hx => ⟨by linarith [hx.1, Real.pi_pos], hx.2⟩)
  exact hsin.comp hmin hmono

theorem monotoneOn_clippedSine : MonotoneOn clippedSine (Ici 0) := by
  intro x hx y hy hxy
  apply Real.monotoneOn_sin
  · exact ⟨by have := le_min hx (by positivity : (0 : ℝ) ≤ Real.pi / 2); linarith [Real.pi_pos],
      min_le_right _ _⟩
  · exact ⟨by have := le_min hy (by positivity : (0 : ℝ) ≤ Real.pi / 2); linarith [Real.pi_pos],
      min_le_right _ _⟩
  · exact min_le_min hxy le_rfl

private theorem abs_sin_le_clippedSine_abs (x : ℝ) : |Real.sin x| ≤ clippedSine |x| := by
  by_cases hx : |x| ≤ Real.pi / 2
  · rw [clippedSine, min_eq_left hx,
      Real.abs_sin_eq_sin_abs_of_abs_le_pi (hx.trans (by linarith [Real.pi_pos]))]
  · rw [clippedSine, min_eq_right (le_of_not_ge hx), Real.sin_pi_div_two]
    exact Real.abs_sin_le_one _

/-- The chord distance of two phases is controlled by the concave clipped sine. -/
theorem norm_cexp_sub_le_clippedSine (s t : ℝ) :
    ‖Complex.exp ((s : ℂ) * Complex.I) - Complex.exp ((t : ℂ) * Complex.I)‖ ≤
      2 * clippedSine (|s - t| / 2) := by
  have heq : Complex.exp ((s : ℂ) * Complex.I) - Complex.exp ((t : ℂ) * Complex.I) =
      Complex.exp ((t : ℂ) * Complex.I) *
        (Complex.exp (Complex.I * (s - t : ℝ)) - 1) := by
    rw [mul_sub, mul_one, ← Complex.exp_add]
    congr 2
    push_cast
    ring
  rw [heq, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul,
    Complex.norm_exp_I_mul_ofReal_sub_one, Real.norm_eq_abs, abs_mul]
  norm_num only [abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
  have h := abs_sin_le_clippedSine_abs ((s - t) / 2)
  simpa only [abs_div, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)] using mul_le_mul_of_nonneg_left h (by norm_num : (0 : ℝ) ≤ 2)

/-- An integrable coupling gives the sine refinement of the linear characteristic-function
comparison. -/
theorem norm_charFun_sub_le_clippedSine_coupling {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (X Y : Ω → ℝ)
    (hX : Measurable X) (hY : Measurable Y)
    (hXY : Integrable (fun w => |X w - Y w|) P) (t : ℝ) :
    ‖charFun (P.map X) t - charFun (P.map Y) t‖ ≤
      2 * clippedSine (|t| * (∫ w, |X w - Y w| ∂P) / 2) := by
  let f (w : Ω) : ℝ := |t| * |X w - Y w| / 2
  have hfi : Integrable f P := (hXY.const_mul |t|).div_const 2
  have hq : Integrable (clippedSine ∘ f) P := by
    apply Integrable.mono' (integrable_const (1 : ℝ)) (by unfold f; fun_prop)
    filter_upwards [] with w
    exact Real.abs_sin_le_one _
  have hj := concaveOn_clippedSine.le_map_integral continuous_clippedSine.continuousOn
    isClosed_Ici (Filter.Eventually.of_forall (fun w => by change 0 ≤ f w; unfold f; positivity)) hfi hq
  have hx : Integrable (fun w => Complex.exp ((t * X w : ℝ) * Complex.I)) P := by
    apply Integrable.mono' (integrable_const (1 : ℝ)) (by fun_prop)
    filter_upwards [] with w
    simp [Complex.norm_exp]
  have hy : Integrable (fun w => Complex.exp ((t * Y w : ℝ) * Complex.I)) P := by
    apply Integrable.mono' (integrable_const (1 : ℝ)) (by fun_prop)
    filter_upwards [] with w
    simp [Complex.norm_exp]
  have hbound (w : Ω) :
      ‖Complex.exp ((t * X w : ℝ) * Complex.I) - Complex.exp ((t * Y w : ℝ) * Complex.I)‖ ≤
        2 * clippedSine (f w) := by
    have h := norm_cexp_sub_le_clippedSine (t * X w) (t * Y w)
    simpa only [← mul_sub, abs_mul] using h
  rw [charFun_apply_real, charFun_apply_real,
    integral_map hX.aemeasurable (by fun_prop), integral_map hY.aemeasurable (by fun_prop)]
  simp only [← Complex.ofReal_mul]
  rw [← integral_sub hx hy]
  calc
    _ ≤ ∫ w, 2 * clippedSine (f w) ∂P := norm_integral_le_of_norm_le (hq.const_mul 2)
      (Filter.Eventually.of_forall hbound)
    _ = 2 * ∫ w, clippedSine (f w) ∂P := integral_const_mul _ _
    _ ≤ 2 * clippedSine (∫ w, f w ∂P) := mul_le_mul_of_nonneg_left hj (by norm_num)
    _ = _ := by
      have hfint : (∫ w, f w ∂P) = |t| * (∫ w, |X w - Y w| ∂P) / 2 := by
        dsimp [f]
        rw [integral_div, integral_const_mul]
      rw [hfint]

private theorem integral_affine (A d l r : ℝ) :
    (∫ u in l..r, A * u - d) = A * (r ^ 2 - l ^ 2) / 2 - d * (r - l) := by
  rw [intervalIntegral.integral_sub
    ((by fun_prop : Continuous (fun u : ℝ => A * u)).intervalIntegrable _ _)
    (intervalIntegrable_const),
    intervalIntegral.integral_const_mul, integral_id, intervalIntegral.integral_const]
  ring

private theorem integral_abs_affine_before_root {A d p : ℝ}
    (hA : 0 ≤ A) (hp : 0 ≤ p) (hroot : A * p ≤ d) :
    (∫ u in (0 : ℝ)..p, |A * u - d|) = d * p - A * p ^ 2 / 2 := by
  have heq : (∫ u in (0 : ℝ)..p, |A * u - d|) =
      -(∫ u in (0 : ℝ)..p, A * u - d) := by
    rw [← intervalIntegral.integral_neg]
    apply intervalIntegral.integral_congr
    intro u hu
    rw [uIcc_of_le hp] at hu
    exact abs_of_nonpos (by nlinarith [mul_le_mul_of_nonneg_left hu.2 hA])
  rw [heq, integral_affine]
  ring

private theorem integral_abs_affine_across_root {A d p : ℝ}
    (hA : 0 < A) (hd : 0 ≤ d) (hroot : d ≤ A * p) :
    (∫ u in (0 : ℝ)..p, |A * u - d|) =
      A * p ^ 2 / 2 - d * p + d ^ 2 / A := by
  have hr0 : 0 ≤ d / A := div_nonneg hd hA.le
  have hrp : d / A ≤ p := (div_le_iff₀ hA).mpr (by linarith)
  have hf : Continuous (fun u : ℝ => |A * u - d|) := by fun_prop
  rw [← intervalIntegral.integral_add_adjacent_intervals
    (hf.intervalIntegrable 0 (d / A)) (hf.intervalIntegrable (d / A) p)]
  rw [integral_abs_affine_before_root hA.le hr0 (by field_simp; rfl)]
  have heq : (∫ u in d / A..p, |A * u - d|) =
      ∫ u in d / A..p, A * u - d := by
    apply intervalIntegral.integral_congr
    intro u hu
    rw [uIcc_of_le hrp] at hu
    exact abs_of_nonneg (by
      have h := (div_le_iff₀ hA).mp hu.1
      nlinarith)
  rw [heq, integral_affine]
  field_simp
  ring

/-- A monotone coupling of a uniform law on `[-a,c]` to the centered two-point law on
`{-b,c}` costs no more than coupling it to the endpoints `{-a,c}`. -/
theorem uniform_binary_transport_cost_le {a b c : ℝ}
    (hb : 0 ≤ b) (hba : b ≤ a) (hc : 0 < c) :
    (∫ u in (0 : ℝ)..(c / (b + c)), |(a + c) * u - (a - b)|) +
      (∫ u in (c / (b + c))..1, (a + c) * (1 - u)) ≤
        (a ^ 2 + c ^ 2) / (2 * (a + c)) := by
  let A := a + c
  let B := b + c
  let p := c / B
  let d := a - b
  have hA : 0 < A := by dsimp [A]; linarith
  have hB : 0 < B := by dsimp [B]; linarith
  have hA0 : a + c ≠ 0 := hA.ne'
  have hB0 : b + c ≠ 0 := hB.ne'
  have hd : 0 ≤ d := sub_nonneg.mpr hba
  have hp : 0 ≤ p := div_nonneg hc.le hB.le
  have hsecond : (∫ u in p..1, A * (1 - u)) = A / 2 - A * p + A * p ^ 2 / 2 := by
    have heq : (fun u : ℝ => A * (1 - u)) = (fun u => (-A) * u - (-A)) := by
      ext u; ring
    rw [heq, integral_affine]
    ring
  change (∫ u in (0 : ℝ)..p, |A * u - d|) + (∫ u in p..1, A * (1 - u)) ≤ _
  rw [hsecond]
  by_cases hr : d ≤ A * p
  · rw [integral_abs_affine_across_root hA hd hr]
    have hid : (A * p - d) * B = c * B - b * d := by
      dsimp [A, B, p, d]
      field_simp [hA0, hB0]
      ring
    have hrel : b * d ≤ c * B := by
      have h := mul_nonneg (sub_nonneg.mpr hr) hB.le
      rw [hid] at h
      linarith
    have hgap : (a ^ 2 + c ^ 2) / (2 * (a + c)) -
        (A * p ^ 2 / 2 - d * p + d ^ 2 / A + (A / 2 - A * p + A * p ^ 2 / 2)) =
        b * d * (2 * c * B - b * d) / (A * B ^ 2) := by
      dsimp [A, B, p, d]
      field_simp [hA0, hB0]
      ring
    have hn : 0 ≤ b * d * (2 * c * B - b * d) / (A * B ^ 2) := by
      apply div_nonneg
      · exact mul_nonneg (mul_nonneg hb hd) (by nlinarith [mul_nonneg hc.le hB.le])
      · positivity
    linarith
  · rw [integral_abs_affine_before_root hA.le hp (le_of_not_ge hr)]
    have hgap : (a ^ 2 + c ^ 2) / (2 * (a + c)) -
        (d * p - A * p ^ 2 / 2 + (A / 2 - A * p + A * p ^ 2 / 2)) =
        c ^ 2 / A := by
      dsimp [A, B, p, d]
      field_simp [hA0, hB0]
      ring
    have hn : 0 ≤ c ^ 2 / A := div_nonneg (sq_nonneg _) hA.le
    linarith

private theorem integral_unit_piecewise {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] {f g : ℝ → E} (hf : Continuous f) (hg : Continuous g)
    {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1) :
    (∫ u in (0 : ℝ)..1, if u ≤ p then f u else g u) =
      (∫ u in (0 : ℝ)..p, f u) + ∫ u in p..1, g u := by
  classical
  have hi (l r : ℝ) : IntervalIntegrable (fun u => if u ≤ p then f u else g u) volume l r := by
    apply (intervalIntegrable_iff').2
    exact Integrable.piecewise measurableSet_Iic
      (hf.continuousOn.integrableOn_compact isCompact_uIcc).integrableOn
      (hg.continuousOn.integrableOn_compact isCompact_uIcc).integrableOn
  rw [← intervalIntegral.integral_add_adjacent_intervals (hi 0 p) (hi p 1)]
  congr 1
  · apply intervalIntegral.integral_congr_Ioo_of_le hp0
    intro u hu
    simp [hu.2.le]
  · apply intervalIntegral.integral_congr_Ioo_of_le hp1
    intro u hu
    simp [not_le.mpr hu.1]

/-- A unit-uniform coordinate realizes the centered binary law on `{-b,c}`. -/
def uniformBinaryValue (b c u : ℝ) : ℝ := if u ≤ c / (b + c) then -b else c

@[fun_prop] theorem measurable_uniformBinaryValue (b c : ℝ) :
    Measurable (uniformBinaryValue b c) := by
  unfold uniformBinaryValue
  exact Measurable.ite measurableSet_Iic measurable_const measurable_const

/-- Integrating a test against the binary coordinate gives its two explicit weights. -/
theorem integral_uniformBinaryValue_test {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (h : ℝ → E) {b c : ℝ} (hb : 0 ≤ b) (hc : 0 < c) :
    (∫ u in (0 : ℝ)..1, h (uniformBinaryValue b c u)) =
      (c / (b + c)) • h (-b) + (1 - c / (b + c)) • h c := by
  have hB : 0 < b + c := by linarith
  have hp0 : 0 ≤ c / (b + c) := div_nonneg hc.le hB.le
  have hp1 : c / (b + c) ≤ 1 := (div_le_one hB).mpr (by linarith)
  have heq : (fun u => h (uniformBinaryValue b c u)) =
      (fun u => if u ≤ c / (b + c) then h (-b) else h c) := by
    ext u
    unfold uniformBinaryValue
    split_ifs <;> rfl
  rw [heq, integral_unit_piecewise continuous_const continuous_const hp0 hp1]
  simp only [intervalIntegral.integral_const, sub_zero]

/-- The explicit binary coordinate has mean zero. -/
theorem integral_uniformBinaryValue_mean {b c : ℝ} (hb : 0 ≤ b) (hc : 0 < c) :
    (∫ u in (0 : ℝ)..1, uniformBinaryValue b c u) = 0 := by
  have hB : b + c ≠ 0 := by linarith
  rw [integral_uniformBinaryValue_test (fun x => x) hb hc]
  simp only [smul_eq_mul]
  field_simp
  ring

/-- The explicit binary coordinate has variance `b*c`. -/
theorem integral_uniformBinaryValue_second {b c : ℝ} (hb : 0 ≤ b) (hc : 0 < c) :
    (∫ u in (0 : ℝ)..1, (uniformBinaryValue b c u) ^ 2) = b * c := by
  have hB : b + c ≠ 0 := by linarith
  rw [integral_uniformBinaryValue_test (fun x => x ^ 2) hb hc]
  simp only [smul_eq_mul]
  field_simp
  ring

/-- The third absolute moment of the explicit binary coordinate. -/
theorem integral_uniformBinaryValue_third {b c : ℝ} (hb : 0 ≤ b) (hc : 0 < c) :
    (∫ u in (0 : ℝ)..1, |uniformBinaryValue b c u| ^ 3) =
      b * c * (b ^ 2 + c ^ 2) / (b + c) := by
  have hB : b + c ≠ 0 := by linarith
  rw [integral_uniformBinaryValue_test (fun x => |x| ^ 3) hb hc]
  simp only [smul_eq_mul, abs_neg, abs_of_nonneg hb, abs_of_pos hc]
  field_simp
  ring

/-- The transport-cost bound applies to the actual pair of coordinates on the unit interval. -/
theorem integral_uniformBinaryValue_transport_le {a b c : ℝ}
    (hb : 0 ≤ b) (hba : b ≤ a) (hc : 0 < c) :
    (∫ u in (0 : ℝ)..1, |uniformBinaryValue b c u - ((a + c) * u - a)|) ≤
      (a ^ 2 + c ^ 2) / (2 * (a + c)) := by
  have hB : 0 < b + c := by linarith
  have hp0 : 0 ≤ c / (b + c) := div_nonneg hc.le hB.le
  have hp1 : c / (b + c) ≤ 1 := (div_le_one hB).mpr (by linarith)
  have heq : (fun u => |uniformBinaryValue b c u - ((a + c) * u - a)|) =
      (fun u => if u ≤ c / (b + c) then |(a + c) * u - (a - b)|
        else |(a + c) * (1 - u)|) := by
    ext u
    unfold uniformBinaryValue
    split_ifs
    · rw [← abs_neg]
      congr 1
      ring
    · congr 1
      ring
  rw [heq, integral_unit_piecewise (by fun_prop) (by fun_prop) hp0 hp1]
  have hsecond : (∫ u in (c / (b + c))..1, |(a + c) * (1 - u)|) =
      ∫ u in (c / (b + c))..1, (a + c) * (1 - u) := by
    apply intervalIntegral.integral_congr_Ioo_of_le hp1
    intro u hu
    exact abs_of_nonneg (mul_nonneg (by linarith) (by linarith [hu.2]))
  rw [hsecond]
  exact uniform_binary_transport_cost_le hb hba hc


open Filter
open scoped Topology

private theorem exists_three_moment_relation {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (v : ι → Fin 3 → ℝ) (hcard : 3 < s.card) :
    ∃ d : ι → ℝ, (∀ i ∉ s, d i = 0) ∧ (∑ i ∈ s, d i • v i) = 0 ∧
      ∃ i ∈ s, d i ≠ 0 := by
  have hdep : ¬LinearIndependent ℝ (fun i : s => v i) := by
    intro h
    have hc := h.fintype_card_le_finrank
    have : s.card ≤ 3 := by simpa using hc
    omega
  obtain ⟨g, hsum, i, hi⟩ := Fintype.not_linearIndependent_iff.mp hdep
  let d (j : ι) : ℝ := if h : j ∈ s then g ⟨j, h⟩ else 0
  have hdmem (j : s) : d j = g j := by simp [d, j.property]
  refine ⟨d, ?_, ?_, i, i.2, ?_⟩
  · intro j hj
    simp [d, hj]
  · rw [← Finset.sum_finset_coe]
    simpa only [hdmem] using! hsum
  · rw [hdmem]
    exact hi

private theorem exists_positive_boundary_step {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (w d : ι → ℝ) (hw : ∀ i ∈ s, 0 < w i)
    (hd : ∃ i ∈ s, 0 < d i) :
    ∃ (α : ℝ) (i : ι), 0 < α ∧ i ∈ s ∧ (w i - α * d i = 0) ∧
      ∀ j ∈ s, 0 ≤ w j - α * d j := by
  let p := s.filter (fun i => 0 < d i)
  have hp : p.Nonempty := by
    obtain ⟨i, hi, hd⟩ := hd
    exact ⟨i, Finset.mem_filter.mpr ⟨hi, hd⟩⟩
  obtain ⟨i, hi, hmin⟩ := p.exists_min_image (fun i => w i / d i) hp
  have his : i ∈ s := (Finset.mem_filter.mp hi).1
  have hid : 0 < d i := (Finset.mem_filter.mp hi).2
  refine ⟨w i / d i, i, div_pos (hw i his) hid, his, ?_, ?_⟩
  · field_simp
    ring
  · intro j hj
    by_cases hdj : 0 < d j
    · have h := hmin j (Finset.mem_filter.mpr ⟨hj, hdj⟩)
      have h' := (le_div_iff₀ hdj).mp h
      linarith
    · have h' : (w i / d i) * d j ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (div_nonneg (hw i his).le hid.le) (le_of_not_gt hdj)
      linarith [hw j hj]

private theorem exists_moment_preserving_split {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (w : ι → ℝ) (v : ι → Fin 3 → ℝ)
    (hv : ∀ i ∈ s, v i 0 = 1) (hw : ∀ i ∈ s, 0 < w i)
    (hcard : 3 < s.card) :
    ∃ (u z : ι → ℝ) (a b : ℝ) (i j : ι),
      0 < a ∧ 0 < b ∧ a + b = 1 ∧ i ∈ s ∧ j ∈ s ∧
      u i = 0 ∧ z j = 0 ∧
      (∀ k ∈ s, 0 ≤ u k ∧ 0 ≤ z k) ∧
      (∀ k ∉ s, u k = w k ∧ z k = w k) ∧
      (∑ k ∈ s, u k • v k) = ∑ k ∈ s, w k • v k ∧
      (∑ k ∈ s, z k • v k) = ∑ k ∈ s, w k • v k ∧
      w = a • u + b • z := by
  obtain ⟨d, hdout, hdv, k, hk, hdk⟩ := exists_three_moment_relation s v hcard
  have hsum : ∑ i ∈ s, d i = 0 := by
    have h := congrFun hdv 0
    have heq : (∑ i ∈ s, d i * v i 0) = ∑ i ∈ s, d i := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [hv i hi, mul_one]
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply, heq] using h
  have hdpos : ∃ i ∈ s, 0 < d i :=
    Finset.exists_pos_of_sum_zero_of_exists_nonzero d hsum ⟨k, hk, hdk⟩
  have hdneg : ∃ i ∈ s, 0 < -d i := by
    apply Finset.exists_pos_of_sum_zero_of_exists_nonzero (fun i => -d i)
    · rw [Finset.sum_neg_distrib, hsum, neg_zero]
    · exact ⟨k, hk, neg_ne_zero.mpr hdk⟩
  obtain ⟨α, i, hα, hi, hui, hu⟩ := exists_positive_boundary_step s w d hw hdpos
  obtain ⟨β, j, hβ, hj, hzj, hz⟩ := exists_positive_boundary_step s w (fun i => -d i) hw hdneg
  let u (k : ι) := w k - α * d k
  let z (k : ι) := w k + β * d k
  have hden : 0 < α + β := add_pos hα hβ
  refine ⟨u, z, β / (α + β), α / (α + β), i, j,
    div_pos hβ hden, div_pos hα hden, ?_, hi, hj, hui, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · field_simp
    ring
  · dsimp [z]
    simpa only [mul_neg, sub_neg_eq_add] using hzj
  · intro k hk
    exact ⟨hu k hk, by simpa only [mul_neg, sub_neg_eq_add] using hz k hk⟩
  · intro k hk
    simp [u, z, hdout k hk]
  · simp only [u, sub_smul, mul_smul, Finset.sum_sub_distrib, ← Finset.smul_sum,
      hdv, smul_zero, sub_zero]
  · simp only [z, add_smul, mul_smul, Finset.sum_add_distrib, ← Finset.smul_sum,
      hdv, smul_zero, add_zero]
  · ext k
    dsimp [u, z]
    field_simp
    ring

/-- A convex property of finitely supported moment-constrained weights is determined by
weights supported on at most three points. The constraints may encode mass, mean and variance. -/
theorem convex_weights_of_three_point {ι : Type*} [DecidableEq ι]
    (v : ι → Fin 3 → ℝ) (hv : ∀ i, v i 0 = 1) (m : Fin 3 → ℝ)
    (K : Set (ι → ℝ)) (hK : Convex ℝ K)
    (hbase : ∀ (s : Finset ι) (w : ι → ℝ), s.card ≤ 3 →
      (∀ i ∈ s, 0 ≤ w i) → (∀ i ∉ s, w i = 0) →
      (∑ i ∈ s, w i • v i) = m → w ∈ K)
    (s : Finset ι) (w : ι → ℝ) (hw : ∀ i ∈ s, 0 ≤ w i)
    (hout : ∀ i ∉ s, w i = 0) (hwm : (∑ i ∈ s, w i • v i) = m) : w ∈ K := by
  induction s using Finset.strongInductionOn generalizing w with | _ s ih =>
  by_cases hsmall : s.card ≤ 3
  · exact hbase s w hsmall hw hout hwm
  by_cases hz : ∃ i ∈ s, w i = 0
  · obtain ⟨i, hi, hwi⟩ := hz
    apply ih (s.erase i) (Finset.erase_ssubset hi) w
    · intro k hk
      exact hw k (Finset.mem_of_mem_erase hk)
    · intro k hk
      by_cases hki : k = i
      · simpa only [hki] using hwi
      · exact hout k (fun hks => hk (Finset.mem_erase.mpr ⟨hki, hks⟩))
    · calc
        _ = ∑ k ∈ s, w k • v k := Finset.sum_erase _ (by rw [hwi, zero_smul])
        _ = m := hwm
  have hwpos : ∀ i ∈ s, 0 < w i := by
    intro i hi
    exact (hw i hi).lt_of_ne' (fun heq => hz ⟨i, hi, heq⟩)
  obtain ⟨u, z, a, b, i, j, ha, hb, hab, hi, hj, hui, hzj, hunon, huout, hum, hzm, hsplit⟩ :=
    exists_moment_preserving_split s w v (fun i _ => hv i) hwpos (lt_of_not_ge hsmall)
  have huK : u ∈ K := by
    apply ih (s.erase i) (Finset.erase_ssubset hi) u
    · intro k hk
      exact (hunon k (Finset.mem_of_mem_erase hk)).1
    · intro k hk
      by_cases hki : k = i
      · simpa only [hki] using hui
      · have hks : k ∉ s := by
          exact fun hks => hk (Finset.mem_erase.mpr ⟨hki, hks⟩)
        rw [(huout k hks).1, hout k hks]
    · calc
        _ = ∑ k ∈ s, u k • v k := Finset.sum_erase _ (by rw [hui, zero_smul])
        _ = _ := hum
        _ = m := hwm
  have hzK : z ∈ K := by
    apply ih (s.erase j) (Finset.erase_ssubset hj) z
    · intro k hk
      exact (hunon k (Finset.mem_of_mem_erase hk)).2
    · intro k hk
      by_cases hkj : k = j
      · simpa only [hkj] using hzj
      · have hks : k ∉ s := by
          exact fun hks => hk (Finset.mem_erase.mpr ⟨hkj, hks⟩)
        rw [(huout k hks).2, hout k hks]
    · calc
        _ = ∑ k ∈ s, z k • v k := Finset.sum_erase _ (by rw [hzj, zero_smul])
        _ = _ := hzm
        _ = m := hwm
  rw [hsplit]
  exact hK huK hzK ha.le hb.le hab

private theorem norm_convex_combination_le_clippedSine {a b c d : ℝ} {z w : ℂ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1) (hc : 0 ≤ c) (hd : 0 ≤ d)
    (hz : ‖z‖ ≤ 2 * clippedSine c) (hw : ‖w‖ ≤ 2 * clippedSine d) :
    ‖(a : ℂ) * z + (b : ℂ) * w‖ ≤ 2 * clippedSine (a * c + b * d) := by
  have hj := concaveOn_clippedSine.2 hc hd ha hb hab
  simp only [smul_eq_mul] at hj
  calc
    _ ≤ ‖(a : ℂ) * z‖ + ‖(b : ℂ) * w‖ := norm_add_le _ _
    _ = a * ‖z‖ + b * ‖w‖ := by
      simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ha, abs_of_nonneg hb]
    _ ≤ a * (2 * clippedSine c) + b * (2 * clippedSine d) :=
      add_le_add (mul_le_mul_of_nonneg_left hz ha) (mul_le_mul_of_nonneg_left hw hb)
    _ ≤ _ := by linarith

/-- The Fourier sine bound is convex as a property of nonnegative finite weights. -/
theorem convex_weights_clippedSine_bound {ι : Type*} [Fintype ι]
    (z : ι → ℂ) (r : ι → ℝ) (hr : ∀ i, 0 ≤ r i) {t : ℝ} (ht : 0 ≤ t) :
    Convex ℝ {w : ι → ℝ | (∀ i, 0 ≤ w i) ∧
      ‖∑ i, (w i : ℂ) * z i‖ ≤ 2 * clippedSine (t * ∑ i, w i * r i)} := by
  intro u hu w hw a b ha hb hab
  refine ⟨fun i => ?_, ?_⟩
  · change 0 ≤ a * u i + b * w i
    exact add_nonneg (mul_nonneg ha (hu.1 i)) (mul_nonneg hb (hw.1 i))
  · have hmu : 0 ≤ t * ∑ i, u i * r i :=
      mul_nonneg ht (Finset.sum_nonneg (fun i _ => mul_nonneg (hu.1 i) (hr i)))
    have hmw : 0 ≤ t * ∑ i, w i * r i :=
      mul_nonneg ht (Finset.sum_nonneg (fun i _ => mul_nonneg (hw.1 i) (hr i)))
    have h := norm_convex_combination_le_clippedSine ha hb hab hmu hmw hu.2 hw.2
    have hz : (∑ i, (((a • u + b • w) i : ℝ) : ℂ) * z i) =
        (a : ℂ) * (∑ i, (u i : ℂ) * z i) + (b : ℂ) * (∑ i, (w i : ℂ) * z i) := by
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Complex.ofReal_add,
        Complex.ofReal_mul, add_mul, mul_assoc, Finset.sum_add_distrib, Finset.mul_sum]
    have hm : t * (∑ i, (a • u + b • w) i * r i) =
        a * (t * ∑ i, u i * r i) + b * (t * ∑ i, w i * r i) := by
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, add_mul,
        mul_assoc, Finset.sum_add_distrib, ← Finset.mul_sum]
      ring
    change ‖∑ i, (((a • u + b • w) i : ℝ) : ℂ) * z i‖ ≤
      2 * clippedSine (t * ∑ i, (a • u + b • w) i * r i)
    rw [hz, hm]
    exact h

/-- The test function whose expectation is the original minus zero-bias characteristic function
for a law with second moment one. -/
def zeroBiasFourierKernel (t x : ℝ) : ℂ :=
  Complex.exp ((t * x : ℝ) * Complex.I) - (x : ℂ) ^ 2 *
    (∫ u in (0 : ℝ)..1, Complex.exp ((t * (u * x) : ℝ) * Complex.I))

private theorem measurable_unit_cexp_integral (t : ℝ) :
    Measurable (fun x : ℝ => ∫ u in (0 : ℝ)..1,
      Complex.exp ((t * (u * x) : ℝ) * Complex.I)) := by
  have hf : StronglyMeasurable (fun z : ℝ × ℝ =>
      Complex.exp ((t * (z.2 * z.1) : ℝ) * Complex.I)) := by fun_prop
  simpa only [intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)] using
    (hf.integral_prod_right' (ν := volume.restrict (Ioc (0 : ℝ) 1))).measurable

private theorem norm_unit_cexp_integral_le (t x : ℝ) :
    ‖∫ u in (0 : ℝ)..1, Complex.exp ((t * (u * x) : ℝ) * Complex.I)‖ ≤ 1 := by
  have h := intervalIntegral.norm_integral_le_of_norm_le_const
    (a := 0) (b := 1) (C := 1)
    (f := fun u : ℝ => Complex.exp ((t * (u * x) : ℝ) * Complex.I))
    (fun u _ => by simp [Complex.norm_exp])
  simpa using h

@[fun_prop] theorem measurable_zeroBiasFourierKernel (t : ℝ) :
    Measurable (zeroBiasFourierKernel t) := by
  have hm := measurable_unit_cexp_integral t
  unfold zeroBiasFourierKernel
  fun_prop

/-- A quadratic envelope dominates the Fourier test used in the finite-support reduction. -/
theorem norm_zeroBiasFourierKernel_le (t x : ℝ) :
    ‖zeroBiasFourierKernel t x‖ ≤ 1 + x ^ 2 := by
  unfold zeroBiasFourierKernel
  calc
    _ ≤ ‖Complex.exp ((t * x : ℝ) * Complex.I)‖ +
        ‖(x : ℂ) ^ 2 * (∫ u in (0 : ℝ)..1,
          Complex.exp ((t * (u * x) : ℝ) * Complex.I))‖ := norm_sub_le _ _
    _ = 1 + x ^ 2 * ‖∫ u in (0 : ℝ)..1,
        Complex.exp ((t * (u * x) : ℝ) * Complex.I)‖ := by
      simp only [Complex.norm_exp_ofReal_mul_I, norm_mul, norm_pow, Complex.norm_real,
        Real.norm_eq_abs, sq_abs]
    _ ≤ _ := by
      have h := mul_le_mul_of_nonneg_left (norm_unit_cexp_integral_le t x) (sq_nonneg x)
      linarith

theorem integrable_zeroBiasFourierKernel (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) (t : ℝ) : Integrable (zeroBiasFourierKernel t) μ := by
  apply ((integrable_const (1 : ℝ)).add hm.integrable_sq).mono'
    (measurable_zeroBiasFourierKernel t).aestronglyMeasurable
  filter_upwards [] with x
  exact norm_zeroBiasFourierKernel_le t x

/-- The finite-support Fourier test is identified with the actual characteristic-function
comparison, with all integrability obligations discharged. -/
theorem charFun_sub_zeroBias_eq_integral (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) (hvariance : (∫ x, x ^ 2 ∂μ) = 1) (t : ℝ) :
    charFun μ t - charFun (zeroBiasMeasure μ) t = ∫ x, zeroBiasFourierKernel t x ∂μ := by
  have hinner := measurable_unit_cexp_integral t
  have hexp : Integrable (fun x : ℝ => Complex.exp ((t * x : ℝ) * Complex.I)) μ := by
    apply Integrable.mono' (integrable_const (1 : ℝ)) (by fun_prop)
    filter_upwards [] with x
    simp [Complex.norm_exp]
  have hweighted : Integrable (fun x : ℝ => (x : ℂ) ^ 2 *
      (∫ u in (0 : ℝ)..1, Complex.exp ((t * (u * x) : ℝ) * Complex.I))) μ := by
    apply hm.integrable_sq.mono' (by fun_prop)
    filter_upwards [] with x
    simp only [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs]
    exact mul_le_of_le_one_right (sq_nonneg x) (norm_unit_cexp_integral_le t x)
  rw [charFun_zeroBiasMeasure μ hm (by rw [hvariance]; norm_num) t,
    hvariance, Complex.ofReal_one, inv_one, one_mul, charFun_apply_real]
  simp only [← Complex.ofReal_mul]
  exact (integral_sub hexp hweighted).symm

/-- Characteristic function of the centered binary coordinate on a unit-uniform space. -/
def binaryFourierMean (t b c : ℝ) : ℂ :=
  ∫ u in (0 : ℝ)..1, Complex.exp ((t * uniformBinaryValue b c u : ℝ) * Complex.I)

/-- Characteristic function of the uniform coordinate on `[-a,c]`. -/
def uniformIntervalFourier (t a c : ℝ) : ℂ :=
  ∫ u in (0 : ℝ)..1, Complex.exp ((t * ((a + c) * u - a) : ℝ) * Complex.I)

private theorem integral_unit_split_zero {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (f : ℝ → E) (hf : Continuous f) (a c : ℝ) :
    a • (∫ u in (0 : ℝ)..1, f (u * (-a))) +
      c • (∫ u in (0 : ℝ)..1, f (u * c)) =
      (a + c) • (∫ u in (0 : ℝ)..1, f ((a + c) * u - a)) := by
  have hleft : a • (∫ u in (0 : ℝ)..1, f (u * (-a))) = ∫ x in -a..0, f x := by
    have h := intervalIntegral.smul_integral_comp_mul_right f (a := 0) (b := 1) (-a)
    rw [intervalIntegral.integral_symm (a := 0) (b := -a)]
    simpa only [neg_smul, neg_neg, zero_mul, one_mul] using congrArg Neg.neg h
  rw [hleft, intervalIntegral.smul_integral_comp_mul_right,
    intervalIntegral.smul_integral_comp_mul_sub]
  simp only [zero_mul, one_mul, mul_zero, mul_one, zero_sub, add_sub_cancel_left]
  exact intervalIntegral.integral_add_adjacent_intervals
    (hf.intervalIntegrable (-a) 0) (hf.intervalIntegrable 0 c)

/-- The square-weighted binary Fourier average is the variance times the uniform
characteristic function. This identity also holds when the lower endpoint is zero. -/
theorem integral_binary_square_fourier {b c : ℝ} (hb : 0 ≤ b) (hc : 0 < c) (t : ℝ) :
    (∫ u in (0 : ℝ)..1, (uniformBinaryValue b c u : ℂ) ^ 2 *
      (∫ r in (0 : ℝ)..1,
        Complex.exp ((t * (r * uniformBinaryValue b c u) : ℝ) * Complex.I))) =
      ((b * c : ℝ) : ℂ) * uniformIntervalFourier t b c := by
  have hB : b + c ≠ 0 := by linarith
  have hBC : (b : ℂ) + (c : ℂ) ≠ 0 := by exact_mod_cast hB
  rw [integral_uniformBinaryValue_test
    (fun x : ℝ => (x : ℂ) ^ 2 * (∫ r in (0 : ℝ)..1,
      Complex.exp ((t * (r * x) : ℝ) * Complex.I))) hb hc]
  have h := integral_unit_split_zero
    (fun x : ℝ => Complex.exp ((t * x : ℝ) * Complex.I)) (by fun_prop) b c
  simp only [Complex.real_smul] at h ⊢
  change (b : ℂ) * _ + (c : ℂ) * _ = ((b + c : ℝ) : ℂ) * uniformIntervalFourier t b c at h
  generalize hL : (∫ r in (0 : ℝ)..1,
    Complex.exp ((t * (r * (-b)) : ℝ) * Complex.I)) = L at h ⊢
  generalize hR : (∫ r in (0 : ℝ)..1,
    Complex.exp ((t * (r * c) : ℝ) * Complex.I)) = R at h ⊢
  generalize hU : uniformIntervalFourier t b c = U at h ⊢
  push_cast at h ⊢
  have heq : (c : ℂ) / (b + c) * ((-b : ℂ) ^ 2 * L) +
      (1 - (c : ℂ) / (b + c)) * ((c : ℂ) ^ 2 * R) =
      ((b : ℂ) * c / (b + c)) * ((b : ℂ) * L + (c : ℂ) * R) := by
    field_simp [hBC]
    ring
  rw [heq, h]
  field_simp [hBC]

private theorem integrable_uniformBinaryValue (P : Measure ℝ) [IsFiniteMeasure P] (b c : ℝ) :
    Integrable (uniformBinaryValue b c) P := by
  apply Integrable.mono' (integrable_const (|b| + |c|))
    (measurable_uniformBinaryValue b c).aestronglyMeasurable
  filter_upwards [] with u
  unfold uniformBinaryValue
  split_ifs
  · simpa only [Real.norm_eq_abs, abs_neg] using le_add_of_nonneg_right (abs_nonneg c)
  · simpa only [Real.norm_eq_abs] using le_add_of_nonneg_left (abs_nonneg b)

/-- The explicit monotone coupling gives the sharp sine bound between a binary law and
any enclosing uniform interval that shares its positive endpoint. -/
theorem norm_binaryFourier_sub_uniform_le {a b c : ℝ}
    (hb : 0 ≤ b) (hba : b ≤ a) (hc : 0 < c) (t : ℝ) :
    ‖binaryFourierMean t b c - uniformIntervalFourier t a c‖ ≤
      2 * clippedSine (|t| * ((a ^ 2 + c ^ 2) / (2 * (a + c))) / 2) := by
  let P : Measure ℝ := volume.restrict (Icc (0 : ℝ) 1)
  let : IsProbabilityMeasure P := ⟨by simp [P]⟩
  have hY : Integrable (fun u : ℝ => (a + c) * u - a) P :=
    (by fun_prop : Continuous (fun u : ℝ => (a + c) * u - a)).continuousOn.integrableOn_Icc
  have hXY : Integrable (fun u : ℝ =>
      |uniformBinaryValue b c u - ((a + c) * u - a)|) P :=
    ((integrable_uniformBinaryValue P b c).sub hY).abs
  have h := norm_charFun_sub_le_clippedSine_coupling P (uniformBinaryValue b c)
    (fun u => (a + c) * u - a) (measurable_uniformBinaryValue b c) (by fun_prop) hXY t
  rw [charFun_apply_real, charFun_apply_real,
    integral_map (measurable_uniformBinaryValue b c).aemeasurable (by fun_prop),
    integral_map (by fun_prop) (by fun_prop)] at h
  simp only [P, ← Complex.ofReal_mul, integral_Icc_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)] at h
  change ‖binaryFourierMean t b c - uniformIntervalFourier t a c‖ ≤
    2 * clippedSine (|t| * (∫ u in (0 : ℝ)..1,
      |uniformBinaryValue b c u - ((a + c) * u - a)|) / 2) at h
  refine h.trans (mul_le_mul_of_nonneg_left (monotoneOn_clippedSine ?_ ?_ ?_) (by norm_num))
  · change 0 ≤ |t| * (∫ u in (0 : ℝ)..1,
      |uniformBinaryValue b c u - ((a + c) * u - a)|) / 2
    exact div_nonneg (mul_nonneg (abs_nonneg _) (intervalIntegral.integral_nonneg
      (by norm_num) (fun u _ => abs_nonneg _))) (by norm_num)
  · change 0 ≤ |t| * ((a ^ 2 + c ^ 2) / (2 * (a + c))) / 2
    have ha : 0 ≤ a := hb.trans hba
    positivity
  · exact div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_left (integral_uniformBinaryValue_transport_le hb hba hc)
        (abs_nonneg _)) (by norm_num)

/-- Jensen's inequality combines finite Fourier errors without losing the sine refinement. -/
theorem norm_sum_le_clippedSine {ι : Type*} [Fintype ι]
    (w r : ι → ℝ) (z : ι → ℂ) (hw : ∀ i, 0 ≤ w i)
    (hsum : ∑ i, w i = 1) (hr : ∀ i, 0 ≤ r i)
    (hz : ∀ i, ‖z i‖ ≤ 2 * clippedSine (r i)) :
    ‖∑ i, (w i : ℂ) * z i‖ ≤ 2 * clippedSine (∑ i, w i * r i) := by
  have hj := concaveOn_clippedSine.le_map_sum (t := Finset.univ)
    (w := w) (p := r) (fun i _ => hw i) hsum (fun i _ => hr i)
  simp only [smul_eq_mul] at hj
  calc
    _ ≤ ∑ i, ‖(w i : ℂ) * z i‖ := norm_sum_le _ _
    _ = ∑ i, w i * ‖z i‖ := by
      apply Finset.sum_congr rfl
      intro i _
      simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hw i)]
    _ ≤ ∑ i, w i * (2 * clippedSine (r i)) :=
      Finset.sum_le_sum (fun i _ => mul_le_mul_of_nonneg_left (hz i) (hw i))
    _ = 2 * ∑ i, w i * clippedSine (r i) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hj (by norm_num)

/-- The normalized zero-bias Fourier test on a binary law. -/
theorem integral_binary_zeroBiasFourierKernel {b c : ℝ}
    (hb : 0 ≤ b) (hc : 0 < c) (t : ℝ) :
    (∫ u in (0 : ℝ)..1, zeroBiasFourierKernel t (uniformBinaryValue b c u)) =
      binaryFourierMean t b c - ((b * c : ℝ) : ℂ) * uniformIntervalFourier t b c := by
  rw [← integral_binary_square_fourier hb hc t]
  unfold binaryFourierMean
  rw [integral_uniformBinaryValue_test (zeroBiasFourierKernel t) hb hc,
    integral_uniformBinaryValue_test
      (fun x : ℝ => Complex.exp ((t * x : ℝ) * Complex.I)) hb hc,
    integral_uniformBinaryValue_test
      (fun x : ℝ => (x : ℂ) ^ 2 * (∫ r in (0 : ℝ)..1,
        Complex.exp ((t * (r * x) : ℝ) * Complex.I))) hb hc]
  simp only [zeroBiasFourierKernel, smul_sub]
  abel

/-- A centered, unit-variance mixture of two binary laws satisfies the sharp
third-moment sine estimate, including an atom at zero. -/
theorem norm_three_point_mixture_zeroBias_le {α a b c : ℝ}
    (hα : 0 ≤ α) (hα1 : α ≤ 1) (hb : 0 ≤ b) (hba : b ≤ a) (hc : 0 < c)
    (hv : α * (a * c) + (1 - α) * (b * c) = 1) (t : ℝ) :
    ‖(α : ℂ) * (∫ u in (0 : ℝ)..1,
        zeroBiasFourierKernel t (uniformBinaryValue a c u)) +
      ((1 - α : ℝ) : ℂ) * (∫ u in (0 : ℝ)..1,
        zeroBiasFourierKernel t (uniformBinaryValue b c u))‖ ≤
      2 * clippedSine (|t| *
        (α * (a * c * (a ^ 2 + c ^ 2) / (a + c)) +
          (1 - α) * (b * c * (b ^ 2 + c ^ 2) / (b + c))) / 4) := by
  have ha : 0 ≤ a := hb.trans hba
  let β := α * (a * c)
  let A := (a ^ 2 + c ^ 2) / (2 * (a + c))
  let B := (b ^ 2 + c ^ 2) / (2 * (b + c))
  have hβ : 0 ≤ β - α := by
    have heq : β - α = α * (1 - α) * c * (a - b) := by
      dsimp [β]
      nlinarith [congrArg (fun x : ℝ => α * x) hv]
    rw [heq]
    positivity
  have hβ1 : 0 ≤ 1 - β := by
    have : 1 - β = (1 - α) * (b * c) := by dsimp [β]; linarith [hv]
    rw [this]
    positivity
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hB : 0 ≤ B := by dsimp [B]; positivity
  let w : Fin 3 → ℝ := ![α, β - α, 1 - β]
  let r : Fin 3 → ℝ := ![|t| * A / 2, |t| * A / 2, |t| * B / 2]
  let z : Fin 3 → ℂ := ![
    binaryFourierMean t a c - uniformIntervalFourier t a c,
    binaryFourierMean t b c - uniformIntervalFourier t a c,
    binaryFourierMean t b c - uniformIntervalFourier t b c]
  have hw : ∀ i, 0 ≤ w i := by
    intro i
    fin_cases i
    · exact hα
    · exact hβ
    · exact hβ1
  have hr : ∀ i, 0 ≤ r i := by
    intro i
    fin_cases i
    · change 0 ≤ |t| * A / 2; positivity
    · change 0 ≤ |t| * A / 2; positivity
    · change 0 ≤ |t| * B / 2; positivity
  have hz : ∀ i, ‖z i‖ ≤ 2 * clippedSine (r i) := by
    intro i
    fin_cases i
    · exact norm_binaryFourier_sub_uniform_le ha le_rfl hc t
    · exact norm_binaryFourier_sub_uniform_le hb hba hc t
    · exact norm_binaryFourier_sub_uniform_le hb le_rfl hc t
  have hsum : ∑ i, w i = 1 := by simp only [Fin.sum_univ_three, w, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]; ring
  have h := norm_sum_le_clippedSine w r z hw hsum hr hz
  simp only [Fin.sum_univ_three, w, r, z, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] at h
  have heq :
      (α : ℂ) * (binaryFourierMean t a c - uniformIntervalFourier t a c) +
        ((β - α : ℝ) : ℂ) * (binaryFourierMean t b c - uniformIntervalFourier t a c) +
        ((1 - β : ℝ) : ℂ) * (binaryFourierMean t b c - uniformIntervalFourier t b c) =
      (α : ℂ) * (binaryFourierMean t a c - ((a * c : ℝ) : ℂ) * uniformIntervalFourier t a c) +
        ((1 - α : ℝ) : ℂ) * (binaryFourierMean t b c - ((b * c : ℝ) : ℂ) * uniformIntervalFourier t b c) := by
    have hvC : (α : ℂ) * ((a : ℂ) * c) + (1 - α) * ((b : ℂ) * c) = 1 := by exact_mod_cast hv
    dsimp [β]
    push_cast
    linear_combination uniformIntervalFourier t b c * hvC
  have hm : α * (|t| * A / 2) + (β - α) * (|t| * A / 2) +
      (1 - β) * (|t| * B / 2) =
      |t| * (α * (a * c * (a ^ 2 + c ^ 2) / (a + c)) +
        (1 - α) * (b * c * (b ^ 2 + c ^ 2) / (b + c))) / 4 := by
    have hrem : 1 - β = (1 - α) * (b * c) := by dsimp [β]; linarith [hv]
    calc
      _ = β * (|t| * A / 2) + (1 - β) * (|t| * B / 2) := by ring
      _ = _ := by rw [hrem]; dsimp [β, A, B]; simp only [div_mul_eq_div_div]; ring
  rw [heq, hm] at h
  simpa only [integral_binary_zeroBiasFourierKernel ha hc,
    integral_binary_zeroBiasFourierKernel hb hc] using h

private theorem binary_mixture_test_identity {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [CompleteSpace E] (F : ℝ → E) {α p q r a b c : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 < c)
    (hp : α * (c / (a + c)) = p) (hq : (1 - α) * (c / (b + c)) = q)
    (hmass : p + q + r = 1) :
    α • (∫ u in (0 : ℝ)..1, F (uniformBinaryValue a c u)) +
      (1 - α) • (∫ u in (0 : ℝ)..1, F (uniformBinaryValue b c u)) =
      p • F (-a) + q • F (-b) + r • F c := by
  rw [integral_uniformBinaryValue_test F ha hc, integral_uniformBinaryValue_test F hb hc]
  simp only [smul_add, smul_smul]
  rw [hp, hq]
  have hr : α * (1 - c / (a + c)) + (1 - α) * (1 - c / (b + c)) = r := by
    nlinarith [hp, hq, hmass]
  calc
    _ = p • F (-a) + q • F (-b) +
        (α * (1 - c / (a + c)) + (1 - α) * (1 - c / (b + c))) • F c := by
      rw [add_smul]
      abel
    _ = _ := by rw [hr]

/-- The sharp Fourier estimate for any centered, unit-variance three-point law
with two nonpositive support points. Zero weights and coincident points are allowed. -/
theorem norm_three_point_nonpositive_zeroBias_le {p q r a b c : ℝ}
    (hp : 0 ≤ p) (hq : 0 ≤ q) (_hr : 0 ≤ r)
    (hmass : p + q + r = 1) (hb : 0 ≤ b) (hba : b ≤ a) (hc : 0 < c)
    (hmean : -p * a - q * b + r * c = 0)
    (hv : p * a ^ 2 + q * b ^ 2 + r * c ^ 2 = 1) (t : ℝ) :
    ‖(p : ℂ) * zeroBiasFourierKernel t (-a) +
      (q : ℂ) * zeroBiasFourierKernel t (-b) +
      (r : ℂ) * zeroBiasFourierKernel t c‖ ≤
      2 * clippedSine (|t| * (p * a ^ 3 + q * b ^ 3 + r * c ^ 3) / 4) := by
  have ha : 0 ≤ a := hb.trans hba
  have hA : a + c ≠ 0 := by linarith
  have hB : b + c ≠ 0 := by linarith
  have hc0 := ne_of_gt hc
  let α := p * (a + c) / c
  have hα : 0 ≤ α := by dsimp [α]; positivity
  have hrem : 1 - α = q * (b + c) / c := by
    dsimp [α]
    apply (eq_div_iff hc0).mpr
    field_simp
    nlinarith [congrArg (fun x : ℝ => x * c) hmass]
  have hα1 : α ≤ 1 := by
    have : 0 ≤ 1 - α := by rw [hrem]; positivity
    linarith
  have hap : α * (c / (a + c)) = p := by dsimp [α]; field_simp
  have hbq : (1 - α) * (c / (b + c)) = q := by rw [hrem]; field_simp
  have hav : α * (a * c) + (1 - α) * (b * c) = 1 := by
    rw [hrem]
    dsimp [α]
    field_simp
    nlinarith [congrArg (fun x : ℝ => x * c) hv,
      congrArg (fun x : ℝ => x * c ^ 2) hmean]
  have hthird :
      α * (a * c * (a ^ 2 + c ^ 2) / (a + c)) +
        (1 - α) * (b * c * (b ^ 2 + c ^ 2) / (b + c)) =
        p * a ^ 3 + q * b ^ 3 + r * c ^ 3 := by
    rw [hrem]
    dsimp [α]
    field_simp
    nlinarith [congrArg (fun x : ℝ => x * c ^ 2 * (a + c) * (b + c)) hmean]
  have h := norm_three_point_mixture_zeroBias_le hα hα1 hb hba hc hav t
  rw [hthird] at h
  have hid := binary_mixture_test_identity (zeroBiasFourierKernel t) ha hb hc hap hbq hmass
  simp only [Complex.real_smul] at hid
  rw [hid] at h
  exact h

/-- Reflecting the argument of the zero-bias Fourier test reflects its frequency. -/
theorem zeroBiasFourierKernel_neg (t x : ℝ) :
    zeroBiasFourierKernel t (-x) = zeroBiasFourierKernel (-t) x := by
  unfold zeroBiasFourierKernel
  simp only [mul_neg, neg_mul, Complex.ofReal_neg, neg_sq]

private theorem norm_three_point_nonpositive_pair_le {p q r x y z : ℝ}
    (hp : 0 ≤ p) (hq : 0 ≤ q) (hr : 0 ≤ r) (hmass : p + q + r = 1)
    (hx : x ≤ 0) (hy : y ≤ 0) (hz : 0 < z)
    (hmean : p * x + q * y + r * z = 0)
    (hv : p * x ^ 2 + q * y ^ 2 + r * z ^ 2 = 1) (t : ℝ) :
    ‖(p : ℂ) * zeroBiasFourierKernel t x + (q : ℂ) * zeroBiasFourierKernel t y +
      (r : ℂ) * zeroBiasFourierKernel t z‖ ≤
      2 * clippedSine (|t| * (p * |x| ^ 3 + q * |y| ^ 3 + r * |z| ^ 3) / 4) := by
  rcases le_total x y with hxy | hyx
  · have h := norm_three_point_nonpositive_zeroBias_le hp hq hr hmass
      (neg_nonneg.mpr hy) (neg_le_neg hxy) hz (by nlinarith [hmean]) (by simpa using hv) t
    simpa only [neg_neg, abs_of_nonpos hx, abs_of_nonpos hy, abs_of_pos hz] using h
  · have h := norm_three_point_nonpositive_zeroBias_le hq hp hr (by linarith [hmass])
      (neg_nonneg.mpr hx) (neg_le_neg hyx) hz (by nlinarith [hmean])
      (by simpa only [neg_sq, add_comm, add_left_comm, add_assoc] using hv) t
    simpa only [neg_neg, abs_of_nonpos hx, abs_of_nonpos hy, abs_of_pos hz,
      add_comm, add_left_comm, add_assoc] using h

private theorem norm_three_point_nonnegative_pair_le {p q r x y z : ℝ}
    (hp : 0 ≤ p) (hq : 0 ≤ q) (hr : 0 ≤ r) (hmass : p + q + r = 1)
    (hx : 0 ≤ x) (hy : 0 ≤ y) (hz : z < 0)
    (hmean : p * x + q * y + r * z = 0)
    (hv : p * x ^ 2 + q * y ^ 2 + r * z ^ 2 = 1) (t : ℝ) :
    ‖(p : ℂ) * zeroBiasFourierKernel t x + (q : ℂ) * zeroBiasFourierKernel t y +
      (r : ℂ) * zeroBiasFourierKernel t z‖ ≤
      2 * clippedSine (|t| * (p * |x| ^ 3 + q * |y| ^ 3 + r * |z| ^ 3) / 4) := by
  have h := norm_three_point_nonpositive_pair_le hp hq hr hmass
    (neg_nonpos.mpr hx) (neg_nonpos.mpr hy) (neg_pos.mpr hz)
    (by nlinarith [hmean]) (by simpa only [neg_sq] using hv) (-t)
  simpa only [zeroBiasFourierKernel_neg, neg_neg, abs_neg] using h

private theorem not_all_nonnegative_of_centered_unit {p q r x y z : ℝ}
    (hp : 0 ≤ p) (hq : 0 ≤ q) (hr : 0 ≤ r)
    (hmean : p * x + q * y + r * z = 0)
    (hv : p * x ^ 2 + q * y ^ 2 + r * z ^ 2 = 1) :
    ¬(0 ≤ x ∧ 0 ≤ y ∧ 0 ≤ z) := by
  rintro ⟨hx, hy, hz⟩
  have hpx : p * x = 0 := by nlinarith [mul_nonneg hp hx, mul_nonneg hq hy, mul_nonneg hr hz]
  have hqy : q * y = 0 := by nlinarith [mul_nonneg hp hx, mul_nonneg hq hy, mul_nonneg hr hz]
  have hrz : r * z = 0 := by nlinarith [mul_nonneg hp hx, mul_nonneg hq hy, mul_nonneg hr hz]
  nlinarith [congrArg (fun u : ℝ => u * x) hpx,
    congrArg (fun u : ℝ => u * y) hqy, congrArg (fun u : ℝ => u * z) hrz]

/-- The normalized third-moment sine estimate for arbitrary three support points. -/
theorem norm_three_point_zeroBias_le {p q r x y z : ℝ}
    (hp : 0 ≤ p) (hq : 0 ≤ q) (hr : 0 ≤ r) (hmass : p + q + r = 1)
    (hmean : p * x + q * y + r * z = 0)
    (hv : p * x ^ 2 + q * y ^ 2 + r * z ^ 2 = 1) (t : ℝ) :
    ‖(p : ℂ) * zeroBiasFourierKernel t x + (q : ℂ) * zeroBiasFourierKernel t y +
      (r : ℂ) * zeroBiasFourierKernel t z‖ ≤
      2 * clippedSine (|t| * (p * |x| ^ 3 + q * |y| ^ 3 + r * |z| ^ 3) / 4) := by
  have hpos := not_all_nonnegative_of_centered_unit hp hq hr hmean hv
  have hneg : ¬(x ≤ 0 ∧ y ≤ 0 ∧ z ≤ 0) := by
    have h := not_all_nonnegative_of_centered_unit (x := -x) (y := -y) (z := -z)
      hp hq hr (by nlinarith [hmean]) (by simpa only [neg_sq] using hv)
    simpa only [neg_nonneg] using h
  by_cases hx : x ≤ 0
  · by_cases hy : y ≤ 0
    · have hz : 0 < z := lt_of_not_ge (fun hz => hneg ⟨hx, hy, hz⟩)
      exact norm_three_point_nonpositive_pair_le hp hq hr hmass hx hy hz hmean hv t
    · have hy' : 0 < y := lt_of_not_ge hy
      by_cases hz : z ≤ 0
      · have h := norm_three_point_nonpositive_pair_le hp hr hq (by linarith [hmass])
          hx hz hy' (by linarith [hmean]) (by linarith [hv]) t
        simpa only [add_comm, add_left_comm, add_assoc] using h
      · have hz' : 0 < z := lt_of_not_ge hz
        have hx' : x < 0 := lt_of_not_ge (fun hx' => hpos ⟨hx', hy'.le, hz'.le⟩)
        have h := norm_three_point_nonnegative_pair_le hq hr hp (by linarith [hmass])
          hy'.le hz'.le hx' (by linarith [hmean]) (by linarith [hv]) t
        simpa only [add_comm, add_left_comm, add_assoc] using h
  · have hx' : 0 < x := lt_of_not_ge hx
    by_cases hy : y ≤ 0
    · by_cases hz : z ≤ 0
      · have h := norm_three_point_nonpositive_pair_le hq hr hp (by linarith [hmass])
          hy hz hx' (by linarith [hmean]) (by linarith [hv]) t
        simpa only [add_comm, add_left_comm, add_assoc] using h
      · have hz' : 0 < z := lt_of_not_ge hz
        have hy' : y < 0 := lt_of_not_ge (fun hy' => hpos ⟨hx'.le, hy', hz'.le⟩)
        have h := norm_three_point_nonnegative_pair_le hp hr hq (by linarith [hmass])
          hx'.le hz'.le hy' (by linarith [hmean]) (by linarith [hv]) t
        simpa only [add_comm, add_left_comm, add_assoc] using h
    · have hy' : 0 < y := lt_of_not_ge hy
      have hz' : z < 0 := lt_of_not_ge (fun hz' => hpos ⟨hx'.le, hy'.le, hz'⟩)
      exact norm_three_point_nonnegative_pair_le hp hq hr hmass hx'.le hy'.le hz' hmean hv t

/-- The three-point inequality in finite-vector notation. -/
theorem norm_fin_three_zeroBias_le (w x : Fin 3 → ℝ)
    (hw : ∀ i, 0 ≤ w i) (hmass : ∑ i, w i = 1)
    (hmean : ∑ i, w i * x i = 0) (hv : ∑ i, w i * (x i) ^ 2 = 1) (t : ℝ) :
    ‖∑ i, (w i : ℂ) * zeroBiasFourierKernel t (x i)‖ ≤
      2 * clippedSine (|t| * (∑ i, w i * |x i| ^ 3) / 4) := by
  simp only [Fin.sum_univ_three] at hmass hmean hv ⊢
  exact norm_three_point_zeroBias_le (hw 0) (hw 1) (hw 2) hmass hmean hv t

private theorem sum_smul_extend {ι κ E : Type*} [Fintype ι] [Fintype κ]
    [AddCommMonoid E] [Module ℝ E] (e : ι ↪ κ) (w x : ι → ℝ) (F : ℝ → E) :
    (∑ i, w i • F (x i)) = ∑ j, Function.extend e w (fun _ => 0) j •
      F (Function.extend e x (fun _ => 0) j) := by
  classical
  apply Fintype.sum_of_injective e e.injective
  · intro j hj
    rw [Function.extend_apply' _ _ j hj, zero_smul]
  · intro i
    simp only [e.injective.extend_apply]

/-- The normalized Fourier sine estimate for any law supported on at most three points. -/
theorem norm_finite_three_zeroBias_le {ι : Type*} [Fintype ι]
    (hcard : Fintype.card ι ≤ 3) (w x : ι → ℝ)
    (hw : ∀ i, 0 ≤ w i) (hmass : ∑ i, w i = 1)
    (hmean : ∑ i, w i * x i = 0) (hv : ∑ i, w i * (x i) ^ 2 = 1) (t : ℝ) :
    ‖∑ i, (w i : ℂ) * zeroBiasFourierKernel t (x i)‖ ≤
      2 * clippedSine (|t| * (∑ i, w i * |x i| ^ 3) / 4) := by
  classical
  obtain ⟨e⟩ : Nonempty (ι ↪ Fin 3) := Function.Embedding.nonempty_of_card_le (by simpa using hcard)
  let W : Fin 3 → ℝ := Function.extend e w (fun _ => 0)
  let X : Fin 3 → ℝ := Function.extend e x (fun _ => 0)
  have hext {E : Type} [AddCommMonoid E] [Module ℝ E] (F : ℝ → E) :
      (∑ i, w i • F (x i)) = ∑ j, W j • F (X j) := sum_smul_extend e w x F
  have hW : ∀ j, 0 ≤ W j := by
    intro j
    by_cases hj : ∃ i, e i = j
    · obtain ⟨i, rfl⟩ := hj
      simpa only [W, e.injective.extend_apply] using hw i
    · simp only [W, Function.extend_apply' _ _ j hj, le_refl]
  have hmassW : ∑ j, W j = 1 := by
    have h := hext (fun _ => (1 : ℝ))
    simpa only [smul_eq_mul, mul_one, hmass] using h.symm
  have hmeanW : ∑ j, W j * X j = 0 := by
    have h := hext (fun z => z)
    simpa only [smul_eq_mul, hmean] using h.symm
  have hvW : ∑ j, W j * (X j) ^ 2 = 1 := by
    have h := hext (fun z => z ^ 2)
    simpa only [smul_eq_mul, hv] using h.symm
  have h := norm_fin_three_zeroBias_le W X hW hmassW hmeanW hvW t
  have hthird := hext (fun z => |z| ^ 3)
  have htest := hext (zeroBiasFourierKernel t)
  simp only [smul_eq_mul] at hthird
  simp only [Complex.real_smul] at htest
  rwa [← hthird, ← htest] at h

private theorem sum_smul_subtype_of_eq_zero {ι E : Type*} [Fintype ι]
    [AddCommMonoid E] [Module ℝ E] (s : Finset ι) (w : ι → ℝ) (F : ι → E)
    (hout : ∀ i ∉ s, w i = 0) :
    (∑ i, w i • F i) = ∑ i : s, w i • F i := by
  classical
  symm
  apply Fintype.sum_of_injective Subtype.val Subtype.val_injective
  · intro i hi
    have his : i ∉ s := fun h => hi ⟨⟨i, h⟩, rfl⟩
    rw [hout i his, zero_smul]
  · intro i
    rfl

/-- The sharp zero-bias Fourier sine bound for every finite centered, unit-variance law. -/
theorem norm_finite_zeroBias_le {ι : Type*} [Fintype ι]
    (w x : ι → ℝ) (hw : ∀ i, 0 ≤ w i) (hmass : ∑ i, w i = 1)
    (hmean : ∑ i, w i * x i = 0) (hv : ∑ i, w i * (x i) ^ 2 = 1) (t : ℝ) :
    ‖∑ i, (w i : ℂ) * zeroBiasFourierKernel t (x i)‖ ≤
      2 * clippedSine (|t| * (∑ i, w i * |x i| ^ 3) / 4) := by
  classical
  let v (i : ι) : Fin 3 → ℝ := ![1, x i, (x i) ^ 2]
  let m : Fin 3 → ℝ := ![1, 0, 1]
  let K : Set (ι → ℝ) := {u | (∀ i, 0 ≤ u i) ∧
    ‖∑ i, (u i : ℂ) * zeroBiasFourierKernel t (x i)‖ ≤
      2 * clippedSine ((|t| / 4) * ∑ i, u i * |x i| ^ 3)}
  have hK : Convex ℝ K := convex_weights_clippedSine_bound (zeroBiasFourierKernel t ∘ x)
    (fun i => |x i| ^ 3) (fun i => by positivity) (by positivity)
  have hbase (s : Finset ι) (u : ι → ℝ) (hs : s.card ≤ 3)
      (hu : ∀ i ∈ s, 0 ≤ u i) (hout : ∀ i ∉ s, u i = 0)
      (hum : (∑ i ∈ s, u i • v i) = m) : u ∈ K := by
    have hmassS : ∑ i : s, u i = 1 := by
      have h := congrFun hum 0
      simpa only [Finset.sum_apply, Pi.smul_apply, v, m, Matrix.cons_val_zero,
        smul_eq_mul, mul_one, Finset.sum_coe_sort] using! h
    have hmeanS : ∑ i : s, u i * x i = 0 := by
      rw [Finset.sum_coe_sort (f := fun i => u i * x i)]
      have h := congrFun hum 1
      simpa only [Finset.sum_apply, Pi.smul_apply, v, m, Matrix.cons_val_one, Matrix.cons_val_zero,
        smul_eq_mul, Finset.sum_coe_sort] using! h
    have hvS : ∑ i : s, u i * (x i) ^ 2 = 1 := by
      rw [Finset.sum_coe_sort (f := fun i => u i * (x i) ^ 2)]
      have h := congrFun hum 2
      simpa only [Finset.sum_apply, Pi.smul_apply, v, m, Matrix.cons_val_two,
        Matrix.head_cons, Matrix.tail_cons, smul_eq_mul, Finset.sum_coe_sort] using! h
    have h := norm_finite_three_zeroBias_le (ι := s) (by simpa using hs)
      (fun i => u i) (fun i => x i) (fun i => hu i i.property) hmassS hmeanS hvS t
    have hthird := sum_smul_subtype_of_eq_zero s u (fun i => |x i| ^ 3) hout
    have htest := sum_smul_subtype_of_eq_zero s u (fun i => zeroBiasFourierKernel t (x i)) hout
    simp only [smul_eq_mul] at hthird
    simp only [Complex.real_smul] at htest
    refine ⟨fun i => ?_, ?_⟩
    · by_cases hi : i ∈ s
      · exact hu i hi
      · rw [hout i hi]
    · rw [hthird, htest]
      simpa only [div_mul_eq_mul_div] using h
  have hwm : (∑ i ∈ Finset.univ, w i • v i) = m := by
    ext j
    fin_cases j
    · simpa [Finset.sum_apply, Pi.smul_apply, v, m] using hmass
    · simpa [Finset.sum_apply, Pi.smul_apply, v, m] using hmean
    · simpa [Finset.sum_apply, Pi.smul_apply, v, m] using hv
  have h := convex_weights_of_three_point v (fun _ => rfl) m K hK hbase
    Finset.univ w (fun i _ => hw i) (by simp) hwm
  simpa only [div_mul_eq_mul_div] using h.2

@[fun_prop] theorem continuous_zeroBiasFourierKernel (t : ℝ) :
    Continuous (zeroBiasFourierKernel t) := by
  have h : Continuous (fun x : ℝ => ∫ u in (0 : ℝ)..1,
      Complex.exp ((t * (u * x) : ℝ) * Complex.I)) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' (by fun_prop) 0 1
  unfold zeroBiasFourierKernel
  fun_prop

private theorem integral_simple_test_eq_sum {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    (μ : Measure Ω) [IsFiniteMeasure μ] (f : SimpleFunc Ω ℝ) (F : ℝ → E) :
    (∫ ω, F (f ω) ∂μ) = ∑ x ∈ f.range, μ.real (f ⁻¹' {x}) • F x := by
  classical
  have hid (ω : Ω) : F (f ω) = ∑ x ∈ f.range, (f ⁻¹' {x}).indicator (fun _ => F x) ω := by
    rw [Finset.sum_eq_single (f ω)]
    · simp
    · intro x _ hx
      simp only [Set.indicator_apply, Set.mem_preimage, Set.mem_singleton_iff]
      exact ite_eq_right (Ne.symm hx)
    · intro h
      exact False.elim (h (f.mem_range_self ω))
  simp_rw [hid]
  rw [integral_finsetSum]
  · apply Finset.sum_congr rfl
    intro x _
    exact integral_indicator_const (F x) (f.measurableSet_fiber x)
  · intro x _
    exact (integrable_const (F x)).indicator (f.measurableSet_fiber x)

/-- The sharp sine bound for any centered, unit-variance simple random variable. -/
theorem norm_integral_simple_zeroBias_le {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (f : SimpleFunc Ω ℝ)
    (hmean : (∫ ω, f ω ∂μ) = 0) (hv : (∫ ω, (f ω) ^ 2 ∂μ) = 1) (t : ℝ) :
    ‖∫ ω, zeroBiasFourierKernel t (f ω) ∂μ‖ ≤
      2 * clippedSine (|t| * (∫ ω, |f ω| ^ 3 ∂μ) / 4) := by
  classical
  let w (x : f.range) := μ.real (f ⁻¹' {(x : ℝ)})
  have heq {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
      (F : ℝ → E) : (∫ ω, F (f ω) ∂μ) = ∑ x : f.range, w x • F x := by
    rw [integral_simple_test_eq_sum μ f F]
    exact (Finset.sum_coe_sort (s := f.range)
      (f := fun x => μ.real (f ⁻¹' {x}) • F x)).symm
  have hmass : ∑ x : f.range, w x = 1 := by
    simpa only [smul_eq_mul, mul_one, integral_const, probReal_univ,
      one_smul] using (heq (fun _ => (1 : ℝ))).symm
  have hmean' : ∑ x : f.range, w x * (x : ℝ) = 0 := by
    have h := (heq id).symm
    change (∑ x : f.range, w x * (x : ℝ)) = (∫ ω, f ω ∂μ) at h
    exact h.trans hmean
  have hv' : ∑ x : f.range, w x * (x : ℝ) ^ 2 = 1 := by
    have h := (heq (fun x => x ^ 2)).symm
    change (∑ x : f.range, w x * (x : ℝ) ^ 2) = (∫ ω, (f ω) ^ 2 ∂μ) at h
    exact h.trans hv
  have h := norm_finite_zeroBias_le w (fun x : f.range => (x : ℝ))
    (fun _ => measureReal_nonneg) hmass hmean' hv' t
  have hthird := heq (fun x => |x| ^ 3)
  have htest := heq (zeroBiasFourierKernel t)
  simp only [smul_eq_mul] at hthird
  simp only [Complex.real_smul] at htest
  rwa [← hthird, ← htest] at h

private theorem standardized_simple_moments {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (f : SimpleFunc Ω ℝ)
    (hv : 0 < (∫ ω, (f ω) ^ 2 ∂μ) - (∫ ω, f ω ∂μ) ^ 2) :
    (∫ ω, (f ω - ∫ ω, f ω ∂μ) /
      Real.sqrt ((∫ ω, (f ω) ^ 2 ∂μ) - (∫ ω, f ω ∂μ) ^ 2) ∂μ) = 0 ∧
    (∫ ω, ((f ω - ∫ ω, f ω ∂μ) /
      Real.sqrt ((∫ ω, (f ω) ^ 2 ∂μ) - (∫ ω, f ω ∂μ) ^ 2)) ^ 2 ∂μ) = 1 := by
  have hcenter : (∫ ω, (f ω - ∫ ω, f ω ∂μ) ^ 2 ∂μ) =
      (∫ ω, (f ω) ^ 2 ∂μ) - (∫ ω, f ω ∂μ) ^ 2 := by
    rw [← variance_eq_integral f.measurable.aemeasurable,
      variance_eq_sub (f.memLp_of_isFiniteMeasure 2 μ)]
    rfl
  constructor
  · rw [integral_div, integral_sub f.integrable_of_isFiniteMeasure (integrable_const _)]
    simp
  · simp_rw [div_pow]
    rw [integral_div, hcenter, Real.sq_sqrt hv.le]
    exact div_self (ne_of_gt hv)

/-- Every centered, unit-variance law with finite third moment admits simple approximations
that are eventually normalized and obey a common linear envelope. -/
theorem exists_simple_normalized_approximation (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : (∫ x, x ∂μ) = 0) (hv : (∫ x, x ^ 2 ∂μ) = 1) :
    ∃ f : ℕ → (SimpleFunc ℝ ℝ),
      (∀ᶠ n in atTop, (∫ x, f n x ∂μ) = 0 ∧ (∫ x, (f n x) ^ 2 ∂μ) = 1) ∧
      (∀ x, Tendsto (fun n => f n x) atTop (𝓝 x)) ∧
      (∀ᶠ n in atTop, ∀ x, |f n x| ≤ 4 * |x| + 2) := by
  let g (n : ℕ) : SimpleFunc ℝ ℝ := SimpleFunc.approxOn id measurable_id univ 0 (mem_univ 0) n
  have hg_lim (x : ℝ) : Tendsto (fun n => g n x) atTop (𝓝 x) :=
    SimpleFunc.tendsto_approxOn measurable_id (mem_univ 0) (by simp)
  have hg_bound (n : ℕ) (x : ℝ) : |g n x| ≤ 2 * |x| := by
    have h := SimpleFunc.norm_approxOn_zero_le measurable_id (mem_univ 0) x n
    simpa only [Real.norm_eq_abs, id_eq, ← two_mul] using h
  have h1 : Integrable (fun x : ℝ => |x|) μ := (hm.integrable (by norm_num)).abs
  have h2 : Integrable (fun x : ℝ => x ^ 2) μ :=
    (hm.mono_exponent (by norm_num : (2 : ENNReal) ≤ 3)).integrable_sq
  let m (n : ℕ) := ∫ x, g n x ∂μ
  have hm_lim : Tendsto m atTop (𝓝 0) := by
    rw [← hmean]
    exact tendsto_integral_of_dominated_convergence (fun x => 2 * |x|)
      (fun n => (g n).aestronglyMeasurable) (h1.const_mul 2)
      (fun n => Eventually.of_forall (fun x => by simpa only [Real.norm_eq_abs] using hg_bound n x))
      (Eventually.of_forall hg_lim)
  have hg2_lim : Tendsto (fun n => ∫ x, (g n x) ^ 2 ∂μ) atTop (𝓝 1) := by
    rw [← hv]
    apply tendsto_integral_of_dominated_convergence (fun x : ℝ => 4 * x ^ 2)
    · intro n
      exact (g n).aestronglyMeasurable.pow 2
    · exact h2.const_mul 4
    · intro n
      filter_upwards [] with x
      simp only [Real.norm_eq_abs, abs_sq]
      have h := sq_le_sq₀ (abs_nonneg (g n x)) (by positivity) |>.mpr (hg_bound n x)
      nlinarith [sq_abs (g n x), sq_abs x]
    · exact Eventually.of_forall (fun x => (hg_lim x).pow 2)
  let v (n : ℕ) := (∫ x, (g n x) ^ 2 ∂μ) - (m n) ^ 2
  have hv_lim : Tendsto v atTop (𝓝 1) := by
    have h := hg2_lim.sub (hm_lim.pow 2)
    simpa only [zero_pow (by decide : 2 ≠ 0), sub_zero] using h
  let s (n : ℕ) := Real.sqrt (v n)
  have hs_lim : Tendsto s atTop (𝓝 1) := by
    have h := Real.continuous_sqrt.tendsto 1 |>.comp hv_lim
    simpa only [s, Function.comp_def, Real.sqrt_one] using h
  let f (n : ℕ) : SimpleFunc ℝ ℝ := (g n).map (fun x => (x - m n) / s n)
  refine ⟨f, ?_, ?_, ?_⟩
  · filter_upwards [hv_lim.eventually (eventually_gt_nhds (by norm_num : (0 : ℝ) < 1))] with n hn
    exact standardized_simple_moments μ (g n) hn
  · intro x
    have h := ((hg_lim x).sub hm_lim).div hs_lim (by norm_num : (1 : ℝ) ≠ 0)
    convert h using 1 <;> simp [f, SimpleFunc.map_apply, Pi.div_def]
  · have hm_bound : ∀ᶠ n in atTop, |m n| < 1 := by
      have h := hm_lim.abs
      simp only [abs_zero] at h
      exact h.eventually (eventually_lt_nhds (by norm_num : (0 : ℝ) < 1))
    filter_upwards [hm_bound,
      hs_lim.eventually (eventually_gt_nhds (by norm_num : (1 / 2 : ℝ) < 1))] with n hmn hsn x
    change |(g n x - m n) / s n| ≤ 4 * |x| + 2
    rw [abs_div, abs_of_pos (by linarith : 0 < s n)]
    apply (div_le_iff₀ (by linarith : 0 < s n)).mpr
    have hsub := abs_sub (g n x) (m n)
    have hgb := hg_bound n x
    nlinarith [mul_nonneg (by positivity : 0 ≤ 4 * |x| + 2) (by linarith : 0 ≤ s n - 1 / 2)]

/-- The sharp third-moment sine estimate for the zero-bias Fourier test, extended from
finite laws by dominated convergence with normalized simple approximations. -/
theorem norm_integral_zeroBias_le (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : (∫ x, x ∂μ) = 0) (hv : (∫ x, x ^ 2 ∂μ) = 1) (t : ℝ) :
    ‖∫ x, zeroBiasFourierKernel t x ∂μ‖ ≤
      2 * clippedSine (|t| * (∫ x, |x| ^ 3 ∂μ) / 4) := by
  obtain ⟨f, hnormalized, hlim, hbound⟩ := exists_simple_normalized_approximation μ hm hmean hv
  let D (x : ℝ) := 4 * |x| + 2
  have hD (x : ℝ) : 0 ≤ D x := by dsimp [D]; positivity
  have hDmem : MemLp D 3 μ := by
    simpa only [D, Pi.add_apply, Real.norm_eq_abs, id_eq] using! (hm.norm.const_mul 4).add (memLp_const (2 : ℝ))
  have hD2 : Integrable (fun x => 1 + (D x) ^ 2) μ :=
    (integrable_const (1 : ℝ)).add
      ((hDmem.mono_exponent (by norm_num : (2 : ENNReal) ≤ 3)).integrable_sq)
  have hD3 : Integrable (fun x => (D x) ^ 3) μ := by
    simpa only [Real.norm_eq_abs, abs_of_nonneg (hD _)] using hDmem.integrable_norm_pow'
  have htestlim : Tendsto (fun n => ∫ x, zeroBiasFourierKernel t (f n x) ∂μ)
      atTop (𝓝 (∫ x, zeroBiasFourierKernel t x ∂μ)) := by
    apply tendsto_integral_filter_of_dominated_convergence (fun x => 1 + (D x) ^ 2)
    · exact Eventually.of_forall (fun n => ((f n).map (zeroBiasFourierKernel t)).aestronglyMeasurable)
    · filter_upwards [hbound] with n hn
      filter_upwards [] with x
      refine (norm_zeroBiasFourierKernel_le t (f n x)).trans ?_
      have hsq : (f n x) ^ 2 ≤ (D x) ^ 2 := by
        have h := (sq_le_sq₀ (abs_nonneg (f n x)) (hD x)).mpr (hn x)
        simpa only [sq_abs] using h
      linarith
    · exact hD2
    · exact Eventually.of_forall (fun x => (continuous_zeroBiasFourierKernel t).continuousAt.tendsto.comp (hlim x))
  have hthirdlim : Tendsto (fun n => ∫ x, |f n x| ^ 3 ∂μ)
      atTop (𝓝 (∫ x, |x| ^ 3 ∂μ)) := by
    apply tendsto_integral_filter_of_dominated_convergence (fun x => (D x) ^ 3)
    · apply Eventually.of_forall
      intro n
      have hf : Measurable (fun x => f n x) := (f n).measurable
      fun_prop
    · filter_upwards [hbound] with n hn
      filter_upwards [] with x
      simp only [Real.norm_eq_abs, abs_pow, abs_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) (hn x) 3
    · exact hD3
    · exact Eventually.of_forall (fun x => (hlim x).abs.pow 3)
  have hle : ∀ᶠ n in atTop,
      ‖∫ x, zeroBiasFourierKernel t (f n x) ∂μ‖ ≤
        2 * clippedSine (|t| * (∫ x, |f n x| ^ 3 ∂μ) / 4) := by
    filter_upwards [hnormalized] with n hn
    exact norm_integral_simple_zeroBias_le μ (f n) hn.1 hn.2 t
  apply le_of_tendsto_of_tendsto htestlim.norm _ hle
  exact tendsto_const_nhds.mul (continuous_clippedSine.continuousAt.tendsto.comp
    ((tendsto_const_nhds.mul hthirdlim).div_const 4))

/-- For a centered law of variance one, the actual zero-bias characteristic-function
error obeys the sharp third-moment sine bound. -/
theorem norm_charFun_sub_zeroBias_le (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : (∫ x, x ∂μ) = 0) (hv : (∫ x, x ^ 2 ∂μ) = 1) (t : ℝ) :
    ‖charFun μ t - charFun (zeroBiasMeasure μ) t‖ ≤
      2 * clippedSine (|t| * (∫ x, |x| ^ 3 ∂μ) / 4) := by
  rw [charFun_sub_zeroBias_eq_integral μ (hm.mono_exponent (by norm_num)) hv t]
  exact norm_integral_zeroBias_le μ hm hmean hv t

private theorem zeroBiasFourierKernel_rescale (t x s : ℝ) (hs : s ≠ 0) :
    zeroBiasFourierKernel (t * s) (x / s) =
      Complex.exp ((t * x : ℝ) * Complex.I) - (((s ^ 2)⁻¹ : ℝ) : ℂ) *
        ((x : ℂ) ^ 2 * (∫ u in (0 : ℝ)..1,
          Complex.exp ((t * (u * x) : ℝ) * Complex.I))) := by
  have heq (u : ℝ) : t * s * (u * (x / s)) = t * (u * x) := by
    field_simp
  unfold zeroBiasFourierKernel
  rw [show t * s * (x / s) = t * x by field_simp]
  simp_rw [heq]
  push_cast
  ring

private theorem integrable_square_unit_cexp (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) (t : ℝ) :
    Integrable (fun x : ℝ => (x : ℂ) ^ 2 * (∫ u in (0 : ℝ)..1,
      Complex.exp ((t * (u * x) : ℝ) * Complex.I))) μ := by
  have hcont : Continuous (fun x : ℝ => ∫ u in (0 : ℝ)..1,
      Complex.exp ((t * (u * x) : ℝ) * Complex.I)) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' (by fun_prop) 0 1
  apply hm.integrable_sq.mono' (by fun_prop)
  filter_upwards [] with x
  simp only [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs]
  apply mul_le_of_le_one_right (sq_nonneg x)
  have h := intervalIntegral.norm_integral_le_of_norm_le_const
    (a := 0) (b := 1) (C := 1)
    (f := fun u : ℝ => Complex.exp ((t * (u * x) : ℝ) * Complex.I))
    (fun u _ => by simp [Complex.norm_exp])
  simpa using h

/-- Scaling the unit-variance Fourier test gives the original characteristic function
minus its zero-bias transform, with no assumption on the frequency. -/
theorem charFun_sub_zeroBias_eq_rescaled_integral (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) {s : ℝ} (hs : 0 < s)
    (hvariance : (∫ x, x ^ 2 ∂μ) = s ^ 2) (t : ℝ) :
    charFun μ t - charFun (zeroBiasMeasure μ) t =
      ∫ x, zeroBiasFourierKernel (t * s) (x / s) ∂μ := by
  have hexp : Integrable (fun x : ℝ => Complex.exp ((t * x : ℝ) * Complex.I)) μ := by
    apply Integrable.mono' (integrable_const (1 : ℝ)) (by fun_prop)
    filter_upwards [] with x
    simp [Complex.norm_exp]
  have hw := (integrable_square_unit_cexp μ hm t).const_mul (((s ^ 2)⁻¹ : ℝ) : ℂ)
  simp_rw [zeroBiasFourierKernel_rescale t _ s hs.ne']
  rw [integral_sub hexp hw, integral_const_mul,
    charFun_zeroBiasMeasure μ hm (by rw [hvariance]; positivity) t,
    hvariance, charFun_apply_real]
  simp only [Complex.ofReal_inv, ← Complex.ofReal_mul]

/-- The sharp sine comparison for any positive variance, expressed in the original scale. -/
theorem norm_charFun_sub_zeroBias_le_variance (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : (∫ x, x ∂μ) = 0)
    (hv : 0 < ∫ x, x ^ 2 ∂μ) (t : ℝ) :
    ‖charFun μ t - charFun (zeroBiasMeasure μ) t‖ ≤
      2 * clippedSine (|t| * (∫ x, |x| ^ 3 ∂μ) / (4 * ∫ x, x ^ 2 ∂μ)) := by
  let v := ∫ x, x ^ 2 ∂μ
  let s := Real.sqrt v
  have hs : 0 < s := Real.sqrt_pos.mpr hv
  have hs2 : s ^ 2 = v := Real.sq_sqrt hv.le
  let ν := μ.map (fun x => x / s)
  have hmap : Measurable (fun x : ℝ => x / s) := by fun_prop
  let : IsProbabilityMeasure ν := (Measure.isProbabilityMeasure_map_iff hmap.aemeasurable).mpr inferInstance
  have hν : MemLp id 3 ν := by
    rw [memLp_map_measure_iff (by fun_prop) hmap.aemeasurable]
    simpa only [Function.comp_def, id_eq, div_eq_mul_inv] using hm.mul_const s⁻¹
  have hmν : (∫ y, y ∂ν) = 0 := by
    rw [integral_map hmap.aemeasurable (by fun_prop), integral_div, hmean, zero_div]
  have hvν : (∫ y, y ^ 2 ∂ν) = 1 := by
    rw [integral_map hmap.aemeasurable (by fun_prop)]
    simp_rw [div_pow]
    rw [integral_div, hs2]
    exact div_self hv.ne'
  have hthird : (∫ y, |y| ^ 3 ∂ν) = (∫ x, |x| ^ 3 ∂μ) / s ^ 3 := by
    rw [integral_map hmap.aemeasurable (by fun_prop)]
    simp_rw [abs_div, abs_of_pos hs, div_pow]
    rw [integral_div]
  have h := norm_integral_zeroBias_le ν hν hmν hvν (t * s)
  rw [integral_map hmap.aemeasurable (continuous_zeroBiasFourierKernel (t * s)).aestronglyMeasurable,
    ← charFun_sub_zeroBias_eq_rescaled_integral μ (hm.mono_exponent (by norm_num)) hs hs2.symm t,
    hthird, abs_mul, abs_of_pos hs] at h
  have heq : |t| * s * ((∫ x, |x| ^ 3 ∂μ) / s ^ 3) / 4 =
      |t| * (∫ x, |x| ^ 3 ∂μ) / (4 * v) := by
    rw [← hs2]
    field_simp
  rw [heq] at h
  exact h

/-- A real law with zero second moment has constant characteristic function one. -/
theorem charFun_eq_one_of_secondMoment_zero (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) (hv : (∫ x, x ^ 2 ∂μ) = 0) (t : ℝ) : charFun μ t = 1 := by
  have hx2 := (integral_eq_zero_iff_of_nonneg (fun x : ℝ => sq_nonneg x) hm.integrable_sq).mp hv
  have hx : ∀ᵐ x : ℝ ∂μ, x = 0 := by
    filter_upwards [hx2] with x hx
    exact sq_eq_zero_iff.mp hx
  rw [charFun_apply_real]
  calc
    _ = ∫ _, (1 : ℂ) ∂μ := by
      apply integral_congr_ae
      filter_upwards [hx] with x hx
      simp [hx]
    _ = 1 := by simp

/-- The zero-bias differential identity also covers zero-variance summands. -/
theorem deriv_charFun_eq_zeroBias_of_centered (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) (hmean : (∫ x, x ∂μ) = 0) (t : ℝ) :
    deriv (charFun μ) t =
      -((∫ x : ℝ, x ^ 2 ∂μ : ℝ) : ℂ) * t * charFun (zeroBiasMeasure μ) t := by
  have hv : 0 ≤ ∫ x, x ^ 2 ∂μ := integral_nonneg (fun x => sq_nonneg x)
  rcases eq_or_lt_of_le hv with heq | hpos
  · have hf : charFun μ = fun _ => 1 := funext (charFun_eq_one_of_secondMoment_zero μ hm heq.symm)
    rw [hf, heq.symm]
    simp
  · exact deriv_charFun_eq_zeroBias μ hm hpos hmean t

/-- The normal differential residual of a normalized product is a sum of
single-coordinate zero-bias errors, weighted by their variances. -/
theorem product_charFun_normal_residual_eq {ι : Type*} [Fintype ι] [DecidableEq ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 2 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    (hv : (∑ i, ∫ x, x ^ 2 ∂μ i) = 1) (t : ℝ) :
    deriv (fun u => ∏ i, charFun (μ i) u) t + (t : ℂ) * (∏ i, charFun (μ i) t) =
      ∑ i, ((∫ x : ℝ, x ^ 2 ∂μ i : ℝ) : ℂ) * t *
        (charFun (μ i) t - charFun (zeroBiasMeasure (μ i)) t) *
        ∏ j ∈ Finset.univ.erase i, charFun (μ j) t := by
  have hd (i : ι) : HasDerivAt (charFun (μ i)) (deriv (charFun (μ i)) t) t :=
    ((contDiff_charFun (n := 1) ((hm i).mono_exponent (by norm_num))).differentiable
      (by norm_num)).differentiableAt.hasDerivAt
  have hprod := (HasDerivAt.fun_finsetProd (u := Finset.univ) (fun i _ => hd i)).deriv
  simp only [smul_eq_mul] at hprod
  have hterm (i : ι) : ((∫ x : ℝ, x ^ 2 ∂μ i : ℝ) : ℂ) * t *
        (charFun (μ i) t - charFun (zeroBiasMeasure (μ i)) t) *
        (∏ j ∈ Finset.univ.erase i, charFun (μ j) t) =
      (∏ j ∈ Finset.univ.erase i, charFun (μ j) t) * deriv (charFun (μ i)) t +
        ((∫ x : ℝ, x ^ 2 ∂μ i : ℝ) : ℂ) * t * (∏ j, charFun (μ j) t) := by
    rw [deriv_charFun_eq_zeroBias_of_centered (μ i) (hm i) (hmean i)]
    have heq := Finset.mul_prod_erase Finset.univ (fun j => charFun (μ j) t) (Finset.mem_univ i)
    rw [← heq]
    ring
  simp_rw [hterm]
  rw [Finset.sum_add_distrib, ← hprod, ← Finset.sum_mul, ← Finset.sum_mul,
    ← Complex.ofReal_sum, hv]
  simp

/-- Variance-weighted zero-bias errors combine by the concavity of the clipped sine.
Zero-variance coordinates are included. -/
theorem sum_variance_mul_zeroBias_error_le {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    (hv : (∑ i, ∫ x, x ^ 2 ∂μ i) = 1) (t : ℝ) :
    (∑ i, (∫ x, x ^ 2 ∂μ i) * ‖charFun (μ i) t - charFun (zeroBiasMeasure (μ i)) t‖) ≤
      2 * clippedSine (|t| * (∑ i, ∫ x, |x| ^ 3 ∂μ i) / 4) := by
  let v (i : ι) := ∫ x, x ^ 2 ∂μ i
  let b (i : ι) := ∫ x, |x| ^ 3 ∂μ i
  let r (i : ι) := |t| * b i / (4 * v i)
  have hvi (i : ι) : 0 ≤ v i := integral_nonneg (fun x => sq_nonneg x)
  have hbi (i : ι) : 0 ≤ b i := integral_nonneg (fun x => by positivity)
  have hri (i : ι) : 0 ≤ r i := by dsimp [r]; positivity
  have hsingle (i : ι) : v i * ‖charFun (μ i) t - charFun (zeroBiasMeasure (μ i)) t‖ ≤
      v i * (2 * clippedSine (r i)) := by
    rcases eq_or_lt_of_le (hvi i) with heq | hpos
    · rw [← heq]; simp
    · exact mul_le_mul_of_nonneg_left
        (norm_charFun_sub_zeroBias_le_variance (μ i) (hm i) (hmean i) hpos t) (hvi i)
  have hj := concaveOn_clippedSine.le_map_sum (t := Finset.univ)
    (w := v) (p := r) (fun i _ => hvi i) hv (fun i _ => hri i)
  simp only [smul_eq_mul] at hj
  have harg : (∑ i, v i * r i) ≤ |t| * (∑ i, b i) / 4 := by
    rw [Finset.mul_sum, Finset.sum_div]
    apply Finset.sum_le_sum
    intro i _
    rcases eq_or_lt_of_le (hvi i) with heq | hpos
    · change v i * (|t| * b i / (4 * v i)) ≤ _
      rw [← heq, zero_mul]
      positivity
    · change v i * (|t| * b i / (4 * v i)) ≤ _
      have heq : v i * (|t| * b i / (4 * v i)) = |t| * b i / 4 := by field_simp
      exact heq.le
  calc
    _ ≤ ∑ i, v i * (2 * clippedSine (r i)) := Finset.sum_le_sum (fun i _ => hsingle i)
    _ = 2 * ∑ i, v i * clippedSine (r i) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ ≤ 2 * clippedSine (∑ i, v i * r i) := mul_le_mul_of_nonneg_left hj (by norm_num)
    _ ≤ _ := mul_le_mul_of_nonneg_left (monotoneOn_clippedSine
      (Finset.sum_nonneg (fun i _ => mul_nonneg (hvi i) (hri i)))
      (by change 0 ≤ |t| * (∑ i, b i) / 4; positivity) harg) (by norm_num)

/-- A common envelope for the products with one coordinate omitted yields the sine-refined
normal differential-residual bound. -/
theorem norm_product_charFun_normal_residual_le {ι : Type*} [Fintype ι] [DecidableEq ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    (hv : (∑ i, ∫ x, x ^ 2 ∂μ i) = 1) (t : ℝ) {M : ℝ} (hM : 0 ≤ M)
    (hprod : ∀ i, ‖∏ j ∈ Finset.univ.erase i, charFun (μ j) t‖ ≤ M) :
    ‖deriv (fun u => ∏ i, charFun (μ i) u) t + (t : ℂ) * (∏ i, charFun (μ i) t)‖ ≤
      2 * |t| * M * clippedSine (|t| * (∑ i, ∫ x, |x| ^ 3 ∂μ i) / 4) := by
  rw [product_charFun_normal_residual_eq μ (fun i => (hm i).mono_exponent (by norm_num)) hmean hv]
  calc
    _ ≤ ∑ i, ‖((∫ x : ℝ, x ^ 2 ∂μ i : ℝ) : ℂ) * t *
        (charFun (μ i) t - charFun (zeroBiasMeasure (μ i)) t) *
        ∏ j ∈ Finset.univ.erase i, charFun (μ j) t‖ := norm_sum_le _ _
    _ ≤ ∑ i, |t| * M * ((∫ x, x ^ 2 ∂μ i) *
        ‖charFun (μ i) t - charFun (zeroBiasMeasure (μ i)) t‖) := by
      apply Finset.sum_le_sum
      intro i _
      have hvi : 0 ≤ ∫ x, x ^ 2 ∂μ i := integral_nonneg (fun x => sq_nonneg x)
      simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hvi]
      calc
        _ ≤ (∫ x, x ^ 2 ∂μ i) * |t| *
            ‖charFun (μ i) t - charFun (zeroBiasMeasure (μ i)) t‖ * M :=
          mul_le_mul_of_nonneg_left (hprod i) (by positivity)
        _ = _ := by ring
    _ = |t| * M * (∑ i, (∫ x, x ^ 2 ∂μ i) *
        ‖charFun (μ i) t - charFun (zeroBiasMeasure (μ i)) t‖) := by rw [Finset.mul_sum]
    _ ≤ |t| * M * (2 * clippedSine (|t| * (∑ i, ∫ x, |x| ^ 3 ∂μ i) / 4)) :=
      mul_le_mul_of_nonneg_left (sum_variance_mul_zeroBias_error_le μ hm hmean hv t) (by positivity)
    _ = _ := by ring

/-- The cubic correction incurred when one coordinate is omitted from a product envelope. -/
def berryEsseenResidualBump (z : ℝ) : ℝ := z ^ 2 / 2 - (49581 / 250000 : ℝ) * z ^ 3

private theorem monotoneOn_berryEsseenResidualBump :
    MonotoneOn berryEsseenResidualBump (Icc 0 (250000 / 148743 : ℝ)) := by
  intro x hx y hy hxy
  have hxx := mul_nonneg hx.1 (sub_nonneg.mpr hx.2)
  have hyy := mul_nonneg hy.1 (sub_nonneg.mpr hy.2)
  have hxy1 := mul_nonneg hx.1 (sub_nonneg.mpr hy.2)
  have hxy2 := mul_nonneg hy.1 (sub_nonneg.mpr hx.2)
  have hfactor : 0 ≤ (x + y) / 2 - (49581 / 250000 : ℝ) * (x ^ 2 + x * y + y ^ 2) := by
    nlinarith
  have hp := mul_nonneg (sub_nonneg.mpr hxy) hfactor
  dsimp [berryEsseenResidualBump]
  nlinarith

/-- The cubic correction is maximized at the explicitly rational critical point. -/
theorem berryEsseenResidualBump_le_peak {z : ℝ} (hz : 0 ≤ z) :
    berryEsseenResidualBump z ≤ berryEsseenResidualBump (250000 / 148743) := by
  have h : 0 ≤ (z - 250000 / 148743) ^ 2 * ((49581 / 250000 : ℝ) * z + 1 / 6) := by positivity
  have heq : berryEsseenResidualBump (250000 / 148743) - berryEsseenResidualBump z =
      (z - 250000 / 148743) ^ 2 * ((49581 / 250000 : ℝ) * z + 1 / 6) := by
    unfold berryEsseenResidualBump
    ring
  linarith

/-- The correction on a bounded nonnegative interval attains its maximum at the endpoint
or the rational critical point, whichever comes first. -/
theorem berryEsseenResidualBump_le_min {z r : ℝ} (hz : 0 ≤ z) (hzr : z ≤ r) :
    berryEsseenResidualBump z ≤ berryEsseenResidualBump (min r (250000 / 148743)) := by
  by_cases hr : r ≤ 250000 / 148743
  · rw [min_eq_left hr]
    exact monotoneOn_berryEsseenResidualBump ⟨hz, hzr.trans hr⟩ ⟨hz.trans hzr, hr⟩ hzr
  · rw [min_eq_right (le_of_not_ge hr)]
    exact berryEsseenResidualBump_le_peak hz

/-- The cube root of the total third moment bounds every coordinate standard deviation. -/
theorem sqrt_secondMoment_le_of_third_sum {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) {q : ℝ} (hq : 0 ≤ q)
    (hthird : (∑ i, ∫ x, |x| ^ 3 ∂μ i) ≤ q ^ 3) (i : ι) :
    Real.sqrt (∫ x, x ^ 2 ∂μ i) ≤ q := by
  have hv : 0 ≤ ∫ x, x ^ 2 ∂μ i := integral_nonneg (fun x => sq_nonneg x)
  have hsingle : (∫ x, |x| ^ 3 ∂μ i) ≤ ∑ j, ∫ x, |x| ^ 3 ∂μ j :=
    Finset.single_le_sum (f := fun j => ∫ x : ℝ, |x| ^ 3 ∂μ j)
      (fun j _ => integral_nonneg (fun x => by positivity)) (Finset.mem_univ i)
  apply (pow_le_pow_iff_left₀ (Real.sqrt_nonneg _) hq (by decide : 3 ≠ 0)).mp
  calc
    _ = (∫ x, x ^ 2 ∂μ i) * Real.sqrt (∫ x, x ^ 2 ∂μ i) := by rw [pow_succ, Real.sq_sqrt hv]
    _ ≤ _ := (secondMoment_mul_sqrt_le_thirdMoment (μ i) (hm i)).trans (hsingle.trans hthird)

/-- The common cubic envelope for all products obtained by omitting one coordinate. -/
theorem norm_charFun_product_erase_le {ι : Type*} [Fintype ι] [DecidableEq ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    (hv : (∑ i, ∫ x, x ^ 2 ∂μ i) = 1) {ℓ q t : ℝ}
    (hthird : (∑ i, ∫ x, |x| ^ 3 ∂μ i) ≤ ℓ)
    (hq : 0 ≤ q) (hthirdq : (∑ i, ∫ x, |x| ^ 3 ∂μ i) ≤ q ^ 3)
    (ht : 0 ≤ t) (i : ι) :
    ‖∏ j ∈ Finset.univ.erase i, charFun (μ j) t‖ ≤
      Real.exp (-t ^ 2 / 2 + (49581 / 250000 : ℝ) * ℓ * t ^ 3 +
        berryEsseenResidualBump (min (t * q) (250000 / 148743))) := by
  let v (j : ι) := ∫ x, x ^ 2 ∂μ j
  let b (j : ι) := ∫ x, |x| ^ 3 ∂μ j
  have hvi : 0 ≤ v i := integral_nonneg (fun x => sq_nonneg x)
  have hlocal : v i * t ^ 2 / 2 - (49581 / 250000 : ℝ) * b i * t ^ 3 ≤
      berryEsseenResidualBump (t * Real.sqrt (v i)) := by
    have hs : Real.sqrt (v i) ^ 3 = v i * Real.sqrt (v i) := by rw [pow_succ, Real.sq_sqrt hvi]
    have h := mul_le_mul_of_nonneg_right (secondMoment_mul_sqrt_le_thirdMoment (μ i) (hm i))
      (by positivity : 0 ≤ (49581 / 250000 : ℝ) * t ^ 3)
    unfold berryEsseenResidualBump
    rw [mul_pow, mul_pow, Real.sq_sqrt hvi, hs]
    change v i * Real.sqrt (v i) * _ ≤ b i * _ at h
    nlinarith
  have hbump := berryEsseenResidualBump_le_min
    (mul_nonneg ht (Real.sqrt_nonneg (v i)))
    (mul_le_mul_of_nonneg_left (sqrt_secondMoment_le_of_third_sum μ hm hq hthirdq i) ht)
  rw [norm_prod]
  calc
    _ ≤ ∏ j ∈ Finset.univ.erase i,
        Real.exp (-v j * t ^ 2 / 2 + (49581 / 250000 : ℝ) * b j * t ^ 3) := by
      apply Finset.prod_le_prod (fun _ _ => norm_nonneg _)
      intro j _
      simpa only [abs_of_nonneg ht] using norm_charFun_le_exp_thirdMoment (μ j) (hm j) (hmean j) t
    _ = Real.exp (-(1 - v i) * t ^ 2 / 2 +
        (49581 / 250000 : ℝ) * ((∑ j, b j) - b i) * t ^ 3) := by
      rw [← Real.exp_sum]
      congr 1
      have hlinear (j : ι) : -v j * t ^ 2 / 2 + (49581 / 250000 : ℝ) * b j * t ^ 3 =
          (-t ^ 2 / 2) * v j + ((49581 / 250000 : ℝ) * t ^ 3) * b j := by ring
      simp_rw [hlinear]
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum,
        Finset.sum_erase_eq_sub (f := v) (Finset.mem_univ i),
        Finset.sum_erase_eq_sub (f := b) (Finset.mem_univ i),
        show (∑ j, v j) = 1 from hv]
      ring
    _ ≤ _ := by
      apply Real.exp_le_exp.mpr
      have htotal := mul_le_mul_of_nonneg_right hthird
        (by positivity : 0 ≤ (49581 / 250000 : ℝ) * t ^ 3)
      change (∑ j, b j) * _ ≤ ℓ * _ at htotal
      nlinarith [hlocal.trans hbump]

/-- The sine-refined integral majorant for the normal characteristic-function error. -/
def berryEsseenNormalErrorBound (ℓ q t : ℝ) : ℝ :=
  2 * Real.exp (-t ^ 2 / 2) * ∫ u in (0 : ℝ)..t,
    clippedSine (u * ℓ / 4) * u * Real.exp ((49581 / 250000 : ℝ) * ℓ * u ^ 3 +
      berryEsseenResidualBump (min (u * q) (250000 / 148743)))

/-- The sharp analytic normal-error majorant for an arbitrary normalized product of
centered laws. The parameter `q` bounds the cube root of the total third moment. -/
theorem charFun_product_normal_error_le {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    (hv : (∑ i, ∫ x, x ^ 2 ∂μ i) = 1) {ℓ q t : ℝ}
    (hthird : (∑ i, ∫ x, |x| ^ 3 ∂μ i) ≤ ℓ)
    (hq : 0 ≤ q) (hthirdq : (∑ i, ∫ x, |x| ^ 3 ∂μ i) ≤ q ^ 3) (ht : 0 ≤ t) :
    ‖charFun ((Measure.pi μ).map (fun z => ∑ i, z i)) t - (Real.exp (-t ^ 2 / 2) : ℂ)‖ ≤
      berryEsseenNormalErrorBound ℓ q t := by
  classical
  let f (u : ℝ) : ℂ := ∏ i, charFun (μ i) u
  have hf : ContDiff ℝ 1 f := contDiff_prod (fun i _ =>
    contDiff_charFun (n := 1) ((hm i).mono_exponent (by norm_num)))
  have hzero : f 0 = 1 := by simp [f]
  have hℓ : 0 ≤ ℓ := (Finset.sum_nonneg (fun i _ => integral_nonneg (fun x => by positivity))).trans hthird
  let B (u : ℝ) := clippedSine (u * ℓ / 4) * u *
    Real.exp ((49581 / 250000 : ℝ) * ℓ * u ^ 3 +
      berryEsseenResidualBump (min (u * q) (250000 / 148743)))
  have hB : Continuous B := by
    unfold B berryEsseenResidualBump
    fun_prop
  have hR : Continuous (fun u : ℝ => Real.exp (u ^ 2 / 2) * ‖deriv f u + u * f u‖) := by
    have hd := hf.continuous_deriv (by norm_num)
    have hc := hf.continuous
    fun_prop
  have hpoint (u : ℝ) (hu : u ∈ Icc 0 t) :
      Real.exp (u ^ 2 / 2) * ‖deriv f u + u * f u‖ ≤ 2 * B u := by
    have hu0 : 0 ≤ u := hu.1
    let M := Real.exp (-u ^ 2 / 2 + (49581 / 250000 : ℝ) * ℓ * u ^ 3 +
      berryEsseenResidualBump (min (u * q) (250000 / 148743)))
    have hM : 0 ≤ M := (Real.exp_pos _).le
    have hres := norm_product_charFun_normal_residual_le μ hm hmean hv u hM
      (fun i => norm_charFun_product_erase_le μ hm hmean hv hthird hq hthirdq hu.1 i)
    rw [abs_of_nonneg hu.1] at hres
    have hsine : clippedSine (u * (∑ i, ∫ x, |x| ^ 3 ∂μ i) / 4) ≤ clippedSine (u * ℓ / 4) := by
      apply monotoneOn_clippedSine
      · change 0 ≤ u * (∑ i, ∫ x, |x| ^ 3 ∂μ i) / 4
        positivity
      · change 0 ≤ u * ℓ / 4
        positivity
      · exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hthird hu.1) (by norm_num)
    have hres' : ‖deriv f u + u * f u‖ ≤ 2 * u * M * clippedSine (u * ℓ / 4) :=
      hres.trans (mul_le_mul_of_nonneg_left hsine (by positivity))
    calc
      _ ≤ Real.exp (u ^ 2 / 2) * (2 * u * M * clippedSine (u * ℓ / 4)) :=
