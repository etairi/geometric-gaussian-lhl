/-- Each finite coefficient pair is checked against the already-proved analytic majorant. -/
theorem berryEsseenRationalTangent_correct (i : Fin 65) :
    0 ≤ (berryEsseenRationalTangent i).1 ∧ (berryEsseenRationalTangent i).1 ≤ 1 ∧
    0 ≤ (berryEsseenRationalTangent i).2 ∧
    ((berryEsseenRationalTangent i).1:ℝ) ≤ berryEsseenTangentA (berryEsseenTangentParameter i) ∧
    berryEsseenTangentB (berryEsseenTangentParameter i) ≤ ((berryEsseenRationalTangent i).2:ℝ) := by
  fin_cases i <;> norm_num [berryEsseenRationalTangent, berryEsseenTangentParameter, berryEsseenTangentA, berryEsseenTangentB]

/-- Cell certificates add to an integral certificate, including singular outer endpoints. -/
theorem berryEsseen_integral_le_mesh_sum {f : ℝ → ℝ} {a : ℕ → ℝ} {m n : ℕ}
    (hmn : m ≤ n) (ha : Monotone a)
    (hf : IntervalIntegrable f volume (a m) (a n))
    (c : ℝ) (B : ℕ → ℝ)
    (hB : ∀ i ∈ Finset.Ico m n, c*(∫ t in a i..a (i+1), f t) ≤ B i) :
    c*(∫ t in a m..a n, f t) ≤ ∑ i ∈ Finset.Ico m n, B i := by
  have hint (i : ℕ) (hi : i ∈ Finset.Ico m n) : IntervalIntegrable f volume (a i) (a (i+1)) := by
    rw [Finset.mem_Ico] at hi
    apply hf.mono_set
    rw [uIcc_of_le (ha (Nat.le_succ _)), uIcc_of_le (ha hmn)]
    exact Icc_subset_Icc (ha hi.1) (ha (by omega))
  rw [← intervalIntegral.sum_integral_adjacent_intervals_Ico hmn (fun i hi => hint i (Finset.mem_Ico.mpr hi)), Finset.mul_sum]
  exact Finset.sum_le_sum hB

/-- Uniform-mesh trapezoids are expressed as a sum of adjacent endpoint pairs. -/
theorem berryEsseen_trapezoidal_uniform (f : ℝ → ℝ) {n : ℕ} (hn : 0 < n) (h : ℝ) :
    trapezoidal_integral f n 0 ((n:ℝ)*h) =
      ∑ i ∈ Finset.range n, h/2*(f ((i:ℝ)*h)+f (((i:ℝ)+1)*h)) := by
  have he := sum_trapezoidal_integral_adjacent_intervals (f := f) (a := 0) (h := h) hn
  simpa only [zero_add, trapezoidal_integral_one, add_mul, one_mul,
    add_sub_cancel_left] using he.symm

/-- Certified correction and Gaussian endpoint values bound the whole correction integral. -/
theorem berryEsseen_correction_mesh {U h : ℝ} (hU : 0 ≤ U) (hh : 0 < h)
    {n : ℕ} (hn : 0 < n) (hn1 : (n:ℝ)*h < 3/4)
    (C G : ℕ → ℝ)
    (hC0 : (1/2:ℝ) ≤ C 0)
    (hC : ∀ i, 0 < i → i ≤ n →
      ‖berryEsseenSmoothingKernel ((i:ℝ)*h)-Complex.I/(2*Real.pi*((i:ℝ)*h):ℝ)‖ ≤ C i)
    (hG : ∀ i ≤ n, Real.exp (-(U*((i:ℝ)*h))^2/2) ≤ G i) :
    2*(∫ t in (0:ℝ)..((n:ℝ)*h),
      ‖berryEsseenSmoothingKernel t-Complex.I/(2*Real.pi*t:ℝ)‖*Real.exp (-(U*t)^2/2)) ≤
      (∑ i ∈ Finset.range n, h*(C i*G i+C (i+1)*G (i+1)))+
      ((n:ℝ)*h)*h^2*(150+12*U+U^2)/12 := by
  have hnR : (0:ℝ) < n := by exact_mod_cast hn
  have hnh : 0 < (n:ℝ)*h := mul_pos hnR hh
  have hc (i : ℕ) (hi : i ≤ n) : berryEsseenCorrectionNorm ((i:ℝ)*h) ≤ C i := by
    rcases Nat.eq_zero_or_pos i with rfl | hi0
    · simpa [berryEsseenCorrectionNorm, berryEsseenRegularCorrection] using hC0
    · rw [berryEsseenCorrectionNorm_eq (mul_pos (by exact_mod_cast hi0) hh)
        ((mul_le_mul_of_nonneg_right (by exact_mod_cast hi) hh.le).trans_lt hn1)]
      exact hC i hi0 hi
  have hp (i : ℕ) (hi : i ≤ n) : berryEsseenCorrectionIntegrand U ((i:ℝ)*h) ≤ 2*(C i*G i) := by
    unfold berryEsseenCorrectionIntegrand
    rw [mul_assoc]
    apply mul_le_mul_of_nonneg_left _ (by norm_num : (0:ℝ) ≤ 2)
    exact mul_le_mul (hc i hi) (hG i hi) (Real.exp_pos _).le
      ((berryEsseenCorrectionNorm_nonneg _).trans (hc i hi))
  have htrap : trapezoidal_integral (berryEsseenCorrectionIntegrand U) n 0 ((n:ℝ)*h) ≤
      ∑ i ∈ Finset.range n, h*(C i*G i+C (i+1)*G (i+1)) := by
    rw [berryEsseen_trapezoidal_uniform _ hn h]
    apply Finset.sum_le_sum
    intro i hi
    have hi' := Finset.mem_range.mp hi
    have h := mul_le_mul_of_nonneg_left (add_le_add (hp i (by omega)) (hp (i+1) (by omega))) (by positivity : 0 ≤ h/2)
    push_cast at h
    nlinarith
  have he : ((n:ℝ)*h)^3*(150+12*U+U^2)/(12*(n:ℝ)^2) =
      ((n:ℝ)*h)*h^2*(150+12*U+U^2)/12 := by field_simp
  have hb := berryEsseen_correction_quadrature hU hnh hn1 hn
  rw [he] at hb
  exact hb.trans (add_le_add htrap le_rfl)

/-- Low-frequency cell certificates combine with the analytic pole cancellation. -/
theorem berryEsseen_low_mesh {q U h : ℝ} (hq : 0 ≤ q) (hU : 0 < U) (hh : 0 < h)
    {n : ℕ} (hn : 0 < n) (hn1 : (n:ℝ)*h < 1)
    (hcut : (q^3/4)*(U*((n:ℝ)*h)) ≤ 1)
    (K G I : ℕ → ℝ)
    (hK : ∀ i, 0 < i → i ≤ n → ‖berryEsseenSmoothingKernel ((i:ℝ)*h)‖ ≤ K i)
    (hG : ∀ i ≤ n, Real.exp (-(U*((i:ℝ)*h))^2/2) ≤ G i)
    (hI : ∀ i ≤ n, berryEsseenInnerPrimitive q (U*((i:ℝ)*h)) ≤ I i) :
    2*(∫ t in (0:ℝ)..((n:ℝ)*h),
      ‖berryEsseenSmoothingKernel t‖*berryEsseenNormalErrorBound (q^3) q (U*t)) ≤
      4*U*berryEsseenInnerMajorant q (U*h)*(h/(2*Real.pi)+h^2/64)+
      ∑ i ∈ Finset.Ico 1 n, 4*h*Real.exp ((U*h)^2/8)*
        berryEsseenChordIntegral3 (K i) (K (i+1)) (G i) (G (i+1)) (I i) (I (i+1)) := by
  let f := fun t => ‖berryEsseenSmoothingKernel t‖*berryEsseenNormalErrorBound (q^3) q (U*t)
  have ha : Monotone (fun i : ℕ => (i:ℝ)*h) := fun i j hij =>
    mul_le_mul_of_nonneg_right (by exact_mod_cast hij) hh.le
  have hhn : h ≤ (n:ℝ)*h := by simpa using ha (show 1 ≤ n by omega)
  have hsub : (q^3/4)*(U*h) ≤ 1 :=
    (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hhn hU.le) (by positivity)).trans hcut
  have hf : IntervalIntegrable f volume 0 ((n:ℝ)*h) :=
    intervalIntegrable_smoothing_normalErrorBound _ _ hU (hh.trans_le hhn) hn1
  have hm : h ∈ uIcc (0:ℝ) ((n:ℝ)*h) := by
    rw [uIcc_of_le (hh.le.trans hhn)]
    exact ⟨hh.le,hhn⟩
  have hleft := hf.mono_set (uIcc_subset_uIcc left_mem_uIcc hm)
  have hright := hf.mono_set (uIcc_subset_uIcc hm right_mem_uIcc)
  have hcells := berryEsseen_integral_le_mesh_sum (a := fun i : ℕ => (i:ℝ)*h)
    (by omega : 1 ≤ n) ha (by simpa using hright) 2
    (fun i => 4*h*Real.exp ((U*h)^2/8)*
      berryEsseenChordIntegral3 (K i) (K (i+1)) (G i) (G (i+1)) (I i) (I (i+1)))
    (by
      intro i hi
      obtain ⟨hi0,hin⟩ := Finset.mem_Ico.mp hi
      have hi1 : i+1 ≤ n := by omega
      have hb := (ha hi1).trans_lt hn1
      have hc := (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (ha hi1) hU.le)
        (by positivity : 0 ≤ q^3/4)).trans hcut
      have hcell := berryEsseen_low_cell hq hU.le
        (mul_pos (by exact_mod_cast (show 0 < i by omega)) hh) (ha (Nat.le_succ _)) hb hc
        (hK i (by omega) (by omega)) (hK (i+1) (by omega) hi1)
        (hG i (by omega)) (hG (i+1) hi1) (hI i (by omega)) (hI (i+1) hi1)
      simpa only [f, Nat.cast_succ, Nat.cast_add, Nat.cast_one, add_mul, one_mul, add_sub_cancel_left] using hcell)
  have hfirst := berryEsseen_low_first_cell hq hU hh (hhn.trans_lt hn1) hsub
  have heq := intervalIntegral.integral_add_adjacent_intervals hleft hright
  dsimp [f] at heq
  simp only [Nat.cast_one, one_mul] at hcells
  linarith

/-- High-frequency cell certificates combine with the analytic endpoint bound. -/
theorem berryEsseen_high_mesh {ell U h : ℝ} (hell : 0 ≤ ell) (hU : 0 ≤ U) (hh : 0 < h)
    {n k : ℕ} (hn : 2 ≤ n) (hk : 0 < k) (hkn : k ≤ n-1) (hmesh : (n:ℝ)*h=1)
    (A B K E₀ E₁ : ℕ → ℝ)
    (hA : ∀ i ∈ Finset.Ico k (n-1), 0 ≤ A i)
    (hB : ∀ i ∈ Finset.Ico k (n-1), 0 ≤ B i)
    (hM : ∀ i ∈ Finset.Ico k (n-1), ∀ t ∈ Icc ((i:ℝ)*h) (((i+1:ℕ):ℝ)*h),
      berryEsseenMagnitudeBound ell (U*t) ≤ Real.exp (-(A i)*(U*t)^2+2*(B i)*ell*(U*t)^3))
    (hK : ∀ i, 0 < i → i < n → ‖berryEsseenSmoothingKernel ((i:ℝ)*h)‖ ≤ K i)
    (hE₀ : ∀ i ∈ Finset.Ico k (n-1),
      Real.exp (-(A i)*(U*((i:ℝ)*h))^2+2*(B i)*ell*(U*((i:ℝ)*h))^3) ≤ E₀ i)
    (hE₁ : ∀ i ∈ Finset.Ico k (n-1),
      Real.exp (-(A i)*(U*(((i+1:ℕ):ℝ)*h))^2+2*(B i)*ell*(U*(((i+1:ℕ):ℝ)*h))^3) ≤ E₁ i) :
    2*(∫ t in ((k:ℝ)*h)..1, ‖berryEsseenSmoothingKernel t‖*berryEsseenMagnitudeBound ell (U*t)) ≤
      (∑ i ∈ Finset.Ico k (n-1), 2*h*Real.exp ((A i)*(U*h)^2/4)*
        berryEsseenChordIntegral2 (K i) (K (i+1)) (E₀ i) (E₁ i))+(61/100:ℝ)*h^2 := by
  let f := fun t => ‖berryEsseenSmoothingKernel t‖*berryEsseenMagnitudeBound ell (U*t)
  have ha : StrictMono (fun i : ℕ => (i:ℝ)*h) := fun i j hij =>
    mul_lt_mul_of_pos_right (by exact_mod_cast hij) hh
  have hend : ((n-1:ℕ):ℝ)*h = 1-h := by
    rw [Nat.cast_sub (by omega : 1 ≤ n), Nat.cast_one, sub_mul, hmesh, one_mul]
  have hhhalf : h ≤ 1/2 := by
    have hnR : (2:ℝ) ≤ n := by exact_mod_cast hn
    nlinarith
  have hk0 : 0 < (k:ℝ)*h := mul_pos (by exact_mod_cast hk) hh
  have hk1 : (k:ℝ)*h < 1 := by simpa [hmesh] using ha (show k < n by omega)
  have hf : IntervalIntegrable f volume ((k:ℝ)*h) 1 := intervalIntegrable_smoothing_magnitudeBound _ _ hk0 hk1
  have hm : ((n-1:ℕ):ℝ)*h ∈ uIcc ((k:ℝ)*h) 1 := by
    rw [uIcc_of_le hk1.le]
    exact ⟨ha.monotone hkn, by rw [hend]; linarith⟩
  have hleft := hf.mono_set (uIcc_subset_uIcc left_mem_uIcc hm)
  have hright := hf.mono_set (uIcc_subset_uIcc hm right_mem_uIcc)
  have hcells := berryEsseen_integral_le_mesh_sum hkn ha.monotone hleft 2
    (fun i => 2*h*Real.exp ((A i)*(U*h)^2/4)*berryEsseenChordIntegral2 (K i) (K (i+1)) (E₀ i) (E₁ i))
    (by
      intro i hi
      obtain ⟨hki,hin⟩ := Finset.mem_Ico.mp hi
      have hi0 : 0 < i := hk.trans_le hki
      have hi1 : i+1 < n := by omega
      have hb : ((i+1:ℕ):ℝ)*h < 1 := by simpa [hmesh] using ha hi1
      have hcell := berryEsseen_high_cell
        (mul_pos (by exact_mod_cast hi0) hh) (ha.monotone (Nat.le_succ _)) hb hU
        (hA i hi) (hB i hi) hell (hM i hi) (hK i hi0 (by omega))
        (hK (i+1) (by omega) hi1) (hE₀ i hi) (hE₁ i hi)
      simpa only [f, Nat.cast_succ, Nat.cast_add, Nat.cast_one, add_mul, one_mul, add_sub_cancel_left] using hcell)
  have hlast := berryEsseen_high_last_cell (ell := ell) (U := U)
    (show 1/2 ≤ ((n-1:ℕ):ℝ)*h by rw [hend]; linarith)
    (show ((n-1:ℕ):ℝ)*h < 1 by rw [hend]; linarith)
  have hcancel : 1-((n-1:ℕ):ℝ)*h = h := by rw [hend]; ring
  rw [hcancel] at hlast
  have heq := intervalIntegral.integral_add_adjacent_intervals hleft hright
  dsimp [f] at heq
  linarith

/-- A finite Gaussian-tail mesh and its analytic remainder use only positive endpoint bounds. -/
theorem berryEsseen_tail_mesh {U h p : ℝ} (hU : 0 < U) (hh : 0 < h)
    (hp : 0 < p) (hpi : p ≤ Real.pi) {k : ℕ} (hk : 0 < k)
    (m : ℕ) (G : ℕ → ℝ)
    (hG : ∀ i ≤ m, Real.exp (-(U*(((k+i:ℕ):ℝ)*h))^2/2) ≤ G (k+i)) :
    (∫ t in Ioi ((k:ℝ)*h), (1/(Real.pi*t))*Real.exp (-(U*t)^2/2)) ≤
      (∑ i ∈ Finset.range m, h/2*(G (k+i)/(p*(((k+i:ℕ):ℝ)*h))+
        G (k+i+1)/(p*(((k+i+1:ℕ):ℝ)*h))))+
      G (k+m)/(p*(U*(((k+m:ℕ):ℝ)*h))^2) := by
  let a (i : ℕ) : ℝ := ((k+i:ℕ):ℝ)*h
  have ha : Monotone a := fun i j hij =>
    mul_le_mul_of_nonneg_right (by exact_mod_cast Nat.add_le_add_left hij k) hh.le
  have ha0 (i : ℕ) : 0 < a i := mul_pos (by exact_mod_cast (show 0 < k+i by omega)) hh
  have hpoint (i : ℕ) (hi : i ≤ m) :
      (1/(Real.pi*a i))*Real.exp (-(U*a i)^2/2) ≤ G (k+i)/(p*a i) := by
    have hden : 0 < p*a i := mul_pos hp (ha0 i)
    rw [one_div_mul_eq_div]
    exact div_le_div₀ ((Real.exp_pos _).le.trans (hG i hi)) (hG i hi) hden
      (mul_le_mul_of_nonneg_right hpi (ha0 i).le)
  have hsum :
      (∑ i ∈ Finset.range m, (a (i+1)-a i)/2*
        ((1/(Real.pi*a i))*Real.exp (-(U*a i)^2/2)+
          (1/(Real.pi*a (i+1)))*Real.exp (-(U*a (i+1))^2/2))) ≤
      ∑ i ∈ Finset.range m, h/2*(G (k+i)/(p*(((k+i:ℕ):ℝ)*h))+
        G (k+i+1)/(p*(((k+i+1:ℕ):ℝ)*h))) := by
    apply Finset.sum_le_sum
    intro i hi
    have hi' := Finset.mem_range.mp hi
    have heq : a (i+1)-a i=h := by dsimp [a]; push_cast; ring
    rw [heq]
    have h := mul_le_mul_of_nonneg_left (add_le_add (hpoint i (by omega)) (hpoint (i+1) (by omega))) (by positivity : 0 ≤ h/2)
    simpa only [a, Nat.add_assoc] using h
  have hrem : Real.exp (-(U*a m)^2/2)/(Real.pi*(U*a m)^2) ≤ G (k+m)/(p*(U*a m)^2) :=
    div_le_div₀ ((Real.exp_pos _).le.trans (hG m le_rfl)) (hG m le_rfl) (by positivity)
      (mul_le_mul_of_nonneg_right hpi (sq_nonneg _))
  have ht := berryEsseen_tail_quadrature (n := m) hU a (ha0 0) ha
  have h := ht.trans (add_le_add hsum hrem)
  simpa only [a, Nat.add_zero] using h

/-- Every indexed interior entry of a witness chunk is checked at its global mesh index. -/
def berryEsseenKernelChunkPoints (N start : ℕ) (data : List BerryEsseenKernelWitness) : Bool :=
  (data.zipIdx start).all (fun p => decide (0 < p.2 ∧ p.2 < N → BerryEsseenKernelWitness.Point N p.2 p.1))

/-- Point checks compose without reevaluating the certified rational arithmetic. -/
theorem berryEsseenKernelChunkPoints_append (N start : ℕ) (a b : List BerryEsseenKernelWitness)
    (ha : berryEsseenKernelChunkPoints N start a = true)
    (hb : berryEsseenKernelChunkPoints N (start+a.length) b = true) :
    berryEsseenKernelChunkPoints N start (a++b) = true := by
  simpa only [berryEsseenKernelChunkPoints, List.zipIdx_append, List.all_append,
    Bool.and_eq_true] using And.intro ha hb

/-- A chain of local rotations and separately checked points yield the global table certificate. -/
theorem berryEsseenKernelWitnessCheck_of_chain {N : ℕ} (step : BerryEsseenKernelWitness)
    (data : List BerryEsseenKernelWitness)
    (hS : step.state.1.Encloses (berryEsseenMeshTrigInterval true N))
    (hC : step.state.2.Encloses (berryEsseenMeshTrigInterval false N))
    (hlen : data.length=N+1) (hzero : data.head!.Initial)
    (hchain : data.IsChain (BerryEsseenKernelWitness.Step step.state.1 step.state.2))
    (hpoints : berryEsseenKernelChunkPoints N 0 data = true) :
    berryEsseenKernelWitnessCheck N step data.toArray = true := by
  simp only [berryEsseenKernelWitnessCheck, Bool.and_eq_true, decide_eq_true_eq,
    beq_iff_eq, List.size_toArray]
  refine ⟨⟨⟨⟨⟨hS,hC⟩,hlen⟩,?_⟩,?_⟩,?_⟩
  · simpa only [List.getElem!_toArray, List.head!_eq_getElem!] using hzero
  · apply List.all_eq_true.mpr
    intro i hi
    have hiN := List.mem_range.mp hi
    have hi0 : i < data.length := by omega
    have hi1 : i+1 < data.length := by omega
    have h := List.isChain_iff_getElem.mp hchain i hi1
    rw [decide_eq_true_eq]
    simpa only [List.getElem!_toArray, getElem!_pos data i hi0,
      getElem!_pos data (i+1) hi1] using h
  · apply List.all_eq_true.mpr
    intro i hi
    have hiN := List.mem_range.mp hi
    have hi1 : i+1 < data.length := by omega
    have hforall := List.all_eq_true.mp hpoints
    have h := (List.forall_mem_zipIdx.mp hforall) (i+1) hi1
    have hp := of_decide_eq_true h
    simp only [Nat.zero_add] at hp
    rw [decide_eq_true_eq]
    simpa only [List.getElem!_toArray, getElem!_pos data (i+1) hi1] using hp ⟨by omega,by omega⟩

/-- Joining checked chunks requires only their shared boundary transition. -/
theorem berryEsseenKernelChain_append {step : BerryEsseenKernelWitness}
    {a b : List BerryEsseenKernelWitness}
    (ha : a.IsChain (BerryEsseenKernelWitness.Step step.state.1 step.state.2))
    (hb : b.IsChain (BerryEsseenKernelWitness.Step step.state.1 step.state.2))
    (hab : BerryEsseenKernelWitness.Step step.state.1 step.state.2 a.getLast! b.head!) :
    (a++b).IsChain (BerryEsseenKernelWitness.Step step.state.1 step.state.2) := by
  apply ha.append hb
  intro x hx y hy
  have hx' : a.getLast! = x := by simp [List.getLast!_eq_getLast?_getD, Option.mem_def.mp hx]
  have hy' : b.head! = y := by simp [List.head!_eq_head?_getD, Option.mem_def.mp hy]
  simpa only [hx',hy'] using hab

/-- Boolean rotation checks give the corresponding proof of a chain. -/
theorem berryEsseenKernelChain_of_steps (step : BerryEsseenKernelWitness)
    (data : List BerryEsseenKernelWitness)
    (h : (data.zip data.tail).all (fun p => decide
      (BerryEsseenKernelWitness.Step step.state.1 step.state.2 p.1 p.2)) = true) :
    data.IsChain (BerryEsseenKernelWitness.Step step.state.1 step.state.2) := by
  rw [List.isChain_iff_getElem]
  intro i hi
  have hiz : i < (data.zip data.tail).length := by
    simp only [List.length_zip, List.length_tail]
    omega
  have hp := of_decide_eq_true (List.all_eq_true.mp h _ (List.getElem_mem hiz))
  simpa only [List.getElem_zip, List.getElem_tail] using hp

/-- Every choice is a globally valid characteristic-function majorant. -/
inductive BerryEsseenPhase where
  | cubic
  | tangent (i : Fin 65)
  | unit
  deriving DecidableEq, Inhabited

/-- Rational coefficients for the selectable upper exponent. -/
def BerryEsseenPhase.coefficients : BerryEsseenPhase → ℚ × ℚ
  | .cubic => (1/2,49581/500000)
  | .tangent i => berryEsseenRationalTangent i
  | .unit => (0,0)

theorem BerryEsseenPhase.coefficients_bounds (p : BerryEsseenPhase) :
    0 ≤ p.coefficients.1 ∧ p.coefficients.1 ≤ 1 ∧ 0 ≤ p.coefficients.2 := by
  cases p with
  | cubic => norm_num [coefficients]
  | unit => norm_num [coefficients]
  | tangent i => exact ⟨(berryEsseenRationalTangent_correct i).1,
      (berryEsseenRationalTangent_correct i).2.1, (berryEsseenRationalTangent_correct i).2.2.1⟩

/-- Rational coefficient rounding preserves the analytic magnitude envelope. -/
theorem BerryEsseenPhase.magnitude_le (p : BerryEsseenPhase) {ell u : ℝ}
    (hell : 0 ≤ ell) (hu : 0 ≤ u) :
    berryEsseenMagnitudeBound ell u ≤
      Real.exp (-(p.coefficients.1:ℝ)*u^2+2*(p.coefficients.2:ℝ)*ell*u^3) := by
  cases p with
  | unit =>
    have h : berryEsseenMagnitudeBound ell u ≤ 1 := min_le_left _ _
    simpa only [coefficients, Rat.cast_zero, neg_zero, zero_mul, mul_zero, add_zero, Real.exp_zero] using h
  | cubic =>
    have h : berryEsseenMagnitudeBound ell u ≤ Real.exp (-u^2/2+(49581/250000:ℝ)*ell*|u|^3) :=
      (min_le_right _ _).trans (min_le_left _ _)
    convert! h using 1
    norm_num [coefficients, abs_of_nonneg hu]
    ring
  | tangent i =>
    have h : berryEsseenMagnitudeBound ell u ≤
        Real.exp (-berryEsseenTangentA (berryEsseenTangentParameter i)*u^2+
          2*berryEsseenTangentB (berryEsseenTangentParameter i)*ell*|u|^3) :=
      ((min_le_right _ _).trans (min_le_right _ _)).trans (Finset.inf'_le _ (Finset.mem_univ i))
    refine h.trans (Real.exp_le_exp.mpr ?_)
    rw [abs_of_nonneg hu]
    have hc := berryEsseenRationalTangent_correct i
    have h1 := mul_le_mul_of_nonneg_right hc.2.2.2.1 (sq_nonneg u)
    have h2 := mul_le_mul_of_nonneg_right hc.2.2.2.2 (by positivity : 0 ≤ 2*ell*u^3)
    dsimp [coefficients]
    nlinarith

/-- The capped inner exponent, in exact rational arithmetic. -/
def berryEsseenRationalCappedExponent (q u : ℚ) : ℚ :=
  (u*q)^2/2+(max (u*q-250000/148743) 0)^2/2+
    (49581/250000:ℚ)*(max (u*q-250000/148743) 0)^3

theorem berryEsseenRationalCappedExponent_cast (q u : ℚ) :
    (berryEsseenRationalCappedExponent q u:ℝ) = berryEsseenCappedExponent q u := by
  rw [berryEsseenCappedExponent_eq]
  simp only [berryEsseenRationalCappedExponent, Rat.cast_add, Rat.cast_div, Rat.cast_pow,
    Rat.cast_mul, Rat.cast_sub, Rat.cast_zero, Rat.cast_ofNat, Rat.cast_max]

/-- The inner polynomial weight is evaluated exactly before exponential rounding. -/
def berryEsseenRationalInnerWeight (q u : ℚ) : ℚ :=
  (q^3/4)*u^2-(q^3/4)^3*u^4/6+(q^3/4)^5*u^6/120

theorem berryEsseenRationalInnerWeight_cast (q u : ℚ) :
    (berryEsseenRationalInnerWeight q u:ℝ) = berryEsseenInnerWeight ((q:ℝ)^3/4) u := by
  simp only [berryEsseenRationalInnerWeight, berryEsseenInnerWeight, Rat.cast_add, Rat.cast_div,
    Rat.cast_pow, Rat.cast_mul, Rat.cast_sub, Rat.cast_ofNat]

/-- An executable upper bound for each inner-integrand endpoint. -/
def berryEsseenRationalInnerUpper (q u : ℚ) : ℚ :=
  berryEsseenRationalInnerWeight q u * berryEsseenExpUpper (berryEsseenRationalCappedExponent q u)

theorem berryEsseenRationalInnerUpper_correct {q u : ℚ}
    (hq : 0 ≤ q) (hu : 0 ≤ u) (hcut : (q^3/4)*u ≤ 1)
    (hexp : berryEsseenRationalCappedExponent q u ≤ 40) :
    berryEsseenInnerMajorant q u ≤ (berryEsseenRationalInnerUpper q u:ℝ) := by
  have hqR : (0:ℝ) ≤ q := by exact_mod_cast hq
  have huR : (0:ℝ) ≤ u := by exact_mod_cast hu
  have hcutR : ((q:ℝ)^3/4)*(u:ℝ) ≤ 1 := by exact_mod_cast hcut
  have he := berryEsseen_exp_le_fast_upper hexp
  rw [berryEsseenRationalCappedExponent_cast] at he
  unfold berryEsseenRationalInnerUpper berryEsseenInnerMajorant
  rw [Rat.cast_mul, berryEsseenRationalInnerWeight_cast]
  exact mul_le_mul_of_nonneg_left he (berryEsseenInnerWeight_nonneg (by positivity) huR hcutR)

/-- A rational Gaussian endpoint bound requires no side condition. -/
def berryEsseenRationalGaussianUpper (u : ℚ) : ℚ := berryEsseenExpUpper (-u^2/2)

theorem berryEsseenRationalGaussianUpper_correct (u : ℚ) :
    Real.exp (-(u:ℝ)^2/2) ≤ (berryEsseenRationalGaussianUpper u:ℝ) := by
  have h : -u^2/2 ≤ 40 := by nlinarith [sq_nonneg u]
  simpa only [berryEsseenRationalGaussianUpper, Rat.cast_div, Rat.cast_neg, Rat.cast_pow,
    Rat.cast_ofNat] using berryEsseen_exp_le_fast_upper h

/-- Trapezoidal prefix sums use executable upper bounds at the inner mesh points. -/
def berryEsseenRationalInnerPrefix (q d : ℚ) (n : ℕ) : ℚ :=
  ∑ i ∈ Finset.range n, d/2*(berryEsseenRationalInnerUpper q ((i:ℚ)*d)+
    berryEsseenRationalInnerUpper q (((i:ℚ)+1)*d))

theorem berryEsseenRationalInnerPrefix_correct {q d : ℚ} (hq : 0 ≤ q) (hd : 0 ≤ d)
    (n : ℕ) (hcut : (q^3/4)*((n:ℚ)*d) ≤ 1)
    (hexp : berryEsseenRationalCappedExponent q ((n:ℚ)*d) ≤ 40) :
    berryEsseenInnerPrimitive q ((n:ℝ)*(d:ℝ)) ≤ (berryEsseenRationalInnerPrefix q d n:ℝ) := by
  have hqR : (0:ℝ) ≤ q := by exact_mod_cast hq
  have hdR : (0:ℝ) ≤ d := by exact_mod_cast hd
  have ha : Monotone (fun i : ℕ => (i:ℚ)*d) := fun i j hij =>
    mul_le_mul_of_nonneg_right (by exact_mod_cast hij) hd
  have hb (i : ℕ) (hi : i ≤ n) :
      berryEsseenInnerMajorant q ((i:ℝ)*(d:ℝ)) ≤
        (berryEsseenRationalInnerUpper q ((i:ℚ)*d):ℝ) := by
    have hcut' := (mul_le_mul_of_nonneg_left (ha hi) (by positivity : 0 ≤ q^3/4)).trans hcut
    have hexpR : berryEsseenCappedExponent q ((i:ℝ)*(d:ℝ)) ≤ 40 := by
      have hx : berryEsseenCappedExponent q ((n:ℝ)*(d:ℝ)) ≤ 40 := by
        simpa only [berryEsseenRationalCappedExponent_cast, Rat.cast_mul, Rat.cast_natCast] using
          (show (berryEsseenRationalCappedExponent q ((n:ℚ)*d):ℝ) ≤ 40 by exact_mod_cast hexp)
      exact (berryEsseenCappedExponent_monotone hqR (by change (0:ℝ) ≤ (i:ℝ)*(d:ℝ); positivity) (by change (0:ℝ) ≤ (n:ℝ)*(d:ℝ); positivity)
