    (hthird : (∑ i, ∫ x, |x|^3 ∂μ i)≤ell) (x : ℝ) :
    |cdf ((Measure.pi μ).map (fun z => ∑ i,z i)) x-cdf (gaussianReal 0 1) x| ≤
      (14/25:ℝ)*ell :=
