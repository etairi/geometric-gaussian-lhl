/-- The certified kernel-norm endpoint table on the 2,000-cell mesh. -/
def berryEsseenKernelUpper (i : ℕ) : ℚ := ((witnessTail0.toArray[i]!).kernel:ℚ)/10^12
/-- The certified correction-norm endpoint table on the same mesh. -/
def berryEsseenCorrectionUpper (i : ℕ) : ℚ := ((witnessTail0.toArray[i]!).correction:ℚ)/10^12

/-- Each interior endpoint value is an upper bound on the actual complex kernel norms. -/
theorem berryEsseenKernelUpper_correct (i : ℕ) (hi : 0 < i) (hiN : i < 2000) :
    ‖berryEsseenSmoothingKernel ((i:ℝ)/2000)‖ ≤ (berryEsseenKernelUpper i:ℝ) ∧
      ‖berryEsseenSmoothingKernel ((i:ℝ)/2000)-Complex.I/(2*Real.pi*((i:ℝ)/2000):ℝ)‖ ≤
        (berryEsseenCorrectionUpper i:ℝ) := by
  have h := berryEsseenKernelWitnessCheck_correct (by norm_num : 0 < (2000:ℕ))
    stepWitness witnessTail0.toArray pointWitnesses_checked i hi hiN
  simpa only [berryEsseenKernelUpper, berryEsseenCorrectionUpper, Rat.cast_div,
    Rat.cast_natCast, Rat.cast_pow, Rat.cast_ofNat, Nat.cast_ofNat] using h

/-- The correction has its smooth limiting value at the origin. -/
theorem berryEsseenCorrectionUpper_zero : berryEsseenCorrectionUpper 0 = 1/2 := by decide +kernel

theorem berryEsseenKernelUpper_nonneg (i : ℕ) : 0 ≤ berryEsseenKernelUpper i := by
  unfold berryEsseenKernelUpper
  positivity

theorem berryEsseenCorrectionUpper_nonneg (i : ℕ) : 0 ≤ berryEsseenCorrectionUpper i := by
  unfold berryEsseenCorrectionUpper
  positivity

end BerryEsseenKernelValues

section BerryEsseenRowAssembly
open MeasureTheory ProbabilityTheory Set
open scoped BigOperators Interval Topology NNReal ENNReal

/-- The rational capped exponent inherits the proved real monotonicity. -/
theorem berryEsseenRationalCappedExponent_mono {q u v : ℚ} (hq : 0 ≤ q)
    (hu : 0 ≤ u) (huv : u ≤ v) :
    berryEsseenRationalCappedExponent q u ≤ berryEsseenRationalCappedExponent q v := by
  have h := berryEsseenCappedExponent_monotone (q := (q:ℝ))
    (by exact_mod_cast hq) (show (u:ℝ) ∈ Ici 0 by change (0:ℝ) ≤ u; exact_mod_cast hu)
    (show (v:ℝ) ∈ Ici 0 by change (0:ℝ) ≤ v; exact_mod_cast hu.trans huv) (by exact_mod_cast huv)
  rw [← berryEsseenRationalCappedExponent_cast, ← berryEsseenRationalCappedExponent_cast] at h
  exact_mod_cast h

/-- Rational low-frequency quadrature includes a separate analytic bound at the pole. -/
def berryEsseenRationalLowBound (q U h p : ℚ) (n : ℕ) (K : ℕ → ℚ) : ℚ :=
  4*U*berryEsseenRationalInnerUpper q (U*h)*(h/(2*p)+h^2/64)+
  ∑ i ∈ Finset.Ico 1 n, 4*h*berryEsseenExpUpper ((U*h)^2/8)*
    berryEsseenRationalChord3 (K i) (K (i+1))
      (berryEsseenRationalGaussianUpper (U*((i:ℚ)*h)))
      (berryEsseenRationalGaussianUpper (U*(((i:ℚ)+1)*h)))
      (berryEsseenRationalInnerPrefix q (U*h) i)
      (berryEsseenRationalInnerPrefix q (U*h) (i+1))

theorem berryEsseenRationalLowBound_correct {q U h p : ℚ}
    (hq : 0 ≤ q) (hU : 0 < U) (hh : 0 < h) (hp : 0 < p) (hpi : (p:ℝ) ≤ Real.pi)
    {n : ℕ} (hn : 0 < n) (hn1 : (n:ℚ)*h < 1)
    (hcut : (q^3/4)*((n:ℚ)*(U*h)) ≤ 1)
    (hexp : berryEsseenRationalCappedExponent q ((n:ℚ)*(U*h)) ≤ 40)
    (hchord : (U*h)^2/8 ≤ 40) (K : ℕ → ℚ)
    (hK : ∀ i, 0 < i → i ≤ n → ‖berryEsseenSmoothingKernel ((i:ℝ)*(h:ℝ))‖ ≤ (K i:ℝ)) :
    2*(∫ t in (0:ℝ)..((n:ℝ)*(h:ℝ)),
      ‖berryEsseenSmoothingKernel t‖*berryEsseenNormalErrorBound ((q:ℝ)^3) q ((U:ℝ)*t)) ≤
      (berryEsseenRationalLowBound q U h p n K:ℝ) := by
  have hqR : (0:ℝ) ≤ q := by exact_mod_cast hq
  have hUR : (0:ℝ) < U := by exact_mod_cast hU
  have hhR : (0:ℝ) < h := by exact_mod_cast hh
  have hpR : (0:ℝ) < p := by exact_mod_cast hp
  have hd : 0 ≤ U*h := mul_nonneg hU.le hh.le
  have hcuti (i : ℕ) (hi : i ≤ n) : (q^3/4)*((i:ℚ)*(U*h)) ≤ 1 :=
    (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (by exact_mod_cast hi) hd) (by positivity)).trans hcut
  have hexpi (i : ℕ) (hi : i ≤ n) : berryEsseenRationalCappedExponent q ((i:ℚ)*(U*h)) ≤ 40 :=
    (berryEsseenRationalCappedExponent_mono hq (by positivity)
      (mul_le_mul_of_nonneg_right (by exact_mod_cast hi) hd)).trans hexp
  let G (i : ℕ) : ℚ := berryEsseenRationalGaussianUpper (U*((i:ℚ)*h))
  let I (i : ℕ) : ℚ := berryEsseenRationalInnerPrefix q (U*h) i
  have hG (i : ℕ) : Real.exp (-((U:ℝ)*((i:ℝ)*(h:ℝ)))^2/2) ≤ (G i:ℝ) := by
    simpa only [G, Rat.cast_mul, Rat.cast_natCast] using berryEsseenRationalGaussianUpper_correct (U*((i:ℚ)*h))
  have hI (i : ℕ) (hi : i ≤ n) : berryEsseenInnerPrimitive q ((U:ℝ)*((i:ℝ)*(h:ℝ))) ≤ (I i:ℝ) := by
    have hb := berryEsseenRationalInnerPrefix_correct hq hd i (hcuti i hi) (hexpi i hi)
    convert! hb using 1
    push_cast
    congr 1
    ring
  have hcutR (i : ℕ) (hi : i ≤ n) : ((q:ℝ)^3/4)*((U:ℝ)*((i:ℝ)*(h:ℝ))) ≤ 1 := by
    have hc : ((q:ℝ)^3/4)*((i:ℝ)*((U:ℝ)*(h:ℝ))) ≤ 1 := by exact_mod_cast hcuti i hi
    convert! hc using 1; ring
  have hbase := berryEsseen_low_mesh hqR hUR hhR hn (by exact_mod_cast hn1) (hcutR n le_rfl)
    (fun i => (K i:ℝ)) (fun i => (G i:ℝ)) (fun i => (I i:ℝ)) hK (fun i _ => hG i) hI
  have hfirstF : berryEsseenInnerMajorant q ((U:ℝ)*(h:ℝ)) ≤
      (berryEsseenRationalInnerUpper q (U*h):ℝ) := by
    have hc : (q^3/4)*(U*h) ≤ 1 := by simpa using hcuti 1 (by omega)
    have he : berryEsseenRationalCappedExponent q (U*h) ≤ 40 := by simpa using hexpi 1 (by omega)
    simpa only [Rat.cast_mul] using berryEsseenRationalInnerUpper_correct hq hd hc he
  have hfirst0 : 0 ≤ berryEsseenInnerMajorant q ((U:ℝ)*(h:ℝ)) := by
    unfold berryEsseenInnerMajorant
    exact mul_nonneg (berryEsseenInnerWeight_nonneg (by positivity) (by positivity)
      (by simpa using hcutR 1 (by omega))) (Real.exp_pos _).le
  have hfirst :
      4*(U:ℝ)*berryEsseenInnerMajorant q ((U:ℝ)*(h:ℝ))*((h:ℝ)/(2*Real.pi)+(h:ℝ)^2/64) ≤
      ((4*U*berryEsseenRationalInnerUpper q (U*h)*(h/(2*p)+h^2/64):ℚ):ℝ) := by
    push_cast
    apply mul_le_mul
    · exact mul_le_mul_of_nonneg_left hfirstF (by positivity)
    · exact add_le_add (div_le_div_of_nonneg_left hhR.le (by positivity)
        (mul_le_mul_of_nonneg_left hpi (by norm_num : (0:ℝ) ≤ 2))) le_rfl
    · positivity
    · exact mul_nonneg (by positivity) (hfirst0.trans hfirstF)
  refine hbase.trans ?_
  unfold berryEsseenRationalLowBound
  rw [Rat.cast_add]
  apply add_le_add hfirst
  rw [Rat.cast_sum]
  apply Finset.sum_le_sum
  intro i hi
  obtain ⟨hi0,hin⟩ := Finset.mem_Ico.mp hi
  have hi1 : i+1 ≤ n := by omega
  have hkn0 := (norm_nonneg _).trans (hK i (by omega) (by omega))
  have hkn1 := (norm_nonneg _).trans (hK (i+1) (by omega) hi1)
  have hg0 := (Real.exp_pos _).le.trans (hG i)
  have hg1 := (Real.exp_pos _).le.trans (hG (i+1))
  have hi₀ : (0:ℝ) ≤ I i :=
    (berryEsseenInnerPrimitive_nonneg hqR (by positivity) (hcutR i (by omega))).trans (hI i (by omega))
  have hi₁ : (0:ℝ) ≤ I (i+1) :=
    (berryEsseenInnerPrimitive_nonneg hqR (by positivity) (hcutR (i+1) hi1)).trans (hI (i+1) hi1)
  have hc := berryEsseenChordIntegral3_nonneg hkn0 hkn1 hg0 hg1 hi₀ hi₁
  have he : Real.exp (((U:ℝ)*(h:ℝ))^2/8) ≤ (berryEsseenExpUpper ((U*h)^2/8):ℝ) := by
    simpa only [Rat.cast_div, Rat.cast_pow, Rat.cast_mul, Rat.cast_ofNat] using berryEsseen_exp_le_fast_upper hchord
  have h := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left he (by positivity : 0 ≤ 4*(h:ℝ))) hc
  simpa only [Rat.cast_mul, Rat.cast_ofNat, berryEsseenRationalChord3_cast, G, I,
    Nat.cast_add, Nat.cast_one] using h

/-- The midpoint chooses a nearby tangent; every possible choice is already certified. -/
def berryEsseenSuggestedPhase (ell U h : ℚ) (i : ℕ) : BerryEsseenPhase :=
  let z := ell*U*((2*(i:ℚ)+1)*h)
  if z ≤ 4 then .cubic else
    .tangent ⟨min 64 (⌊(z-4)*256/9+1/2⌋).toNat, by omega⟩

/-- A nonnegative exponent is safely replaced by the universal unit bound. -/
def berryEsseenSelectedPhase (ell U h : ℚ) (i : ℕ) : BerryEsseenPhase :=
  let p := berryEsseenSuggestedPhase ell U h i
  if max (berryEsseenRationalPhaseExponent p ell (U*((i:ℚ)*h)))
      (berryEsseenRationalPhaseExponent p ell (U*(((i:ℚ)+1)*h))) ≤ 0 then p else .unit

/-- Both exponential arguments are within the certified evaluator range. -/
theorem berryEsseenSelectedPhase_nonpos (ell U h : ℚ) (i : ℕ) :
    berryEsseenRationalPhaseExponent (berryEsseenSelectedPhase ell U h i) ell (U*((i:ℚ)*h)) ≤ 0 ∧
      berryEsseenRationalPhaseExponent (berryEsseenSelectedPhase ell U h i) ell (U*(((i:ℚ)+1)*h)) ≤ 0 := by
  dsimp only [berryEsseenSelectedPhase]
  split
  · rename_i ht
    exact max_le_iff.mp ht
  · simp [berryEsseenRationalPhaseExponent, BerryEsseenPhase.coefficients]

/-- One finite row of the moment-parameter cover. -/
structure BerryEsseenNumericalRow where
  lower : ℚ
  upper : ℚ
  frequency : ℚ
  cutoff : ℕ
  tailEnd : ℕ
  deriving DecidableEq, Inhabited

/-- The complete rational enclosure of all four smoothing-integral terms. -/
def BerryEsseenNumericalRow.bound (r : BerryEsseenNumericalRow) : ℚ :=
  let h : ℚ := 1/2000
  let p := berryEsseenPiInterval.lo
  berryEsseenRationalLowBound r.upper r.frequency h p r.cutoff berryEsseenKernelUpper+
    berryEsseenRationalHighBound (r.upper^3) r.frequency h 2000 r.cutoff berryEsseenKernelUpper
      (berryEsseenSelectedPhase (r.upper^3) r.frequency h)+
    berryEsseenRationalCorrectionBound r.frequency h r.cutoff berryEsseenCorrectionUpper+
    berryEsseenRationalTailBound r.frequency h p r.cutoff (r.tailEnd-r.cutoff)

/-- Finite side conditions and one rational comparison are the entire row certificate. -/
def BerryEsseenNumericalRow.Check (r : BerryEsseenNumericalRow) : Prop :=
  0 ≤ r.lower ∧ r.lower ≤ r.upper ∧ 0 < r.frequency ∧
  0 < r.cutoff ∧ r.cutoff < 1500 ∧ r.cutoff ≤ r.tailEnd ∧
  (r.upper^3/4)*((r.cutoff:ℚ)*(r.frequency*(1/2000))) ≤ 1 ∧
  berryEsseenRationalCappedExponent r.upper ((r.cutoff:ℚ)*(r.frequency*(1/2000))) ≤ 40 ∧
  (r.frequency*(1/2000))^2/4 ≤ 40 ∧
  r.bound ≤ (14/25:ℚ)*r.lower^3

instance (r : BerryEsseenNumericalRow) : Decidable r.Check := inferInstanceAs (Decidable (_ ∧ _))

/-- A checked rational row bounds the actual smoothing envelope, with no numerical assumptions left. -/
theorem BerryEsseenNumericalRow.correct (r : BerryEsseenNumericalRow) (hr : r.Check) :
    0 ≤ (r.upper:ℝ) ∧ 0 < (r.frequency:ℝ) ∧ 0 < (r.cutoff:ℝ)/2000 ∧ (r.cutoff:ℝ)/2000 < 1 ∧
      berryEsseenCDFErrorBound ((r.upper:ℝ)^3) r.upper r.frequency ((r.cutoff:ℝ)/2000) ≤
        (14/25:ℝ)*(r.lower:ℝ)^3 := by
  obtain ⟨hlower,hlowerupper,hU,hk,hkN,_hkm,hcut,hexp,hchord,hbound⟩ := hr
  have hq : 0 ≤ r.upper := hlower.trans hlowerupper
  have hqR : (0:ℝ) ≤ r.upper := by exact_mod_cast hq
  have hUR : (0:ℝ) < r.frequency := by exact_mod_cast hU
  have hkR : (0:ℝ) < r.cutoff := by exact_mod_cast hk
  have hkR1 : (r.cutoff:ℝ) < 1500 := by exact_mod_cast hkN
  have hkτ : (r.cutoff:ℚ)*(1/2000) < 3/4 := by
    have hkr : (r.cutoff:ℚ) < 1500 := by exact_mod_cast hkN
    nlinarith
  have hkτ1 : (r.cutoff:ℚ)*(1/2000) < 1 := hkτ.trans (by norm_num)
  have hπ : ((berryEsseenPiInterval.lo:ℚ):ℝ) ≤ Real.pi := berryEsseenPiInterval_correct.1
  have hp : 0 < berryEsseenPiInterval.lo := by norm_num [berryEsseenPiInterval]
  have hkernel (i : ℕ) (hi : 0 < i) (hin : i < 2000) :
      ‖berryEsseenSmoothingKernel ((i:ℝ)*((1/2000:ℚ):ℝ))‖ ≤ (berryEsseenKernelUpper i:ℝ) := by
    simpa only [Rat.cast_div, Rat.cast_one, Rat.cast_ofNat, mul_one_div] using
      (berryEsseenKernelUpper_correct i hi hin).1
  have hcorr (i : ℕ) (hi : 0 < i) (hin : i ≤ r.cutoff) :
      ‖berryEsseenSmoothingKernel ((i:ℝ)*((1/2000:ℚ):ℝ))-
        Complex.I/(2*Real.pi*((i:ℝ)*((1/2000:ℚ):ℝ)):ℝ)‖ ≤ (berryEsseenCorrectionUpper i:ℝ) := by
    simpa only [Rat.cast_div, Rat.cast_one, Rat.cast_ofNat, mul_one_div] using
      (berryEsseenKernelUpper_correct i hi (by omega)).2
  have hlow := berryEsseenRationalLowBound_correct hq hU (by norm_num : (0:ℚ)<1/2000)
    hp hπ hk hkτ1 hcut hexp (show (r.frequency*(1/2000))^2/8 ≤ 40 by nlinarith [sq_nonneg (r.frequency*(1/2000))])
    berryEsseenKernelUpper (fun i hi hin => hkernel i hi (by omega))
  have hhigh := berryEsseenRationalHighBound_correct (by positivity : 0 ≤ r.upper^3) hU.le
    (by norm_num : (0:ℚ)<1/2000) (by norm_num : 2 ≤ (2000:ℕ)) hk (by omega)
    (by norm_num : (2000:ℚ)*(1/2000)=1) hchord berryEsseenKernelUpper
    (berryEsseenSelectedPhase (r.upper^3) r.frequency (1/2000)) hkernel
    (fun i _ => ((berryEsseenSelectedPhase_nonpos (r.upper^3) r.frequency (1/2000) i).1).trans (by norm_num))
    (fun i _ => ((berryEsseenSelectedPhase_nonpos (r.upper^3) r.frequency (1/2000) i).2).trans (by norm_num))
  have hcor := berryEsseenRationalCorrectionBound_correct hU.le (by norm_num : (0:ℚ)<1/2000)
    hk hkτ berryEsseenCorrectionUpper (by rw [berryEsseenCorrectionUpper_zero]) hcorr
  have htail := berryEsseenRationalTailBound_correct hU (by norm_num : (0:ℚ)<1/2000)
    hp hπ hk (r.tailEnd-r.cutoff)
  have htotal := add_le_add (add_le_add (add_le_add hlow hhigh) hcor) htail
  have htotal' : berryEsseenCDFErrorBound ((r.upper:ℝ)^3) r.upper r.frequency ((r.cutoff:ℝ)/2000) ≤ (r.bound:ℝ) := by
    simpa only [berryEsseenCDFErrorBound, bound, Rat.cast_add, Rat.cast_div, Rat.cast_one,
      Rat.cast_ofNat, Rat.cast_pow, mul_one_div] using htotal
  refine ⟨hqR,hUR,by positivity,by linarith,htotal'.trans ?_⟩
  have hbR : (r.bound:ℝ) ≤ (((14/25:ℚ)*r.lower^3:ℚ):ℝ) := Rat.cast_le.mpr hbound
  simpa only [Rat.cast_mul, Rat.cast_div, Rat.cast_pow, Rat.cast_ofNat] using hbR

/-- All finite prefix sums are formed in one traversal. -/
def berryEsseenPrefixSums (f : ℕ → ℚ) (n : ℕ) : List ℚ :=
  (List.range n).scanl (fun s i => s+f i) 0

theorem berryEsseenPrefixSums_length (f : ℕ → ℚ) (n : ℕ) :
    (berryEsseenPrefixSums f n).length = n+1 := by simp [berryEsseenPrefixSums]

/-- Each output of the executable scan equals the corresponding finite sum. -/
theorem berryEsseenPrefixSums_get (f : ℕ → ℚ) (n i : ℕ) (hi : i ≤ n) :
    (berryEsseenPrefixSums f n)[i]'(by rw [berryEsseenPrefixSums_length]; omega) =
      ∑ j ∈ Finset.range i, f j := by
  induction i with
  | zero => simp [berryEsseenPrefixSums]
  | succ i ih =>
    have hi' : i ≤ n := by omega
    have hir : i < (List.range n).length := by simp; omega
    have hit : i+1 < (berryEsseenPrefixSums f n).length := by rw [berryEsseenPrefixSums_length]; omega
    have hs := List.getElem_succ_scanl (f := fun (s:ℚ) (j:ℕ) => s+f j)
      (b := (0:ℚ)) (l := List.range n) hit
    change (berryEsseenPrefixSums f n)[i+1] = _
    change (berryEsseenPrefixSums f n)[i+1] = (berryEsseenPrefixSums f n)[i]+f (List.range n)[i] at hs
    rw [hs, ih hi', Finset.sum_range_succ]
    simp only [List.getElem_range]

/-- Adjacent nonzero prefixes are paired with their global cell index. -/
def berryEsseenPrefixPairs (f : ℕ → ℚ) (n : ℕ) : List ((ℚ × ℚ) × ℕ) :=
  let p := berryEsseenPrefixSums f n
  (p.tail.zip p.tail.tail).zipIdx 1

theorem berryEsseenPrefixPairs_length (f : ℕ → ℚ) (n : ℕ) :
    (berryEsseenPrefixPairs f n).length = n-1 := by
  simp only [berryEsseenPrefixPairs, List.length_zipIdx, List.length_zip,
    List.length_tail, berryEsseenPrefixSums_length]
  omega

theorem berryEsseenPrefixPairs_get (f : ℕ → ℚ) (n j : ℕ) (hj : j < n-1) :
    (berryEsseenPrefixPairs f n)[j]'(by rw [berryEsseenPrefixPairs_length]; exact hj) =
      ((∑ i ∈ Finset.range (j+1), f i, ∑ i ∈ Finset.range (j+2), f i),j+1) := by
  simp only [berryEsseenPrefixPairs, List.getElem_zipIdx, List.getElem_zip,
    List.getElem_tail, Nat.add_comm 1 j]
  rw [berryEsseenPrefixSums_get f n (j+1) (by omega),
    berryEsseenPrefixSums_get f n (j+1+1) (by omega)]

/-- Conversion between a linear list traversal and its finite-sum specification. -/
theorem berryEsseen_sum_range_list (f : ℕ → ℚ) (n : ℕ) :
    ((List.range n).map f).sum = ∑ i ∈ Finset.range n, f i := by
  induction n with
  | zero => simp
  | succ n ih => simp [List.range_succ, Finset.sum_range_succ, ih]

/-- A cell function is summed while each prefix value is computed only once. -/
def berryEsseenPrefixPairSum (f : ℕ → ℚ) (n : ℕ) (cell : ℕ → ℚ → ℚ → ℚ) : ℚ :=
  ((berryEsseenPrefixPairs f n).map (fun p => cell p.2 p.1.1 p.1.2)).sum

theorem berryEsseenPrefixPairSum_correct (f : ℕ → ℚ) (n : ℕ) (cell : ℕ → ℚ → ℚ → ℚ) :
    berryEsseenPrefixPairSum f n cell =
      ∑ i ∈ Finset.Ico 1 n, cell i (∑ j ∈ Finset.range i, f j) (∑ j ∈ Finset.range (i+1), f j) := by
  have he : ((berryEsseenPrefixPairs f n).map (fun p => cell p.2 p.1.1 p.1.2)) =
      (List.range (n-1)).map (fun i => cell (i+1)
        (∑ j ∈ Finset.range (i+1), f j) (∑ j ∈ Finset.range (i+2), f j)) := by
    apply List.ext_getElem
    · simp [berryEsseenPrefixPairs_length]
    · intro j hj hj'
      have hji : j < n-1 := by simpa only [List.length_map, List.length_range] using hj'
      simp only [List.getElem_map, berryEsseenPrefixPairs_get f n j hji, List.getElem_range]
  unfold berryEsseenPrefixPairSum
  rw [he, berryEsseen_sum_range_list, Finset.sum_Ico_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i hi
  simp only [Nat.add_comm 1 i, Nat.add_assoc]

/-- The low-frequency bound with all inner prefixes evaluated in one scan. -/
def berryEsseenRationalLowFast (q U h p : ℚ) (n : ℕ) (K : ℕ → ℚ) : ℚ :=
  4*U*berryEsseenRationalInnerUpper q (U*h)*(h/(2*p)+h^2/64)+
  berryEsseenPrefixPairSum
    (fun i => (U*h)/2*(berryEsseenRationalInnerUpper q ((i:ℚ)*(U*h))+
      berryEsseenRationalInnerUpper q (((i:ℚ)+1)*(U*h)))) n
    (fun i a b => 4*h*berryEsseenExpUpper ((U*h)^2/8)*
      berryEsseenRationalChord3 (K i) (K (i+1))
        (berryEsseenRationalGaussianUpper (U*((i:ℚ)*h)))
        (berryEsseenRationalGaussianUpper (U*(((i:ℚ)+1)*h))) a b)

/-- The evaluator computes exactly the previously proved rational bound. -/
theorem berryEsseenRationalLowFast_eq (q U h p : ℚ) (n : ℕ) (K : ℕ → ℚ) :
    berryEsseenRationalLowFast q U h p n K = berryEsseenRationalLowBound q U h p n K := by
  unfold berryEsseenRationalLowFast
  rw [berryEsseenPrefixPairSum_correct]
  rfl

/-- A linear-prefix implementation of the complete numerical enclosure. -/
def BerryEsseenNumericalRow.fastBound (r : BerryEsseenNumericalRow) : ℚ :=
  let h : ℚ := 1/2000
  let p := berryEsseenPiInterval.lo
  berryEsseenRationalLowFast r.upper r.frequency h p r.cutoff berryEsseenKernelUpper+
    berryEsseenRationalHighBound (r.upper^3) r.frequency h 2000 r.cutoff berryEsseenKernelUpper
      (berryEsseenSelectedPhase (r.upper^3) r.frequency h)+
    berryEsseenRationalCorrectionBound r.frequency h r.cutoff berryEsseenCorrectionUpper+
    berryEsseenRationalTailBound r.frequency h p r.cutoff (r.tailEnd-r.cutoff)

theorem BerryEsseenNumericalRow.fastBound_eq (r : BerryEsseenNumericalRow) : r.fastBound = r.bound := by
  dsimp only [fastBound, bound]
  rw [berryEsseenRationalLowFast_eq]

/-- The executable row check has the same mathematical obligations as the specification. -/
def BerryEsseenNumericalRow.FastCheck (r : BerryEsseenNumericalRow) : Prop :=
  0 ≤ r.lower ∧ r.lower ≤ r.upper ∧ 0 < r.frequency ∧
  0 < r.cutoff ∧ r.cutoff < 1500 ∧ r.cutoff ≤ r.tailEnd ∧
  (r.upper^3/4)*((r.cutoff:ℚ)*(r.frequency*(1/2000))) ≤ 1 ∧
  berryEsseenRationalCappedExponent r.upper ((r.cutoff:ℚ)*(r.frequency*(1/2000))) ≤ 40 ∧
  (r.frequency*(1/2000))^2/4 ≤ 40 ∧
  r.fastBound ≤ (14/25:ℚ)*r.lower^3

instance (r : BerryEsseenNumericalRow) : Decidable r.FastCheck := inferInstanceAs (Decidable (_ ∧ _))

theorem BerryEsseenNumericalRow.FastCheck_sound {r : BerryEsseenNumericalRow} (h : r.FastCheck) : r.Check := by
  simpa only [FastCheck, Check, fastBound_eq] using h

/-- Upward rounding stated in the rational field used by the evaluator. -/
theorem berryEsseen_le_roundUp_rat (x : ℚ) : x ≤ berryEsseenRoundUp x := by
  exact_mod_cast berryEsseen_le_roundUp x

/-- Rounding each tail endpoint prevents least-common-denominator growth in long sums. -/
def berryEsseenRationalTailRounded (U h p : ℚ) (k m : ℕ) : ℚ :=
  (∑ i ∈ Finset.range m, h/2*(
    berryEsseenRoundUp (berryEsseenRationalGaussianUpper (U*(((k+i:ℕ):ℚ)*h))/(p*(((k+i:ℕ):ℚ)*h)))+
    berryEsseenRoundUp (berryEsseenRationalGaussianUpper (U*(((k+i+1:ℕ):ℚ)*h))/(p*(((k+i+1:ℕ):ℚ)*h)))))+
    berryEsseenRoundUp (berryEsseenRationalGaussianUpper (U*(((k+m:ℕ):ℚ)*h))/(p*(U*(((k+m:ℕ):ℚ)*h))^2))

theorem berryEsseenRationalTailBound_le_rounded (U h p : ℚ) (hh : 0 ≤ h) (k m : ℕ) :
    berryEsseenRationalTailBound U h p k m ≤ berryEsseenRationalTailRounded U h p k m := by
  unfold berryEsseenRationalTailBound berryEsseenRationalTailRounded
  apply add_le_add _ (berryEsseen_le_roundUp_rat _)
  apply Finset.sum_le_sum
  intro i hi
  exact mul_le_mul_of_nonneg_left
    (add_le_add (berryEsseen_le_roundUp_rat _) (berryEsseen_le_roundUp_rat _)) (by positivity)

/-- A rounded-tail evaluator remains an upper bound on the original certified formula. -/
def BerryEsseenNumericalRow.roundedBound (r : BerryEsseenNumericalRow) : ℚ :=
  let h : ℚ := 1/2000
  let p := berryEsseenPiInterval.lo
  berryEsseenRationalLowFast r.upper r.frequency h p r.cutoff berryEsseenKernelUpper+
    berryEsseenRationalHighBound (r.upper^3) r.frequency h 2000 r.cutoff berryEsseenKernelUpper
      (berryEsseenSelectedPhase (r.upper^3) r.frequency h)+
    berryEsseenRationalCorrectionBound r.frequency h r.cutoff berryEsseenCorrectionUpper+
    berryEsseenRationalTailRounded r.frequency h p r.cutoff (r.tailEnd-r.cutoff)

theorem BerryEsseenNumericalRow.bound_le_rounded (r : BerryEsseenNumericalRow) : r.bound ≤ r.roundedBound := by
  dsimp only [bound, roundedBound]
  rw [berryEsseenRationalLowFast_eq]
  exact add_le_add le_rfl (berryEsseenRationalTailBound_le_rounded _ _ _ (by norm_num) _ _)

section BerryEsseenCompactLookup
set_option maxRecDepth 100000
set_option maxHeartbeats 10000000

open Lean in
/-- Expand a nonempty table into a balanced lookup on natural-number indices.
Indices past the table return its last entry, matching the final branch. -/
private partial def makeBalancedLookup (index : TSyntax `term)
    (values : Array (TSyntax `term)) (lo hi : Nat) : MacroM (TSyntax `term) := do
  if hi - lo ≤ 1 then
    return values[lo]!
  let mid := (lo + hi) / 2
  let left ← makeBalancedLookup index values lo mid
  let right ← makeBalancedLookup index values mid hi
  let pivot := Syntax.mkNumLit (toString mid)
  `(if $index < $pivot then $left else $right)

local syntax "balanced_lookup% " term " in " "#[" term,* "]" : term
local macro_rules
  | `(balanced_lookup% $index in #[$values,*]) => do
    let entries := values.getElems
    if entries.isEmpty then
      Lean.Macro.throwError "lookup table must be nonempty"
    makeBalancedLookup index entries 0 entries.size

