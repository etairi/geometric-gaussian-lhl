  norm_num [Finset.sum_range_succ, smul_eq_mul] at h
  have hrem : Real.cos z * x ^ 20 / 2432902008176640000 ≤ x ^ 20 / 2432902008176640000 := by
    apply div_le_div_of_nonneg_right _ (by norm_num)
    simpa using mul_le_mul_of_nonneg_right (Real.cos_le_one z) (by positivity : 0 ≤ x ^ 20)
  unfold cosineUpper20
  linarith

