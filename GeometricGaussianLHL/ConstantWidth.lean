/-!
# Constant-width smoothing theorems

This module collects the following proof sections, in dependency order.
- Unit-coordinate translation of a product Gaussian (`ProductGaussianUnitShift`).
- Characteristic-function estimates for normal approximation (`BerryEsseenCharacteristicEstimates`).
- Pointwise and distributional smoothing bounds (`BerryEsseenSmoothingKernel`).
- CDF comparisons and exact Gaussian test-function integrals (`GaussianNormalComparison`).
- The universal Berry–Esseen bound with constant `0.56` and its numerical certificate (`BerryEsseenNumericalCertification`).
- Constant-width contraction from small coordinates (`GaussianSmallCoordinates`).
- The small-coordinate case with the paper's exact parameters (`ConstantWidthSmallCase`).
- A scalar contraction controls the whole ring block (`ConstantWidthBlock`).
- Gaussian translations and one-coordinate displacements (`GaussianCoordinateShift`).
- Column-norm failure at constant width (`ConstantWidthColumnNorm`).
- Uniform contraction at constant width (`ConstantWidthContraction`).
- Rank failure at constant coefficient width (`GaussianConstantRank`).
- Remainder decay at constant width (`ConstantWidthRemainder`).
- The finite constant-width coefficient certificate (`ConstantWidthMatrix`).
- Constant-width smoothing over power-of-two number fields (`NumberFieldConstantWidth`).
- Uniform column budgets at coefficient width one (`ConstantWidthFamily`).
- The numerical power-of-two pinned smoothing bounds (`PowerTwoPinned`).
- Constant-width asymptotics uniformly in the field degree (`ConstantWidthAsymptotic`).
-/

section ProductGaussianUnitShift

/-!
## Unit-coordinate translation of a product Gaussian

The scalar unit-shift identity is lifted to one coordinate of the actual
product distribution. The same bound holds for either sign of the shift.
-/

noncomputable section

set_option backward.isDefEq.respectTransparency false

namespace GeometricGaussianLHL

theorem integerGaussian_nat_step (s : ℝ) (hs : 0 < s) (n : ℕ) :
    (integerGaussian s hs ((n : ℤ) + 1)).toReal ≤ (integerGaussian s hs n).toReal := by
  rw [integerGaussian_toReal, integerGaussian_toReal]
  apply div_le_div_of_nonneg_right _ (integerGaussianPartition_pos hs).le
  apply Real.exp_le_exp.mpr
  simp only [Int.cast_add, Int.cast_natCast, Int.cast_one]
  exact mul_le_mul_of_nonpos_left (by nlinarith [Nat.cast_nonneg (α := ℝ) n])
    (neg_nonpos.mpr (div_pos Real.pi_pos (sq_pos_of_pos hs)).le)

theorem integerGaussian_unit_translation (s : ℝ) (hs : 0 < s) :
    discreteTotalVariation (integerGaussian s hs) ((integerGaussian s hs).map (fun z => z + 1)) =
      (integerGaussian s hs 0).toReal :=
  pmf_unimodal_unit_translation _ (integerGaussian_symmetric s hs) (integerGaussian_nat_step s hs)

theorem pmf_integer_translate_variation_neg (p : PMF ℤ) (v : ℤ) :
    discreteTotalVariation p (p.map (fun z => z + -v)) =
      discreteTotalVariation p (p.map (fun z => z + v)) := by
  have happly (w z : ℤ) : (p.map (fun x => x + w)) z = p (z - w) := by
    simpa only [sub_add_cancel] using pmf_map_integer_add_apply p w (z - w)
  unfold discreteTotalVariation
  congr 1
  rw [← (Equiv.addRight v).tsum_eq (fun z => |(p z).toReal - (p.map (fun z => z + v) z).toReal|)]
  simp only [Equiv.coe_addRight, happly, add_sub_cancel_right, sub_neg_eq_add, abs_sub_comm]

theorem integerGaussian_signed_unit_translation {s : ℝ} (hs : 1 ≤ s) (v : ℤ) (hv : |v| = 1) :
    discreteTotalVariation (integerGaussian s (by linarith))
      ((integerGaussian s (by linarith)).map (fun z => z + v)) < (921 / 1000 : ℝ) := by
  have hv' : v = 1 ∨ v = -1 := by
    rcases le_total 0 v with h | h
    · rw [abs_of_nonneg h] at hv
      exact Or.inl hv
    · rw [abs_of_nonpos h] at hv
      exact Or.inr (by omega)
  rcases hv' with rfl | rfl
  · rw [integerGaussian_unit_translation]
    exact integerGaussian_zero_mass_lt hs
  · rw [pmf_integer_translate_variation_neg, integerGaussian_unit_translation]
    exact integerGaussian_zero_mass_lt hs

/-- Translating one coordinate costs at most its scalar total variation.
-/
theorem independentProduct_single_translation_le {n : ℕ} (p : PMF ℤ) (i : Fin n) (v : ℤ) :
    discreteTotalVariation (independentProduct (fun _ : Fin n => p))
      ((independentProduct (fun _ : Fin n => p)).map (fun z => z + Pi.single i v)) ≤
        discreteTotalVariation p (p.map (fun z => z + v)) := by
  classical
  have hmap : (fun z : Fin n → ℤ => z + Pi.single i v) =
      (fun (z : Fin n → ℤ) (j : Fin n) => z j + (Pi.single i v : Fin n → ℤ) j) := rfl
  rw [hmap]
  rw [independentProduct_map (fun _ : Fin n => p)
    (fun (j : Fin n) (z : ℤ) => z + (Pi.single i v : Fin n → ℤ) j)]
  apply (discreteTotalVariation_independentProduct_le _ _).trans
  rw [Finset.sum_eq_single i]
  · simp only [Pi.single_eq_same]
    exact le_rfl
  · intro j _ hji
    simp only [Pi.single_eq_of_ne hji, add_zero]
    change discreteTotalVariation p (p.map id) = 0
    rw [PMF.map_id]
    simp [discreteTotalVariation]
  · simp

theorem productIntegerGaussian_signed_unit_translation {n : ℕ} {s : ℝ} (hs : 1 ≤ s)
    (i : Fin n) (v : ℤ) (hv : |v| = 1) :
    discreteTotalVariation (productIntegerGaussian n s (by linarith))
      ((productIntegerGaussian n s (by linarith)).map (fun z => z + Pi.single i v)) <
        (921 / 1000 : ℝ) :=
  (independentProduct_single_translation_le _ i v).trans_lt
    (integerGaussian_signed_unit_translation hs v hv)

end GeometricGaussianLHL
end

end ProductGaussianUnitShift

section BerryEsseenCharacteristicEstimates

/-!
## Characteristic-function estimates for normal approximation

The symmetric finite-product comparison, the sharp quadratic Taylor remainder,
and the symmetrized third-moment estimate are analytic ingredients for the
Berry–Esseen argument. Symmetrization transfers a pointwise cosine majorant to
an exponential characteristic-function envelope. The sum theorem concerns the
actual product probability law and keeps those envelope bounds explicit.
The rational cubic cosine majorant is certified below, and the smoothing
inequality is proved in the following proof section. The numerical
Berry–Esseen constant remains a separate proof obligation.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
open MeasureTheory ProbabilityTheory Set
open scoped BigOperators Interval
namespace GeometricGaussianLHL

private theorem sum_mul_prod_erase_insert {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (i : ι) (hi : i ∉ s) (a d : ι → ℝ) :
    (∑ j ∈ insert i s, d j * ∏ k ∈ (insert i s).erase j, a k) =
      d i * (∏ k ∈ s, a k) + a i * ∑ j ∈ s, d j * ∏ k ∈ s.erase j, a k := by
  rw [Finset.sum_insert hi, Finset.erase_insert hi, Finset.mul_sum]
  congr 1
  apply Finset.sum_congr rfl
  intro j hj
  have hji : j ≠ i := by rintro rfl; exact hi hj
  rw [Finset.erase_insert_of_ne hji.symm, Finset.prod_insert (by simp [hi])]
  ring

/-- Symmetric finite-product comparison, with the error in each factor weighted
by the products of the remaining upper bounds and reference factors. -/
theorem norm_prod_sub_prod_le_symmetric {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (a c : ι → ℝ) (b : ι → ℂ)
    (ha : ∀ i ∈ s, 0 ≤ a i) (hac : ∀ i ∈ s, a i ≤ c i)
    (hb : ∀ i ∈ s, ‖b i‖ ≤ c i) :
    2 * ‖(∏ i ∈ s, b i) - (∏ i ∈ s, (a i : ℂ))‖ ≤
      (∑ i ∈ s, ‖b i - (a i : ℂ)‖ * ∏ j ∈ s.erase i, c j) +
      (∑ i ∈ s, ‖b i - (a i : ℂ)‖ * ∏ j ∈ s.erase i, a j) := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    have has : ∀ j ∈ s, 0 ≤ a j := fun j hj => ha j (Finset.mem_insert_of_mem hj)
    have hacs : ∀ j ∈ s, a j ≤ c j := fun j hj => hac j (Finset.mem_insert_of_mem hj)
    have hbs : ∀ j ∈ s, ‖b j‖ ≤ c j := fun j hj => hb j (Finset.mem_insert_of_mem hj)
    have hai := ha i (Finset.mem_insert_self i s)
    have haci := hac i (Finset.mem_insert_self i s)
    have hbi := hb i (Finset.mem_insert_self i s)
    have hci : 0 ≤ c i := hai.trans haci
    have hprod : ‖∏ j ∈ s, b j‖ ≤ ∏ j ∈ s, c j := by
      rw [norm_prod]
      exact Finset.prod_le_prod (fun _ _ => norm_nonneg _) hbs
    have hanorm : ‖∏ j ∈ s, (a j : ℂ)‖ = ∏ j ∈ s, a j := by
      rw [norm_prod]
      apply Finset.prod_congr rfl
      intro j hj
      simp [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (has j hj)]
    have hsum :
        (∑ j ∈ s, ‖b j - (a j : ℂ)‖ * ∏ k ∈ s.erase j, a k) ≤
        (∑ j ∈ s, ‖b j - (a j : ℂ)‖ * ∏ k ∈ s.erase j, c k) := by
      apply Finset.sum_le_sum
      intro j hj
      apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
      exact Finset.prod_le_prod (fun k hk => has k (Finset.mem_of_mem_erase hk))
        (fun k hk => hacs k (Finset.mem_of_mem_erase hk))
    have hidentity :
        (2 : ℂ) * (b i * (∏ j ∈ s, b j) - (a i : ℂ) * (∏ j ∈ s, (a j : ℂ))) =
        (b i + (a i : ℂ)) * ((∏ j ∈ s, b j) - (∏ j ∈ s, (a j : ℂ))) +
        (b i - (a i : ℂ)) * ((∏ j ∈ s, b j) + (∏ j ∈ s, (a j : ℂ))) := by ring
    have hstep :
        2 * ‖b i * (∏ j ∈ s, b j) - (a i : ℂ) * (∏ j ∈ s, (a j : ℂ))‖ ≤
        (c i + a i) * ‖(∏ j ∈ s, b j) - (∏ j ∈ s, (a j : ℂ))‖ +
        ‖b i - (a i : ℂ)‖ * ((∏ j ∈ s, c j) + ∏ j ∈ s, a j) := by
      calc
        _ = ‖(2 : ℂ) * (b i * (∏ j ∈ s, b j) - (a i : ℂ) * (∏ j ∈ s, (a j : ℂ)))‖ := by
          rw [norm_mul]; norm_num
        _ ≤ ‖b i + (a i : ℂ)‖ * ‖(∏ j ∈ s, b j) - (∏ j ∈ s, (a j : ℂ))‖ +
            ‖b i - (a i : ℂ)‖ * ‖(∏ j ∈ s, b j) + (∏ j ∈ s, (a j : ℂ))‖ := by
          rw [hidentity]
          simpa only [norm_mul] using norm_add_le
            ((b i + (a i : ℂ)) * ((∏ j ∈ s, b j) - ∏ j ∈ s, (a j : ℂ)))
            ((b i - (a i : ℂ)) * ((∏ j ∈ s, b j) + ∏ j ∈ s, (a j : ℂ)))
        _ ≤ _ := by
          apply add_le_add
          · apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
            calc
              ‖b i + (a i : ℂ)‖ ≤ ‖b i‖ + ‖(a i : ℂ)‖ := norm_add_le _ _
              _ ≤ c i + a i := by simpa [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hai] using add_le_add_right hbi (a i)
          · apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
            exact (norm_add_le _ _).trans (by rw [hanorm]; gcongr)
    rw [Finset.prod_insert hi, Finset.prod_insert hi,
      sum_mul_prod_erase_insert s i hi, sum_mul_prod_erase_insert s i hi]
    have hih := mul_le_mul_of_nonneg_left (ih has hacs hbs) (add_nonneg hci hai)
    have hcross := mul_nonneg (sub_nonneg.mpr haci) (sub_nonneg.mpr hsum)
    nlinarith

private theorem sum_mul_prod_erase_eq_prod_mul_sum_div {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (a d : ι → ℝ) (ha : ∀ i ∈ s, a i ≠ 0) :
    (∑ i ∈ s, d i * ∏ j ∈ s.erase i, a j) =
      (∏ j ∈ s, a j) * ∑ i ∈ s, d i / a i := by
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  have hp : (∏ j ∈ s.erase i, a j) = (∏ j ∈ s, a j) / a i :=
    (eq_div_iff (ha i hi)).2 (Finset.prod_erase_mul s a hi)
  rw [hp]
  ring

/-- The normalized symmetric product comparison for positive reference factors. -/
theorem norm_prod_sub_prod_le_symmetric_div {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (a c : ι → ℝ) (b : ι → ℂ)
    (ha : ∀ i ∈ s, 0 < a i) (hac : ∀ i ∈ s, a i ≤ c i)
    (hb : ∀ i ∈ s, ‖b i‖ ≤ c i) :
    2 * ‖(∏ i ∈ s, b i) - (∏ i ∈ s, (a i : ℂ))‖ ≤
      (∏ i ∈ s, c i) * (∑ i ∈ s, ‖b i - (a i : ℂ)‖ / c i) +
      (∏ i ∈ s, a i) * (∑ i ∈ s, ‖b i - (a i : ℂ)‖ / a i) := by
  simpa only [sum_mul_prod_erase_eq_prod_mul_sum_div s c _
    (fun i hi => ne_of_gt ((ha i hi).trans_le (hac i hi))),
    sum_mul_prod_erase_eq_prod_mul_sum_div s a _ (fun i hi => ne_of_gt (ha i hi))] using
      norm_prod_sub_prod_le_symmetric s a c b (fun i hi => (ha i hi).le) hac hb

/-- A common bound for the inverse reference factors gives a useful product
comparison without coordinatewise denominators. -/
theorem norm_prod_sub_prod_le_symmetric_inv_bound {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (a c : ι → ℝ) (b : ι → ℂ) (M : ℝ)
    (ha : ∀ i ∈ s, 0 < a i) (hac : ∀ i ∈ s, a i ≤ c i)
    (hb : ∀ i ∈ s, ‖b i‖ ≤ c i) (hM : ∀ i ∈ s, (a i)⁻¹ ≤ M) :
    2 * ‖(∏ i ∈ s, b i) - (∏ i ∈ s, (a i : ℂ))‖ ≤
      ((∏ i ∈ s, c i) + ∏ i ∈ s, a i) *
        (∑ i ∈ s, ‖b i - (a i : ℂ)‖) * M := by
  have hasum : (∑ i ∈ s, ‖b i - (a i : ℂ)‖ / a i) ≤
      (∑ i ∈ s, ‖b i - (a i : ℂ)‖) * M := by
    rw [Finset.sum_mul]
    apply Finset.sum_le_sum
    intro i hi
    simpa only [div_eq_mul_inv] using mul_le_mul_of_nonneg_left (hM i hi) (norm_nonneg _)
  have hcsum : (∑ i ∈ s, ‖b i - (a i : ℂ)‖ / c i) ≤
      (∑ i ∈ s, ‖b i - (a i : ℂ)‖) * M := by
    refine le_trans (Finset.sum_le_sum (fun i hi => ?_)) hasum
    exact div_le_div_of_nonneg_left (norm_nonneg _) (ha i hi) (hac i hi)
  refine (norm_prod_sub_prod_le_symmetric_div s a c b ha hac hb).trans ?_
  calc
    _ ≤ (∏ i ∈ s, c i) * ((∑ i ∈ s, ‖b i - (a i : ℂ)‖) * M) +
        (∏ i ∈ s, a i) * ((∑ i ∈ s, ‖b i - (a i : ℂ)‖) * M) := by
      exact add_le_add (mul_le_mul_of_nonneg_left hcsum
        (Finset.prod_nonneg (fun i hi => ((ha i hi).trans_le (hac i hi)).le)))
        (mul_le_mul_of_nonneg_left hasum (Finset.prod_nonneg (fun i hi => (ha i hi).le)))
    _ = _ := by ring



/-- The quadratic Taylor remainder with the sharp factorial constant. -/
theorem norm_quadratic_taylor_remainder_le {f : ℝ → ℂ} {C : ℝ}
    (hf : ContDiff ℝ 3 f) (hC : 0 ≤ C)
    (hb : ∀ u, ‖iteratedDeriv 3 f u‖ ≤ C) (t : ℝ) :
    ‖f t - taylorWithinEval f 2 univ 0 t‖ ≤ C * |t| ^ 3 / 6 := by
  by_cases ht : t = 0
  · simp [ht]
  have hu : UniqueDiffOn ℝ (uIcc 0 t) := uniqueDiffOn_uIcc (Ne.symm ht)
  have hpoly : taylorWithinEval f 2 (uIcc 0 t) 0 t =
      taylorWithinEval f 2 univ 0 t := by
    rw [taylor_within_apply, taylor_within_apply]
    apply Finset.sum_congr rfl
    intro k hk
    rw [iteratedDerivWithin_univ,
      iteratedDerivWithin_eq_iteratedDeriv hu (hf.contDiffAt.of_le (by
        have : k < 3 := Finset.mem_range.mp hk
        exact_mod_cast this.le)) (left_mem_uIcc)]
  rw [← hpoly, taylor_integral_remainder (n := 2) hf.contDiffOn]
  have hi : IntervalIntegrable (fun u : ℝ => (t - u) ^ 2 / 2 * C) volume 0 t := by
    apply Continuous.intervalIntegrable
    fun_prop
  calc
    _ ≤ |∫ u in (0 : ℝ)..t, (t - u) ^ 2 / 2 * C| := by
      apply intervalIntegral.norm_integral_le_abs_of_norm_le _ hi
      filter_upwards [ae_restrict_mem measurableSet_uIoc] with u hu'
      rw [iteratedDerivWithin_eq_iteratedDeriv hu hf.contDiffAt (uIoc_subset_uIcc hu')]
      simp only [Nat.factorial_two, Nat.cast_ofNat, norm_smul,
        Real.norm_eq_abs, abs_of_nonneg (by positivity : 0 ≤ (t - u) ^ 2 / 2)]
      exact mul_le_mul_of_nonneg_left (hb u) (by positivity)
    _ = C * |t| ^ 3 / 6 := by
      rw [intervalIntegral.integral_mul_const, intervalIntegral.integral_div,
        intervalIntegral.integral_comp_sub_left (fun u : ℝ => u ^ 2)]
      simp only [sub_zero, sub_self, integral_pow]
      rw [abs_mul, abs_div, abs_of_nonneg hC]
      norm_num [abs_mul, abs_div, abs_pow]
      ring

/-- A finite third absolute moment bounds the third derivative of the
characteristic function uniformly in its argument. -/
theorem norm_iteratedDeriv_charFun_three_le (μ : Measure ℝ) [IsFiniteMeasure μ]
    (hm : MemLp id 3 μ) (t : ℝ) :
    ‖iteratedDeriv 3 (charFun μ) t‖ ≤ ∫ x, |x| ^ 3 ∂μ := by
  rw [iteratedDeriv_charFun hm, norm_mul, norm_pow, Complex.norm_I]
  norm_num only [one_pow, one_mul]
  apply norm_integral_le_of_norm_le
  · simpa only [id_eq, Real.norm_eq_abs] using hm.integrable_norm_pow'
  · filter_upwards [] with x
    simp [norm_pow, Complex.norm_real, Real.norm_eq_abs,
      Complex.norm_exp]

/-- Quantitative quadratic approximation to a real characteristic function. -/
theorem charFun_quadratic_error_le (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (t : ℝ) :
    ‖charFun μ t -
      (1 + (∫ x, x ∂μ : ℝ) * t * Complex.I -
        (∫ x, x ^ 2 ∂μ : ℝ) * t ^ 2 / 2)‖ ≤
      (∫ x, |x| ^ 3 ∂μ) * |t| ^ 3 / 6 := by
  have hm2 : MemLp id 2 μ := hm.mono_exponent (by norm_num)
  have heq : taylorWithinEval (charFun μ) 2 univ 0 t =
      1 + (∫ x, x ∂μ : ℝ) * t * Complex.I -
        (∫ x, x ^ 2 ∂μ : ℝ) * t ^ 2 / 2 := by
    simpa only [Measure.map_id, id_eq, Pi.pow_apply] using
      taylorWithinEval_charFun_two_zero (P := μ) (X := id) measurable_id.aemeasurable
        (by simpa using hm2) t
  rw [← heq]
  exact norm_quadratic_taylor_remainder_le (contDiff_charFun hm)
    (integral_nonneg (fun _ => by positivity)) (norm_iteratedDeriv_charFun_three_le μ hm) t

/-- The second-order remainder of the decaying real exponential. -/
theorem abs_exp_neg_sub_one_add_le {u : ℝ} (hu : 0 ≤ u) :
    |Real.exp (-u) - 1 + u| ≤ u ^ 2 / 2 := by
  have hd (x : ℝ) : HasDerivAt
      (fun z : ℝ => z ^ 2 / 2 - Real.exp (-z) + 1 - z)
      (x + Real.exp (-x) - 1) x := by
    have h := (((((hasDerivAt_id x).pow 2).div_const 2).sub
      ((hasDerivAt_id x).neg.exp)).add_const 1).sub (hasDerivAt_id x)
    exact h.congr_deriv (by dsimp; ring)
  have hm := monotone_of_hasDerivAt_nonneg hd (fun x => by
    have h := Real.add_one_le_exp (-x)
    dsimp
    linarith)
  have h := hm hu
  simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, zero_div,
    neg_zero, Real.exp_zero, zero_sub, neg_add_cancel, sub_zero] at h
  rw [abs_of_nonneg (by linarith [Real.add_one_le_exp (-u)])]
  linarith

/-- A centered real law and its normal reference have a characteristic-function
error controlled by the third absolute moment and the square of the variance. -/
theorem charFun_normal_error_le (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : ∫ x, x ∂μ = 0) (t : ℝ) :
    ‖charFun μ t - (Real.exp (-(∫ x, x ^ 2 ∂μ) * t ^ 2 / 2) : ℂ)‖ ≤
      (∫ x, |x| ^ 3 ∂μ) * |t| ^ 3 / 6 +
        (∫ x, x ^ 2 ∂μ) ^ 2 * t ^ 4 / 8 := by
  let v : ℝ := ∫ x, x ^ 2 ∂μ
  have hv : 0 ≤ v := integral_nonneg (fun _ => sq_nonneg _)
  have hfirst : ‖charFun μ t - (1 - (v : ℂ) * t ^ 2 / 2)‖ ≤
      (∫ x, |x| ^ 3 ∂μ) * |t| ^ 3 / 6 := by
    simpa only [hmean, Complex.ofReal_zero, zero_mul, add_zero] using
      charFun_quadratic_error_le μ hm t
  have hsecond : ‖(1 - (v : ℂ) * t ^ 2 / 2) -
      (Real.exp (-v * t ^ 2 / 2) : ℂ)‖ ≤ v ^ 2 * t ^ 4 / 8 := by
    have h := abs_exp_neg_sub_one_add_le (u := v * t ^ 2 / 2) (by positivity)
    have hn : ‖(1 - (v : ℂ) * t ^ 2 / 2) - (Real.exp (-v * t ^ 2 / 2) : ℂ)‖ =
        |Real.exp (-(v * t ^ 2 / 2)) - 1 + v * t ^ 2 / 2| := by
      norm_cast
      rw [Real.norm_eq_abs, ← abs_neg]
      congr 1
      simp only [neg_div, neg_mul]
      ring
    rw [hn]
    convert h using 1
    ring
  calc
    _ = ‖(charFun μ t - (1 - (v : ℂ) * t ^ 2 / 2)) +
        ((1 - (v : ℂ) * t ^ 2 / 2) - (Real.exp (-v * t ^ 2 / 2) : ℂ))‖ := by
      congr 1
      dsimp [v]
      ring
    _ ≤ _ := (norm_add_le _ _).trans (add_le_add hfirst hsecond)



/-- Symmetrizing a centered law costs at most twice its third absolute moment
plus twice the product of its variance and first absolute moment. -/
theorem integral_symmetrized_abs_cube_le (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : ∫ x, x ∂μ = 0) :
    (∫ z : ℝ × ℝ, |z.1 - z.2| ^ 3 ∂μ.prod μ) ≤
      2 * ((∫ x, |x| ^ 3 ∂μ) + (∫ x, x ^ 2 ∂μ) * ∫ x, |x| ∂μ) := by
  have h1 : Integrable (fun x : ℝ => x) μ := hm.integrable (by norm_num)
  have ha1 : Integrable (fun x : ℝ => |x|) μ := h1.abs
  have h2 : Integrable (fun x : ℝ => x ^ 2) μ :=
    (hm.mono_exponent (by norm_num : (2 : ENNReal) ≤ 3)).integrable_sq
  have ha3 : Integrable (fun x : ℝ => |x| ^ 3) μ := by
    simpa only [id_eq, Real.norm_eq_abs] using hm.integrable_norm_pow'
  have hxa : Integrable (fun x : ℝ => x * |x|) μ := by
    apply h2.mono' (by fun_prop)
    filter_upwards [] with x
    simp [Real.norm_eq_abs, ← sq, sq_abs]
  let g (z : ℝ × ℝ) : ℝ :=
    |z.1| ^ 3 + |z.2| ^ 3 + z.1 ^ 2 * |z.2| + |z.1| * z.2 ^ 2 -
      2 * ((z.1 * |z.1|) * z.2) - 2 * (z.1 * (z.2 * |z.2|))
  have hg : Integrable g (μ.prod μ) :=
    (((((ha3.comp_fst μ).add (ha3.comp_snd μ)).add (h2.mul_prod ha1)).add
      (ha1.mul_prod h2)).sub ((hxa.mul_prod h1).const_mul 2)).sub
        ((h1.mul_prod hxa).const_mul 2)
  have hgeq (x y : ℝ) : g (x, y) = (x - y) ^ 2 * (|x| + |y|) := by
    dsimp [g]
    have hx : |x| ^ 3 = x ^ 2 * |x| := by rw [pow_succ, sq_abs]
    have hy : |y| ^ 3 = y ^ 2 * |y| := by rw [pow_succ, sq_abs]
    rw [hx, hy]
    ring
  have hbound (z : ℝ × ℝ) : |z.1 - z.2| ^ 3 ≤ g z := by
    change |z.1 - z.2| ^ 3 ≤ g (z.1, z.2)
    rw [hgeq]
    calc
      _ = (z.1 - z.2) ^ 2 * |z.1 - z.2| := by rw [pow_succ, sq_abs]
      _ ≤ _ := mul_le_mul_of_nonneg_left (abs_sub _ _) (sq_nonneg _)
  have hleft : Integrable (fun z : ℝ × ℝ => |z.1 - z.2| ^ 3) (μ.prod μ) := by
    apply hg.mono' (by fun_prop)
    filter_upwards [] with z
    simpa only [Real.norm_eq_abs, abs_pow, abs_abs] using hbound z
  refine (integral_mono hleft hg hbound).trans_eq ?_
  dsimp [g]
  erw [integral_sub (((((ha3.comp_fst μ).add (ha3.comp_snd μ)).add (h2.mul_prod ha1)).add
      (ha1.mul_prod h2)).sub ((hxa.mul_prod h1).const_mul 2)) ((h1.mul_prod hxa).const_mul 2),
    integral_sub ((((ha3.comp_fst μ).add (ha3.comp_snd μ)).add (h2.mul_prod ha1)).add
      (ha1.mul_prod h2)) ((hxa.mul_prod h1).const_mul 2),
    integral_add (((ha3.comp_fst μ).add (ha3.comp_snd μ)).add (h2.mul_prod ha1))
      (ha1.mul_prod h2),
    integral_add ((ha3.comp_fst μ).add (ha3.comp_snd μ)) (h2.mul_prod ha1),
    integral_add (ha3.comp_fst μ) (ha3.comp_snd μ)]
  simp only [integral_const_mul]
  erw [integral_fun_fst (fun x : ℝ => |x| ^ 3),
    integral_fun_snd (fun x : ℝ => |x| ^ 3),
    integral_prod_mul (fun x : ℝ => x ^ 2) (fun x : ℝ => |x|),
    integral_prod_mul (fun x : ℝ => |x|) (fun x : ℝ => x ^ 2),
    integral_prod_mul (fun x : ℝ => x * |x|) (fun x : ℝ => x),
    integral_prod_mul (fun x : ℝ => x) (fun x : ℝ => x * |x|)]
  simp only [probReal_univ, one_smul, hmean, mul_zero, zero_mul, sub_zero]
  ring



/-- The squared characteristic-function norm is the cosine expectation of
the difference of two independent copies. -/
theorem norm_charFun_sq_eq_integral_cos_sub (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (t : ℝ) :
    ‖charFun μ t‖ ^ 2 = ∫ z : ℝ × ℝ, Real.cos (t * (z.1 - z.2)) ∂μ.prod μ := by
  let f (z : ℝ × ℝ) : ℂ := Complex.exp ((t * (z.1 - z.2) : ℝ) * Complex.I)
  have hf : Integrable f (μ.prod μ) := by
    apply Integrable.mono' (integrable_const (1 : ℝ)) (by fun_prop)
    filter_upwards [] with z
    simp [f, Complex.norm_exp]
  have heq : charFun μ t * (starRingEnd ℂ) (charFun μ t) = ∫ z, f z ∂μ.prod μ := by
    rw [← charFun_neg, charFun_apply_real, charFun_apply_real, ← integral_prod_mul]
    apply integral_congr_ae
    filter_upwards [] with z
    dsimp [f]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hr := congrArg Complex.re heq
  rw [Complex.mul_conj'] at hr
  have hi : (∫ z, f z ∂μ.prod μ).re =
      ∫ z : ℝ × ℝ, Real.cos (t * (z.1 - z.2)) ∂μ.prod μ := by
    rw [← RCLike.re_eq_complex_re, ← integral_re hf]
    apply integral_congr_ae
    filter_upwards [] with z
    simp [f, Complex.exp_re]
  simpa only [← Complex.ofReal_pow, Complex.ofReal_re, hi] using hr

/-- The second moment of the difference of independent centered copies. -/
theorem integral_symmetrized_sq (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 2 μ) (hmean : ∫ x, x ∂μ = 0) :
    (∫ z : ℝ × ℝ, (z.1 - z.2) ^ 2 ∂μ.prod μ) = 2 * ∫ x, x ^ 2 ∂μ := by
  have h1 : Integrable (fun x : ℝ => x) μ := hm.integrable (by norm_num)
  have h2 : Integrable (fun x : ℝ => x ^ 2) μ := hm.integrable_sq
  have heq : (fun z : ℝ × ℝ => (z.1 - z.2) ^ 2) =
      (fun z => z.1 ^ 2 + z.2 ^ 2 - 2 * (z.1 * z.2)) := by
    ext z
    ring
  rw [heq]
  erw [integral_sub ((h2.comp_fst μ).add (h2.comp_snd μ)) ((h1.mul_prod h1).const_mul 2),
    integral_add (h2.comp_fst μ) (h2.comp_snd μ), integral_const_mul,
    integral_fun_fst (fun x : ℝ => x ^ 2), integral_fun_snd (fun x : ℝ => x ^ 2),
    integral_prod_mul (fun x : ℝ => x) (fun x : ℝ => x)]
  simp [hmean, two_mul]

/-- A cosine majorant and the symmetrized moments give a quantitative bound
on the squared norm of a centered characteristic function. -/
theorem norm_charFun_sq_le_of_cos_majorant (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : ∫ x, x ∂μ = 0) {κ : ℝ} (hκ : 0 ≤ κ)
    (hcos : ∀ x : ℝ, Real.cos x ≤ 1 - x ^ 2 / 2 + κ * |x| ^ 3) (t : ℝ) :
    ‖charFun μ t‖ ^ 2 ≤ 1 - (∫ x, x ^ 2 ∂μ) * t ^ 2 +
      2 * κ * ((∫ x, |x| ^ 3 ∂μ) + (∫ x, x ^ 2 ∂μ) * ∫ x, |x| ∂μ) * |t| ^ 3 := by
  have hp : MemLp (fun z : ℝ × ℝ => z.1 - z.2) 3 (μ.prod μ) :=
    (hm.comp_fst μ).sub (hm.comp_snd μ)
  have h2 : Integrable (fun z : ℝ × ℝ => (z.1 - z.2) ^ 2) (μ.prod μ) :=
    (hp.mono_exponent (by norm_num : (2 : ENNReal) ≤ 3)).integrable_sq
  have h3 : Integrable (fun z : ℝ × ℝ => |z.1 - z.2| ^ 3) (μ.prod μ) := by
    simpa only [Real.norm_eq_abs] using hp.integrable_norm_pow'
  have hc : Integrable (fun z : ℝ × ℝ => Real.cos (t * (z.1 - z.2))) (μ.prod μ) := by
    apply Integrable.mono' (integrable_const (1 : ℝ)) (by fun_prop)
    filter_upwards [] with z
    exact Real.abs_cos_le_one _
  let g (z : ℝ × ℝ) := 1 - t ^ 2 / 2 * (z.1 - z.2) ^ 2 +
    (κ * |t| ^ 3) * |z.1 - z.2| ^ 3
  have hg : Integrable g (μ.prod μ) :=
    ((integrable_const 1).sub (h2.const_mul (t ^ 2 / 2))).add (h3.const_mul (κ * |t| ^ 3))
  have hmajor : ∀ z : ℝ × ℝ, Real.cos (t * (z.1 - z.2)) ≤ g z := by
    intro z
    convert hcos (t * (z.1 - z.2)) using 1
    dsimp [g]
    rw [abs_mul, mul_pow, mul_pow]
    ring
  rw [norm_charFun_sq_eq_integral_cos_sub]
  refine (integral_mono hc hg hmajor).trans ?_
  have hig : (∫ z, g z ∂μ.prod μ) =
      1 - (∫ x, x ^ 2 ∂μ) * t ^ 2 +
        (κ * |t| ^ 3) * ∫ z : ℝ × ℝ, |z.1 - z.2| ^ 3 ∂μ.prod μ := by
    dsimp [g]
    erw [integral_add ((integrable_const 1).sub (h2.const_mul (t ^ 2 / 2)))
      (h3.const_mul (κ * |t| ^ 3)),
      integral_sub (integrable_const 1) (h2.const_mul (t ^ 2 / 2)), integral_const_mul,
      integral_const_mul, integral_symmetrized_sq μ (hm.mono_exponent (by norm_num)) hmean]
    simp only [integral_const, probReal_univ, smul_eq_mul, one_mul]
    ring
  rw [hig]
  have h := mul_le_mul_of_nonneg_left (integral_symmetrized_abs_cube_le μ hm hmean)
    (mul_nonneg hκ (by positivity : 0 ≤ |t| ^ 3))
  nlinarith

/-- The exponential characteristic-function envelope obtained from a cubic
cosine majorant. -/
theorem norm_charFun_le_exp_of_cos_majorant (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hm : MemLp id 3 μ) (hmean : ∫ x, x ∂μ = 0) {κ : ℝ} (hκ : 0 ≤ κ)
    (hcos : ∀ x : ℝ, Real.cos x ≤ 1 - x ^ 2 / 2 + κ * |x| ^ 3) (t : ℝ) :
    ‖charFun μ t‖ ≤ Real.exp (-(∫ x, x ^ 2 ∂μ) * t ^ 2 / 2 +
      κ * ((∫ x, |x| ^ 3 ∂μ) + (∫ x, x ^ 2 ∂μ) * ∫ x, |x| ∂μ) * |t| ^ 3) := by
  let b := -(∫ x, x ^ 2 ∂μ) * t ^ 2 / 2 +
    κ * ((∫ x, |x| ^ 3 ∂μ) + (∫ x, x ^ 2 ∂μ) * ∫ x, |x| ∂μ) * |t| ^ 3
  have h := norm_charFun_sq_le_of_cos_majorant μ hm hmean hκ hcos t
  have hsq : ‖charFun μ t‖ ^ 2 ≤ Real.exp b ^ 2 := by
    have he := Real.add_one_le_exp (2 * b)
    rw [show 2 * b = b + b by ring, Real.exp_add] at he
    dsimp [b] at he ⊢
    nlinarith
  exact (sq_le_sq₀ (norm_nonneg _) (Real.exp_pos _).le).mp hsq


/-- The characteristic-function comparison for an actual sum under a product
law. The envelope bounds remain explicit so sharper magnitude estimates can be
substituted before applying the smoothing inequality. -/
theorem charFun_product_sum_normal_error_le {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (v β c : ι → ℝ) (m t : ℝ)
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, ∫ x, x ∂μ i = 0)
    (hv : ∀ i, ∫ x, x ^ 2 ∂μ i = v i)
    (hβ : ∀ i, (∫ x, |x| ^ 3 ∂μ i) ≤ β i)
    (hmax : ∀ i, v i ≤ m)
    (ha : ∀ i, Real.exp (-v i * t ^ 2 / 2) ≤ c i)
    (hc : ∀ i, ‖charFun (μ i) t‖ ≤ c i) :
    2 * ‖charFun ((Measure.pi μ).map (fun z => ∑ i, z i)) t -
      (Real.exp (-(∑ i, v i) * t ^ 2 / 2) : ℂ)‖ ≤
      ((∏ i, c i) + Real.exp (-(∑ i, v i) * t ^ 2 / 2)) *
        ((∑ i, β i) * |t| ^ 3 / 6 + (∑ i, (v i) ^ 2) * t ^ 4 / 8) *
        Real.exp (m * t ^ 2 / 2) := by
  classical
  let a (i : ι) := Real.exp (-v i * t ^ 2 / 2)
  have hprod : (∏ i, a i) = Real.exp (-(∑ i, v i) * t ^ 2 / 2) := by
    change (∏ i, Real.exp (-v i * t ^ 2 / 2)) = _
    rw [← Real.exp_sum]
    apply congrArg Real.exp
    rw [← Finset.sum_div, ← Finset.sum_mul, Finset.sum_neg_distrib]
  have hprodC : (∏ i, (a i : ℂ)) =
      (Real.exp (-(∑ i, v i) * t ^ 2 / 2) : ℂ) := by
    rw [← Complex.ofReal_prod, hprod]
  have hinv (i : ι) : (a i)⁻¹ ≤ Real.exp (m * t ^ 2 / 2) := by
    dsimp [a]
    rw [← Real.exp_neg]
    apply Real.exp_le_exp.mpr
    have h := mul_le_mul_of_nonneg_right (hmax i) (sq_nonneg t)
    linarith
  have herror (i : ι) : ‖charFun (μ i) t - (a i : ℂ)‖ ≤
      β i * |t| ^ 3 / 6 + (v i) ^ 2 * t ^ 4 / 8 := by
    have h := charFun_normal_error_le (μ i) (hm i) (hmean i) t
    rw [hv i] at h
    refine h.trans ?_
    gcongr
    exact hβ i
  have hsum : (∑ i, ‖charFun (μ i) t - (a i : ℂ)‖) ≤
      (∑ i, β i) * |t| ^ 3 / 6 + (∑ i, (v i) ^ 2) * t ^ 4 / 8 := by
    simpa only [Finset.sum_add_distrib, Finset.sum_div, Finset.sum_mul] using
      Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => herror i)
  have hbound := norm_prod_sub_prod_le_symmetric_inv_bound Finset.univ a c
    (fun i => charFun (μ i) t) (Real.exp (m * t ^ 2 / 2))
    (fun i _ => Real.exp_pos _) (fun i _ => ha i) (fun i _ => hc i)
    (fun i _ => hinv i)
  have hfactor : 0 ≤ (∏ i, c i) + ∏ i, a i := by
    apply add_nonneg
    · exact Finset.prod_nonneg (fun i _ => (Real.exp_pos _).le.trans (ha i))
    · exact Finset.prod_nonneg (fun i _ => (Real.exp_pos _).le)
  have hfinal := hbound.trans (mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left hsum hfactor) (Real.exp_pos _).le)
  rw [hprodC, hprod] at hfinal
  simpa only [charFun_map_sum_pi_eq_prod, Finset.prod_apply] using hfinal

