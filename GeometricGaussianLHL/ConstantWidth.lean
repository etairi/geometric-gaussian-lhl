/-- Every compact entry matches the original kernel-checked endpoint certificate. -/
theorem berryEsseenCompactKernelData_correct (i : ℕ) (hi : i < 2001) :
    (berryEsseenCompactKernelData i).1/((10^12:ℕ):ℚ) = berryEsseenKernelUpper i ∧
    (berryEsseenCompactKernelData i).2/((10^12:ℕ):ℚ) = berryEsseenCorrectionUpper i := by
  have hb : i/100 < 21 := by omega
  have hj : i%100 < min 100 (2001-100*(i/100)) := by omega
  have h := of_decide_eq_true (List.all_eq_true.mp (compactChunks ⟨i/100,hb⟩) (i%100) (List.mem_range.mpr hj))
  have he : 100*(i/100)+i%100=i := by omega
  simpa only [he] using h

/-- Fast lookup agrees with the original upper table at every index. -/
def berryEsseenCompactKernelUpper (i : ℕ) : ℚ :=
  if i < 2001 then (berryEsseenCompactKernelData i).1/((10^12:ℕ):ℚ) else berryEsseenKernelUpper i

def berryEsseenCompactCorrectionUpper (i : ℕ) : ℚ :=
  if i < 2001 then (berryEsseenCompactKernelData i).2/((10^12:ℕ):ℚ) else berryEsseenCorrectionUpper i

theorem berryEsseenCompactKernelUpper_eq (i : ℕ) : berryEsseenCompactKernelUpper i = berryEsseenKernelUpper i := by
  unfold berryEsseenCompactKernelUpper
  split
  · exact (berryEsseenCompactKernelData_correct i ‹i < 2001›).1
  · rfl

theorem berryEsseenCompactCorrectionUpper_eq (i : ℕ) : berryEsseenCompactCorrectionUpper i = berryEsseenCorrectionUpper i := by
  unfold berryEsseenCompactCorrectionUpper
  split
  · exact (berryEsseenCompactKernelData_correct i ‹i < 2001›).2
  · rfl

end BerryEsseenCompactLookup

/-- Compact lookup and fixed-denominator tail sums evaluate the same certified upper enclosure. -/
def BerryEsseenNumericalRow.compactBound (r : BerryEsseenNumericalRow) : ℚ :=
  let h : ℚ := 1/2000
  let p := berryEsseenPiInterval.lo
  berryEsseenRationalLowFast r.upper r.frequency h p r.cutoff berryEsseenCompactKernelUpper+
    berryEsseenRationalHighBound (r.upper^3) r.frequency h 2000 r.cutoff berryEsseenCompactKernelUpper
      (berryEsseenSelectedPhase (r.upper^3) r.frequency h)+
    berryEsseenRationalCorrectionBound r.frequency h r.cutoff berryEsseenCompactCorrectionUpper+
    berryEsseenRationalTailRounded r.frequency h p r.cutoff (r.tailEnd-r.cutoff)

theorem BerryEsseenNumericalRow.bound_le_compact (r : BerryEsseenNumericalRow) : r.bound ≤ r.compactBound := by
  have hK : berryEsseenCompactKernelUpper = berryEsseenKernelUpper := funext berryEsseenCompactKernelUpper_eq
  have hC : berryEsseenCompactCorrectionUpper = berryEsseenCorrectionUpper := funext berryEsseenCompactCorrectionUpper_eq
  simpa only [compactBound, roundedBound, hK, hC] using r.bound_le_rounded

/-- A finite check suitable for the concrete moment-cover data. -/
def BerryEsseenNumericalRow.CompactCheck (r : BerryEsseenNumericalRow) : Prop :=
  0 ≤ r.lower ∧ r.lower ≤ r.upper ∧ 0 < r.frequency ∧
  0 < r.cutoff ∧ r.cutoff < 1500 ∧ r.cutoff ≤ r.tailEnd ∧
  (r.upper^3/4)*((r.cutoff:ℚ)*(r.frequency*(1/2000))) ≤ 1 ∧
  berryEsseenRationalCappedExponent r.upper ((r.cutoff:ℚ)*(r.frequency*(1/2000))) ≤ 40 ∧
  (r.frequency*(1/2000))^2/4 ≤ 40 ∧
  r.compactBound ≤ (14/25:ℚ)*r.lower^3

instance (r : BerryEsseenNumericalRow) : Decidable r.CompactCheck := inferInstanceAs (Decidable (_ ∧ _))

theorem BerryEsseenNumericalRow.CompactCheck_sound {r : BerryEsseenNumericalRow} (h : r.CompactCheck) : r.Check := by
  obtain ⟨h₀,h₁,h₂,h₃,h₄,h₅,h₆,h₇,h₈,h₉⟩ := h
  exact ⟨h₀,h₁,h₂,h₃,h₄,h₅,h₆,h₇,h₈,r.bound_le_compact.trans h₉⟩

/-- Positive scaling preserves CDF comparisons at correspondingly scaled thresholds. -/
theorem berryEsseen_cdf_div_scale (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {s : ℝ} (hs : 0 < s) (x : ℝ) :
    cdf (μ.map (fun z => z/s)) (x/s) = cdf μ x := by
  rw [cdf_eq_real, cdf_eq_real, map_measureReal_apply (by fun_prop) measurableSet_Iic]
  congr 1
  ext z
  simp only [mem_preimage, mem_Iic, div_le_div_iff_of_pos_right hs]

/-- Scaling the actual product-sum law agrees with scaling every independent summand. -/
theorem berryEsseen_product_sum_map_div {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)] (s : ℝ) :
    (((Measure.pi μ).map (fun z => ∑ i, z i)).map (fun x => x/s)) =
      (Measure.pi (fun i => (μ i).map (fun x => x/s))).map (fun z => ∑ i, z i) := by
  rw [← Measure.pi_map_pi (fun i => (by fun_prop : AEMeasurable (fun x : ℝ => x/s) (μ i))),
    Measure.map_map (by fun_prop) (by fun_prop), Measure.map_map (by fun_prop) (by fun_prop)]
  congr 1
  funext z
  simp only [Function.comp_apply, Finset.sum_div]

/-- Third moments and square moments transform by the exact scaling powers. -/
theorem berryEsseen_div_moments (μ : Measure ℝ) (s : ℝ) (hs : 0 < s) :
    (∫ x : ℝ, x ∂μ.map (fun z => z/s)) = (∫ x : ℝ, x ∂μ)/s ∧
    (∫ x : ℝ, x^2 ∂μ.map (fun z => z/s)) = (∫ x : ℝ, x^2 ∂μ)/s^2 ∧
    (∫ x : ℝ, |x|^3 ∂μ.map (fun z => z/s)) = (∫ x : ℝ, |x|^3 ∂μ)/s^3 := by
  constructor
  · rw [integral_map (f := fun x : ℝ => x) (by fun_prop) (by fun_prop), integral_div]
  constructor
  · rw [integral_map (f := fun x : ℝ => x^2) (by fun_prop) (by fun_prop)]
    simp only [div_pow, integral_div]
  · rw [integral_map (f := fun x : ℝ => |x|^3) (by fun_prop) (by fun_prop)]
    simp only [abs_div, abs_of_pos hs, div_pow, integral_div]

/-- Normalization preserves the finite third-moment hypothesis. -/
theorem berryEsseen_memLp_div (μ : Measure ℝ) (s : ℝ) (hm : MemLp id 3 μ) :
    MemLp id 3 (μ.map (fun z => z/s)) := by
  rw [memLp_map_measure_iff (by fun_prop) (by fun_prop)]
  simpa only [Function.comp_def, id_eq, div_eq_mul_inv] using hm.mul_const s⁻¹

/-- The comparison normal law scales to unit variance exactly. -/
theorem berryEsseen_gaussian_div_scale {s : ℝ} (hs : 0 < s) :
    (gaussianReal 0 (⟨s^2,sq_nonneg s⟩:ℝ≥0)).map (fun z => z/s) = gaussianReal 0 1 := by
  rw [gaussianReal_map_div_const, zero_div]
  congr 1
  apply NNReal.coe_injective
  change s^2/s^2=1
  exact div_self (pow_ne_zero 2 hs.ne')

/-- Centering, variance normalization, and the third-moment budget hold for the actual scaled laws. -/
theorem berryEsseen_product_normalization {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    {s ell : ℝ} (hs : 0 < s) (hv : (∑ i, ∫ x, x^2 ∂μ i) = s^2)
    (hthird : (∑ i, ∫ x, |x|^3 ∂μ i) ≤ ell*s^3) :
    (∀ i, MemLp id 3 ((μ i).map (fun z => z/s))) ∧
    (∀ i, (∫ x, x ∂(μ i).map (fun z => z/s)) = 0) ∧
    (∑ i, ∫ x, x^2 ∂(μ i).map (fun z => z/s)) = 1 ∧
    (∑ i, ∫ x, |x|^3 ∂(μ i).map (fun z => z/s)) ≤ ell := by
  refine ⟨fun i => berryEsseen_memLp_div (μ i) s (hm i),?_,?_,?_⟩
  · intro i
    rw [(berryEsseen_div_moments (μ i) s hs).1, hmean i, zero_div]
  · simp_rw [(berryEsseen_div_moments _ s hs).2.1]
    rw [← Finset.sum_div, hv, div_self (pow_ne_zero 2 hs.ne')]
  · simp_rw [(berryEsseen_div_moments _ s hs).2.2]
    rw [← Finset.sum_div]
    exact (div_le_iff₀ (pow_pos hs 3)).mpr hthird

/-- A CDF bound for the normalized independent sum transfers back to its original variance. -/
theorem berryEsseen_product_cdf_denormalize {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    {s δ x : ℝ} (hs : 0 < s)
    (h : |cdf ((Measure.pi (fun i => (μ i).map (fun z => z/s))).map (fun z => ∑ i, z i)) (x/s)-
      cdf (gaussianReal 0 1) (x/s)| ≤ δ) :
    |cdf ((Measure.pi μ).map (fun z => ∑ i, z i)) x-
      cdf (gaussianReal 0 (⟨s^2,sq_nonneg s⟩:ℝ≥0)) x| ≤ δ := by
  have hsum := berryEsseen_cdf_div_scale ((Measure.pi μ).map (fun z => ∑ i, z i)) hs x
  rw [berryEsseen_product_sum_map_div] at hsum
  have hnormal := berryEsseen_cdf_div_scale (gaussianReal 0 (⟨s^2,sq_nonneg s⟩:ℝ≥0)) hs x
  rw [berryEsseen_gaussian_div_scale hs] at hnormal
  rwa [hsum,hnormal] at h

/-- A vanishing total second moment forces the actual independent sum to be the point mass at zero. -/
theorem berryEsseen_product_sum_zero_variance {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 2 (μ i)) (hv : (∑ i, ∫ x, x^2 ∂μ i) = 0) :
    (Measure.pi μ).map (fun z => ∑ i, z i) = gaussianReal 0 0 := by
  classical
  have hi (i : ι) : (∫ x, x^2 ∂μ i) = 0 :=
    (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => integral_nonneg (fun x => sq_nonneg x))).mp hv i (Finset.mem_univ i)
  apply Measure.ext_of_charFun
  funext t
  rw [charFun_map_sum_pi_eq_prod]
  simp only [Finset.prod_apply, charFun_eq_one_of_secondMoment_zero _ (hm _) (hi _),
    Finset.prod_const_one, charFun_gaussianReal]
  simp


/-- The bounded quadratures use only certified indices of the direct lookup. -/
def berryEsseenRawKernelUpper (i : ℕ) : ℚ := (berryEsseenCompactKernelData i).1/((10^12:ℕ):ℚ)
def berryEsseenRawCorrectionUpper (i : ℕ) : ℚ := (berryEsseenCompactKernelData i).2/((10^12:ℕ):ℚ)

theorem berryEsseenRawKernelUpper_eq {i : ℕ} (hi : i < 2001) :
    berryEsseenRawKernelUpper i=berryEsseenCompactKernelUpper i := by
  simp only [berryEsseenRawKernelUpper, berryEsseenCompactKernelUpper, ite_eq_left hi]

theorem berryEsseenRawCorrectionUpper_eq {i : ℕ} (hi : i < 2001) :
    berryEsseenRawCorrectionUpper i=berryEsseenCompactCorrectionUpper i := by
  simp only [berryEsseenRawCorrectionUpper, berryEsseenCompactCorrectionUpper, ite_eq_left hi]

/-- The low-frequency evaluator depends only on kernel values up to its cutoff. -/
theorem berryEsseenRationalLowFast_congr (q U h p : ℚ) (n : ℕ) {K L : ℕ → ℚ}
    (hKL : ∀ i, 0 < i → i ≤ n → K i=L i) :
    berryEsseenRationalLowFast q U h p n K=berryEsseenRationalLowFast q U h p n L := by
  rw [berryEsseenRationalLowFast_eq,berryEsseenRationalLowFast_eq]
  unfold berryEsseenRationalLowBound
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  obtain ⟨hi0,hin⟩ := Finset.mem_Ico.mp hi
  rw [hKL i (by omega) (by omega), hKL (i+1) (by omega) (by omega)]

/-- The high-frequency evaluator accesses only interior mesh points. -/
theorem berryEsseenRationalHighBound_congr (ell U h : ℚ) (n k : ℕ) (phase : ℕ → BerryEsseenPhase)
    {K L : ℕ → ℚ} (hKL : ∀ i, i < n → K i=L i) :
    berryEsseenRationalHighBound ell U h n k K phase=berryEsseenRationalHighBound ell U h n k L phase := by
  unfold berryEsseenRationalHighBound
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  obtain ⟨hik,hin⟩ := Finset.mem_Ico.mp hi
  rw [hKL i (by omega), hKL (i+1) (by omega)]

/-- The correction quadrature accesses only endpoints up to its cutoff. -/
theorem berryEsseenRationalCorrectionBound_congr (U h : ℚ) (n : ℕ) {K L : ℕ → ℚ}
    (hKL : ∀ i, i ≤ n → K i=L i) :
    berryEsseenRationalCorrectionBound U h n K=berryEsseenRationalCorrectionBound U h n L := by
  unfold berryEsseenRationalCorrectionBound
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  have hin := Finset.mem_range.mp hi
  rw [hKL i (by omega), hKL (i+1) (by omega)]

/-- Direct lookup avoids costly evaluation of the total-function fallback branch. -/
def BerryEsseenNumericalRow.rawBound (r : BerryEsseenNumericalRow) : ℚ :=
  let h : ℚ := 1/2000
  let p := berryEsseenPiInterval.lo
  berryEsseenRationalLowFast r.upper r.frequency h p r.cutoff berryEsseenRawKernelUpper+
    berryEsseenRationalHighBound (r.upper^3) r.frequency h 2000 r.cutoff berryEsseenRawKernelUpper
      (berryEsseenSelectedPhase (r.upper^3) r.frequency h)+
    berryEsseenRationalCorrectionBound r.frequency h r.cutoff berryEsseenRawCorrectionUpper+
    berryEsseenRationalTailRounded r.frequency h p r.cutoff (r.tailEnd-r.cutoff)

theorem BerryEsseenNumericalRow.rawBound_eq (r : BerryEsseenNumericalRow) (hk : r.cutoff < 1500) :
    r.rawBound=r.compactBound := by
  dsimp only [rawBound,compactBound]
  rw [berryEsseenRationalLowFast_congr _ _ _ _ _ (fun i hi0 hin => berryEsseenRawKernelUpper_eq (by omega)),
    berryEsseenRationalHighBound_congr _ _ _ _ _ _ (fun i hi => berryEsseenRawKernelUpper_eq (by omega)),
    berryEsseenRationalCorrectionBound_congr _ _ _ (fun i hi => berryEsseenRawCorrectionUpper_eq (by omega))]


/-- Factoring out a square tests a phase sign without evaluating cubic rational powers. -/
theorem berryEsseenRationalPhaseExponent_nonpos_iff (p : BerryEsseenPhase) (ell u : ℚ) :
    berryEsseenRationalPhaseExponent p ell u ≤ 0 ↔ 2*p.coefficients.2*ell*u ≤ p.coefficients.1 := by
  by_cases hu : u=0
  · subst u
    simp only [berryEsseenRationalPhaseExponent,pow_succ,mul_zero,zero_add,le_refl,true_iff]
    exact p.coefficients_bounds.1
  have he : berryEsseenRationalPhaseExponent p ell u=(2*p.coefficients.2*ell*u-p.coefficients.1)*u^2 := by
    unfold berryEsseenRationalPhaseExponent
    ring
  rw [he]
  simpa only [zero_mul,sub_nonpos] using
    (mul_le_mul_iff_left₀ (sq_pos_of_ne_zero hu) :
      (2*p.coefficients.2*ell*u-p.coefficients.1)*u^2 ≤ 0*u^2 ↔
        2*p.coefficients.2*ell*u-p.coefficients.1 ≤ 0)

/-- A factored implementation makes exactly the same phase choice. -/
def berryEsseenSelectedPhaseFast (ell U h : ℚ) (i : ℕ) : BerryEsseenPhase :=
  let p := berryEsseenSuggestedPhase ell U h i
  if 2*p.coefficients.2*ell*(U*((i:ℚ)*h)) ≤ p.coefficients.1 ∧
      2*p.coefficients.2*ell*(U*(((i:ℚ)+1)*h)) ≤ p.coefficients.1 then p else .unit

theorem berryEsseenSelectedPhaseFast_eq (ell U h : ℚ) (i : ℕ) :
    berryEsseenSelectedPhaseFast ell U h i=berryEsseenSelectedPhase ell U h i := by
  simp only [berryEsseenSelectedPhaseFast,berryEsseenSelectedPhase,max_le_iff,
    berryEsseenRationalPhaseExponent_nonpos_iff]


section BerryEsseenUniversalCertificate

set_option Elab.async false

set_option maxRecDepth 100000

set_option maxHeartbeats 10000000

set_option backward.isDefEq.respectTransparency false

open MeasureTheory ProbabilityTheory Set

open scoped BigOperators Interval Topology NNReal ENNReal


section BerryEsseenCertifiedIntervals

/-- A finite interval certificate is built from checked rows, proved box enclosures, and exact joins. -/
inductive BerryEsseenCertifiedInterval : ℚ → ℚ → Prop
  | row (r : BerryEsseenNumericalRow) (checked : r.Check) :
      BerryEsseenCertifiedInterval r.lower r.upper
  | join {lo mid hi : ℚ} : BerryEsseenCertifiedInterval lo mid →
      BerryEsseenCertifiedInterval mid hi → BerryEsseenCertifiedInterval lo hi
  | box {lo hi : ℚ} (hlo : 0<lo) (horder : lo≤hi) (U tau : ℝ)
      (hU : 0<U) (htau : 0<tau) (htau1 : tau<1)
      (hbound : ∀ q ∈ Icc (lo:ℝ) (hi:ℝ),
        berryEsseenCDFErrorBound (q^3) q U tau≤(14/25:ℝ)*q^3) :
      BerryEsseenCertifiedInterval lo hi

/-- A checked interval supplies a numerical enclosure at every intermediate moment budget. -/
theorem BerryEsseenCertifiedInterval.enclosure {lo hi : ℚ}
    (h : BerryEsseenCertifiedInterval lo hi) {ell : ℝ}
    (hl : (lo:ℝ)^3≤ell) (hu : ell≤(hi:ℝ)^3) :
    ∃ q U tau : ℝ, 0≤q ∧ ell≤q^3 ∧ 0<U ∧ 0<tau ∧ tau<1 ∧
      berryEsseenCDFErrorBound (q^3) q U tau ≤ (14/25:ℝ)*ell := by
  induction h with
  | row r hr =>
    obtain ⟨hq,hU,ht,ht1,hb⟩ := r.correct hr
    exact ⟨r.upper,r.frequency,(r.cutoff:ℝ)/2000,hq,hu,hU,ht,ht1,
      hb.trans (mul_le_mul_of_nonneg_left hl (by norm_num))⟩
  | @join lo mid hi h₁ h₂ ih₁ ih₂ =>
    by_cases hm : ell≤(mid:ℝ)^3
    · exact ih₁ hl hm
    · exact ih₂ (le_of_not_ge hm) hu
  | @box lo hi hlo horder U tau hU ht ht1 hbound =>
    have hloR : (0:ℝ)<lo := by exact_mod_cast hlo
    have horderR : (lo:ℝ)≤hi := by exact_mod_cast horder
    obtain ⟨q,hq,hpow⟩ := intermediate_value_Icc horderR
      (show ContinuousOn (fun q : ℝ => q^3) (Icc (lo:ℝ) (hi:ℝ)) by fun_prop) ⟨hl,hu⟩
    dsimp only at hpow
    exact ⟨q,U,tau,hloR.le.trans hq.1,by rw [hpow],hU,ht,ht1,
      (hbound q hq).trans_eq (by rw [hpow])⟩

/-- A finite certificate closes the universal normalized Berry–Esseen inequality. -/
theorem berryEsseen_product_cdf_of_certified_interval {lo hi : ℚ}
    (hcover : BerryEsseenCertifiedInterval lo hi)
    (hfirst : (lo:ℝ)^3≤1/100) (hlast : 25/14≤(hi:ℝ)^3)
    {ι : Type*} [Fintype ι] (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i)=0)
    (hv : (∑ i, ∫ x, x^2 ∂μ i)=1) {ell : ℝ}
    (hthird : (∑ i, ∫ x, |x|^3 ∂μ i)≤ell) (x : ℝ) :
    |cdf ((Measure.pi μ).map (fun z => ∑ i,z i)) x-cdf (gaussianReal 0 1) x| ≤
      (14/25:ℝ)*ell := by
  have hell : 0<ell := (berryEsseen_total_thirdMoment_pos μ hm hv).trans_le hthird
  by_cases hsmall : ell≤1/100
  · exact berryEsseen_product_cdf_small μ hm hmean hv hell hsmall hthird x
  by_cases hlarge : 25/14≤ell
  · exact berryEsseen_cdf_large hlarge x
  obtain ⟨q,U,tau,hq,hbudget,hU,ht,ht1,hb⟩ := hcover.enclosure
    (hfirst.trans (le_of_not_ge hsmall)) ((le_of_not_ge hlarge).trans hlast)
  exact (berryEsseen_product_cdf_error_le μ hm hmean hv (hthird.trans hbudget)
    hq (hthird.trans hbudget) hU ht ht1 x).trans hb

/-- A certified normalized cover gives the usual variance-scaled Berry–Esseen inequality,
including zero total variance and zero-variance individual summands. -/
theorem berryEsseen_product_cdf_scaled_of_certified_interval {lo hi : ℚ}
    (hcover : BerryEsseenCertifiedInterval lo hi)
    (hfirst : (lo:ℝ)^3 ≤ 1/100) (hlast : 25/14 ≤ (hi:ℝ)^3)
    {ι : Type*} [Fintype ι] (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    (v : ℝ≥0) (hv : (∑ i, ∫ x, x^2 ∂μ i) = (v:ℝ)) (x : ℝ) :
    |cdf ((Measure.pi μ).map (fun z => ∑ i, z i)) x-cdf (gaussianReal 0 v) x| ≤
      (14/25:ℝ)*(∑ i, ∫ x, |x|^3 ∂μ i)/(Real.sqrt (v:ℝ))^3 := by
  by_cases hv0 : v = 0
  · subst v
    have hzero := berryEsseen_product_sum_zero_variance μ
      (fun i => (hm i).mono_exponent (by norm_num)) hv
    simp [hzero]
  have hvpos : 0 < (v:ℝ) := by exact_mod_cast (pos_iff_ne_zero.mpr hv0)
  let s := Real.sqrt (v:ℝ)
  have hs : 0 < s := Real.sqrt_pos.mpr hvpos
  have hs2 : s^2=(v:ℝ) := Real.sq_sqrt hvpos.le
  let ell : ℝ := (∑ i, ∫ x, |x|^3 ∂μ i)/s^3
  have hvar : (∑ i, ∫ x, x^2 ∂μ i)=s^2 := hv.trans hs2.symm
  have hthird : (∑ i, ∫ x, |x|^3 ∂μ i) ≤ ell*s^3 := by
    dsimp [ell]
    rw [div_mul_cancel₀ _ (pow_ne_zero 3 hs.ne')]
  obtain ⟨hnm,hnmean,hnv,hnb⟩ := berryEsseen_product_normalization μ hm hmean hs hvar hthird
  have hnorm := berryEsseen_product_cdf_of_certified_interval hcover hfirst hlast
    (fun i => (μ i).map (fun z => z/s)) hnm hnmean hnv hnb (x/s)
  have h := berryEsseen_product_cdf_denormalize μ hs hnorm
  have hNN : (⟨s^2,sq_nonneg s⟩:ℝ≥0)=v := NNReal.coe_injective hs2
  rw [hNN] at h
  simpa only [ell, s, mul_div_assoc] using h

end BerryEsseenCertifiedIntervals


section BerryEsseenNaturalPrefixes

/-- All finite prefix sums are formed in one traversal. -/
def berryEsseenNatPrefixSums (f : ℕ → ℕ) (n : ℕ) : List ℕ :=
  (List.range n).scanl (fun s i => s+f i) 0

theorem berryEsseenNatPrefixSums_length (f : ℕ → ℕ) (n : ℕ) :
    (berryEsseenNatPrefixSums f n).length = n+1 := by simp [berryEsseenNatPrefixSums]

/-- Each output of the executable scan equals the corresponding finite sum. -/
theorem berryEsseenNatPrefixSums_get (f : ℕ → ℕ) (n i : ℕ) (hi : i ≤ n) :
    (berryEsseenNatPrefixSums f n)[i]'(by rw [berryEsseenNatPrefixSums_length]; omega) =
      ∑ j ∈ Finset.range i, f j := by
  induction i with
  | zero => simp [berryEsseenNatPrefixSums]
  | succ i ih =>
    have hi' : i ≤ n := by omega
    have hir : i < (List.range n).length := by simp; omega
    have hit : i+1 < (berryEsseenNatPrefixSums f n).length := by rw [berryEsseenNatPrefixSums_length]; omega
    have hs := List.getElem_succ_scanl (f := fun (s:ℕ) (j:ℕ) => s+f j)
      (b := (0:ℕ)) (l := List.range n) hit
    change (berryEsseenNatPrefixSums f n)[i+1] = _
    change (berryEsseenNatPrefixSums f n)[i+1] = (berryEsseenNatPrefixSums f n)[i]+f (List.range n)[i] at hs
    rw [hs, ih hi', Finset.sum_range_succ]
    simp only [List.getElem_range]

/-- Adjacent nonzero prefixes are paired with their global cell index. -/
def berryEsseenNatPrefixPairs (f : ℕ → ℕ) (n : ℕ) : List ((ℕ × ℕ) × ℕ) :=
  let p := berryEsseenNatPrefixSums f n
  (p.tail.zip p.tail.tail).zipIdx 1

theorem berryEsseenNatPrefixPairs_length (f : ℕ → ℕ) (n : ℕ) :
    (berryEsseenNatPrefixPairs f n).length = n-1 := by
  simp only [berryEsseenNatPrefixPairs, List.length_zipIdx, List.length_zip,
    List.length_tail, berryEsseenNatPrefixSums_length]
  omega

theorem berryEsseenNatPrefixPairs_get (f : ℕ → ℕ) (n j : ℕ) (hj : j < n-1) :
    (berryEsseenNatPrefixPairs f n)[j]'(by rw [berryEsseenNatPrefixPairs_length]; exact hj) =
      ((∑ i ∈ Finset.range (j+1), f i, ∑ i ∈ Finset.range (j+2), f i),j+1) := by
  simp only [berryEsseenNatPrefixPairs, List.getElem_zipIdx, List.getElem_zip,
    List.getElem_tail, Nat.add_comm 1 j]
  rw [berryEsseenNatPrefixSums_get f n (j+1) (by omega),
    berryEsseenNatPrefixSums_get f n (j+1+1) (by omega)]

/-- Conversion between a linear list traversal and its finite-sum specification. -/
theorem berryEsseen_nat_sum_range_list (f : ℕ → ℕ) (n : ℕ) :
    ((List.range n).map f).sum = ∑ i ∈ Finset.range n, f i := by
  induction n with
  | zero => simp
  | succ n ih => simp [List.range_succ, Finset.sum_range_succ, ih]

/-- A cell function is summed while each prefix value is computed only once. -/
def berryEsseenNatPrefixPairSum (f : ℕ → ℕ) (n : ℕ) (cell : ℕ → ℕ → ℕ → ℕ) : ℕ :=
  ((berryEsseenNatPrefixPairs f n).map (fun p => cell p.2 p.1.1 p.1.2)).sum

theorem berryEsseenNatPrefixPairSum_correct (f : ℕ → ℕ) (n : ℕ) (cell : ℕ → ℕ → ℕ → ℕ) :
    berryEsseenNatPrefixPairSum f n cell =
      ∑ i ∈ Finset.Ico 1 n, cell i (∑ j ∈ Finset.range i, f j) (∑ j ∈ Finset.range (i+1), f j) := by
  have he : ((berryEsseenNatPrefixPairs f n).map (fun p => cell p.2 p.1.1 p.1.2)) =
      (List.range (n-1)).map (fun i => cell (i+1)
        (∑ j ∈ Finset.range (i+1), f j) (∑ j ∈ Finset.range (i+2), f j)) := by
    apply List.ext_getElem
    · simp [berryEsseenNatPrefixPairs_length]
    · intro j hj hj'
      have hji : j < n-1 := by simpa only [List.length_map, List.length_range] using hj'
      simp only [List.getElem_map, berryEsseenNatPrefixPairs_get f n j hji, List.getElem_range]
  unfold berryEsseenNatPrefixPairSum
  rw [he, berryEsseen_nat_sum_range_list, Finset.sum_Ico_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i hi
  simp only [Nat.add_comm 1 i, Nat.add_assoc]

end BerryEsseenNaturalPrefixes


section BerryEsseenNaturalQuadratures

/-- The natural-number numerator of the certified rational exponential evaluator. -/
def berryEsseenFastExpCode (x : ℚ) : ℕ :=
  berryEsseenExpCodeUpper (berryEsseenExpArgumentCode x)

def berryEsseenIntegerHighBound (ell U h : ℚ) (n k : ℕ) (phase : ℕ → BerryEsseenPhase) : ℚ :=
  let cell (i : ℕ) : ℕ :=
    let a := (berryEsseenCompactKernelData i).1
    let b := (berryEsseenCompactKernelData (i+1)).1
    let c := berryEsseenFastExpCode (berryEsseenRationalPhaseExponent (phase i) ell (U*((i:ℚ)*h)))
    let d := berryEsseenFastExpCode (berryEsseenRationalPhaseExponent (phase i) ell (U*(((i:ℚ)+1)*h)))
    (2*a+b)*c+(a+2*b)*d
  2*h*berryEsseenExpUpper ((U*h)^2/4)*((∑ i ∈ Finset.Ico k (n-1), cell i:ℕ):ℚ)/(6*10^12*2^100)+(61/100)*h^2

def berryEsseenIntegerCorrectionBound (U h : ℚ) (n : ℕ) : ℚ :=
  let cell (i : ℕ) : ℕ :=
    (berryEsseenCompactKernelData i).2*berryEsseenFastExpCode (-(U*((i:ℚ)*h))^2/2)+
    (berryEsseenCompactKernelData (i+1)).2*berryEsseenFastExpCode (-(U*(((i:ℚ)+1)*h))^2/2)
  h*((∑ i ∈ Finset.range n,cell i:ℕ):ℚ)/(10^12*2^100)+
    ((n:ℚ)*h)*h^2*(150+12*U+U^2)/12

/-- The natural-number code is exactly the rational evaluator. -/
theorem berryEsseenFastExpCode_eq (x : ℚ) :
    (berryEsseenFastExpCode x:ℚ)/2^100=berryEsseenExpUpper x := rfl

theorem berryEsseenIntegerHighBound_eq (ell U h : ℚ) (n k : ℕ) (phase : ℕ → BerryEsseenPhase)
    :
    berryEsseenIntegerHighBound ell U h n k phase=
      berryEsseenRationalHighBound ell U h n k berryEsseenRawKernelUpper phase := by
  unfold berryEsseenIntegerHighBound berryEsseenRationalHighBound
  simp only [Nat.cast_sum,Finset.mul_sum,Finset.sum_div]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  simp only [← berryEsseenFastExpCode_eq, Nat.cast_add,Nat.cast_mul,Nat.cast_ofNat,
    berryEsseenRawKernelUpper,berryEsseenRationalChord2]
  ring

theorem berryEsseenIntegerCorrectionBound_eq (U h : ℚ) (n : ℕ) :
    berryEsseenIntegerCorrectionBound U h n=
      berryEsseenRationalCorrectionBound U h n berryEsseenRawCorrectionUpper := by
  unfold berryEsseenIntegerCorrectionBound berryEsseenRationalCorrectionBound
  simp only [Nat.cast_sum,Finset.mul_sum,Finset.sum_div]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  unfold berryEsseenRationalGaussianUpper
  simp only [← berryEsseenFastExpCode_eq, Nat.cast_add,Nat.cast_mul,berryEsseenRawCorrectionUpper]
  ring

end BerryEsseenNaturalQuadratures


section BerryEsseenNaturalLowFrequency

/-- Nonnegative fixed-point rounding, also an upper bound for negative inputs. -/
def berryEsseenNatRoundCode (x : ℚ) : ℕ := (⌈x*2^80⌉).toNat

theorem berryEsseenNatRoundCode_upper (x : ℚ) :
    x ≤ (berryEsseenNatRoundCode x:ℚ)/2^80 := by
  apply (le_div_iff₀ (by norm_num : (0:ℚ)<2^80)).mpr
  refine (Int.le_ceil _).trans ?_
  unfold berryEsseenNatRoundCode
  have h := Int.self_le_toNat (⌈x*(2:ℚ)^(80:ℕ)⌉)
  exact_mod_cast h

/-- The inner majorant is rounded before prefix accumulation. -/
def berryEsseenInnerCode (q d : ℚ) (i : ℕ) : ℕ :=
  berryEsseenNatRoundCode (berryEsseenRationalInnerUpper q ((i:ℚ)*d))

/-- Factoring the chord integral uses each prefix only once. -/
def berryEsseenNatChord3 (a b c d e f : ℕ) : ℕ :=
  ((3*a+b)*c+(a+b)*d)*e+((a+b)*c+(a+3*b)*d)*f

theorem berryEsseenRationalChord3_mono_prefix {a b c d e f E F : ℚ}
    (ha : 0≤a) (hb : 0≤b) (hc : 0≤c) (hd : 0≤d) (he : e≤E) (hf : f≤F) :
    berryEsseenRationalChord3 a b c d e f ≤ berryEsseenRationalChord3 a b c d E F := by
  unfold berryEsseenRationalChord3
  gcongr

/-- A natural-number accumulator keeps the low-frequency denominators fixed. -/
def berryEsseenNaturalLowBound (q U h p : ℚ) (n : ℕ) : ℚ :=
  let d := U*h
  4*U*((berryEsseenInnerCode q d 1:ℚ)/2^80)*(h/(2*p)+h^2/64)+
    4*h*berryEsseenExpUpper (d^2/8)*d/2*
      (berryEsseenNatPrefixPairSum
        (fun i => berryEsseenInnerCode q d i+berryEsseenInnerCode q d (i+1)) n
        (fun i a b => berryEsseenNatChord3
          (berryEsseenCompactKernelData i).1 (berryEsseenCompactKernelData (i+1)).1
          (berryEsseenFastExpCode (-(U*((i:ℚ)*h))^2/2))
          (berryEsseenFastExpCode (-(U*(((i:ℚ)+1)*h))^2/2)) a b):ℚ)/
      (12*10^12*2^100*2^80)

theorem berryEsseenInnerPrefix_le_code {q d : ℚ} (hd : 0≤d) (n : ℕ) :
    berryEsseenRationalInnerPrefix q d n ≤
      d/(2*2^80)*((∑ i ∈ Finset.range n,
        (berryEsseenInnerCode q d i+berryEsseenInnerCode q d (i+1)):ℕ):ℚ) := by
  unfold berryEsseenRationalInnerPrefix
  calc
    _ ≤ ∑ i ∈ Finset.range n, d/2*
        ((berryEsseenInnerCode q d i:ℚ)/2^80+(berryEsseenInnerCode q d (i+1):ℚ)/2^80) := by
      apply Finset.sum_le_sum
      intro i hi
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply add_le_add (berryEsseenNatRoundCode_upper _)
      simpa only [berryEsseenInnerCode, Nat.cast_add, Nat.cast_one] using
        berryEsseenNatRoundCode_upper (berryEsseenRationalInnerUpper q (((i:ℚ)+1)*d))
    _ = _ := by
      simp only [Nat.cast_sum, Nat.cast_add, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      ring

theorem berryEsseenNaturalLowBound_sound {q U h p : ℚ} (hU : 0≤U) (hh : 0≤h)
    (hp : 0<p) (n : ℕ) :
    berryEsseenRationalLowFast q U h p n berryEsseenRawKernelUpper ≤
      berryEsseenNaturalLowBound q U h p n := by
  unfold berryEsseenRationalLowFast berryEsseenNaturalLowBound
  dsimp only
  rw [berryEsseenPrefixPairSum_correct, berryEsseenNatPrefixPairSum_correct]
  apply add_le_add
  · apply mul_le_mul_of_nonneg_right _ (by positivity)
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    simpa only [berryEsseenInnerCode, Nat.cast_one, one_mul] using
      berryEsseenNatRoundCode_upper (berryEsseenRationalInnerUpper q (U*h))
  · simp only [Nat.cast_sum, Finset.mul_sum, Finset.sum_div]
    apply Finset.sum_le_sum
    intro i hi
    have he := berryEsseenInnerPrefix_le_code (q := q) (mul_nonneg hU hh) i
    have hf := berryEsseenInnerPrefix_le_code (q := q) (mul_nonneg hU hh) (i+1)
    have hch := berryEsseenRationalChord3_mono_prefix
      (show 0≤berryEsseenRawKernelUpper i by unfold berryEsseenRawKernelUpper; positivity)
      (show 0≤berryEsseenRawKernelUpper (i+1) by unfold berryEsseenRawKernelUpper; positivity)
      (show 0≤berryEsseenRationalGaussianUpper (U*((i:ℚ)*h)) by
        unfold berryEsseenRationalGaussianUpper berryEsseenExpUpper; positivity)
      (show 0≤berryEsseenRationalGaussianUpper (U*(((i:ℚ)+1)*h)) by
        unfold berryEsseenRationalGaussianUpper berryEsseenExpUpper; positivity) he hf
    have hscale : 0≤4*h*berryEsseenExpUpper ((U*h)^2/8) := by
      unfold berryEsseenExpUpper
      positivity
    refine (mul_le_mul_of_nonneg_left hch hscale).trans_eq ?_
    simp only [berryEsseenRationalChord3, berryEsseenNatChord3, berryEsseenRawKernelUpper,
      berryEsseenRationalGaussianUpper, ← berryEsseenFastExpCode_eq,
      Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat]
    ring

end BerryEsseenNaturalLowFrequency


section BerryEsseenNaturalRowBounds

/-- Algebraic side conditions for the four rigorously bounded quadratures. -/
def BerryEsseenNumericalRow.Admissible (r : BerryEsseenNumericalRow) : Prop :=
  0≤r.lower ∧ r.lower≤r.upper ∧ 0<r.frequency ∧
  0<r.cutoff ∧ r.cutoff<1500 ∧ r.cutoff≤r.tailEnd ∧
  (r.upper^3/4)*((r.cutoff:ℚ)*(r.frequency*(1/2000)))≤1 ∧
  berryEsseenRationalCappedExponent r.upper ((r.cutoff:ℚ)*(r.frequency*(1/2000)))≤40 ∧
  (r.frequency*(1/2000))^2/4≤40

instance (r : BerryEsseenNumericalRow) : Decidable r.Admissible :=
  inferInstanceAs (Decidable (_ ∧ _))

/-- Four independently checked bounds yield a complete row certificate. -/
theorem BerryEsseenNumericalRow.check_of_natural_bounds (r : BerryEsseenNumericalRow)
    (a b c d : ℚ) (hs : r.Admissible)
    (ha : berryEsseenNaturalLowBound r.upper r.frequency (1/2000)
      berryEsseenPiInterval.lo r.cutoff≤a)
    (hb : berryEsseenIntegerHighBound (r.upper^3) r.frequency (1/2000) 2000 r.cutoff
      (berryEsseenSelectedPhaseFast (r.upper^3) r.frequency (1/2000))≤b)
    (hc : berryEsseenIntegerCorrectionBound r.frequency (1/2000) r.cutoff≤c)
    (hd : berryEsseenRationalTailRounded r.frequency (1/2000) berryEsseenPiInterval.lo
      r.cutoff (r.tailEnd-r.cutoff)≤d)
    (hsum : a+b+c+d≤(14/25:ℚ)*r.lower^3) : r.Check := by
  obtain ⟨hl,hlu,hU,hk,hkmax,hkm,hcut,hexp,hchord⟩ := hs
  apply BerryEsseenNumericalRow.CompactCheck_sound
  refine ⟨hl,hlu,hU,hk,hkmax,hkm,hcut,hexp,hchord,?_⟩
  rw [← r.rawBound_eq hkmax]
  have hlow := (berryEsseenNaturalLowBound_sound hU.le (by norm_num)
    (by norm_num [berryEsseenPiInterval]) r.cutoff).trans ha
  rw [berryEsseenIntegerHighBound_eq,
    show berryEsseenSelectedPhaseFast (r.upper^3) r.frequency (1/2000)=
      berryEsseenSelectedPhase (r.upper^3) r.frequency (1/2000) from
      funext (berryEsseenSelectedPhaseFast_eq _ _ _)] at hb
  rw [berryEsseenIntegerCorrectionBound_eq] at hc
  exact (add_le_add (add_le_add (add_le_add hlow hb) hc) hd).trans hsum

/-- A row's component checks can be used directly when assembling a finite interval cover. -/
theorem BerryEsseenNumericalRow.interval_of_natural_bounds (r : BerryEsseenNumericalRow)
    (a b c d : ℚ) (hs : r.Admissible)
    (ha : berryEsseenNaturalLowBound r.upper r.frequency (1/2000)
      berryEsseenPiInterval.lo r.cutoff≤a)
    (hb : berryEsseenIntegerHighBound (r.upper^3) r.frequency (1/2000) 2000 r.cutoff
      (berryEsseenSelectedPhaseFast (r.upper^3) r.frequency (1/2000))≤b)
    (hc : berryEsseenIntegerCorrectionBound r.frequency (1/2000) r.cutoff≤c)
    (hd : berryEsseenRationalTailRounded r.frequency (1/2000) berryEsseenPiInterval.lo
      r.cutoff (r.tailEnd-r.cutoff)≤d)
    (hsum : a+b+c+d≤(14/25:ℚ)*r.lower^3) :
    BerryEsseenCertifiedInterval r.lower r.upper :=
  .row r (r.check_of_natural_bounds a b c d hs ha hb hc hd hsum)

end BerryEsseenNaturalRowBounds


section BerryEsseenMomentConvexity

def berryEsseenNormalizedInnerPolynomial (u q : ℝ) : ℝ :=
  1-u^2*q^6/96+u^4*q^12/30720

private def normalizedInnerPD (u q : ℝ) : ℝ := -u^2*q^5/16+u^4*q^11/2560
private def normalizedInnerPDD (u q : ℝ) : ℝ := -5*u^2*q^4/16+11*u^4*q^10/2560

private theorem normalizedInnerP_hasDerivAt (u q : ℝ) :
    HasDerivAt (berryEsseenNormalizedInnerPolynomial u) (normalizedInnerPD u q) q := by
  convert! (((((hasDerivAt_id q).pow 6).const_mul (u^2)).div_const 96).const_sub 1).add
    ((((hasDerivAt_id q).pow 12).const_mul (u^4)).div_const 30720) using 1 <;>
    dsimp [berryEsseenNormalizedInnerPolynomial,normalizedInnerPD] <;> ring

private theorem normalizedInnerPD_hasDerivAt (u q : ℝ) :
    HasDerivAt (normalizedInnerPD u) (normalizedInnerPDD u q) q := by
  convert! (((((hasDerivAt_id q).pow 5).const_mul (u^2)).div_const 16).neg).add
    ((((hasDerivAt_id q).pow 11).const_mul (u^4)).div_const 2560) using 1
  · ext x
    dsimp [normalizedInnerPD]
    ring
  · dsimp [normalizedInnerPDD]
    ring

theorem berryEsseenNormalizedInnerPolynomial_lower {u q : ℝ}
    (hu : 0≤u) (hq : 0≤q) (hcut : q^3*u/4≤1) :
    5/6≤berryEsseenNormalizedInnerPolynomial u q := by
  have hsq : (q^3*u/4)^2≤1 := by nlinarith [show 0≤q^3*u/4 by positivity]
  have hp : 0≤u^4*q^12 := mul_nonneg (pow_nonneg hu _) (pow_nonneg hq _)
  unfold berryEsseenNormalizedInnerPolynomial
  nlinarith

private def normalizedInnerBase (u q : ℝ) : ℝ :=
  berryEsseenNormalizedInnerPolynomial u q*Real.exp (u^2*q^2/2)
private def normalizedInnerBaseD (u q : ℝ) : ℝ :=
  (normalizedInnerPD u q+u^2*q*berryEsseenNormalizedInnerPolynomial u q)*Real.exp (u^2*q^2/2)
private def normalizedInnerBaseDD (u q : ℝ) : ℝ :=
  (normalizedInnerPDD u q+2*u^2*q*normalizedInnerPD u q+
    (u^2+u^4*q^2)*berryEsseenNormalizedInnerPolynomial u q)*Real.exp (u^2*q^2/2)

private theorem normalizedInnerBase_hasDerivAt (u q : ℝ) :
    HasDerivAt (normalizedInnerBase u) (normalizedInnerBaseD u q) q := by
  convert! (normalizedInnerP_hasDerivAt u q).mul
    (((((hasDerivAt_id q).pow 2).const_mul (u^2)).div_const 2).exp) using 1 <;>
    dsimp [normalizedInnerBase,normalizedInnerBaseD] <;> ring

private theorem normalizedInnerBaseD_hasDerivAt (u q : ℝ) :
    HasDerivAt (normalizedInnerBaseD u) (normalizedInnerBaseDD u q) q := by
  convert! ((normalizedInnerPD_hasDerivAt u q).add
    (((hasDerivAt_id q).const_mul (u^2)).mul (normalizedInnerP_hasDerivAt u q))).mul
    (((((hasDerivAt_id q).pow 2).const_mul (u^2)).div_const 2).exp) using 1 <;>
    dsimp [normalizedInnerBaseD,normalizedInnerBaseDD] <;> ring

private theorem normalizedInnerBaseD_nonneg {u q : ℝ}
    (hu : 0≤u) (hq : 0≤q) (hqmax : q≤5/4) (hcut : q^3*u/4≤1) :
    0≤normalizedInnerBaseD u q := by
  have hP := berryEsseenNormalizedInnerPolynomial_lower hu hq hcut
  have hq4 : q^4≤625/256 := by
    calc _ ≤ (5/4:ℝ)^4 := pow_le_pow_left₀ hq hqmax 4
         _ = _ := by norm_num
  have hpos : 0≤berryEsseenNormalizedInnerPolynomial u q-q^4/16 := by linarith
  have hp : 0≤u^2*q*(berryEsseenNormalizedInnerPolynomial u q-q^4/16)+u^4*q^11/2560 := by positivity
  unfold normalizedInnerBaseD
  apply mul_nonneg _ (Real.exp_pos _).le
  convert! hp using 1
  unfold normalizedInnerPD
  ring

private theorem normalizedInnerBaseDD_nonneg {u q : ℝ}
    (hu : 0≤u) (hq : 0≤q) (hqmax : q≤5/4) (hcut : q^3*u/4≤1) :
    0≤normalizedInnerBaseDD u q := by
  have hP := berryEsseenNormalizedInnerPolynomial_lower hu hq hcut
  have hq4 : q^4≤625/256 := by
    calc _ ≤ (5/4:ℝ)^4 := pow_le_pow_left₀ hq hqmax 4
         _ = _ := by norm_num
  have hpos₁ : 0≤berryEsseenNormalizedInnerPolynomial u q-5*q^4/16 := by linarith
  have hpos₂ : 0≤berryEsseenNormalizedInnerPolynomial u q-q^4/8 := by linarith
  have hp : 0≤u^2*(berryEsseenNormalizedInnerPolynomial u q-5*q^4/16)+
      u^4*q^2*(berryEsseenNormalizedInnerPolynomial u q-q^4/8)+
      11*u^4*q^10/2560+u^6*q^12/1280 := by positivity
  unfold normalizedInnerBaseDD
  apply mul_nonneg _ (Real.exp_pos _).le
  convert! hp using 1
  unfold normalizedInnerPD normalizedInnerPDD
  ring

private theorem normalizedInnerBase_convex {u Q : ℝ} (hu : 0≤u)
    (hQ : Q≤5/4) (hcut : Q^3*u/4≤1) :
    ConvexOn ℝ (Icc 0 Q) (normalizedInnerBase u) := by
  apply convexOn_of_hasDerivWithinAt2_nonneg (convex_Icc 0 Q)
    (by unfold normalizedInnerBase berryEsseenNormalizedInnerPolynomial; fun_prop)
    (fun q _ => (normalizedInnerBase_hasDerivAt u q).hasDerivWithinAt)
    (fun q _ => (normalizedInnerBaseD_hasDerivAt u q).hasDerivWithinAt)
  intro q hq
  have hq' : q ∈ Icc 0 Q := interior_subset hq
  exact normalizedInnerBaseDD_nonneg hu hq'.1 (hq'.2.trans hQ)
    ((div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right
      (pow_le_pow_left₀ hq'.1 hq'.2 3) hu) (by norm_num)).trans hcut)

private theorem normalizedInnerBase_monotone {u Q : ℝ} (hu : 0≤u)
    (hQ : Q≤5/4) (hcut : Q^3*u/4≤1) :
    MonotoneOn (normalizedInnerBase u) (Icc 0 Q) := by
  apply monotoneOn_of_hasDerivWithinAt_nonneg (convex_Icc 0 Q)
    (by unfold normalizedInnerBase berryEsseenNormalizedInnerPolynomial; fun_prop)
    (fun q _ => (normalizedInnerBase_hasDerivAt u q).hasDerivWithinAt)
  intro q hq
  have hq' : q ∈ Icc 0 Q := interior_subset hq
  exact normalizedInnerBaseD_nonneg hu hq'.1 (hq'.2.trans hQ)
    ((div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right
      (pow_le_pow_left₀ hq'.1 hq'.2 3) hu) (by norm_num)).trans hcut)

/-- The inner majorant after removing the total-third-moment factor. -/
def berryEsseenNormalizedInner (u q : ℝ) : ℝ :=
  (u^2/4)*berryEsseenNormalizedInnerPolynomial u q*Real.exp (berryEsseenCappedExponent q u)

theorem berryEsseenInnerMajorant_eq_normalized (q u : ℝ) :
    berryEsseenInnerMajorant q u=q^3*berryEsseenNormalizedInner u q := by
  unfold berryEsseenInnerMajorant berryEsseenInnerWeight
    berryEsseenNormalizedInner berryEsseenNormalizedInnerPolynomial
  ring

private def normalizedInnerExtra (u q : ℝ) : ℝ :=
  (max (u*q-250000/148743) 0)^2/2+
    (49581/250000:ℝ)*(max (u*q-250000/148743) 0)^3

private theorem normalizedInnerExtra_convex {u : ℝ} (hu : 0≤u) (Q : ℝ) :
    ConvexOn ℝ (Icc 0 Q) (normalizedInnerExtra u) := by
  let w : ℝ → ℝ := fun q => max (u*q-250000/148743) 0
  have hz : ConvexOn ℝ (Icc 0 Q) (fun q => u*q) := by
    convert! (convexOn_id (convex_Icc (0:ℝ) Q)).smul hu using 1
  have hw : ConvexOn ℝ (Icc 0 Q) w := by
    convert! (hz.add_const (-(250000/148743:ℝ))).sup (convexOn_const (0:ℝ) (convex_Icc 0 Q)) using 1
  have hw0 : ∀ ⦃q⦄, q ∈ Icc 0 Q → 0≤w q := fun _ _ => le_max_right _ _
  have h := ((hw.pow hw0 2).smul (by norm_num : (0:ℝ)≤1/2)).add
    ((hw.pow hw0 3).smul (by norm_num : (0:ℝ)≤49581/250000))
  apply h.congr
  intro q hq
  dsimp [normalizedInnerExtra,w]
  ring

private theorem normalizedInnerExtra_monotone {u : ℝ} (hu : 0≤u) :
    Monotone (normalizedInnerExtra u) := by
  intro x y hxy
  unfold normalizedInnerExtra
  have hx : 0≤max (u*x-250000/148743) 0 := le_max_right _ _
  gcongr

/-- Convexity in the moment parameter allows an entire parameter interval to be certified
from its endpoints, after normalization by the third-moment budget. -/
theorem berryEsseenNormalizedInner_convex {u Q : ℝ} (hu : 0≤u)
    (hQ : Q≤5/4) (hcut : Q^3*u/4≤1) :
    ConvexOn ℝ (Icc 0 Q) (berryEsseenNormalizedInner u) := by
  have hc := normalizedInnerExtra_convex hu Q
  have he : ConvexOn ℝ (Icc 0 Q) (fun q => Real.exp (normalizedInnerExtra u q)) := by
    refine ⟨hc.1,?_⟩
    intro x hx y hy a b ha hb hab
    exact (Real.exp_le_exp.mpr (hc.2 hx hy ha hb hab)).trans
      (convexOn_exp.2 (Set.mem_univ _) (Set.mem_univ _) ha hb hab)
  have hem : MonotoneOn (fun q => Real.exp (normalizedInnerExtra u q)) (Icc 0 Q) :=
    fun x _ y _ hxy => Real.exp_le_exp.mpr (normalizedInnerExtra_monotone hu hxy)
  have hb := normalizedInnerBase_convex hu hQ hcut
  have hbm := normalizedInnerBase_monotone hu hQ hcut
  have hb0 : ∀ ⦃q⦄, q ∈ Icc 0 Q → 0≤normalizedInnerBase u q := by
    intro q hq
    have hcutq := (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right
      (pow_le_pow_left₀ hq.1 hq.2 3) hu) (by norm_num : (0:ℝ)≤4)).trans hcut
    unfold normalizedInnerBase
    exact mul_nonneg ((by norm_num : (0:ℝ)≤5/6).trans
      (berryEsseenNormalizedInnerPolynomial_lower hu hq.1 hcutq)) (Real.exp_pos _).le
  have h := (hb.mul he hb0 (fun _ _ => (Real.exp_pos _).le) (hbm.monovaryOn hem)).smul
    (show 0≤u^2/4 by positivity)
  apply h.congr
  intro q hq
  dsimp [berryEsseenNormalizedInner,normalizedInnerBase,normalizedInnerExtra]
  rw [berryEsseenCappedExponent_eq]
  have harg : (u*q)^2/2+(max (u*q-250000/148743) 0)^2/2+
      (49581/250000:ℝ)*(max (u*q-250000/148743) 0)^3 =
      u^2*q^2/2+((max (u*q-250000/148743) 0)^2/2+
      (49581/250000:ℝ)*(max (u*q-250000/148743) 0)^3) := by ring
  rw [harg]
  simp only [Real.exp_add]
  ring

end BerryEsseenMomentConvexity


section BerryEsseenPhaseConvexity

/-- A characteristic-function phase divided by the third-moment budget. -/
def berryEsseenNormalizedPhase (a b q : ℝ) : ℝ := Real.exp (a+b*q^3)/q^3
private def normalizedPhaseD (a b q : ℝ) : ℝ :=
  Real.exp (a+b*q^3)*(3*b*q^3-3)/q^4
private def normalizedPhaseDD (a b q : ℝ) : ℝ :=
  3*Real.exp (a+b*q^3)*(3*(b*q^3)^2-4*(b*q^3)+4)/q^5

private theorem normalizedPhase_hasDerivAt (a b : ℝ) {q : ℝ} (hq : q≠0) :
    HasDerivAt (berryEsseenNormalizedPhase a b) (normalizedPhaseD a b q) q := by
  convert! (((((hasDerivAt_id q).pow 3).const_mul b).const_add a).exp).div
    ((hasDerivAt_id q).pow 3) (pow_ne_zero 3 hq) using 1
  dsimp [normalizedPhaseD]
  field_simp [hq]

private theorem normalizedPhaseD_hasDerivAt (a b : ℝ) {q : ℝ} (hq : q≠0) :
    HasDerivAt (normalizedPhaseD a b) (normalizedPhaseDD a b q) q := by
  convert! ((((((hasDerivAt_id q).pow 3).const_mul b).const_add a).exp).mul
    ((((hasDerivAt_id q).pow 3).const_mul (3*b)).sub_const 3)).div
    ((hasDerivAt_id q).pow 4) (pow_ne_zero 4 hq) using 1
  dsimp [normalizedPhaseDD]
  field_simp [hq]
  ring

/-- Normalized exponential cubic phases are convex for every choice of coefficients. -/
theorem berryEsseenNormalizedPhase_convex (a b : ℝ) :
    ConvexOn ℝ (Ioi 0) (berryEsseenNormalizedPhase a b) := by
  apply convexOn_of_hasDerivWithinAt2_nonneg (convex_Ioi (0:ℝ))
    (fun q hq => (normalizedPhase_hasDerivAt a b (ne_of_gt hq)).continuousAt.continuousWithinAt)
    (fun q hq => (normalizedPhase_hasDerivAt a b (ne_of_gt (interior_subset hq))).hasDerivWithinAt)
    (fun q hq => (normalizedPhaseD_hasDerivAt a b (ne_of_gt (interior_subset hq))).hasDerivWithinAt)
  intro q hq
  have hq' : 0<q := interior_subset hq
  have hp : 0≤3*(b*q^3)^2-4*(b*q^3)+4 := by nlinarith [sq_nonneg (b*q^3-2/3)]
  unfold normalizedPhaseDD
  positivity

/-- The moment-independent correction and tail terms have the same convex normalization. -/
theorem berryEsseen_inverse_cube_convex : ConvexOn ℝ (Ioi (0:ℝ)) (fun q => 1/q^3) := by
  convert! (convexOn_zpow (-3:ℤ) : ConvexOn ℝ (Ioi (0:ℝ)) (fun q => q^(-3:ℤ))) using 1
  ext q
  simp only [zpow_neg, zpow_ofNat, one_div]

end BerryEsseenPhaseConvexity


section BerryEsseenConvexQuadratures

/-- Finite positive linear combinations preserve convexity of parameter bounds. -/
theorem berryEsseen_convexOn_sum {ι : Type*} (s : Finset ι) {D : Set ℝ}
    (hD : Convex ℝ D) (f : ι → ℝ → ℝ) (hf : ∀ i ∈ s, ConvexOn ℝ D (f i)) :
    ConvexOn ℝ D (fun q => ∑ i ∈ s,f i q) := by
  refine ⟨hD,?_⟩
  intro x hx y hy a b ha hb hab
  calc
    _ ≤ ∑ i ∈ s,(a • f i x+b • f i y) :=
      Finset.sum_le_sum (fun i hi => (hf i hi).2 hx hy ha hb hab)
    _ = _ := by simp only [smul_eq_mul,Finset.sum_add_distrib,Finset.mul_sum]

theorem berryEsseen_convexOn_chord2 {D : Set ℝ} {f g : ℝ → ℝ} {a b : ℝ}
    (hf : ConvexOn ℝ D f) (hg : ConvexOn ℝ D g) (ha : 0≤a) (hb : 0≤b) :
    ConvexOn ℝ D (fun q => berryEsseenChordIntegral2 a b (f q) (g q)) := by
  have h := (hf.smul (show 0≤(2*a+b)/6 by positivity)).add
    (hg.smul (show 0≤(a+2*b)/6 by positivity))
  apply h.congr
  intro q hq
  dsimp [berryEsseenChordIntegral2]
  ring

theorem berryEsseen_convexOn_chord3 {D : Set ℝ} {f g : ℝ → ℝ} {a b c d : ℝ}
    (hf : ConvexOn ℝ D f) (hg : ConvexOn ℝ D g)
    (ha : 0≤a) (hb : 0≤b) (hc : 0≤c) (hd : 0≤d) :
    ConvexOn ℝ D (fun q => berryEsseenChordIntegral3 a b c d (f q) (g q)) := by
  have h := (hf.smul (show 0≤((3*a+b)*c+(a+b)*d)/12 by positivity)).add
    (hg.smul (show 0≤((a+b)*c+(a+3*b)*d)/12 by positivity))
  apply h.congr
  intro q hq
  dsimp [berryEsseenChordIntegral3]
  ring

def berryEsseenNormalizedPrefix (d : ℝ) (n : ℕ) (q : ℝ) : ℝ :=
  ∑ i ∈ Finset.range n,d/2*(berryEsseenNormalizedInner ((i:ℝ)*d) q+
    berryEsseenNormalizedInner (((i:ℝ)+1)*d) q)

theorem berryEsseenNormalizedPrefix_convex {d Q : ℝ} (hd : 0≤d) (hQ0 : 0≤Q)
    (hQ : Q≤5/4) (n : ℕ) (hcut : Q^3*((n:ℝ)*d)/4≤1) :
    ConvexOn ℝ (Icc 0 Q) (berryEsseenNormalizedPrefix d n) := by
  have hc (i : ℕ) (hi : i≤n) : Q^3*((i:ℝ)*d)/4≤1 :=
    (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_right (by exact_mod_cast hi) hd) (by positivity)) (by norm_num)).trans hcut
  apply berryEsseen_convexOn_sum _ (convex_Icc _ _)
  intro i hi
  have hin := Finset.mem_range.mp hi
  have h := (berryEsseenNormalizedInner_convex (by positivity : 0≤(i:ℝ)*d) hQ (hc i (by omega))).add
    (berryEsseenNormalizedInner_convex (by positivity : 0≤((i:ℝ)+1)*d) hQ
      (by simpa only [Nat.cast_add,Nat.cast_one] using hc (i+1) (by simpa using Finset.mem_range.mp hi)))
  exact h.smul (by positivity)

def berryEsseenNormalizedLow (U h p E : ℝ) (n : ℕ) (K G : ℕ → ℝ) (q : ℝ) : ℝ :=
  4*U*berryEsseenNormalizedInner (U*h) q*(h/(2*p)+h^2/64)+
    ∑ i ∈ Finset.Ico 1 n,4*h*E*berryEsseenChordIntegral3
      (K i) (K (i+1)) (G i) (G (i+1))
      (berryEsseenNormalizedPrefix (U*h) i q) (berryEsseenNormalizedPrefix (U*h) (i+1) q)

theorem berryEsseenNormalizedLow_convex {U h p E Q : ℝ}
    (hU : 0≤U) (hh : 0≤h) (hp : 0<p) (hE : 0≤E) (hQ0 : 0≤Q) (hQ : Q≤5/4)
    {n : ℕ} (hn : 0<n) (hcut : Q^3*((n:ℝ)*(U*h))/4≤1)
    (K G : ℕ → ℝ) (hK : ∀ i,0≤K i) (hG : ∀ i,0≤G i) :
    ConvexOn ℝ (Icc 0 Q) (berryEsseenNormalizedLow U h p E n K G) := by
  have hd : 0≤U*h := mul_nonneg hU hh
  have hc (i : ℕ) (hi : i≤n) : Q^3*((i:ℝ)*(U*h))/4≤1 :=
    (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_right (by exact_mod_cast hi) hd) (by positivity)) (by norm_num)).trans hcut
  have hfirst := (berryEsseenNormalizedInner_convex hd hQ (by simpa using hc 1 (by omega))).smul
    (show 0≤4*U*(h/(2*p)+h^2/64) by positivity)
  have hrest : ConvexOn ℝ (Icc 0 Q) (fun q => ∑ i ∈ Finset.Ico 1 n,
      4*h*E*berryEsseenChordIntegral3 (K i) (K (i+1)) (G i) (G (i+1))
        (berryEsseenNormalizedPrefix (U*h) i q) (berryEsseenNormalizedPrefix (U*h) (i+1) q)) := by
    apply berryEsseen_convexOn_sum _ (convex_Icc _ _)
    intro i hi
    have hin := (Finset.mem_Ico.mp hi).2
    exact (berryEsseen_convexOn_chord3
      (berryEsseenNormalizedPrefix_convex hd hQ0 hQ i (hc i (by omega)))
      (berryEsseenNormalizedPrefix_convex hd hQ0 hQ (i+1) (hc (i+1) (by omega)))
      (hK i) (hK (i+1)) (hG i) (hG (i+1))).smul (by positivity)
  apply (hfirst.add hrest).congr
  intro q hq
  dsimp [berryEsseenNormalizedLow]
  ring

def berryEsseenNormalizedHigh (U h E : ℝ) (n k : ℕ) (K : ℕ → ℝ)
    (phase : ℕ → BerryEsseenPhase) (q : ℝ) : ℝ :=
  ∑ i ∈ Finset.Ico k (n-1),2*h*E*berryEsseenChordIntegral2 (K i) (K (i+1))
    (berryEsseenNormalizedPhase (-(phase i).coefficients.1*(U*((i:ℝ)*h))^2)
      (2*(phase i).coefficients.2*(U*((i:ℝ)*h))^3) q)
    (berryEsseenNormalizedPhase (-(phase i).coefficients.1*(U*(((i:ℝ)+1)*h))^2)
      (2*(phase i).coefficients.2*(U*(((i:ℝ)+1)*h))^3) q)

theorem berryEsseenNormalizedHigh_convex (U : ℝ) {h E : ℝ} (hh : 0≤h) (hE : 0≤E)
    (n k : ℕ) (K : ℕ → ℝ) (hK : ∀ i,0≤K i) (phase : ℕ → BerryEsseenPhase) :
    ConvexOn ℝ (Ioi 0) (berryEsseenNormalizedHigh U h E n k K phase) := by
  apply berryEsseen_convexOn_sum _ (convex_Ioi _)
  intro i hi
  exact (berryEsseen_convexOn_chord2 (berryEsseenNormalizedPhase_convex _ _)
    (berryEsseenNormalizedPhase_convex _ _) (hK i) (hK (i+1))).smul (by positivity)

end BerryEsseenConvexQuadratures


section BerryEsseenNormalizedQuadratures

theorem berryEsseenNormalizedPrefix_correct {q d : ℝ} (hq : 0≤q) (hd : 0≤d)
    (n : ℕ) (hcut : (q^3/4)*((n:ℝ)*d)≤1) :
    berryEsseenInnerPrimitive q ((n:ℝ)*d)≤q^3*berryEsseenNormalizedPrefix d n q := by
  refine (berryEsseenInnerPrimitive_prefix hq hd n hcut).trans_eq ?_
  unfold berryEsseenNormalizedPrefix
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [berryEsseenInnerMajorant_eq_normalized,berryEsseenInnerMajorant_eq_normalized]
  ring

/-- The normalized low-frequency curve bounds the original analytic integral. -/
theorem berryEsseenNormalizedLow_correct {q U h p E : ℝ}
    (hq : 0<q) (hU : 0<U) (hh : 0<h) (hp : 0<p) (hpi : p≤Real.pi)
    (hE : Real.exp ((U*h)^2/8)≤E) {n : ℕ} (hn : 0<n) (hn1 : (n:ℝ)*h<1)
    (hcut : (q^3/4)*(U*((n:ℝ)*h))≤1) (K G : ℕ → ℝ)
    (hK : ∀ i, 0 < i → i ≤ n → ‖berryEsseenSmoothingKernel ((i:ℝ)*h)‖≤K i)
    (hG : ∀ i≤n,Real.exp (-(U*((i:ℝ)*h))^2/2)≤G i) :
    2*(∫ t in (0:ℝ)..((n:ℝ)*h),‖berryEsseenSmoothingKernel t‖*
      berryEsseenNormalErrorBound (q^3) q (U*t))≤
      q^3*berryEsseenNormalizedLow U h p E n K G q := by
  have hd : 0≤U*h := by positivity
  let I (i : ℕ) := q^3*berryEsseenNormalizedPrefix (U*h) i q
  have hcuti (i : ℕ) (hi : i≤n) : (q^3/4)*(U*((i:ℝ)*h))≤1 :=
    (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_right (by exact_mod_cast hi) hh.le) hU.le) (by positivity)).trans hcut
  have hI (i : ℕ) (hi : i≤n) : berryEsseenInnerPrimitive q (U*((i:ℝ)*h))≤I i := by
    have hc : (q^3/4)*((i:ℝ)*(U*h))≤1 := by convert! hcuti i hi using 1 <;> ring
    simpa only [show (i:ℝ)*(U*h)=U*((i:ℝ)*h) by ring, I] using
      berryEsseenNormalizedPrefix_correct hq.le hd i hc
  have hb := berryEsseen_low_mesh hq.le hU hh hn hn1 hcut K G I hK hG hI
  have hF0 : 0≤berryEsseenInnerMajorant q (U*h) := by
    unfold berryEsseenInnerMajorant
    exact mul_nonneg (berryEsseenInnerWeight_nonneg (by positivity) hd
      (by simpa using hcuti 1 (by omega))) (Real.exp_pos _).le
  have hfirst :
      4*U*berryEsseenInnerMajorant q (U*h)*(h/(2*Real.pi)+h^2/64)≤
      q^3*(4*U*berryEsseenNormalizedInner (U*h) q*(h/(2*p)+h^2/64)) := by
    have hcoeff : h/(2*Real.pi)+h^2/64≤h/(2*p)+h^2/64 := by
      exact add_le_add (div_le_div_of_nonneg_left hh.le (by positivity)
        (mul_le_mul_of_nonneg_left hpi (by norm_num))) le_rfl
    have hbound := mul_le_mul_of_nonneg_left hcoeff
      (mul_nonneg (show 0≤4*U by positivity) hF0)
    rw [berryEsseenInnerMajorant_eq_normalized] at hbound ⊢
    convert! hbound using 1 <;> ring
  refine hb.trans ?_
  unfold berryEsseenNormalizedLow
  rw [mul_add (q^3),Finset.mul_sum]
  apply add_le_add hfirst
  apply Finset.sum_le_sum
  intro i hi
  obtain ⟨hi0,hin⟩ := Finset.mem_Ico.mp hi
  have hI0 (j : ℕ) (hj : j≤n) : 0≤I j :=
    (berryEsseenInnerPrimitive_nonneg hq.le (by positivity) (hcuti j hj)).trans (hI j hj)
  have hc := berryEsseenChordIntegral3_nonneg
    ((norm_nonneg _).trans (hK i (by omega) (by omega)))
    ((norm_nonneg _).trans (hK (i+1) (by omega) (by omega)))
    ((Real.exp_pos _).le.trans (hG i (by omega)))
    ((Real.exp_pos _).le.trans (hG (i+1) (by omega)))
    (hI0 i (by omega)) (hI0 (i+1) (by omega))
  have hs := mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left hE (show 0≤4*h by positivity)) hc
  convert! hs using 1 <;> dsimp [I,berryEsseenChordIntegral3] <;> ring

/-- A fixed choice of phases gives a convex normalized high-frequency bound. -/
theorem berryEsseenNormalizedHigh_correct {q U h E : ℝ} (hq : 0<q) (hU : 0≤U)
    (hh : 0<h) (hE : Real.exp ((U*h)^2/4)≤E) {n k : ℕ}
    (hn : 2≤n) (hk : 0<k) (hkn : k≤n-1) (hmesh : (n:ℝ)*h=1)
    (K : ℕ → ℝ) (phase : ℕ → BerryEsseenPhase)
    (hK : ∀ i, 0 < i → i < n → ‖berryEsseenSmoothingKernel ((i:ℝ)*h)‖≤K i) :
    2*(∫ t in ((k:ℝ)*h)..1,‖berryEsseenSmoothingKernel t‖*berryEsseenMagnitudeBound (q^3) (U*t))≤
      q^3*berryEsseenNormalizedHigh U h E n k K phase q+(61/100:ℝ)*h^2 := by
  let A (i : ℕ) : ℝ := (phase i).coefficients.1
  let B (i : ℕ) : ℝ := (phase i).coefficients.2
  let E₀ (i : ℕ) := Real.exp (-(A i)*(U*((i:ℝ)*h))^2+2*(B i)*q^3*(U*((i:ℝ)*h))^3)
  let E₁ (i : ℕ) := Real.exp (-(A i)*(U*(((i+1:ℕ):ℝ)*h))^2+2*(B i)*q^3*(U*(((i+1:ℕ):ℝ)*h))^3)
  have hA (i : ℕ) : 0≤A i := by dsimp [A]; exact_mod_cast (phase i).coefficients_bounds.1
  have hA1 (i : ℕ) : A i≤1 := by dsimp [A]; exact_mod_cast (phase i).coefficients_bounds.2.1
  have hB (i : ℕ) : 0≤B i := by dsimp [B]; exact_mod_cast (phase i).coefficients_bounds.2.2
  have hb := berryEsseen_high_mesh (by positivity : 0≤q^3) hU hh hn hk hkn hmesh
    A B K E₀ E₁ (fun i _ => hA i) (fun i _ => hB i)
    (by
      intro i hi t ht
      exact (phase i).magnitude_le (by positivity)
        (mul_nonneg hU ((by positivity : 0≤(i:ℝ)*h).trans ht.1)))
    hK (fun _ _ => le_rfl) (fun _ _ => le_rfl)
  refine hb.trans (add_le_add ?_ le_rfl)
  unfold berryEsseenNormalizedHigh
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro i hi
  obtain ⟨hki,hin⟩ := Finset.mem_Ico.mp hi
  have hi0 : 0 < i := hk.trans_le hki
  have hc := berryEsseenChordIntegral2_nonneg
    ((norm_nonneg _).trans (hK i hi0 (by omega)))
    ((norm_nonneg _).trans (hK (i+1) (by omega) (by omega)))
    ((Real.exp_pos _).le : 0≤E₀ i) ((Real.exp_pos _).le : 0≤E₁ i)
  have hfactor : Real.exp ((A i)*(U*h)^2/4)≤E := by
    apply le_trans (Real.exp_le_exp.mpr ?_) hE
    nlinarith [mul_le_mul_of_nonneg_right (hA1 i) (sq_nonneg (U*h))]
  have hs := mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left hfactor (show 0≤2*h by positivity)) hc
  refine hs.trans_eq ?_
  dsimp [berryEsseenNormalizedPhase,berryEsseenChordIntegral2,E₀,E₁,A,B]
  simp only [Nat.cast_add,Nat.cast_one]
  have harg (u : ℝ) :
      -((phase i).coefficients.1:ℝ)*u^2+2*((phase i).coefficients.2:ℝ)*q^3*u^3=
      -((phase i).coefficients.1:ℝ)*u^2+(2*((phase i).coefficients.2:ℝ)*u^3)*q^3 := by ring
  simp only [harg]
  field_simp [hq.ne']

end BerryEsseenNormalizedQuadratures


section BerryEsseenConvexBoxEnclosure

def BerryEsseenNumericalRow.BoxAdmissible (r : BerryEsseenNumericalRow) : Prop :=
  r.Admissible ∧ 0<r.lower ∧ r.upper≤5/4

instance (r : BerryEsseenNumericalRow) : Decidable r.BoxAdmissible :=
  inferInstanceAs (Decidable (_ ∧ _))

def BerryEsseenNumericalRow.boxRemainder (r : BerryEsseenNumericalRow) : ℚ :=
  berryEsseenRationalCorrectionBound r.frequency (1/2000) r.cutoff berryEsseenRawCorrectionUpper+
    berryEsseenRationalTailRounded r.frequency (1/2000) berryEsseenPiInterval.lo
      r.cutoff (r.tailEnd-r.cutoff)+(61/100:ℚ)*(1/2000)^2

def BerryEsseenNumericalRow.boxCurve (r : BerryEsseenNumericalRow) (q : ℝ) : ℝ :=
  berryEsseenNormalizedLow r.frequency (1/2000) berryEsseenPiInterval.lo
    (berryEsseenExpUpper ((r.frequency*(1/2000))^2/8)) r.cutoff
    (fun i => (berryEsseenRawKernelUpper i:ℝ))
    (fun i => (berryEsseenRationalGaussianUpper (r.frequency*((i:ℚ)*(1/2000))):ℝ)) q+
  berryEsseenNormalizedHigh r.frequency (1/2000)
    (berryEsseenExpUpper ((r.frequency*(1/2000))^2/4)) 2000 r.cutoff
    (fun i => (berryEsseenRawKernelUpper i:ℝ))
    (berryEsseenSelectedPhaseFast (r.upper^3) r.frequency (1/2000)) q+
  (r.boxRemainder:ℝ)/q^3

def BerryEsseenNumericalRow.boxEndpointBound (r : BerryEsseenNumericalRow) (q : ℚ) : ℚ :=
  berryEsseenNaturalLowBound q r.frequency (1/2000) berryEsseenPiInterval.lo r.cutoff+
    berryEsseenIntegerHighBound (q^3) r.frequency (1/2000) 2000 r.cutoff
      (berryEsseenSelectedPhaseFast (r.upper^3) r.frequency (1/2000))+
    berryEsseenIntegerCorrectionBound r.frequency (1/2000) r.cutoff+
    berryEsseenRationalTailRounded r.frequency (1/2000) berryEsseenPiInterval.lo
      r.cutoff (r.tailEnd-r.cutoff)

theorem BerryEsseenNumericalRow.boxRemainder_nonneg (r : BerryEsseenNumericalRow)
    (hU : 0≤r.frequency) : 0≤r.boxRemainder := by
  have hG (u : ℚ) : 0≤berryEsseenRationalGaussianUpper u := by
    unfold berryEsseenRationalGaussianUpper berryEsseenExpUpper
    positivity
  have hC (i : ℕ) : 0≤berryEsseenRawCorrectionUpper i := by
    unfold berryEsseenRawCorrectionUpper
    positivity
  have hr {x : ℚ} (hx : 0≤x) : 0≤berryEsseenRoundUp x := hx.trans (berryEsseen_le_roundUp_rat x)
  unfold boxRemainder berryEsseenRationalCorrectionBound berryEsseenRationalTailRounded
  apply add_nonneg (add_nonneg ?_ ?_) (by norm_num)
  · apply add_nonneg
    · apply Finset.sum_nonneg
      intro i hi
      apply mul_nonneg (by norm_num)
      exact add_nonneg (mul_nonneg (hC i) (hG _)) (mul_nonneg (hC (i+1)) (hG _))
    · positivity
  · apply add_nonneg (Finset.sum_nonneg (fun i _ => ?_))
      (hr (div_nonneg (hG _) (mul_nonneg (by norm_num [berryEsseenPiInterval]) (sq_nonneg _))))
    apply mul_nonneg (by norm_num)
    exact add_nonneg
      (hr (div_nonneg (hG _) (mul_nonneg (by norm_num [berryEsseenPiInterval]) (by positivity))))
      (hr (div_nonneg (hG _) (mul_nonneg (by norm_num [berryEsseenPiInterval]) (by positivity))))

/-- The complete normalized enclosure is convex on each certified parameter box. -/
theorem BerryEsseenNumericalRow.boxCurve_convex (r : BerryEsseenNumericalRow)
    (hr : r.BoxAdmissible) : ConvexOn ℝ (Icc (r.lower:ℝ) (r.upper:ℝ)) r.boxCurve := by
  obtain ⟨hs,hlo,hhi⟩ := hr
  obtain ⟨hl,hlu,hU,hk,hkN,hkm,hcut,hexp,hchord⟩ := hs
  have hUR : (0:ℝ)≤r.frequency := by exact_mod_cast hU.le
  have hloR : (0:ℝ)<r.lower := by exact_mod_cast hlo
  have hQ0 : (0:ℝ)≤r.upper := by exact_mod_cast hl.trans hlu
  have hQ : (r.upper:ℝ)≤5/4 := by
    have ht : (r.upper:ℝ)≤((5/4:ℚ):ℝ) := Rat.cast_le.mpr hhi
    norm_num at ht
    exact ht
  have he (x : ℚ) : (0:ℝ)≤berryEsseenExpUpper x := by
    unfold berryEsseenExpUpper
    positivity
  have hK (i : ℕ) : (0:ℝ)≤berryEsseenRawKernelUpper i := by
    unfold berryEsseenRawKernelUpper
    positivity
  have hG (i : ℕ) : (0:ℝ)≤berryEsseenRationalGaussianUpper (r.frequency*((i:ℚ)*(1/2000))) :=
    he _
  have hc : (r.upper:ℝ)^3*((r.cutoff:ℝ)*((r.frequency:ℝ)*(1/2000)))/4≤1 := by
    have ht : ((r.upper:ℝ)^3/4)*((r.cutoff:ℝ)*((r.frequency:ℝ)*(1/2000)))≤1 := by
      have hc : (((r.upper^3/4)*((r.cutoff:ℚ)*(r.frequency*(1/2000))):ℚ):ℝ)≤((1:ℚ):ℝ) := Rat.cast_le.mpr hcut
      push_cast at hc
      exact hc
    nlinarith only [ht]
  have hL := (berryEsseenNormalizedLow_convex (h := 1/2000) (p := (berryEsseenPiInterval.lo:ℝ))
    hUR (by norm_num) (by norm_num [berryEsseenPiInterval])
    (he ((r.frequency*(1/2000))^2/8)) hQ0 hQ hk hc (fun i => (berryEsseenRawKernelUpper i:ℝ)) _ hK hG).subset
      (fun q hq => ⟨hloR.le.trans hq.1,hq.2⟩) (convex_Icc (r.lower:ℝ) (r.upper:ℝ))
  have hH := (berryEsseenNormalizedHigh_convex (h := 1/2000) (r.frequency:ℝ) (by norm_num) (he ((r.frequency*(1/2000))^2/4))
    2000 r.cutoff (fun i => (berryEsseenRawKernelUpper i:ℝ)) hK
    (berryEsseenSelectedPhaseFast (r.upper^3) r.frequency (1/2000))).subset
      (fun q hq => hloR.trans_le hq.1) (convex_Icc (r.lower:ℝ) (r.upper:ℝ))
  have hR0 : (0:ℝ)≤r.boxRemainder := by exact_mod_cast r.boxRemainder_nonneg hU.le
  have hR := (berryEsseen_inverse_cube_convex.smul hR0).subset
    (fun q hq => hloR.trans_le hq.1) (convex_Icc (r.lower:ℝ) (r.upper:ℝ))
  apply ((hL.add hH).add hR).congr
  intro q hq
  dsimp [boxCurve]
  ring

end BerryEsseenConvexBoxEnclosure


section BerryEsseenConvexBoxSoundness

theorem berryEsseenRawKernelUpper_correct (i : ℕ) (hi : 0 < i) (hin : i<2000) :
    ‖berryEsseenSmoothingKernel ((i:ℝ)/2000)‖≤(berryEsseenRawKernelUpper i:ℝ) ∧
    ‖berryEsseenSmoothingKernel ((i:ℝ)/2000)-Complex.I/(2*Real.pi*((i:ℝ)/2000):ℝ)‖≤
      (berryEsseenRawCorrectionUpper i:ℝ) := by
  rw [berryEsseenRawKernelUpper_eq (by omega),berryEsseenCompactKernelUpper_eq,
    berryEsseenRawCorrectionUpper_eq (by omega),berryEsseenCompactCorrectionUpper_eq]
  exact berryEsseenKernelUpper_correct i hi hin

/-- The convex curve is an upper enclosure of the original four smoothing integrals. -/
theorem BerryEsseenNumericalRow.boxCurve_correct (r : BerryEsseenNumericalRow)
    (hr : r.BoxAdmissible) {q : ℝ} (hq : q ∈ Icc (r.lower:ℝ) (r.upper:ℝ)) :
    berryEsseenCDFErrorBound (q^3) q r.frequency ((r.cutoff:ℝ)/2000)≤q^3*r.boxCurve q := by
  obtain ⟨hs,hlo,hhi⟩ := hr
  obtain ⟨hl,hlu,hU,hk,hkN,hkm,hcut,hexp,hchord⟩ := hs
  have hUR : (0:ℝ)<r.frequency := by exact_mod_cast hU
  have hloR : (0:ℝ)<r.lower := by exact_mod_cast hlo
  have hq0 : 0<q := hloR.trans_le hq.1
  have hkR : (0:ℝ)<r.cutoff := by exact_mod_cast hk
  have hkτ : (r.cutoff:ℚ)*(1/2000)<3/4 := by
    have hc : (r.cutoff:ℚ)<1500 := by exact_mod_cast hkN
    linarith
  have hkτR : (r.cutoff:ℝ)*(1/2000)<1 := by
    have hc : (r.cutoff:ℝ)<1500 := by exact_mod_cast hkN
    linarith
  have hc : (q^3/4)*((r.frequency:ℝ)*((r.cutoff:ℝ)*(1/2000)))≤1 := by
    have ht : ((r.upper:ℝ)^3/4)*((r.cutoff:ℝ)*((r.frequency:ℝ)*(1/2000)))≤1 := by
      have hb : (((r.upper^3/4)*((r.cutoff:ℚ)*(r.frequency*(1/2000))):ℚ):ℝ)≤((1:ℚ):ℝ) := Rat.cast_le.mpr hcut
      push_cast at hb
      exact hb
    have hp := mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right
      (pow_le_pow_left₀ hq0.le hq.2 3) (by norm_num : (0:ℝ)≤4))
      (show 0≤(r.frequency:ℝ)*((r.cutoff:ℝ)*(1/2000)) by positivity)
    nlinarith only [ht,hp]
  have hkernel (i : ℕ) (hi : 0 < i) (hin : i<2000) :
      ‖berryEsseenSmoothingKernel ((i:ℝ)*(1/2000))‖≤(berryEsseenRawKernelUpper i:ℝ) := by
    simpa only [mul_one_div] using (berryEsseenRawKernelUpper_correct i hi hin).1
  have hcorr (i : ℕ) (hi : 0 < i) (hin : i≤r.cutoff) :
      ‖berryEsseenSmoothingKernel ((i:ℝ)*((1/2000:ℚ):ℝ))-
        Complex.I/(2*Real.pi*((i:ℝ)*((1/2000:ℚ):ℝ)):ℝ)‖≤
          (berryEsseenRawCorrectionUpper i:ℝ) := by
    simpa only [Rat.cast_div,Rat.cast_one,Rat.cast_ofNat,mul_one_div] using
      (berryEsseenRawKernelUpper_correct i hi (by omega)).2
  have hG (i : ℕ) : Real.exp (-((r.frequency:ℝ)*((i:ℝ)*(1/2000)))^2/2)≤
      (berryEsseenRationalGaussianUpper (r.frequency*((i:ℚ)*(1/2000))):ℝ) := by
    simpa only [Rat.cast_mul,Rat.cast_natCast,Rat.cast_div,Rat.cast_one,Rat.cast_ofNat] using
      berryEsseenRationalGaussianUpper_correct (r.frequency*((i:ℚ)*(1/2000)))
  have hE₀ : Real.exp (((r.frequency:ℝ)*(1/2000))^2/8)≤
      (berryEsseenExpUpper ((r.frequency*(1/2000))^2/8):ℝ) := by
    have hc : (r.frequency*(1/2000))^2/8≤40 := by nlinarith [sq_nonneg (r.frequency*(1/2000))]
    simpa only [Rat.cast_mul,Rat.cast_div,Rat.cast_pow,Rat.cast_one,Rat.cast_ofNat] using
      berryEsseen_exp_le_fast_upper hc
  have hE₁ : Real.exp (((r.frequency:ℝ)*(1/2000))^2/4)≤
      (berryEsseenExpUpper ((r.frequency*(1/2000))^2/4):ℝ) := by
    simpa only [Rat.cast_mul,Rat.cast_div,Rat.cast_pow,Rat.cast_one,Rat.cast_ofNat] using
      berryEsseen_exp_le_fast_upper hchord
  have hp : 0<berryEsseenPiInterval.lo := by norm_num [berryEsseenPiInterval]
  have hpi : (berryEsseenPiInterval.lo:ℝ)≤Real.pi := berryEsseenPiInterval_correct.1
  have hlow := berryEsseenNormalizedLow_correct hq0 hUR (by norm_num)
    (show (0:ℝ)<berryEsseenPiInterval.lo by exact_mod_cast hp) hpi hE₀ hk hkτR hc
    (fun i => (berryEsseenRawKernelUpper i:ℝ)) _
    (fun i hi hin => hkernel i hi (by omega)) (fun i _ => hG i)
  have hhigh := berryEsseenNormalizedHigh_correct hq0 hUR.le (by norm_num) hE₁
    (by norm_num : 2≤(2000:ℕ)) hk (by omega) (by norm_num : (2000:ℝ)*(1/2000)=1)
    (fun i => (berryEsseenRawKernelUpper i:ℝ))
    (berryEsseenSelectedPhaseFast (r.upper^3) r.frequency (1/2000)) hkernel
  have hcor := berryEsseenRationalCorrectionBound_correct hU.le (by norm_num : (0:ℚ)<1/2000)
    hk hkτ berryEsseenRawCorrectionUpper (by decide +kernel) hcorr
  have htail := (berryEsseenRationalTailBound_correct hU (by norm_num : (0:ℚ)<1/2000)
    hp hpi hk (r.tailEnd-r.cutoff)).trans
      (Rat.cast_le.mpr (berryEsseenRationalTailBound_le_rounded r.frequency (1/2000)
        berryEsseenPiInterval.lo (by norm_num) r.cutoff (r.tailEnd-r.cutoff)))
  have htotal := add_le_add (add_le_add (add_le_add hlow hhigh) hcor) htail
  simp only [Rat.cast_div,Rat.cast_one,Rat.cast_ofNat,mul_one_div] at htotal
  change berryEsseenCDFErrorBound (q^3) q r.frequency ((r.cutoff:ℝ)/2000)≤_
  refine htotal.trans_eq ?_
  unfold boxCurve boxRemainder
  push_cast
  field_simp [hq0.ne']
  ring

end BerryEsseenConvexBoxSoundness


section BerryEsseenEndpointComparison

theorem berryEsseenRationalInnerUpper_mesh_correct {q d : ℚ} (hq : 0≤q) (hd : 0≤d)
    (n : ℕ) (hcut : (q^3/4)*((n:ℚ)*d)≤1)
    (hexp : berryEsseenRationalCappedExponent q ((n:ℚ)*d)≤40)
    (i : ℕ) (hi : i≤n) :
    berryEsseenInnerMajorant (q:ℝ) ((i:ℝ)*(d:ℝ))≤
      (berryEsseenRationalInnerUpper q ((i:ℚ)*d):ℝ) := by
  have hm : (i:ℚ)*d≤(n:ℚ)*d := mul_le_mul_of_nonneg_right (by exact_mod_cast hi) hd
  have hc := (mul_le_mul_of_nonneg_left hm (show 0≤q^3/4 by positivity)).trans hcut
  have he := (berryEsseenRationalCappedExponent_mono hq (by positivity : 0≤(i:ℚ)*d) hm).trans hexp
  simpa only [Rat.cast_mul,Rat.cast_natCast] using
    berryEsseenRationalInnerUpper_correct hq (by positivity : 0≤(i:ℚ)*d) hc he

theorem berryEsseenNormalizedPrefix_le_rational {q d : ℚ} (hq : 0≤q) (hd : 0≤d)
    (n : ℕ) (hcut : (q^3/4)*((n:ℚ)*d)≤1)
    (hexp : berryEsseenRationalCappedExponent q ((n:ℚ)*d)≤40) :
    (q:ℝ)^3*berryEsseenNormalizedPrefix d n q≤(berryEsseenRationalInnerPrefix q d n:ℝ) := by
  have hF := berryEsseenRationalInnerUpper_mesh_correct hq hd n hcut hexp
  unfold berryEsseenNormalizedPrefix berryEsseenRationalInnerPrefix
  rw [Finset.mul_sum,Rat.cast_sum]
  apply Finset.sum_le_sum
  intro i hi
  have hin := Finset.mem_range.mp hi
  have hF₀ := hF i (by omega)
  have hF₁ := hF (i+1) (by omega)
  rw [berryEsseenInnerMajorant_eq_normalized] at hF₀ hF₁
  simp only [Nat.cast_add,Nat.cast_one] at hF₁
  have hdR : (0:ℝ)≤d := by exact_mod_cast hd
  have h := mul_le_mul_of_nonneg_left (add_le_add hF₀ hF₁) (show 0≤(d:ℝ)/2 by positivity)
  simp only [Rat.cast_mul,Rat.cast_div,Rat.cast_add,Rat.cast_ofNat]
  convert! h using 1 <;> ring

theorem berryEsseenChordIntegral3_mono_prefix {a b c d e f E F : ℝ}
    (ha : 0≤a) (hb : 0≤b) (hc : 0≤c) (hd : 0≤d) (he : e≤E) (hf : f≤F) :
    berryEsseenChordIntegral3 a b c d e f≤berryEsseenChordIntegral3 a b c d E F := by
  unfold berryEsseenChordIntegral3
  gcongr

/-- At rational endpoints the convex low-frequency curve is bounded by the checked evaluator. -/
theorem berryEsseenNormalizedLow_le_rational {q U h p : ℚ} (hq : 0≤q) (hU : 0≤U)
    (hh : 0≤h) (hp : 0<p) {n : ℕ} (hn : 0<n)
    (hcut : (q^3/4)*((n:ℚ)*(U*h))≤1)
    (hexp : berryEsseenRationalCappedExponent q ((n:ℚ)*(U*h))≤40)
    (K : ℕ → ℚ) (hK : ∀ i,0≤K i) :
    (q:ℝ)^3*berryEsseenNormalizedLow U h p (berryEsseenExpUpper ((U*h)^2/8)) n
      (fun i => (K i:ℝ))
      (fun i => (berryEsseenRationalGaussianUpper (U*((i:ℚ)*h)):ℝ)) q≤
      (berryEsseenRationalLowFast q U h p n K:ℝ) := by
  have hd : 0≤U*h := mul_nonneg hU hh
  have hUR : (0:ℝ)≤U := by exact_mod_cast hU
  have hhR : (0:ℝ)≤h := by exact_mod_cast hh
  have hpR : (0:ℝ)<p := by exact_mod_cast hp
  have hF := berryEsseenRationalInnerUpper_mesh_correct hq hd n hcut hexp
  have hc (i : ℕ) (hi : i≤n) : (q^3/4)*((i:ℚ)*(U*h))≤1 :=
    (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (by exact_mod_cast hi) hd)
      (by positivity)).trans hcut
  have he (i : ℕ) (hi : i≤n) : berryEsseenRationalCappedExponent q ((i:ℚ)*(U*h))≤40 :=
    (berryEsseenRationalCappedExponent_mono hq (by positivity)
      (mul_le_mul_of_nonneg_right (by exact_mod_cast hi) hd)).trans hexp
  have hI (i : ℕ) (hi : i≤n) := berryEsseenNormalizedPrefix_le_rational hq hd i (hc i hi) (he i hi)
  have hKR (i : ℕ) : (0:ℝ)≤K i := by exact_mod_cast hK i
  have hG (u : ℚ) : (0:ℝ)≤berryEsseenRationalGaussianUpper u := by
    unfold berryEsseenRationalGaussianUpper berryEsseenExpUpper
    positivity
  have hE : (0:ℝ)≤berryEsseenExpUpper ((U*h)^2/8) := by unfold berryEsseenExpUpper; positivity
  unfold berryEsseenNormalizedLow
  rw [mul_add ((q:ℝ)^3),Finset.mul_sum,berryEsseenRationalLowFast_eq]
  unfold berryEsseenRationalLowBound
  rw [Rat.cast_add,Rat.cast_sum]
  apply add_le_add
  · have hb := hF 1 (by omega)
    simp only [Nat.cast_one,one_mul,Rat.cast_mul] at hb
    rw [berryEsseenInnerMajorant_eq_normalized] at hb
    have hs := mul_le_mul_of_nonneg_left hb
      (show 0≤4*(U:ℝ)*((h:ℝ)/(2*(p:ℝ))+(h:ℝ)^2/64) by positivity)
    simp only [Rat.cast_mul,Rat.cast_add,Rat.cast_div,Rat.cast_pow,Rat.cast_ofNat]
    convert! hs using 1 <;> ring
  · apply Finset.sum_le_sum
    intro i hi
    obtain ⟨hi0,hin⟩ := Finset.mem_Ico.mp hi
    have hI₀ := hI i (by omega)
    have hI₁ := hI (i+1) (by omega)
    simp only [Rat.cast_mul] at hI₀ hI₁
    have hc := berryEsseenChordIntegral3_mono_prefix (hKR i) (hKR (i+1))
      (hG (U*((i:ℚ)*h))) (hG (U*(((i:ℚ)+1)*h))) hI₀ hI₁
    have hs := mul_le_mul_of_nonneg_left hc
      (show 0≤4*(h:ℝ)*(berryEsseenExpUpper ((U*h)^2/8):ℝ) by positivity)
    simp only [Rat.cast_mul,Rat.cast_ofNat,berryEsseenRationalChord3_cast,Nat.cast_add,Nat.cast_one]
    convert! hs using 1 <;> unfold berryEsseenChordIntegral3 <;> ring

theorem berryEsseenChordIntegral2_mono {a b c d C D : ℝ}
    (ha : 0≤a) (hb : 0≤b) (hc : c≤C) (hd : d≤D) :
    berryEsseenChordIntegral2 a b c d≤berryEsseenChordIntegral2 a b C D := by
  unfold berryEsseenChordIntegral2
  gcongr

/-- Rational exponential endpoint checks bound the normalized high-frequency curve. -/
theorem berryEsseenNormalizedHigh_le_rational {q U h : ℚ} (hq : 0<q) (hh : 0≤h)
    (n k : ℕ) (K : ℕ → ℚ) (hK : ∀ i,0≤K i) (phase : ℕ → BerryEsseenPhase)
    (hp₀ : ∀ i ∈ Finset.Ico k (n-1),berryEsseenRationalPhaseExponent (phase i) (q^3) (U*((i:ℚ)*h))≤40)
    (hp₁ : ∀ i ∈ Finset.Ico k (n-1),berryEsseenRationalPhaseExponent (phase i) (q^3) (U*(((i:ℚ)+1)*h))≤40) :
    (q:ℝ)^3*berryEsseenNormalizedHigh U h (berryEsseenExpUpper ((U*h)^2/4)) n k
      (fun i => (K i:ℝ)) phase q+(61/100:ℝ)*(h:ℝ)^2≤
      (berryEsseenRationalHighBound (q^3) U h n k K phase:ℝ) := by
  have hqR : (0:ℝ)<q := by exact_mod_cast hq
  have hhR : (0:ℝ)≤h := by exact_mod_cast hh
  have hKR (i : ℕ) : (0:ℝ)≤K i := by exact_mod_cast hK i
  have hE : (0:ℝ)≤berryEsseenExpUpper ((U*h)^2/4) := by unfold berryEsseenExpUpper; positivity
  unfold berryEsseenNormalizedHigh berryEsseenRationalHighBound
  rw [Finset.mul_sum,Rat.cast_add,Rat.cast_sum]
  apply add_le_add _ (by simp only [Rat.cast_mul,Rat.cast_div,Rat.cast_pow,Rat.cast_ofNat,le_refl])
  apply Finset.sum_le_sum
  intro i hi
  have hexp (u : ℚ) (hu : berryEsseenRationalPhaseExponent (phase i) (q^3) u≤40) :
      Real.exp (-((phase i).coefficients.1:ℝ)*(u:ℝ)^2+
        (2*((phase i).coefficients.2:ℝ)*(u:ℝ)^3)*(q:ℝ)^3)≤
      (berryEsseenExpUpper (berryEsseenRationalPhaseExponent (phase i) (q^3) u):ℝ) := by
    have hx := berryEsseen_exp_le_fast_upper hu
    rw [berryEsseenRationalPhaseExponent_cast] at hx
    simp only [Rat.cast_pow] at hx
    convert! hx using 2 <;> ring
  have hc := berryEsseenChordIntegral2_mono (hKR i) (hKR (i+1))
    (hexp (U*((i:ℚ)*h)) (hp₀ i hi)) (hexp (U*(((i:ℚ)+1)*h)) (hp₁ i hi))
  have hs := mul_le_mul_of_nonneg_left hc
    (show 0≤2*(h:ℝ)*(berryEsseenExpUpper ((U*h)^2/4):ℝ) by positivity)
  simp only [Rat.cast_mul,Rat.cast_ofNat,berryEsseenRationalChord2_cast]
  simp only [Rat.cast_mul,Rat.cast_natCast,Rat.cast_add,Rat.cast_one] at hs
  convert! hs using 1
  unfold berryEsseenChordIntegral2 berryEsseenNormalizedPhase
  field_simp [hqR.ne']

end BerryEsseenEndpointComparison


section BerryEsseenBoxEndpointBounds

theorem berryEsseenRationalCappedExponent_comm (q u : ℚ) :
    berryEsseenRationalCappedExponent q u=berryEsseenRationalCappedExponent u q := by
  simp only [berryEsseenRationalCappedExponent,mul_comm]

theorem berryEsseenRationalPhaseExponent_mono (p : BerryEsseenPhase) {ell E u : ℚ}
    (hell : ell≤E) (hu : 0≤u) :
    berryEsseenRationalPhaseExponent p ell u≤berryEsseenRationalPhaseExponent p E u := by
  unfold berryEsseenRationalPhaseExponent
  apply add_le_add le_rfl
  apply mul_le_mul_of_nonneg_right _ (pow_nonneg hu _)
  exact mul_le_mul_of_nonneg_left hell (mul_nonneg (by norm_num) p.coefficients_bounds.2.2)

/-- Endpoint evaluation of the convex curve is dominated by the executable rational bound. -/
theorem BerryEsseenNumericalRow.boxEndpointBound_correct (r : BerryEsseenNumericalRow)
    (hr : r.BoxAdmissible) {q : ℚ} (hq : q ∈ Icc r.lower r.upper) :
    (q:ℝ)^3*r.boxCurve q≤(r.boxEndpointBound q:ℝ) := by
  obtain ⟨hs,hlo,hhi⟩ := hr
  obtain ⟨hl,hlu,hU,hk,hkN,hkm,hcut,hexp,hchord⟩ := hs
  have hq0 : 0<q := hlo.trans_le hq.1
  have hqR : (0:ℝ)<q := by exact_mod_cast hq0
  have hcube : q^3≤r.upper^3 := pow_le_pow_left₀ hq0.le hq.2 3
  have hcutq : (q^3/4)*((r.cutoff:ℚ)*(r.frequency*(1/2000)))≤1 :=
    (mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right hcube (by norm_num))
      (by positivity)).trans hcut
  have hexpq : berryEsseenRationalCappedExponent q ((r.cutoff:ℚ)*(r.frequency*(1/2000)))≤40 := by
    rw [berryEsseenRationalCappedExponent_comm q]
    have he := (berryEsseenRationalCappedExponent_mono
      (show 0≤(r.cutoff:ℚ)*(r.frequency*(1/2000)) by positivity) hq0.le hq.2)
    rw [berryEsseenRationalCappedExponent_comm _ r.upper] at he
    exact he.trans hexp
  have hphase (i : ℕ) :
      berryEsseenRationalPhaseExponent (berryEsseenSelectedPhaseFast (r.upper^3) r.frequency (1/2000) i)
        (q^3) (r.frequency*((i:ℚ)*(1/2000)))≤40 ∧
      berryEsseenRationalPhaseExponent (berryEsseenSelectedPhaseFast (r.upper^3) r.frequency (1/2000) i)
        (q^3) (r.frequency*(((i:ℚ)+1)*(1/2000)))≤40 := by
    rw [berryEsseenSelectedPhaseFast_eq]
    have hs := berryEsseenSelectedPhase_nonpos (r.upper^3) r.frequency (1/2000) i
    exact ⟨((berryEsseenRationalPhaseExponent_mono _ hcube (by positivity)).trans hs.1).trans (by norm_num),
      ((berryEsseenRationalPhaseExponent_mono _ hcube (by positivity)).trans hs.2).trans (by norm_num)⟩
  have hK (i : ℕ) : 0≤berryEsseenRawKernelUpper i := by unfold berryEsseenRawKernelUpper; positivity
  have hlow₀ := berryEsseenNormalizedLow_le_rational (p := berryEsseenPiInterval.lo)
    hq0.le hU.le (by norm_num : (0:ℚ)≤1/2000)
    (by norm_num [berryEsseenPiInterval]) hk hcutq hexpq berryEsseenRawKernelUpper hK
  have hlow := hlow₀.trans (Rat.cast_le.mpr (berryEsseenNaturalLowBound_sound hU.le
    (by norm_num : (0:ℚ)≤1/2000) (by norm_num [berryEsseenPiInterval]) r.cutoff))
  have hhigh := berryEsseenNormalizedHigh_le_rational hq0 (by norm_num : (0:ℚ)≤1/2000)
    2000 r.cutoff berryEsseenRawKernelUpper hK
    (berryEsseenSelectedPhaseFast (r.upper^3) r.frequency (1/2000))
    (fun i _ => (hphase i).1) (fun i _ => (hphase i).2)
  rw [← berryEsseenIntegerHighBound_eq] at hhigh
  have htotal := add_le_add (add_le_add (add_le_add hlow hhigh)
    (le_refl (berryEsseenRationalCorrectionBound r.frequency (1/2000) r.cutoff berryEsseenRawCorrectionUpper:ℝ)))
    (le_refl (berryEsseenRationalTailRounded r.frequency (1/2000) berryEsseenPiInterval.lo
      r.cutoff (r.tailEnd-r.cutoff):ℝ))
  norm_num only [Rat.cast_div,Rat.cast_one,Rat.cast_ofNat] at htotal
  convert! htotal using 1
  · unfold boxCurve boxRemainder
    push_cast
    field_simp [hqR.ne']
    ring
  · unfold boxEndpointBound
    rw [berryEsseenIntegerCorrectionBound_eq]
    push_cast
    ring

end BerryEsseenBoxEndpointBounds


section BerryEsseenBoxCertificates

/-- The complete box certificate consists of side conditions and two rational endpoint bounds. -/
def BerryEsseenNumericalRow.BoxCheck (r : BerryEsseenNumericalRow) : Prop :=
  r.BoxAdmissible ∧ r.boxEndpointBound r.lower≤(14/25:ℚ)*r.lower^3 ∧
    r.boxEndpointBound r.upper≤(14/25:ℚ)*r.upper^3

instance (r : BerryEsseenNumericalRow) : Decidable r.BoxCheck :=
  inferInstanceAs (Decidable (_ ∧ _))

/-- Checked endpoint values control every intermediate normalized moment parameter. -/
theorem BerryEsseenNumericalRow.boxCurve_le_of_check (r : BerryEsseenNumericalRow)
    (hr : r.BoxCheck) {q : ℝ} (hq : q ∈ Icc (r.lower:ℝ) (r.upper:ℝ)) :
    r.boxCurve q≤14/25 := by
  obtain ⟨hmeta,hl,hu⟩ := hr
  have horder : r.lower≤r.upper := hmeta.1.2.1
  have horderR : (r.lower:ℝ)≤r.upper := by exact_mod_cast horder
  have hloR : (0:ℝ)<r.lower := by exact_mod_cast hmeta.2.1
  have hhiR : (0:ℝ)<r.upper := hloR.trans_le horderR
  have hendpoint (a : ℚ) (ha : a ∈ Icc r.lower r.upper) (ha0 : (0:ℝ)<a)
      (hb : r.boxEndpointBound a≤(14/25:ℚ)*a^3) : r.boxCurve a≤14/25 := by
    have hbR : (r.boxEndpointBound a:ℝ)≤(((14/25:ℚ)*a^3:ℚ):ℝ) := Rat.cast_le.mpr hb
    norm_num only [Rat.cast_mul,Rat.cast_div,Rat.cast_pow,Rat.cast_ofNat] at hbR
    have he := (r.boxEndpointBound_correct hmeta ha).trans hbR
    apply (mul_le_mul_iff_right₀ (pow_pos ha0 3)).mp
    nlinarith only [he]
  have hlc := hendpoint r.lower ⟨le_rfl,horder⟩ hloR hl
  have huc := hendpoint r.upper ⟨horder,le_rfl⟩ hhiR hu
  exact ((r.boxCurve_convex hmeta).le_max_of_mem_Icc
    ⟨le_rfl,horderR⟩ ⟨horderR,le_rfl⟩ hq).trans (max_le hlc huc)

/-- A numerical box gives a finite interval certificate for the full analytic error envelope. -/
theorem BerryEsseenNumericalRow.interval_of_boxCheck (r : BerryEsseenNumericalRow)
    (hr : r.BoxCheck) : BerryEsseenCertifiedInterval r.lower r.upper := by
  have hmeta := hr.1
  have horder : r.lower≤r.upper := hmeta.1.2.1
  obtain ⟨hl,hlu,hU,hk,hkN,hkm,hcut,hexp,hchord⟩ := hmeta.1
  have hUR : (0:ℝ)<r.frequency := by exact_mod_cast hU
  have hkR : (0:ℝ)<r.cutoff := by exact_mod_cast hk
  have hkR1 : (r.cutoff:ℝ)<1500 := by exact_mod_cast hkN
  apply BerryEsseenCertifiedInterval.box hmeta.2.1 horder (r.frequency:ℝ)
    ((r.cutoff:ℝ)/2000) hUR (by positivity) (by linarith)
  intro q hq
  have hloR : (0:ℝ)<r.lower := by exact_mod_cast hmeta.2.1
  have hq0 : 0≤q := hloR.le.trans hq.1
  refine (r.boxCurve_correct hmeta hq).trans ?_
  have h := mul_le_mul_of_nonneg_left (r.boxCurve_le_of_check hr hq) (pow_nonneg hq0 3)
  nlinarith only [h]

end BerryEsseenBoxCertificates


section BerryEsseenIndependentSums

/-- Independence identifies the sum law with the sum of the marginal product measure. -/
theorem berryEsseen_independent_sum_law {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
    (P : Measure Ω) [IsProbabilityMeasure P] (X : ι → Ω → ℝ)
    (hX : ∀ i, AEMeasurable (X i) P) (hind : iIndepFun X P) :
    P.map (fun w => ∑ i,X i w)=
      (Measure.pi (fun i => P.map (X i))).map (fun z => ∑ i,z i) := by
  rw [← iIndepFun.map_fun_eq_pi_map hX hind,
    AEMeasurable.map_map_of_aemeasurable (by fun_prop) (aemeasurable_pi_lambda _ hX)]
  rfl

/-- The variance-scaled theorem applies to independent summands on any probability space. -/
theorem berryEsseen_independent_cdf_of_certified_interval {lo hi : ℚ}
    (hcover : BerryEsseenCertifiedInterval lo hi)
    (hfirst : (lo:ℝ)^3≤1/100) (hlast : 25/14≤(hi:ℝ)^3)
    {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
    (P : Measure Ω) [IsProbabilityMeasure P] (X : ι → Ω → ℝ)
    (hind : iIndepFun X P) (hm : ∀ i, MemLp (X i) 3 P)
    (hmean : ∀ i, (∫ w, X i w ∂P)=0)
    (v : ℝ≥0) (hv : (∑ i, ∫ w, (X i w)^2 ∂P)=(v:ℝ)) (x : ℝ) :
    |cdf (P.map (fun w => ∑ i,X i w)) x-cdf (gaussianReal 0 v) x| ≤
      (14/25:ℝ)*(∑ i, ∫ w, |X i w|^3 ∂P)/(Real.sqrt (v:ℝ))^3 := by
  have hX (i) : AEMeasurable (X i) P := (hm i).aestronglyMeasurable.aemeasurable
  have hmarg (i) : MemLp id 3 (P.map (X i)) := by
    rw [memLp_map_measure_iff (by fun_prop) (hX i)]
    simpa only [Function.comp_def,id_eq] using hm i
  have hmean' (i) : (∫ z : ℝ, z ∂P.map (X i))=0 := by
    rw [integral_map (f := fun z : ℝ => z) (hX i) (by fun_prop)]
    exact hmean i
  have hv' : (∑ i, ∫ z : ℝ, z^2 ∂P.map (X i))=(v:ℝ) := by
    simpa only [integral_map (f := fun z : ℝ => z^2) (hX _) (by fun_prop)] using hv
  have ht' : (∑ i, ∫ z : ℝ, |z|^3 ∂P.map (X i))=
      (∑ i, ∫ w, |X i w|^3 ∂P) := by
    simp only [integral_map (f := fun z : ℝ => |z|^3) (hX _) (by fun_prop)]
  have h := berryEsseen_product_cdf_scaled_of_certified_interval hcover hfirst hlast
    (fun i => P.map (X i)) hmarg hmean' v hv' x
  rw [ht', ← berryEsseen_independent_sum_law P X hX hind] at h
  exact h

end BerryEsseenIndependentSums


