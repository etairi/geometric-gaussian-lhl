/-- Exact rational products of two linear chords. -/
def berryEsseenRationalChord2 (f₀ f₁ g₀ g₁ : ℚ) : ℚ :=
  (2*f₀*g₀+f₀*g₁+f₁*g₀+2*f₁*g₁)/6
/-- Exact rational products of three linear chords. -/
def berryEsseenRationalChord3 (f₀ f₁ g₀ g₁ h₀ h₁ : ℚ) : ℚ :=
  (3*f₀*g₀*h₀+f₀*g₀*h₁+f₀*g₁*h₀+f₁*g₀*h₀+
    f₀*g₁*h₁+f₁*g₀*h₁+f₁*g₁*h₀+3*f₁*g₁*h₁)/12

theorem berryEsseenRationalChord2_cast (f₀ f₁ g₀ g₁ : ℚ) :
    (berryEsseenRationalChord2 f₀ f₁ g₀ g₁:ℝ) = berryEsseenChordIntegral2 f₀ f₁ g₀ g₁ := by
  simp only [berryEsseenRationalChord2, berryEsseenChordIntegral2, Rat.cast_add,
    Rat.cast_div, Rat.cast_mul, Rat.cast_ofNat]

theorem berryEsseenRationalChord3_cast (f₀ f₁ g₀ g₁ h₀ h₁ : ℚ) :
    (berryEsseenRationalChord3 f₀ f₁ g₀ g₁ h₀ h₁:ℝ) = berryEsseenChordIntegral3 f₀ f₁ g₀ g₁ h₀ h₁ := by
  simp only [berryEsseenRationalChord3, berryEsseenChordIntegral3, Rat.cast_add,
    Rat.cast_div, Rat.cast_mul, Rat.cast_ofNat]

/-- The selected phase exponent is a rational polynomial. -/
def berryEsseenRationalPhaseExponent (p : BerryEsseenPhase) (ell u : ℚ) : ℚ :=
  -p.coefficients.1*u^2+2*p.coefficients.2*ell*u^3

theorem berryEsseenRationalPhaseExponent_cast (p : BerryEsseenPhase) (ell u : ℚ) :
    (berryEsseenRationalPhaseExponent p ell u:ℝ) =
      -(p.coefficients.1:ℝ)*(u:ℝ)^2+2*(p.coefficients.2:ℝ)*(ell:ℝ)*(u:ℝ)^3 := by
  simp only [berryEsseenRationalPhaseExponent, Rat.cast_add, Rat.cast_neg, Rat.cast_pow,
    Rat.cast_mul, Rat.cast_ofNat]

/-- Rational quadrature of the regular correction integral, including the proved error term. -/
def berryEsseenRationalCorrectionBound (U h : ℚ) (n : ℕ) (C : ℕ → ℚ) : ℚ :=
  (∑ i ∈ Finset.range n, h*(C i*berryEsseenRationalGaussianUpper (U*((i:ℚ)*h))+
    C (i+1)*berryEsseenRationalGaussianUpper (U*(((i:ℚ)+1)*h))))+
    ((n:ℚ)*h)*h^2*(150+12*U+U^2)/12

theorem berryEsseenRationalCorrectionBound_correct {U h : ℚ} (hU : 0 ≤ U) (hh : 0 < h)
    {n : ℕ} (hn : 0 < n) (hn1 : (n:ℚ)*h < 3/4) (C : ℕ → ℚ)
    (hC0 : (1/2:ℚ) ≤ C 0)
    (hC : ∀ i, 0 < i → i ≤ n →
      ‖berryEsseenSmoothingKernel ((i:ℝ)*(h:ℝ))-Complex.I/(2*Real.pi*((i:ℝ)*(h:ℝ)):ℝ)‖ ≤ (C i:ℝ)) :
    2*(∫ t in (0:ℝ)..((n:ℝ)*(h:ℝ)),
      ‖berryEsseenSmoothingKernel t-Complex.I/(2*Real.pi*t:ℝ)‖*Real.exp (-((U:ℝ)*t)^2/2)) ≤
      (berryEsseenRationalCorrectionBound U h n C:ℝ) := by
  have hn1R : (n:ℝ)*(h:ℝ) < 3/4 := by
    have ht : (((n:ℚ)*h:ℚ):ℝ) < ((3/4:ℚ):ℝ) := Rat.cast_lt.mpr hn1
    norm_num only [Rat.cast_mul, Rat.cast_natCast, Rat.cast_div, Rat.cast_ofNat] at ht
    exact ht
  have hC0R : (1/2:ℝ) ≤ (C 0:ℝ) := by
    have ht : ((1/2:ℚ):ℝ) ≤ (C 0:ℝ) := Rat.cast_le.mpr hC0
    norm_num only [Rat.cast_div, Rat.cast_one, Rat.cast_ofNat] at ht
    exact ht
  have h := berryEsseen_correction_mesh (U := (U:ℝ)) (h := (h:ℝ)) (by exact_mod_cast hU) (by exact_mod_cast hh)
    hn hn1R (fun i => (C i:ℝ))
    (fun i => (berryEsseenRationalGaussianUpper (U*((i:ℚ)*h)):ℝ))
    hC0R hC (fun i _ => by
      simpa only [Rat.cast_mul, Rat.cast_natCast] using berryEsseenRationalGaussianUpper_correct (U*((i:ℚ)*h)))
  convert! h using 1
  unfold berryEsseenRationalCorrectionBound
  push_cast
  rfl

/-- Rational quadrature of the infinite Gaussian tail, with a final analytic remainder. -/
def berryEsseenRationalTailBound (U h p : ℚ) (k m : ℕ) : ℚ :=
  (∑ i ∈ Finset.range m, h/2*(berryEsseenRationalGaussianUpper (U*(((k+i:ℕ):ℚ)*h))/(p*(((k+i:ℕ):ℚ)*h))+
    berryEsseenRationalGaussianUpper (U*(((k+i+1:ℕ):ℚ)*h))/(p*(((k+i+1:ℕ):ℚ)*h))))+
    berryEsseenRationalGaussianUpper (U*(((k+m:ℕ):ℚ)*h))/(p*(U*(((k+m:ℕ):ℚ)*h))^2)

theorem berryEsseenRationalTailBound_correct {U h p : ℚ} (hU : 0 < U) (hh : 0 < h)
    (hp : 0 < p) (hpi : (p:ℝ) ≤ Real.pi) {k : ℕ} (hk : 0 < k) (m : ℕ) :
    (∫ t in Ioi ((k:ℝ)*(h:ℝ)), (1/(Real.pi*t))*Real.exp (-((U:ℝ)*t)^2/2)) ≤
      (berryEsseenRationalTailBound U h p k m:ℝ) := by
  have h := berryEsseen_tail_mesh (U := (U:ℝ)) (h := (h:ℝ)) (p := (p:ℝ)) (by exact_mod_cast hU) (by exact_mod_cast hh)
    (by exact_mod_cast hp) hpi hk m
    (fun i => (berryEsseenRationalGaussianUpper (U*((i:ℚ)*h)):ℝ)) (fun i _ => by
      simpa only [Rat.cast_mul, Rat.cast_natCast] using berryEsseenRationalGaussianUpper_correct (U*(((k+i:ℕ):ℚ)*h)))
  convert! h using 1
  unfold berryEsseenRationalTailBound
  push_cast
  rfl

/-- Positivity of the explicit chord integrals is independent of their analytic construction. -/
theorem berryEsseenChordIntegral2_nonneg {f₀ f₁ g₀ g₁ : ℝ}
    (hf₀ : 0 ≤ f₀) (hf₁ : 0 ≤ f₁) (hg₀ : 0 ≤ g₀) (hg₁ : 0 ≤ g₁) :
    0 ≤ berryEsseenChordIntegral2 f₀ f₁ g₀ g₁ := by unfold berryEsseenChordIntegral2; positivity

theorem berryEsseenChordIntegral3_nonneg {f₀ f₁ g₀ g₁ h₀ h₁ : ℝ}
    (hf₀ : 0 ≤ f₀) (hf₁ : 0 ≤ f₁) (hg₀ : 0 ≤ g₀) (hg₁ : 0 ≤ g₁)
    (hh₀ : 0 ≤ h₀) (hh₁ : 0 ≤ h₁) :
    0 ≤ berryEsseenChordIntegral3 f₀ f₁ g₀ g₁ h₀ h₁ := by unfold berryEsseenChordIntegral3; positivity

/-- Rational high-frequency quadrature uses a chosen valid phase on every cell. -/
def berryEsseenRationalHighBound (ell U h : ℚ) (n k : ℕ)
    (K : ℕ → ℚ) (phase : ℕ → BerryEsseenPhase) : ℚ :=
  (∑ i ∈ Finset.Ico k (n-1), 2*h*berryEsseenExpUpper ((U*h)^2/4)*
    berryEsseenRationalChord2 (K i) (K (i+1))
      (berryEsseenExpUpper (berryEsseenRationalPhaseExponent (phase i) ell (U*((i:ℚ)*h))))
      (berryEsseenExpUpper (berryEsseenRationalPhaseExponent (phase i) ell (U*(((i:ℚ)+1)*h)))))+
    (61/100:ℚ)*h^2

theorem berryEsseenRationalHighBound_correct {ell U h : ℚ}
    (hell : 0 ≤ ell) (hU : 0 ≤ U) (hh : 0 < h)
    {n k : ℕ} (hn : 2 ≤ n) (hk : 0 < k) (hkn : k ≤ n-1) (hmesh : (n:ℚ)*h=1)
    (hchord : (U*h)^2/4 ≤ 40) (K : ℕ → ℚ) (phase : ℕ → BerryEsseenPhase)
    (hK : ∀ i, 0 < i → i < n → ‖berryEsseenSmoothingKernel ((i:ℝ)*(h:ℝ))‖ ≤ (K i:ℝ))
    (hp₀ : ∀ i ∈ Finset.Ico k (n-1), berryEsseenRationalPhaseExponent (phase i) ell (U*((i:ℚ)*h)) ≤ 40)
    (hp₁ : ∀ i ∈ Finset.Ico k (n-1), berryEsseenRationalPhaseExponent (phase i) ell (U*(((i:ℚ)+1)*h)) ≤ 40) :
    2*(∫ t in ((k:ℝ)*(h:ℝ))..1, ‖berryEsseenSmoothingKernel t‖*berryEsseenMagnitudeBound ell ((U:ℝ)*t)) ≤
      (berryEsseenRationalHighBound ell U h n k K phase:ℝ) := by
  have hellR : (0:ℝ) ≤ ell := by exact_mod_cast hell
  have hUR : (0:ℝ) ≤ U := by exact_mod_cast hU
  have hhR : (0:ℝ) < h := by exact_mod_cast hh
  let A (i : ℕ) : ℝ := ((phase i).coefficients.1:ℝ)
  let B (i : ℕ) : ℝ := ((phase i).coefficients.2:ℝ)
  let E₀ (i : ℕ) : ℚ := berryEsseenExpUpper (berryEsseenRationalPhaseExponent (phase i) ell (U*((i:ℚ)*h)))
  let E₁ (i : ℕ) : ℚ := berryEsseenExpUpper (berryEsseenRationalPhaseExponent (phase i) ell (U*(((i:ℚ)+1)*h)))
  have hA (i : ℕ) : 0 ≤ A i := by dsimp [A]; exact_mod_cast (phase i).coefficients_bounds.1
  have hA1 (i : ℕ) : A i ≤ 1 := by dsimp [A]; exact_mod_cast (phase i).coefficients_bounds.2.1
  have hB (i : ℕ) : 0 ≤ B i := by dsimp [B]; exact_mod_cast (phase i).coefficients_bounds.2.2
  have he₀ (i : ℕ) (hi : i ∈ Finset.Ico k (n-1)) :
      Real.exp (-(A i)*((U:ℝ)*((i:ℝ)*(h:ℝ)))^2+2*(B i)*(ell:ℝ)*((U:ℝ)*((i:ℝ)*(h:ℝ)))^3) ≤ (E₀ i:ℝ) := by
    simpa only [E₀, A, B, berryEsseenRationalPhaseExponent_cast, Rat.cast_mul, Rat.cast_natCast] using
      berryEsseen_exp_le_fast_upper (hp₀ i hi)
  have he₁ (i : ℕ) (hi : i ∈ Finset.Ico k (n-1)) :
      Real.exp (-(A i)*((U:ℝ)*(((i+1:ℕ):ℝ)*(h:ℝ)))^2+2*(B i)*(ell:ℝ)*((U:ℝ)*(((i+1:ℕ):ℝ)*(h:ℝ)))^3) ≤ (E₁ i:ℝ) := by
    simpa only [E₁, A, B, berryEsseenRationalPhaseExponent_cast, Rat.cast_mul, Rat.cast_natCast,
      Rat.cast_add, Rat.cast_one, Nat.cast_add, Nat.cast_one] using berryEsseen_exp_le_fast_upper (hp₁ i hi)
  have hb := berryEsseen_high_mesh hellR hUR hhR hn hk hkn (by exact_mod_cast hmesh)
    A B (fun i => (K i:ℝ)) (fun i => (E₀ i:ℝ)) (fun i => (E₁ i:ℝ))
    (fun i _ => hA i) (fun i _ => hB i)
    (by
      intro i hi t ht
      exact (phase i).magnitude_le hellR (mul_nonneg hUR ((by positivity : 0 ≤ (i:ℝ)*(h:ℝ)).trans ht.1)))
    hK he₀ he₁
  refine hb.trans ?_
  unfold berryEsseenRationalHighBound
  push_cast
  apply add_le_add _ le_rfl
  apply Finset.sum_le_sum
  intro i hi
  obtain ⟨hki,hin⟩ := Finset.mem_Ico.mp hi
  have hi0 : 0 < i := hk.trans_le hki
  have hi1 : i+1 < n := by omega
  have hc0 := (norm_nonneg _).trans (hK i hi0 (by omega))
  have hc1 := (norm_nonneg _).trans (hK (i+1) (by omega) hi1)
  have he0 := (Real.exp_pos _).le.trans (he₀ i hi)
  have he1 := (Real.exp_pos _).le.trans (he₁ i hi)
  have hch := berryEsseenChordIntegral2_nonneg hc0 hc1 he0 he1
  have hfactor : Real.exp ((A i)*((U:ℝ)*(h:ℝ))^2/4) ≤
      (berryEsseenExpUpper ((U*h)^2/4):ℝ) := by
    have hf : (A i)*((U:ℝ)*(h:ℝ))^2/4 ≤ ((U:ℝ)*(h:ℝ))^2/4 := by
      nlinarith [mul_le_mul_of_nonneg_right (hA1 i) (sq_nonneg ((U:ℝ)*(h:ℝ)))]
    refine (Real.exp_le_exp.mpr hf).trans ?_
    simpa only [Rat.cast_div, Rat.cast_pow, Rat.cast_mul, Rat.cast_ofNat] using berryEsseen_exp_le_fast_upper hchord
  have hmul := mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left hfactor (by positivity : 0 ≤ 2*(h:ℝ))) hch
  simpa only [berryEsseenRationalChord2_cast, E₀, E₁] using hmul

