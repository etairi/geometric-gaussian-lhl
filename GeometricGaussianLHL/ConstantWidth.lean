    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    (hv : (∑ i, ∫ x, x ^ 2 ∂μ i) = 1) {ℓ θ : ℝ}
    (hthird : (∑ i, ∫ x, |x| ^ 3 ∂μ i) ≤ ℓ)
    (hθ0 : 4 ≤ θ) (hθ1 : θ ≤ 25 / 4) (t : ℝ) :
    ‖charFun ((Measure.pi μ).map (fun z => ∑ i, z i)) t‖ ≤
      Real.exp (-berryEsseenTangentA θ * t ^ 2 + 2 * berryEsseenTangentB θ * ℓ * |t| ^ 3) := by
  have hb := berryEsseenTangentB_nonneg hθ0 hθ1
  have h := norm_charFun_product_sum_le_of_quadratic_cubic_majorant μ hm hmean
    hb (cos_le_berryEsseenTangent hθ0 hθ1) t
  rw [hv] at h
  refine h.trans (Real.exp_le_exp.mpr ?_)
  simp only [mul_one]
  gcongr

/-- The rational grid of tangent parameters used by the numerical magnitude envelope. -/
def berryEsseenTangentParameter (i : Fin 65) : ℝ := 4 + (9 / 256 : ℝ) * (i : ℝ)

private theorem berryEsseenTangentParameter_mem (i : Fin 65) :
    berryEsseenTangentParameter i ∈ Icc 4 (25 / 4) := by
  have hi0 : 0 ≤ (i : ℝ) := Nat.cast_nonneg _
  have hi1 : (i : ℝ) ≤ 64 := by exact_mod_cast (Nat.le_of_lt_succ i.isLt)
  unfold berryEsseenTangentParameter
  constructor <;> nlinarith

/-- A finite minimum of certified cubic and tangent envelopes, capped by one. -/
def berryEsseenMagnitudeBound (ℓ t : ℝ) : ℝ :=
  min 1 (min (Real.exp (-t ^ 2 / 2 + (49581 / 250000 : ℝ) * ℓ * |t| ^ 3))
    (Finset.univ.inf' (Finset.univ_nonempty : (Finset.univ : Finset (Fin 65)).Nonempty)
      (fun i => Real.exp (-berryEsseenTangentA (berryEsseenTangentParameter i) * t ^ 2 +
        2 * berryEsseenTangentB (berryEsseenTangentParameter i) * ℓ * |t| ^ 3))))

theorem berryEsseenMagnitudeBound_nonneg (ℓ t : ℝ) : 0 ≤ berryEsseenMagnitudeBound ℓ t := by
  unfold berryEsseenMagnitudeBound
  refine le_min (by norm_num) (le_min (Real.exp_pos _).le ?_)
  exact Finset.le_inf' _ _ (fun i _ => (Real.exp_pos _).le)

@[fun_prop] theorem continuous_berryEsseenMagnitudeBound (ℓ : ℝ) :
    Continuous (berryEsseenMagnitudeBound ℓ) := by
  have h : Continuous (fun t : ℝ =>
      Finset.univ.inf' (Finset.univ_nonempty : (Finset.univ : Finset (Fin 65)).Nonempty)
        (fun i => Real.exp (-berryEsseenTangentA (berryEsseenTangentParameter i) * t ^ 2 +
          2 * berryEsseenTangentB (berryEsseenTangentParameter i) * ℓ * |t| ^ 3))) :=
    Continuous.finset_inf'_apply _ (fun i _ => by fun_prop)
  unfold berryEsseenMagnitudeBound
  have hc : Continuous (fun t : ℝ => Real.exp (-t ^ 2 / 2 + (49581 / 250000 : ℝ) * ℓ * |t| ^ 3)) := by fun_prop
  exact continuous_const.min (hc.min h)

/-- The actual product-sum characteristic function is bounded by the certified finite envelope. -/
theorem norm_charFun_product_sum_le_magnitude {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    (hv : (∑ i, ∫ x, x ^ 2 ∂μ i) = 1) {ℓ : ℝ}
    (hthird : (∑ i, ∫ x, |x| ^ 3 ∂μ i) ≤ ℓ) (t : ℝ) :
    ‖charFun ((Measure.pi μ).map (fun z => ∑ i, z i)) t‖ ≤ berryEsseenMagnitudeBound ℓ t := by
  unfold berryEsseenMagnitudeBound
  refine le_min (norm_charFun_le_one t)
    (le_min (norm_charFun_product_sum_le_exp_normalized μ hm hmean hv hthird t) ?_)
  apply Finset.le_inf'
  intro i _
  exact norm_charFun_product_sum_le_tangent μ hm hmean hv hthird
    (berryEsseenTangentParameter_mem i).1 (berryEsseenTangentParameter_mem i).2 t

end GeometricGaussianLHL

end

end BerryEsseenCharacteristicEstimates

section BerryEsseenSmoothingKernel

/-!
## Pointwise and distributional smoothing bounds

A squared-sinc partition of unity and telescoping reciprocal tails give upper
and lower approximations to the right-continuous step function. Integrating
these against an arbitrary probability measure bounds its actual CDF, including
atoms. Abel damping identifies their finite-frequency representations. Fubini
then gives bounds in terms of the actual characteristic function. The normal
CDF has an exact, integrable Fourier representation for comparison. The
quantitative Berry–Esseen constant remains a separate proof obligation.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
open MeasureTheory ProbabilityTheory Set Filter
open scoped Topology BigOperators Interval NNReal ComplexConjugate
namespace GeometricGaussianLHL

theorem integral_cexp_mul_eq_sinc (a r : ℝ) :
    (∫ t in -r..r, Complex.exp ((a * t : ℝ) * Complex.I)) =
      (2 * r * Real.sinc (a * r) : ℝ) := by
  by_cases ha : a = 0
  · simp [ha]
    ring
  have h := intervalIntegral.integral_comp_mul_left
    (fun t : ℝ => Complex.exp (t * Complex.I)) (a := -r) (b := r) ha
  rw [mul_neg, integral_exp_mul_I_eq_sinc] at h
  calc
    _ = a⁻¹ • (2 * (a * r) * Real.sinc (a * r) : ℂ) := by simpa only [Complex.ofReal_mul] using h
    _ = _ := by
      simp only [Complex.real_smul, Complex.ofReal_inv, Complex.ofReal_mul,
        Complex.ofReal_ofNat]
      field_simp [show (a : ℂ) ≠ 0 by exact_mod_cast ha]

theorem fourierCoeffOn_cexp_eq_sinc (x : ℝ) (n : ℤ) :
    fourierCoeffOn (show (-1 : ℝ) < 1 by norm_num)
      (fun t : ℝ => Complex.exp ((Real.pi * x * t : ℝ) * Complex.I)) n =
      (Real.sinc (Real.pi * (x - n)) : ℂ) := by
  rw [fourierCoeffOn_eq_integral]
  have heq (t : ℝ) :
      fourier (-n) (t : AddCircle ((1 : ℝ) - -1)) •
          Complex.exp ((Real.pi * x * t : ℝ) * Complex.I) =
      Complex.exp (((Real.pi * (x - n)) * t : ℝ) * Complex.I) := by
    rw [fourier_coe_apply, smul_eq_mul, ← Complex.exp_add]
    congr 1
    push_cast
    ring
  simp_rw [heq]
  rw [integral_cexp_mul_eq_sinc]
  norm_num [Complex.real_smul]
  ring

/-- The cardinal squared-sinc kernels form a partition of unity. This is
Parseval applied to a real-frequency exponential on a finite interval. -/
theorem hasSum_sinc_sq_int (x : ℝ) :
    HasSum (fun n : ℤ => Real.sinc (Real.pi * (x - n)) ^ 2) 1 := by
  let f (t : ℝ) := Complex.exp ((Real.pi * x * t : ℝ) * Complex.I)
  have hf : MemLp f 2 (volume.restrict (Ioc (-1 : ℝ) 1)) := by
    apply MemLp.of_bound (by fun_prop) 1
    filter_upwards [] with t
    simp [f, Complex.norm_exp]
  have h := hasSum_sq_fourierCoeffOn (show (-1 : ℝ) < 1 by norm_num) hf
  simp only [f, fourierCoeffOn_cexp_eq_sinc, Complex.norm_real, Real.norm_eq_abs,
    sq_abs] at h
  simpa [Complex.norm_exp] using h



private theorem hasSum_reciprocal_diff {x : ℝ} (hx : 0 < x) :
    HasSum (fun n : ℕ => 1 / (x + n) - 1 / (x + (n + 1))) (1 / x) := by
  have hn (n : ℕ) : 0 ≤ 1 / (x + n) - 1 / (x + (n + 1)) := by
    apply sub_nonneg.mpr
    apply one_div_le_one_div_of_le (by positivity)
    linarith
  apply (hasSum_iff_tendsto_nat_of_nonneg hn _).mpr
  have heq (n : ℕ) : (∑ k ∈ Finset.range n, (1 / (x + k) - 1 / (x + (k + 1)))) =
      1 / x - 1 / (x + n) := by
    simpa only [Nat.cast_zero, Nat.cast_add, Nat.cast_one, add_zero] using
      Finset.sum_range_sub' (fun k : ℕ => 1 / (x + k)) n
  simp_rw [heq]
  have ht : Tendsto (fun n : ℕ => 1 / (x + n)) atTop (𝓝 0) :=
    by
      have hnat : Tendsto (fun n : ℕ => x + (n : ℝ)) atTop atTop :=
        atTop.tendsto_atTop_add_const_left x tendsto_natCast_atTop_atTop
      simpa only [one_div, Function.comp_def] using tendsto_inv_atTop_zero.comp hnat
  simpa using tendsto_const_nhds.sub ht

/-- Bounds on the positive reciprocal-square tail by telescoping differences. -/
theorem reciprocal_square_tail_bounds {x : ℝ} (hx : 0 < x) :
    Summable (fun n : ℕ => 1 / (x + (n + 1)) ^ 2) ∧
      1 / (x + 1) ≤ (∑' n : ℕ, 1 / (x + (n + 1)) ^ 2) ∧
      (∑' n : ℕ, 1 / (x + (n + 1)) ^ 2) ≤ 1 / x := by
  have hupper (n : ℕ) : 1 / (x + (n + 1)) ^ 2 ≤
      1 / (x + n) - 1 / (x + (n + 1)) := by
    have hxn : 0 < x + n := by positivity
    have hxn1 : 0 < x + (n + 1) := by positivity
    rw [div_sub_div _ _ (ne_of_gt hxn) (ne_of_gt hxn1)]
    field_simp
    nlinarith [sq_nonneg (x + n)]
  have hsum := Summable.of_nonneg_of_le (fun n : ℕ => by positivity)
    hupper (hasSum_reciprocal_diff hx).summable
  refine ⟨hsum, ?_, ?_⟩
  · have hlower (n : ℕ) : 1 / (x + 1 + n) - 1 / (x + 1 + (n + 1)) ≤
        1 / (x + (n + 1)) ^ 2 := by
      have hxn : 0 < x + 1 + n := by positivity
      have hxn1 : 0 < x + 1 + (n + 1) := by positivity
      rw [div_sub_div _ _ (ne_of_gt hxn) (ne_of_gt hxn1)]
      field_simp
      nlinarith [sq_nonneg (x + 1 + n)]
    exact hasSum_le hlower (hasSum_reciprocal_diff (by positivity)) hsum.hasSum
  · exact hasSum_le hupper hsum.hasSum (hasSum_reciprocal_diff hx)


def smoothingCardinalKernel (x : ℝ) : ℝ := Real.sinc (Real.pi * x) ^ 2

def smoothingSignApprox (x : ℝ) : ℝ :=
  (∑' n : ℤ, (n.sign : ℝ) * smoothingCardinalKernel (x - n)) +
    2 * x * smoothingCardinalKernel x

theorem smoothingCardinalKernel_nonneg (x : ℝ) : 0 ≤ smoothingCardinalKernel x :=
  sq_nonneg _

theorem smoothingCardinalKernel_neg (x : ℝ) :
    smoothingCardinalKernel (-x) = smoothingCardinalKernel x := by
  simp [smoothingCardinalKernel]

theorem smoothingCardinalKernel_zero : smoothingCardinalKernel 0 = 1 := by
  simp [smoothingCardinalKernel]

theorem smoothingCardinalKernel_int (n : ℤ) :
    smoothingCardinalKernel n = if n = 0 then 1 else 0 := by
  by_cases hn : n = 0
  · simp [hn, smoothingCardinalKernel_zero]
  · have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast hn
    rw [smoothingCardinalKernel, Real.sinc_of_ne_zero (mul_ne_zero Real.pi_ne_zero hn')]
    simp [mul_comm Real.pi, Real.sin_int_mul_pi, hn]

theorem summable_smoothingCardinalKernel (x : ℝ) :
    Summable (fun n : ℤ => smoothingCardinalKernel (x - n)) :=
  (hasSum_sinc_sq_int x).summable

theorem tsum_smoothingCardinalKernel (x : ℝ) :
    (∑' n : ℤ, smoothingCardinalKernel (x - n)) = 1 :=
  (hasSum_sinc_sq_int x).tsum_eq

theorem summable_smoothingSignSeries (x : ℝ) :
    Summable (fun n : ℤ => (n.sign : ℝ) * smoothingCardinalKernel (x - n)) := by
  apply Summable.of_norm_bounded (summable_smoothingCardinalKernel x)
  intro n
  have hn : |(n.sign : ℝ)| ≤ 1 := by
    rcases lt_trichotomy n 0 with h | rfl | h
    · simp [Int.sign_eq_neg_one_of_neg h]
    · simp
    · simp [Int.sign_eq_one_of_pos h]
  rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (smoothingCardinalKernel_nonneg _)]
  simpa using mul_le_mul_of_nonneg_right hn (smoothingCardinalKernel_nonneg (x - n))

theorem smoothingCardinalKernel_add_nat {x : ℝ} (hx : 0 < x) (n : ℕ) :
    smoothingCardinalKernel (x + n) =
      (x ^ 2 * smoothingCardinalKernel x) * (1 / (x + n) ^ 2) := by
  have hx' : x + n ≠ 0 := ne_of_gt (by positivity)
  rw [smoothingCardinalKernel, smoothingCardinalKernel,
    Real.sinc_of_ne_zero (mul_ne_zero Real.pi_ne_zero hx'),
    Real.sinc_of_ne_zero (mul_ne_zero Real.pi_ne_zero hx.ne')]
  rw [mul_add, mul_comm Real.pi (n : ℝ), Real.sin_add_nat_mul_pi]
  rw [div_pow, mul_pow, ← pow_mul, mul_comm n 2, pow_mul]
  norm_num
  field_simp

theorem smoothingSignApprox_zero : smoothingSignApprox 0 = 0 := by
  rw [smoothingSignApprox]
  simp only [zero_sub, zero_mul, mul_zero, add_zero]
  calc
    _ = ∑' _ : ℤ, (0 : ℝ) := by
      apply tsum_congr
      intro n
      rw [← Int.cast_neg, smoothingCardinalKernel_int]
      split_ifs with h
      · have hn : n = 0 := by omega
        simp [hn]
      · simp
    _ = 0 := tsum_zero

theorem smoothingSignApprox_neg (x : ℝ) :
    smoothingSignApprox (-x) = -smoothingSignApprox x := by
  have hs : (∑' n : ℤ, (n.sign : ℝ) * smoothingCardinalKernel (-x - n)) =
      -(∑' n : ℤ, (n.sign : ℝ) * smoothingCardinalKernel (x - n)) := by
    rw [← (Equiv.neg ℤ).tsum_eq (fun n : ℤ =>
      (n.sign : ℝ) * smoothingCardinalKernel (-x - n))]
    simp only [Equiv.neg_apply, Int.sign_neg, Int.cast_neg]
    have heq (n : ℤ) : -x - -(n : ℝ) = -(x - n) := by ring
    simp_rw [heq, smoothingCardinalKernel_neg, neg_mul, tsum_neg]
  rw [smoothingSignApprox, smoothingSignApprox, hs, smoothingCardinalKernel_neg]
  ring

theorem smoothingSignApprox_pos_formula {x : ℝ} (hx : 0 < x) :
    smoothingSignApprox x = 1 + smoothingCardinalKernel x *
      (2 * x - 1 - 2 * x ^ 2 * ∑' n : ℕ, 1 / (x + (n + 1)) ^ 2) := by
  have hpos : Function.Injective (fun n : ℕ => (n : ℤ) + 1) := by
    intro a b h
    dsimp at h
    omega
  have hneg : Function.Injective (fun n : ℕ => -((n : ℤ) + 1)) := by
    intro a b h
    dsimp at h
    omega
  have hp := (summable_smoothingCardinalKernel x).comp_injective hpos
  have hn := (summable_smoothingCardinalKernel x).comp_injective hneg
  have hsp := (summable_smoothingSignSeries x).comp_injective hpos
  have hsn := (summable_smoothingSignSeries x).comp_injective hneg
  have hsignpos (n : ℕ) : ((n : ℤ) + 1).sign = 1 :=
    Int.sign_eq_one_of_pos (by omega)
  have hsignneg (n : ℕ) : (-((n : ℤ) + 1)).sign = -1 :=
    Int.sign_eq_neg_one_of_neg (by omega)
  have hpart := tsum_smoothingCardinalKernel x
  rw [tsum_of_add_one_of_neg_add_one (f := fun n : ℤ => smoothingCardinalKernel (x - n)) hp hn] at hpart
  rw [smoothingSignApprox, tsum_of_add_one_of_neg_add_one
    (f := fun n : ℤ => (n.sign : ℝ) * smoothingCardinalKernel (x - n)) hsp hsn]
  simp only [hsignpos, hsignneg, Int.cast_one, Int.cast_neg, one_mul, neg_one_mul,
    Int.sign_zero, Int.cast_zero, zero_mul, add_zero, sub_zero, tsum_neg] at hpart ⊢
  have htail : (∑' n : ℕ, smoothingCardinalKernel (x - (-((n : ℤ) + 1) : ℤ))) =
      (x ^ 2 * smoothingCardinalKernel x) * (∑' n : ℕ, 1 / (x + (n + 1)) ^ 2) := by
    simp only [Int.cast_neg, Int.cast_add, Int.cast_natCast, Int.cast_one, sub_neg_eq_add]
    have hshift (n : ℕ) : smoothingCardinalKernel (x + (n + 1)) =
        (x ^ 2 * smoothingCardinalKernel x) * (1 / (x + (n + 1)) ^ 2) := by
      simpa only [Nat.cast_add, Nat.cast_one] using smoothingCardinalKernel_add_nat hx (n + 1)
    simp_rw [hshift, tsum_mul_left]
  simp only [Int.cast_neg] at htail
  rw [htail] at hpart ⊢
  nlinarith

theorem smoothingSignApprox_pos_error {x : ℝ} (hx : 0 < x) :
    |smoothingSignApprox x - 1| ≤ smoothingCardinalKernel x := by
  obtain ⟨_, hl, hu⟩ := reciprocal_square_tail_bounds hx
  let T := ∑' n : ℕ, 1 / (x + (n + 1)) ^ 2
  have hl' : 1 ≤ (x + 1) * T := by
    simpa only [mul_comm] using (div_le_iff₀ (by positivity : 0 < x + 1)).mp hl
  have hu' : x * T ≤ 1 := by
    simpa only [mul_comm] using (le_div_iff₀ hx).mp hu
  have hlow : 0 ≤ x - x ^ 2 * T := by
    nlinarith [mul_nonneg hx.le (sub_nonneg.mpr hu')]
  have hhigh : x - x ^ 2 * T ≤ 1 := by
    nlinarith [mul_nonneg hx.le (sub_nonneg.mpr hl')]
  rw [smoothingSignApprox_pos_formula hx]
  change |1 + smoothingCardinalKernel x * (2 * x - 1 - 2 * x ^ 2 * T) - 1| ≤ _
  rw [add_sub_cancel_left, abs_mul, abs_of_nonneg (smoothingCardinalKernel_nonneg _)]
  have hc : |2 * x - 1 - 2 * x ^ 2 * T| ≤ 1 := by
    rw [abs_le]
    constructor <;> linarith
  simpa using mul_le_mul_of_nonneg_left hc (smoothingCardinalKernel_nonneg x)

/-- The smoothed step functions bound the right-continuous unit step,
including its value at the jump. -/
theorem smoothing_step_bounds (x : ℝ) :
    (1 + smoothingSignApprox x - smoothingCardinalKernel x) / 2 ≤
        (if 0 ≤ x then (1 : ℝ) else 0) ∧
      (if 0 ≤ x then (1 : ℝ) else 0) ≤
        (1 + smoothingSignApprox x + smoothingCardinalKernel x) / 2 := by
  rcases lt_trichotomy x 0 with hx | rfl | hx
  · have h := smoothingSignApprox_pos_error (neg_pos.mpr hx)
    rw [smoothingSignApprox_neg, smoothingCardinalKernel_neg, abs_le] at h
    simp only [ite_eq_right (not_le.mpr hx)]
    constructor <;> linarith [h.1, h.2]
  · simp [smoothingSignApprox_zero, smoothingCardinalKernel_zero]
  · have h := abs_le.mp (smoothingSignApprox_pos_error hx)
    simp only [ite_eq_left hx.le]
    constructor <;> linarith [h.1, h.2]

@[fun_prop]
theorem continuous_smoothingCardinalKernel : Continuous smoothingCardinalKernel := by
  unfold smoothingCardinalKernel
  fun_prop

@[fun_prop]
theorem measurable_smoothingSignApprox : Measurable smoothingSignApprox := by
  unfold smoothingSignApprox
  apply Measurable.add
  · apply Measurable.tsum
    intro n
    fun_prop
  · fun_prop

theorem smoothingCardinalKernel_le_one (x : ℝ) : smoothingCardinalKernel x ≤ 1 := by
  have h := Real.abs_sinc_le_one (Real.pi * x)
  have hn := abs_nonneg (Real.sinc (Real.pi * x))
  unfold smoothingCardinalKernel
  nlinarith [sq_abs (Real.sinc (Real.pi * x))]

theorem abs_smoothingSignApprox_le_two (x : ℝ) : |smoothingSignApprox x| ≤ 2 := by
  have h := smoothing_step_bounds x
  have hK := smoothingCardinalKernel_le_one x
  split_ifs at h <;> rw [abs_le] <;> constructor <;> linarith [h.1, h.2]

/-- The cardinal majorant bounds the CDF of every real probability law.
This statement includes atoms and uses the right-continuous CDF convention. -/
theorem cdf_bounds_of_smoothing_kernel (μ : Measure ℝ) [IsProbabilityMeasure μ]
    {T : ℝ} (hT : 0 < T) (x : ℝ) :
    (1 + (∫ y, smoothingSignApprox (T * (x - y)) ∂μ) -
        (∫ y, smoothingCardinalKernel (T * (x - y)) ∂μ)) / 2 ≤ ProbabilityTheory.cdf μ x ∧
      ProbabilityTheory.cdf μ x ≤
        (1 + (∫ y, smoothingSignApprox (T * (x - y)) ∂μ) +
          (∫ y, smoothingCardinalKernel (T * (x - y)) ∂μ)) / 2 := by
  let H (y : ℝ) := smoothingSignApprox (T * (x - y))
  let K (y : ℝ) := smoothingCardinalKernel (T * (x - y))
  let step (y : ℝ) := (Iic x).indicator (fun _ => (1 : ℝ)) y
  have hH : Integrable H μ := by
    apply Integrable.mono' (integrable_const (2 : ℝ)) (by fun_prop)
    filter_upwards [] with y
    exact abs_smoothingSignApprox_le_two _
  have hK : Integrable K μ := by
    apply Integrable.mono' (integrable_const (1 : ℝ)) (by fun_prop)
    filter_upwards [] with y
    rw [Real.norm_eq_abs, abs_of_nonneg (smoothingCardinalKernel_nonneg _)]
    exact smoothingCardinalKernel_le_one _
  have hs : Integrable step μ := (integrable_const 1).indicator measurableSet_Iic
  have hsint : (∫ y, step y ∂μ) = ProbabilityTheory.cdf μ x := by
    rw [integral_indicator_const _ measurableSet_Iic, ProbabilityTheory.cdf_eq_real]
    simp
  have hb (y : ℝ) : (1 + H y - K y) / 2 ≤ step y ∧ step y ≤ (1 + H y + K y) / 2 := by
    have h := smoothing_step_bounds (T * (x - y))
    simpa only [H, K, step, Set.indicator_apply, Set.mem_Iic,
      mul_nonneg_iff_of_pos_left hT, sub_nonneg] using h
  have hlow := integral_mono (((integrable_const 1).add hH).sub hK |>.div_const 2) hs
    (fun y => (hb y).1)
  have hupp := integral_mono hs (((integrable_const 1).add hH).add hK |>.div_const 2)
    (fun y => (hb y).2)
  rw [hsint] at hlow hupp
  rw [integral_div, integral_sub' ((integrable_const 1).add hH) hK,
    integral_add' (integrable_const 1) hH] at hlow
  rw [integral_div, integral_add' ((integrable_const 1).add hH) hK,
    integral_add' (integrable_const 1) hH] at hupp
  simpa only [integral_const, probReal_univ, smul_eq_mul, mul_one, H, K] using And.intro hlow hupp

private theorem integral_triangle_cos {a : ℝ} (ha : a ≠ 0) :
    (∫ t in (0 : ℝ)..1, (1 - t) * Real.cos (a * t)) =
      (1 - Real.cos a) / a ^ 2 := by
  have hd (t : ℝ) : HasDerivAt
      (fun t : ℝ => (1 - t) * Real.sin (a * t) / a - Real.cos (a * t) / a ^ 2)
      ((1 - t) * Real.cos (a * t)) t := by
    have h := (((hasDerivAt_const t 1).sub (hasDerivAt_id t)).mul
      (((hasDerivAt_id t).const_mul a).sin)).div_const a |>.sub
      ((((hasDerivAt_id t).const_mul a).cos).div_const (a ^ 2))
    exact h.congr_deriv (by dsimp; field_simp [ha]; ring)
  have h := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := 0) (b := 1)
    (fun t _ => hd t) (by apply Continuous.intervalIntegrable; fun_prop)
  rw [h]
  simp only [mul_one, mul_zero, Real.cos_zero, Real.sin_zero, zero_mul, sub_self,
    zero_div, sub_zero]
  ring

/-- The cardinal kernel is the Fourier cosine transform of the triangular weight. -/
theorem smoothingCardinalKernel_fourier (x : ℝ) :
    smoothingCardinalKernel x =
      2 * ∫ t in (0 : ℝ)..1, (1 - t) * Real.cos (2 * Real.pi * x * t) := by
  by_cases hx : x = 0
  · subst x
    simp only [smoothingCardinalKernel_zero, mul_zero, zero_mul, Real.cos_zero, mul_one]
    rw [intervalIntegral.integral_sub
      (f := fun _ : ℝ => (1 : ℝ)) (g := fun t : ℝ => t)
      (continuous_const.intervalIntegrable 0 1) (continuous_id.intervalIntegrable 0 1)]
    norm_num [integral_id]
  have ha : 2 * Real.pi * x ≠ 0 := mul_ne_zero (mul_ne_zero (by norm_num) Real.pi_ne_zero) hx
  rw [integral_triangle_cos ha, smoothingCardinalKernel, Real.sinc_of_ne_zero
    (mul_ne_zero Real.pi_ne_zero hx)]
  rw [show 2 * Real.pi * x = 2 * (Real.pi * x) by ring, Real.cos_two_mul]
  have htrig := Real.sin_sq_add_cos_sq (Real.pi * x)
  field_simp
  nlinarith


/-- The Abel-damped cotangent kernel is the sum of its absolutely convergent sine series. -/
theorem hasSum_damped_sine {r : ℝ} (hr : 0 ≤ r) (hr1 : r < 1) (θ : ℝ) :
    HasSum (fun n : ℕ => r ^ n * Real.sin (n * θ))
      (r * Real.sin θ / (1 - 2 * r * Real.cos θ + r ^ 2)) := by
  let z : ℂ := r * Complex.exp ((θ : ℂ) * Complex.I)
  have hz : ‖z‖ < 1 := by
    simpa [z, norm_mul, Complex.norm_exp, Real.norm_eq_abs, abs_of_nonneg hr] using hr1
  have hterm (n : ℕ) : (z ^ n).im = r ^ n * Real.sin (n * θ) := by
    simp only [z, mul_pow, ← Complex.exp_nat_mul]
    rw [show (n : ℂ) * ((θ : ℂ) * Complex.I) = ((n * θ : ℝ) : ℂ) * Complex.I by push_cast; ring]
    simp only [← Complex.ofReal_pow, Complex.mul_im, Complex.ofReal_re,
      Complex.ofReal_im, Complex.exp_re, Complex.exp_im, Complex.mul_re,
      Complex.I_re, Complex.I_im, mul_zero, zero_mul, sub_zero, mul_one,
      add_zero, Real.exp_zero, one_mul]
  have h := Complex.hasSum_im (hasSum_geometric_of_norm_lt_one hz)
  simp_rw [hterm] at h
  have hv : r * Real.sin θ / (1 - 2 * r * Real.cos θ + r ^ 2) = (1 - z)⁻¹.im := by
    simp only [Complex.inv_im, Complex.sub_im, Complex.one_im, Complex.normSq_apply, Complex.sub_re, Complex.one_re]
    have hre : z.re = r * Real.cos θ := by simp [z, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
    have him : z.im = r * Real.sin θ := by simp [z, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
    rw [hre, him]
    congr 1 <;> nlinarith [congrArg (fun u : ℝ => r ^ 2 * u) (Real.sin_sq_add_cos_sq θ)]
  rw [hv]
  exact h

/-- The rational denominator in the damped sine series is uniformly positive for `r < 1`. -/
theorem damped_sine_denominator_pos {r : ℝ} (hr : 0 ≤ r) (hr1 : r < 1) (θ : ℝ) :
    0 < 1 - 2 * r * Real.cos θ + r ^ 2 := by
  have hc := Real.cos_le_one θ
  nlinarith [sq_pos_of_pos (sub_pos.mpr hr1), mul_nonneg hr (sub_nonneg.mpr hc)]

/-- Inside one period, Abel damping cannot increase the absolute cotangent kernel. -/
theorem abs_damped_sine_le_cot {r t : ℝ} (hr : 0 ≤ r) (hr1 : r < 1)
    (ht : 0 < t) (ht1 : t < 1) :
    |2 * r * Real.sin (2 * Real.pi * t) /
      (1 - 2 * r * Real.cos (2 * Real.pi * t) + r ^ 2)| ≤
      |Real.cos (Real.pi * t) / Real.sin (Real.pi * t)| := by
  have hs : 0 < Real.sin (Real.pi * t) :=
    Real.sin_pos_of_pos_of_lt_pi (mul_pos Real.pi_pos ht) (by nlinarith [Real.pi_pos])
  have hd := damped_sine_denominator_pos hr hr1 (2 * Real.pi * t)
  rw [show 2 * Real.pi * t = 2 * (Real.pi * t) by ring,
    Real.cos_two_mul] at hd ⊢
  rw [Real.sin_two_mul]
  simp only [abs_div, abs_mul, abs_of_pos hd, abs_of_pos hs,
    abs_of_nonneg hr, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
  apply (div_le_div_iff₀ hd hs).mpr
  have heq : 1 - 2 * r * (2 * Real.cos (Real.pi * t) ^ 2 - 1) + r ^ 2 =
      (1 - r) ^ 2 + 4 * r * Real.sin (Real.pi * t) ^ 2 := by
    nlinarith [congrArg (fun u : ℝ => 4 * r * u) (Real.sin_sq_add_cos_sq (Real.pi * t))]
  rw [heq]
  nlinarith [mul_nonneg (abs_nonneg (Real.cos (Real.pi * t))) (sq_nonneg (1 - r))]




private theorem integral_triangle_sin_sin (x y : ℝ) :
    (∫ t in (0 : ℝ)..1, (1 - t) * Real.sin (2 * Real.pi * x * t) *
      Real.sin (2 * Real.pi * y * t)) =
      (smoothingCardinalKernel (x - y) - smoothingCardinalKernel (x + y)) / 4 := by
  have heq (t : ℝ) : (1 - t) * Real.sin (2 * Real.pi * x * t) *
      Real.sin (2 * Real.pi * y * t) =
      ((1 - t) * Real.cos (2 * Real.pi * (x - y) * t) -
        (1 - t) * Real.cos (2 * Real.pi * (x + y) * t)) / 2 := by
    rw [show 2 * Real.pi * (x - y) * t = 2 * Real.pi * x * t - 2 * Real.pi * y * t by ring,
      show 2 * Real.pi * (x + y) * t = 2 * Real.pi * x * t + 2 * Real.pi * y * t by ring,
      Real.cos_sub, Real.cos_add]
    ring
  simp_rw [heq]
  rw [intervalIntegral.integral_div, intervalIntegral.integral_sub
    (by apply Continuous.intervalIntegrable; fun_prop)
    (by apply Continuous.intervalIntegrable; fun_prop)]
  rw [smoothingCardinalKernel_fourier, smoothingCardinalKernel_fourier]
  ring

private theorem integral_sine_linear (x : ℝ) :
    (2 / Real.pi) * (∫ t in (0 : ℝ)..1, Real.sin (2 * Real.pi * x * t)) =
      2 * x * smoothingCardinalKernel x := by
  by_cases hx : x = 0
  · simp [hx]
  have ha : 2 * Real.pi * x ≠ 0 := mul_ne_zero (mul_ne_zero (by norm_num) Real.pi_ne_zero) hx
  have hd (t : ℝ) : HasDerivAt
      (fun t : ℝ => -Real.cos (2 * Real.pi * x * t) / (2 * Real.pi * x))
      (Real.sin (2 * Real.pi * x * t)) t := by
    exact ((((hasDerivAt_id t).const_mul (2 * Real.pi * x)).cos).neg.div_const _).congr_deriv
      (by dsimp; field_simp)
  have hi := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := 0) (b := 1)
    (fun t _ => hd t) (by apply Continuous.intervalIntegrable; fun_prop)
  rw [hi, smoothingCardinalKernel, Real.sinc_of_ne_zero (mul_ne_zero Real.pi_ne_zero hx)]
  simp only [mul_one, mul_zero, Real.cos_zero]
  rw [show 2 * Real.pi * x = 2 * (Real.pi * x) by ring, Real.cos_two_mul]
  field_simp
  nlinarith [Real.sin_sq_add_cos_sq (Real.pi * x)]



private theorem sin_pi_lower_quadratic {t : ℝ} (ht : 0 ≤ t) (ht1 : t ≤ 1) :
    2 * t * (1 - t) ≤ Real.sin (Real.pi * t) := by
  rcases le_or_gt t (1 / 2) with hh | hh
  · have hs := Real.mul_le_sin (x := Real.pi * t) (by positivity) (by nlinarith [Real.pi_pos])
    have he : 2 / Real.pi * (Real.pi * t) = 2 * t := by field_simp
    rw [he] at hs
    nlinarith [sq_nonneg t]
  · have hs := Real.mul_le_sin (x := Real.pi * (1 - t)) (by positivity)
      (by nlinarith [Real.pi_pos])
    have he : 2 / Real.pi * (Real.pi * (1 - t)) = 2 * (1 - t) := by field_simp
    rw [he, show Real.pi * (1 - t) = Real.pi - Real.pi * t by ring,
      Real.sin_pi_sub] at hs
    nlinarith [sq_nonneg (1 - t)]

private theorem abs_weighted_cot_sine_le (x : ℝ) {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    |(1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) *
      Real.sin (2 * Real.pi * x * t)| ≤ Real.pi * |x| := by
  have hs : 0 < Real.sin (Real.pi * t) :=
    Real.sin_pos_of_pos_of_lt_pi (mul_pos Real.pi_pos ht) (by nlinarith [Real.pi_pos])
  have hsin : |Real.sin (2 * Real.pi * x * t)| ≤ 2 * Real.pi * |x| * t := by
    simpa only [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2), abs_of_pos Real.pi_pos, abs_of_pos ht]
      using (Real.abs_sin_le_abs (x := 2 * Real.pi * x * t))
  have hcos := Real.abs_cos_le_one (Real.pi * t)
  have hlo := sin_pi_lower_quadratic ht.le ht1.le
  simp only [abs_mul, abs_div, abs_of_pos (sub_pos.mpr ht1), abs_of_pos hs]
  calc
    (1 - t) * (|Real.cos (Real.pi * t)| / Real.sin (Real.pi * t)) *
        |Real.sin (2 * Real.pi * x * t)| ≤
      (1 - t) * (1 / Real.sin (Real.pi * t)) * (2 * Real.pi * |x| * t) := by
        gcongr
    _ ≤ Real.pi * |x| := by
      rw [← mul_div_assoc, mul_one, div_mul_eq_mul_div, div_le_iff₀ hs]
      nlinarith [mul_nonneg (mul_nonneg Real.pi_pos.le (abs_nonneg x)) (sub_nonneg.mpr hlo)]

private theorem tendsto_damped_sine {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    Tendsto (fun r : ℝ => 2 * r * Real.sin (2 * Real.pi * t) /
      (1 - 2 * r * Real.cos (2 * Real.pi * t) + r ^ 2)) (𝓝 1)
      (𝓝 (Real.cos (Real.pi * t) / Real.sin (Real.pi * t))) := by
  have hs : 0 < Real.sin (Real.pi * t) :=
    Real.sin_pos_of_pos_of_lt_pi (mul_pos Real.pi_pos ht) (by nlinarith [Real.pi_pos])
  have heq : 1 - 2 * 1 * Real.cos (2 * Real.pi * t) + (1 : ℝ) ^ 2 =
      4 * Real.sin (Real.pi * t) ^ 2 := by
    rw [show 2 * Real.pi * t = 2 * (Real.pi * t) by ring, Real.cos_two_mul]
    nlinarith [Real.sin_sq_add_cos_sq (Real.pi * t)]
  have hd : 1 - 2 * 1 * Real.cos (2 * Real.pi * t) + (1 : ℝ) ^ 2 ≠ 0 := by
    rw [heq]
    positivity
  have hc : ContinuousAt (fun r : ℝ => 2 * r * Real.sin (2 * Real.pi * t) /
      (1 - 2 * r * Real.cos (2 * Real.pi * t) + r ^ 2)) 1 := by
    apply ContinuousAt.div
    · fun_prop
    · fun_prop
    · exact hd
  have hv : 2 * 1 * Real.sin (2 * Real.pi * t) /
      (1 - 2 * 1 * Real.cos (2 * Real.pi * t) + (1 : ℝ) ^ 2) =
      Real.cos (Real.pi * t) / Real.sin (Real.pi * t) := by
    rw [heq, show 2 * Real.pi * t = 2 * (Real.pi * t) by ring, Real.sin_two_mul]
    field_simp
    ring
  exact hv ▸ hc.tendsto



private theorem smoothingSignApprox_nat_formula (x : ℝ) :
    smoothingSignApprox x =
      (∑' n : ℕ, (smoothingCardinalKernel (x - n) - smoothingCardinalKernel (x + n))) +
        2 * x * smoothingCardinalKernel x := by
  have hi : Function.Injective (fun n : ℕ => -(n : ℤ)) := by
    intro a b h
    exact_mod_cast neg_injective h
  have hp := (summable_smoothingSignSeries x).comp_injective (show Function.Injective (fun n : ℕ => (n : ℤ)) by intro a b h; dsimp at h; omega)
  have hn := (summable_smoothingSignSeries x).comp_injective hi
  simp only [Function.comp_def] at hp hn
  rw [smoothingSignApprox, Summable.tsum_of_nat_of_neg
    (f := fun n : ℤ => (n.sign : ℝ) * smoothingCardinalKernel (x - n)) hp hn]
  simp only [Int.sign_zero, Int.cast_zero, zero_mul, sub_zero]
  rw [← hp.tsum_add hn]
  congr 1
  apply tsum_congr
  intro n
  cases n with
  | zero => simp
  | succ n =>
    have hpos : ((n + 1 : ℕ) : ℤ).sign = 1 := Int.sign_eq_one_of_pos (by omega)
    simp only [hpos, Int.sign_neg, Int.cast_neg, Int.cast_one, one_mul, neg_one_mul,
      Int.cast_natCast, sub_eq_add_neg, neg_neg]

private theorem summable_smoothingKernel_difference (x : ℝ) :
    Summable (fun n : ℕ => smoothingCardinalKernel (x - n) - smoothingCardinalKernel (x + n)) := by
  have hi : Function.Injective (fun n : ℕ => -(n : ℤ)) := by
    intro a b h
    exact_mod_cast neg_injective h
  have hp := (summable_smoothingCardinalKernel x).comp_injective (show Function.Injective (fun n : ℕ => (n : ℤ)) by intro a b h; dsimp at h; omega)
  have hn := (summable_smoothingCardinalKernel x).comp_injective hi
  simpa only [Function.comp_def, Int.cast_neg, Int.cast_natCast, sub_neg_eq_add] using hp.sub hn

private theorem integral_damped_sine_eq_series (x : ℝ) {r : ℝ} (hr : 0 ≤ r) (hr1 : r < 1) :
    (∫ t in (0 : ℝ)..1, 2 * (1 - t) *
      (2 * r * Real.sin (2 * Real.pi * t) / (1 - 2 * r * Real.cos (2 * Real.pi * t) + r ^ 2)) *
        Real.sin (2 * Real.pi * x * t)) =
      ∑' n : ℕ, (smoothingCardinalKernel (x - n) - smoothingCardinalKernel (x + n)) * r ^ n := by
  let μ := volume.restrict (Ioo (0 : ℝ) 1)
  let F (n : ℕ) (t : ℝ) := 4 * r ^ n *
    ((1 - t) * Real.sin (2 * Real.pi * x * t) * Real.sin (2 * Real.pi * n * t))
  let G (t : ℝ) := 2 * (1 - t) *
      (2 * r * Real.sin (2 * Real.pi * t) / (1 - 2 * r * Real.cos (2 * Real.pi * t) + r ^ 2)) *
        Real.sin (2 * Real.pi * x * t)
  have hpoint (t : ℝ) : HasSum (fun n => F n t) (G t) := by
    have h := (hasSum_damped_sine hr hr1 (2 * Real.pi * t)).mul_left
      (4 * (1 - t) * Real.sin (2 * Real.pi * x * t))
    have hv : G t = 4 * (1 - t) * Real.sin (2 * Real.pi * x * t) *
        (r * Real.sin (2 * Real.pi * t) / (1 - 2 * r * Real.cos (2 * Real.pi * t) + r ^ 2)) := by
      dsimp [G]
      ring
    rw [hv]
    apply h.congr_fun
    intro n
    dsimp [F]
    rw [show 2 * Real.pi * n * t = (n : ℝ) * (2 * Real.pi * t) by ring]
    ring
  have hbound (n : ℕ) : ∀ᵐ t ∂μ, ‖F n t‖ ≤ 4 * r ^ n := by
    filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
    have hweight : |1 - t| ≤ 1 := by rw [abs_of_pos (sub_pos.mpr ht.2)]; linarith [ht.1]
    have h := mul_le_mul (mul_le_mul hweight (Real.abs_sin_le_one (2 * Real.pi * x * t))
      (abs_nonneg _) (by norm_num)) (Real.abs_sin_le_one (2 * Real.pi * n * t))
        (abs_nonneg _) (by norm_num)
    dsimp [F]
    rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ 4 * r ^ n)]
    simpa only [abs_mul, one_mul, mul_one] using mul_le_mul_of_nonneg_left h
      (by positivity : 0 ≤ 4 * r ^ n)
  have hsum : Summable (fun n : ℕ => 4 * r ^ n) :=
    (summable_geometric_of_lt_one hr hr1).mul_left 4
  have hint := hasSum_integral_of_dominated_convergence
    (μ := μ) (F := F) (f := G) (fun n _ => 4 * r ^ n)
    (fun n => by dsimp [F]; exact Continuous.aestronglyMeasurable (by fun_prop)) hbound
    (Filter.Eventually.of_forall (fun _ => hsum)) (integrable_const _) (Filter.Eventually.of_forall hpoint)
  have hn (n : ℕ) : (∫ t, F n t ∂μ) =
      (smoothingCardinalKernel (x - n) - smoothingCardinalKernel (x + n)) * r ^ n := by
    dsimp [F, μ]
    rw [← integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1),
      intervalIntegral.integral_const_mul, integral_triangle_sin_sin]
    ring
  simp_rw [hn] at hint
  rw [intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1), integral_Ioc_eq_integral_Ioo]
  exact hint.tsum_eq.symm

private theorem tendsto_integral_damped_sine (x : ℝ) :
    Tendsto (fun r : ℝ => ∫ t in (0 : ℝ)..1, 2 * (1 - t) *
      (2 * r * Real.sin (2 * Real.pi * t) / (1 - 2 * r * Real.cos (2 * Real.pi * t) + r ^ 2)) *
        Real.sin (2 * Real.pi * x * t)) (𝓝[<] 1)
      (𝓝 (∫ t in (0 : ℝ)..1, 2 * (1 - t) *
        (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) * Real.sin (2 * Real.pi * x * t))) := by
  simp only [intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1), integral_Ioc_eq_integral_Ioo]
  apply tendsto_integral_filter_of_dominated_convergence (fun _ => 2 * Real.pi * |x|)
  · filter_upwards [Ioo_mem_nhdsLT (show (0 : ℝ) < 1 by norm_num)] with r hr
    have hcont : Continuous (fun t : ℝ => 2 * (1 - t) *
        (2 * r * Real.sin (2 * Real.pi * t) / (1 - 2 * r * Real.cos (2 * Real.pi * t) + r ^ 2)) *
          Real.sin (2 * Real.pi * x * t)) := by
      apply Continuous.mul
      · apply Continuous.mul
        · fun_prop
        · apply Continuous.div
          · fun_prop
          · fun_prop
          · intro t
            exact ne_of_gt (damped_sine_denominator_pos hr.1.le hr.2 _)
      · fun_prop
    exact hcont.aestronglyMeasurable
  · filter_upwards [Ioo_mem_nhdsLT (show (0 : ℝ) < 1 by norm_num)] with r hr
    filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
    rw [Real.norm_eq_abs]
    calc
      _ ≤ |2 * (1 - t)| * |Real.cos (Real.pi * t) / Real.sin (Real.pi * t)| *
        |Real.sin (2 * Real.pi * x * t)| := by
          rw [abs_mul, abs_mul]
          exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left
            (abs_damped_sine_le_cot hr.1.le hr.2 ht.1 ht.2) (abs_nonneg _)) (abs_nonneg _)
      _ = 2 * |(1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) *
          Real.sin (2 * Real.pi * x * t)| := by
        simp only [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
        ring
      _ ≤ 2 * Real.pi * |x| := by
        nlinarith [abs_weighted_cot_sine_le x ht.1 ht.2]
  · exact integrable_const _
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
    exact ((tendsto_damped_sine ht.1 ht.2).mono_left nhdsWithin_le_nhds).const_mul
      (2 * (1 - t)) |>.mul_const (Real.sin (2 * Real.pi * x * t))



private theorem intervalIntegrable_weighted_cot_sine (x : ℝ) :
    IntervalIntegrable (fun t : ℝ => (1 - t) *
      (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) * Real.sin (2 * Real.pi * x * t))
      volume 0 1 := by
  rw [intervalIntegrable_iff_integrableOn_Ioo_of_le (by norm_num : (0 : ℝ) ≤ 1)]
  apply (integrable_const (Real.pi * |x|)).mono'
  · apply Measurable.aestronglyMeasurable
    fun_prop
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
    simpa only [Real.norm_eq_abs] using abs_weighted_cot_sine_le x ht.1 ht.2

/-- The sign approximant is the finite-frequency sine transform of the cotangent smoothing weight.
The singularity at the lower endpoint is cancelled by the sine factor. -/
theorem smoothingSignApprox_fourier (x : ℝ) :
    smoothingSignApprox x =
      2 * ∫ t in (0 : ℝ)..1,
        ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) *
          Real.sin (2 * Real.pi * x * t) := by
  have ha := Real.tendsto_tsum_powerSeries_nhdsWithin_lt
    (summable_smoothingKernel_difference x).hasSum.tendsto_sum_nat
  have hd := tendsto_integral_damped_sine x
  have hevent : (fun r : ℝ => ∫ t in (0 : ℝ)..1, 2 * (1 - t) *
      (2 * r * Real.sin (2 * Real.pi * t) / (1 - 2 * r * Real.cos (2 * Real.pi * t) + r ^ 2)) *
        Real.sin (2 * Real.pi * x * t)) =ᶠ[𝓝[<] 1]
      (fun r : ℝ => ∑' n : ℕ,
        (smoothingCardinalKernel (x - n) - smoothingCardinalKernel (x + n)) * r ^ n) := by
    filter_upwards [Ioo_mem_nhdsLT (show (0 : ℝ) < 1 by norm_num)] with r hr
    exact integral_damped_sine_eq_series x hr.1.le hr.2
  have hcot := tendsto_nhds_unique hd (ha.congr' hevent.symm)
  have hcot' : (∑' n : ℕ,
      (smoothingCardinalKernel (x - n) - smoothingCardinalKernel (x + n))) =
      2 * ∫ t in (0 : ℝ)..1, (1 - t) *
        (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) * Real.sin (2 * Real.pi * x * t) := by
    rw [← hcot, ← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro t _
    ring
  rw [smoothingSignApprox_nat_formula, hcot']
  have heq (t : ℝ) :
      ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) *
          Real.sin (2 * Real.pi * x * t) =
      (1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) *
          Real.sin (2 * Real.pi * x * t) +
        (1 / Real.pi) * Real.sin (2 * Real.pi * x * t) := by ring
  simp_rw [heq]
  rw [intervalIntegral.integral_add (intervalIntegrable_weighted_cot_sine x)
    (by apply Continuous.intervalIntegrable; fun_prop), intervalIntegral.integral_const_mul]
  rw [← integral_sine_linear x]
  ring



/-- An integrable bound for the smoothing sine integrand, uniform over the finite frequency range. -/
theorem abs_smoothing_sine_integrand_le (x : ℝ) {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    |((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) *
        Real.sin (2 * Real.pi * x * t)| ≤ (Real.pi + 2) * |x| := by
  have hsin : |Real.sin (2 * Real.pi * x * t)| ≤ 2 * Real.pi * |x| * t := by
    simpa only [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2),
      abs_of_pos Real.pi_pos, abs_of_pos ht] using
      (Real.abs_sin_le_abs (x := 2 * Real.pi * x * t))
  have hc : |(1 / Real.pi) * Real.sin (2 * Real.pi * x * t)| ≤ 2 * |x| := by
    rw [abs_mul, abs_of_pos (one_div_pos.mpr Real.pi_pos)]
    calc
      _ ≤ (1 / Real.pi) * (2 * Real.pi * |x| * t) :=
        mul_le_mul_of_nonneg_left hsin (by positivity)
      _ = 2 * |x| * t := by field_simp
      _ ≤ 2 * |x| := by nlinarith [mul_nonneg (abs_nonneg x) (sub_nonneg.mpr ht1.le)]
  rw [add_mul]
  exact (abs_add_le _ _).trans ((add_le_add (abs_weighted_cot_sine_le x ht ht1) hc).trans_eq (by ring))

/-- Translation and reflection of the exponential integral of a probability measure. -/
theorem integral_cexp_sub_eq_charFun (μ : Measure ℝ) (x u : ℝ) :
    (∫ y, Complex.exp (((u * (x - y) : ℝ) : ℂ) * Complex.I) ∂μ) =
      Complex.exp (((u * x : ℝ) : ℂ) * Complex.I) * charFun μ (-u) := by
  rw [charFun_apply_real, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with y
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- The cosine and sine transforms are the real and imaginary parts of the shifted characteristic
function. -/
theorem integral_trig_sub_eq_charFun (μ : Measure ℝ) [IsProbabilityMeasure μ] (x u : ℝ) :
    (∫ y, Real.cos (u * (x - y)) ∂μ) =
        (Complex.exp (((u * x : ℝ) : ℂ) * Complex.I) * charFun μ (-u)).re ∧
      (∫ y, Real.sin (u * (x - y)) ∂μ) =
        (Complex.exp (((u * x : ℝ) : ℂ) * Complex.I) * charFun μ (-u)).im := by
  have hi : Integrable (fun y : ℝ => Complex.exp (((u * (x - y) : ℝ) : ℂ) * Complex.I)) μ := by
    apply (integrable_const (1 : ℝ)).mono'
    · exact Continuous.aestronglyMeasurable (by fun_prop)
    · filter_upwards [] with y
      simp [Complex.norm_exp]
  have hr := integral_re hi
  have him := integral_im hi
  rw [integral_cexp_sub_eq_charFun] at hr him
  constructor
  · simpa [Complex.exp_re] using hr
  · simpa [Complex.exp_im] using him

/-- Averaging the cardinal kernel commutes with its finite-frequency cosine representation. -/
theorem integral_smoothingCardinalKernel_fourier (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (x T : ℝ) :
    (∫ y, smoothingCardinalKernel (T * (x - y)) ∂μ) =
      2 * ∫ t in (0 : ℝ)..1, (1 - t) *
        (∫ y, Real.cos (2 * Real.pi * (T * (x - y)) * t) ∂μ) := by
  let ν := volume.restrict (Ioo (0 : ℝ) 1)
  let f (y t : ℝ) := (1 - t) * Real.cos (2 * Real.pi * (T * (x - y)) * t)
  have hf : Integrable (Function.uncurry f) (μ.prod ν) := by
    apply (integrable_const (1 : ℝ)).mono'
    · exact Continuous.aestronglyMeasurable (by dsimp [f, Function.uncurry]; fun_prop)
    · rw [Measure.ae_prod_iff_ae_ae (by
        dsimp [f, Function.uncurry]
        apply measurableSet_le <;> fun_prop)]
      filter_upwards [] with y
      filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
      dsimp [f, Function.uncurry]
      rw [abs_mul, abs_of_pos (sub_pos.mpr ht.2)]
      have hc := Real.abs_cos_le_one (2 * Real.pi * (T * (x - y)) * t)
      nlinarith [ht.1, mul_nonneg (sub_nonneg.mpr ht.2.le) (sub_nonneg.mpr hc)]
  simp_rw [smoothingCardinalKernel_fourier, intervalIntegral.integral_of_le
    (by norm_num : (0 : ℝ) ≤ 1), integral_Ioc_eq_integral_Ioo]
  rw [integral_const_mul]
  congr 1
  change (∫ y, ∫ t, f y t ∂ν ∂μ) = _
  rw [integral_integral_swap hf]
  apply integral_congr_ae
  filter_upwards [] with t
  exact integral_const_mul _ _

/-- A finite first absolute moment suffices to average the sine smoothing representation. -/
theorem integral_smoothingSignApprox_fourier (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ : Integrable (fun y : ℝ => y) μ) (x T : ℝ) :
    (∫ y, smoothingSignApprox (T * (x - y)) ∂μ) =
      2 * ∫ t in (0 : ℝ)..1,
        ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) *
          (∫ y, Real.sin (2 * Real.pi * (T * (x - y)) * t) ∂μ) := by
  let ν := volume.restrict (Ioo (0 : ℝ) 1)
  let f (y t : ℝ) :=
    ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) *
      Real.sin (2 * Real.pi * (T * (x - y)) * t)
  have hi : Integrable (fun y : ℝ => (Real.pi + 2) * |T * (x - y)|) μ :=
    ((((integrable_const x).sub hμ).const_mul T).abs).const_mul (Real.pi + 2)
  have hf : Integrable (Function.uncurry f) (μ.prod ν) := by
    apply (hi.comp_fst ν).mono'
    · apply Measurable.aestronglyMeasurable
      dsimp [f, Function.uncurry]
      fun_prop
    · rw [Measure.ae_prod_iff_ae_ae (by
        dsimp [f, Function.uncurry]
        apply measurableSet_le <;> fun_prop)]
      filter_upwards [] with y
      filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
      exact abs_smoothing_sine_integrand_le (T * (x - y)) ht.1 ht.2
  simp_rw [smoothingSignApprox_fourier, intervalIntegral.integral_of_le
    (by norm_num : (0 : ℝ) ≤ 1), integral_Ioc_eq_integral_Ioo]
  rw [integral_const_mul]
  congr 1
  change (∫ y, ∫ t, f y t ∂ν ∂μ) = _
  rw [integral_integral_swap hf]
  apply integral_congr_ae
  filter_upwards [] with t
  exact integral_const_mul _ _


/-- Finite-frequency upper and lower CDF bounds, expressed using the actual characteristic
function. The probability measure needs only a finite first absolute moment. -/
theorem cdf_bounds_of_charFun_smoothing (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ : Integrable (fun y : ℝ => y) μ) (x : ℝ) {T : ℝ} (hT : 0 < T) :
    let Q := fun t : ℝ => Complex.exp ((((2 * Real.pi * T * t) * x : ℝ) : ℂ) * Complex.I) *
      charFun μ (-(2 * Real.pi * T * t))
    let S := ∫ t in (0 : ℝ)..1,
      ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) * (Q t).im
    let C := ∫ t in (0 : ℝ)..1, (1 - t) * (Q t).re
    1 / 2 + S - C ≤ cdf μ x ∧ cdf μ x ≤ 1 / 2 + S + C := by
  dsimp only
  have h := cdf_bounds_of_smoothing_kernel μ hT x
  rw [integral_smoothingCardinalKernel_fourier μ x T,
    integral_smoothingSignApprox_fourier μ hμ x T] at h
  have hs (t : ℝ) : (∫ y, Real.sin (2 * Real.pi * (T * (x - y)) * t) ∂μ) =
      (Complex.exp ((((2 * Real.pi * T * t) * x : ℝ) : ℂ) * Complex.I) *
        charFun μ (-(2 * Real.pi * T * t))).im := by
    have heq (y : ℝ) : 2 * Real.pi * (T * (x - y)) * t = (2 * Real.pi * T * t) * (x - y) := by ring
    simp_rw [heq]
    exact (integral_trig_sub_eq_charFun μ x _).2
  have hc (t : ℝ) : (∫ y, Real.cos (2 * Real.pi * (T * (x - y)) * t) ∂μ) =
      (Complex.exp ((((2 * Real.pi * T * t) * x : ℝ) : ℂ) * Complex.I) *
        charFun μ (-(2 * Real.pi * T * t))).re := by
    have heq (y : ℝ) : 2 * Real.pi * (T * (x - y)) * t = (2 * Real.pi * T * t) * (x - y) := by ring
    simp_rw [heq]
    exact (integral_trig_sub_eq_charFun μ x _).1
  simp_rw [hs, hc] at h
  constructor <;> linarith [h.1, h.2]

/-- The CDF of the standard normal is the integral of its density on a half-line. -/
theorem standardGaussian_cdf_eq_integral (x : ℝ) :
    cdf (gaussianReal 0 1) x = ∫ t in Iic x, gaussianPDFReal 0 1 t := by
  rw [cdf_eq_real, Measure.real, gaussianReal_apply_eq_integral _ (by norm_num), ENNReal.toReal_ofReal]
  exact integral_nonneg (gaussianPDFReal_nonneg 0 1)

/-- Symmetry places exactly half of the standard Gaussian mass on either side of zero. -/
theorem standardGaussian_cdf_zero : cdf (gaussianReal 0 1) 0 = 1 / 2 := by
  rw [standardGaussian_cdf_eq_integral]
  have he (t : ℝ) : gaussianPDFReal 0 1 (-t) = gaussianPDFReal 0 1 t := by
    simp [gaussianPDFReal]
  have hhalf := integral_comp_neg_Iic 0 (gaussianPDFReal 0 1)
  simp only [he, neg_zero] at hhalf
  have htotal := integral_add_compl (s := Iic (0 : ℝ)) measurableSet_Iic (integrable_gaussianPDFReal 0 1)
  rw [compl_Iic, hhalf, integral_gaussianPDFReal_eq_one 0 (by norm_num)] at htotal
  linarith

/-- The standard Gaussian density is the cosine transform of its characteristic function. -/
theorem standardGaussian_density_cosine_integral (x : ℝ) :
    (1 / Real.pi) * (∫ t in Ioi (0 : ℝ), Real.exp (-t ^ 2 / 2) * Real.cos (x * t)) =
      gaussianPDFReal 0 1 x := by
  have hi : Integrable (fun y : ℝ => Complex.exp ((x : ℂ) * y * Complex.I)) (gaussianReal 0 1) := by
    apply (integrable_const (1 : ℝ)).mono'
    · exact Continuous.aestronglyMeasurable (by fun_prop)
    · filter_upwards [] with y
      simp [Complex.norm_exp]
  have hchar := congrArg Complex.re (charFun_gaussianReal (μ := 0) (v := 1) x)
  rw [charFun_apply_real] at hchar
  have hchar := (integral_re hi).trans hchar
  change (∫ y, (Complex.exp ((x : ℂ) * y * Complex.I)).re ∂gaussianReal 0 1) = _ at hchar
  simp [Complex.exp_re, ← Complex.ofReal_pow] at hchar
  rw [integral_gaussianReal_eq_integral_smul (by norm_num : (1 : ℝ≥0) ≠ 0)] at hchar
  simp only [gaussianPDFReal, NNReal.coe_one, mul_one, sub_zero, smul_eq_mul, mul_assoc] at hchar
  rw [integral_const_mul] at hchar
  have hhalf := integral_comp_abs (f := fun t : ℝ => Real.exp (-t ^ 2 / 2) * Real.cos (x * t))
  have habs (t : ℝ) : Real.exp (-|t| ^ 2 / 2) * Real.cos (x * |t|) =
      Real.exp (-t ^ 2 / 2) * Real.cos (x * t) := by
    rw [sq_abs]
    rcases le_or_gt 0 t with ht | ht
    · rw [abs_of_nonneg ht]
    · rw [abs_of_neg ht, mul_neg, Real.cos_neg]
  simp_rw [habs] at hhalf
  rw [hhalf] at hchar
  have hs : 0 < Real.sqrt (2 * Real.pi) := Real.sqrt_pos.mpr (by positivity)
  have hs2 : Real.sqrt (2 * Real.pi) ^ 2 = 2 * Real.pi := Real.sq_sqrt (by positivity)
  simp only [gaussianPDFReal, NNReal.coe_one, mul_one, sub_zero]
  have hc : 2 * (∫ t in Ioi (0 : ℝ), Real.exp (-t ^ 2 / 2) * Real.cos (x * t)) =
      Real.sqrt (2 * Real.pi) * Real.exp (-x ^ 2 / 2) := by
    have h := congrArg (fun u : ℝ => Real.sqrt (2 * Real.pi) * u) hchar
    simpa only [← mul_assoc, mul_inv_cancel₀ hs.ne', one_mul, neg_div] using h
  generalize hJ : (∫ t in Ioi (0 : ℝ), Real.exp (-t ^ 2 / 2) * Real.cos (x * t)) = J at hc ⊢
  generalize hE : Real.exp (-x ^ 2 / 2) = E at hc ⊢
  field_simp
  rw [mul_comm Real.pi 2]
  nlinarith [congrArg (fun u : ℝ => Real.sqrt (2 * Real.pi) * u) hc,
    congrArg (fun u : ℝ => u * E) hs2]


/-- Fourier inversion for the standard Gaussian CDF, with an absolutely integrable sine quotient. -/
theorem standardGaussian_cdf_sine_integral (x : ℝ) :
    cdf (gaussianReal 0 1) x = 1 / 2 +
      (1 / Real.pi) * ∫ t in Ioi (0 : ℝ), Real.exp (-t ^ 2 / 2) * Real.sin (x * t) / t := by
  let ν := volume.restrict (Ioi (0 : ℝ))
  let f (s t : ℝ) := Real.exp (-t ^ 2 / 2) * Real.cos (s * t)
  have hg : Integrable (fun t : ℝ => Real.exp (-t ^ 2 / 2)) ν := by
    have h := integrable_exp_neg_mul_sq (by norm_num : (0 : ℝ) < 1 / 2)
    have heq (t : ℝ) : -(1 / 2 : ℝ) * t ^ 2 = -t ^ 2 / 2 := by ring
    simp_rw [heq] at h
    exact h.restrict
  let : IsFiniteMeasure (volume.restrict (uIoc (0 : ℝ) x)) := by
    rw [uIoc]
    infer_instance
  have hf : Integrable (Function.uncurry f) ((volume.restrict (uIoc 0 x)).prod ν) := by
    apply (hg.comp_snd (volume.restrict (uIoc 0 x))).mono'
    · exact Continuous.aestronglyMeasurable (by dsimp [f, Function.uncurry]; fun_prop)
    · filter_upwards [] with z
      dsimp [f, Function.uncurry]
      rw [abs_mul, abs_of_pos (Real.exp_pos _)]
      exact mul_le_of_le_one_right (Real.exp_pos _).le (Real.abs_cos_le_one _)
  have hswap := intervalIntegral_integral_swap (a := 0) (b := x) hf
  have hinner (t : ℝ) (ht : 0 < t) :
      (∫ s in (0 : ℝ)..x, f s t) = Real.exp (-t ^ 2 / 2) * Real.sin (x * t) / t := by
    have hd (s : ℝ) : HasDerivAt (fun s : ℝ => Real.sin (s * t) / t) (Real.cos (s * t)) s := by
      exact (((hasDerivAt_id s).mul_const t).sin.div_const t).congr_deriv (by
        dsimp
        field_simp)
    have hi := intervalIntegral.integral_eq_sub_of_hasDerivAt (a := 0) (b := x)
      (fun s _ => hd s) (by apply Continuous.intervalIntegrable; fun_prop)
    dsimp [f]
    rw [intervalIntegral.integral_const_mul, hi]
    simp only [zero_mul, Real.sin_zero, zero_div, sub_zero]
    ring
  have hswap' : (∫ s in (0 : ℝ)..x, ∫ t in Ioi (0 : ℝ),
      Real.exp (-t ^ 2 / 2) * Real.cos (s * t)) =
      ∫ t in Ioi (0 : ℝ), Real.exp (-t ^ 2 / 2) * Real.sin (x * t) / t := by
    rw [hswap]
    apply integral_congr_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact hinner t ht
  have hcdf := intervalIntegral.integral_Iic_sub_Iic (a := 0) (b := x)
    (integrable_gaussianPDFReal 0 1).integrableOn (integrable_gaussianPDFReal 0 1).integrableOn
  rw [← standardGaussian_cdf_eq_integral, ← standardGaussian_cdf_eq_integral,
    standardGaussian_cdf_zero] at hcdf
  simp_rw [← standardGaussian_density_cosine_integral] at hcdf
  rw [intervalIntegral.integral_const_mul, hswap'] at hcdf
  linarith



/-- The apparent singularity in the Gaussian sine quotient is removable for integrability. -/
theorem integrable_standardGaussian_sine_quotient (x : ℝ) :
    Integrable (fun t : ℝ => Real.exp (-t ^ 2 / 2) * Real.sin (x * t) / t) := by
  have hg : Integrable (fun t : ℝ => Real.exp (-t ^ 2 / 2)) := by
    have h := integrable_exp_neg_mul_sq (by norm_num : (0 : ℝ) < 1 / 2)
    convert h using 1
    ext t
    congr 1
    ring
  apply (hg.mul_const |x|).mono'
  · apply Measurable.aestronglyMeasurable
    fun_prop
  · filter_upwards [] with t
    rw [Real.norm_eq_abs, abs_div, abs_mul, abs_of_pos (Real.exp_pos _)]
    by_cases ht : t = 0
    · simp [ht]
    · apply (div_le_iff₀ (abs_pos.mpr ht)).mpr
      have hsin : |Real.sin (x * t)| ≤ |x| * |t| := by
        simpa only [abs_mul] using (Real.abs_sin_le_abs (x := x * t))
      nlinarith [mul_le_mul_of_nonneg_left hsin (Real.exp_pos (-t ^ 2 / 2)).le]

private theorem gaussian_sine_quotient_scale (x : ℝ) {U : ℝ} (hU : U ≠ 0) (t : ℝ) :
    U * (Real.exp (-(U * t) ^ 2 / 2) * Real.sin (x * (U * t)) / (U * t)) =
      Real.exp (-(U * t) ^ 2 / 2) * Real.sin (U * x * t) / t := by
  rw [show x * (U * t) = U * x * t by ring]
  by_cases ht : t = 0
  · simp [ht]
  · field_simp

/-- The normal CDF inversion formula is invariant under a positive frequency rescaling. -/
theorem standardGaussian_cdf_sine_integral_scaled (x : ℝ) {U : ℝ} (hU : 0 < U) :
    cdf (gaussianReal 0 1) x = 1 / 2 +
      (1 / Real.pi) * ∫ t in Ioi (0 : ℝ),
        Real.exp (-(U * t) ^ 2 / 2) * Real.sin (U * x * t) / t := by
  have h := integral_comp_mul_left_Ioi'
    (fun t : ℝ => Real.exp (-t ^ 2 / 2) * Real.sin (x * t) / t) 0 hU
  simp only [mul_zero, smul_eq_mul] at h
  rw [← integral_const_mul] at h
  simp_rw [gaussian_sine_quotient_scale x hU.ne'] at h
  rw [h, standardGaussian_cdf_sine_integral]

/-- Integrability of the scaled normal inversion integrand allows splitting its frequency range. -/
theorem integrable_standardGaussian_sine_quotient_scaled (x : ℝ) {U : ℝ} (hU : U ≠ 0) :
    Integrable (fun t : ℝ => Real.exp (-(U * t) ^ 2 / 2) * Real.sin (U * x * t) / t) := by
  have h := ((integrable_standardGaussian_sine_quotient x).comp_mul_left' hU).const_mul U
  simpa only [gaussian_sine_quotient_scale x hU] using h

/-- The complex kernel packages the two real smoothing weights without losing their joint norm. -/
def berryEsseenSmoothingKernel (t : ℝ) : ℂ :=
  ⟨(1 - t) / 2, ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) / 2⟩

private theorem abs_real_im_linear_le (a b : ℝ) (z : ℂ) :
    |a * z.re + b * z.im| ≤ ‖(⟨a, b⟩ : ℂ)‖ * ‖z‖ := by
  have heq : a * z.re + b * z.im = ((⟨a, b⟩ : ℂ) * conj z).re := by
    simp [Complex.mul_re]
  rw [heq]
  exact (Complex.abs_re_le_norm _).trans_eq (by rw [norm_mul, Complex.norm_conj])

private theorem norm_complex_mk_sign (a b σ : ℝ) (hσ : σ ^ 2 = 1) :
    ‖(⟨σ * a, b⟩ : ℂ)‖ = ‖(⟨a, b⟩ : ℂ)‖ := by
  rw [Complex.norm_eq_sqrt_sq_add_sq, Complex.norm_eq_sqrt_sq_add_sq]
  change Real.sqrt ((σ * a) ^ 2 + b ^ 2) = Real.sqrt (a ^ 2 + b ^ 2)
  rw [mul_pow, hσ, one_mul]

private theorem abs_real_im_linear_comparison (a b c : ℝ) (z w : ℂ) :
    |a * z.re + b * z.im - c * w.im| ≤
      ‖(⟨a, b⟩ : ℂ)‖ * ‖z - w‖ + ‖(⟨a, b - c⟩ : ℂ)‖ * ‖w‖ := by
  have heq : a * z.re + b * z.im - c * w.im =
      (a * (z - w).re + b * (z - w).im) + (a * w.re + (b - c) * w.im) := by
    simp only [Complex.sub_re, Complex.sub_im]
    ring
  rw [heq]
  exact (abs_add_le _ _).trans (add_le_add (abs_real_im_linear_le a b (z - w))
    (abs_real_im_linear_le a (b - c) w))

/-- Both signs of the cosine smoothing term have the same sharp coefficient norm. -/
theorem abs_smoothing_linear_le (t σ : ℝ) (hσ : σ ^ 2 = 1) (z : ℂ) :
    |σ * (1 - t) * z.re +
      ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) * z.im| ≤
        2 * ‖berryEsseenSmoothingKernel t‖ * ‖z‖ := by
  have h := abs_real_im_linear_le (σ * (1 - t))
    ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) z
  rw [norm_complex_mk_sign _ _ σ hσ] at h
  have heq : (⟨1 - t, (1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi⟩ : ℂ) =
      (2 : ℂ) * berryEsseenSmoothingKernel t := by
    apply Complex.ext <;> simp [berryEsseenSmoothingKernel, Complex.mul_re, Complex.mul_im] <;> ring
  rw [heq, norm_mul] at h
  simpa using h

/-- At low frequencies the comparison and normal correction retain the full complex kernel norm. -/
theorem abs_smoothing_linear_comparison (t σ : ℝ) (hσ : σ ^ 2 = 1) (z w : ℂ) :
    |σ * (1 - t) * z.re +
      ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) * z.im -
        (1 / (Real.pi * t)) * w.im| ≤
      2 * ‖berryEsseenSmoothingKernel t‖ * ‖z - w‖ +
        2 * ‖berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)‖ * ‖w‖ := by
  have h := abs_real_im_linear_comparison (σ * (1 - t))
    ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi)
      (1 / (Real.pi * t)) z w
  rw [norm_complex_mk_sign _ _ σ hσ, norm_complex_mk_sign _ _ σ hσ] at h
  have heq : (⟨1 - t, (1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi⟩ : ℂ) =
      (2 : ℂ) * berryEsseenSmoothingKernel t := by
    apply Complex.ext <;> simp [berryEsseenSmoothingKernel, Complex.mul_re, Complex.mul_im] <;> ring
  have heq' : (⟨1 - t,
      ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) - 1 / (Real.pi * t)⟩ : ℂ) =
      (2 : ℂ) * (berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)) := by
    apply Complex.ext <;>
      simp only [Complex.mul_re, Complex.mul_im, Complex.sub_re, Complex.sub_im,
        Complex.div_ofReal_re, Complex.div_ofReal_im, Complex.I_re, Complex.I_im,
        berryEsseenSmoothingKernel] <;> norm_num <;> ring
  rw [heq, heq', norm_mul, norm_mul] at h
  simpa using h

/-- A phase factor and conjugation preserve the characteristic-function comparison error. -/
theorem norm_shifted_charFun_sub_normal (μ : Measure ℝ) (x u v : ℝ) :
    ‖Complex.exp (((u * x : ℝ) : ℂ) * Complex.I) * charFun μ (-u) -
      Complex.exp (((u * x : ℝ) : ℂ) * Complex.I) * (v : ℂ)‖ =
        ‖charFun μ u - (v : ℂ)‖ := by
  rw [← mul_sub, norm_mul, charFun_neg]
  have hc : conj (charFun μ u) - (v : ℂ) = conj (charFun μ u - (v : ℂ)) := by simp
  rw [hc, Complex.norm_conj]
  simp [Complex.norm_exp]


/-- A characteristic-function error controls either signed smoothing integrand, uniformly in the
CDF evaluation point. -/
theorem smoothing_charFun_error_bound (μ : Measure ℝ) (x u t σ : ℝ) (hσ : σ ^ 2 = 1) :
    let Q := Complex.exp (((u * x : ℝ) : ℂ) * Complex.I) * charFun μ (-u)
    |σ * (1 - t) * Q.re +
      ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) * Q.im -
        (1 / (Real.pi * t)) * Real.exp (-u ^ 2 / 2) * Real.sin (u * x)| ≤
      2 * ‖berryEsseenSmoothingKernel t‖ * ‖charFun μ u - (Real.exp (-u ^ 2 / 2) : ℂ)‖ +
        2 * ‖berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)‖ * Real.exp (-u ^ 2 / 2) := by
  let z := Complex.exp (((u * x : ℝ) : ℂ) * Complex.I) * charFun μ (-u)
  let w := Complex.exp (((u * x : ℝ) : ℂ) * Complex.I) * (Real.exp (-u ^ 2 / 2) : ℂ)
  have hwim : w.im = Real.exp (-u ^ 2 / 2) * Real.sin (u * x) := by
    simp only [w, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
      mul_zero, zero_add, Complex.exp_im, Complex.mul_re, Complex.I_re, Complex.I_im,
      mul_one, sub_zero, add_zero, Real.exp_zero, one_mul]
    ring
  have hwn : ‖w‖ = Real.exp (-u ^ 2 / 2) := by
    simp only [w, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _),
      Complex.norm_exp, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im, mul_zero, zero_mul, sub_zero, Real.exp_zero, one_mul]
  have hd : ‖z - w‖ = ‖charFun μ u - (Real.exp (-u ^ 2 / 2) : ℂ)‖ :=
    norm_shifted_charFun_sub_normal μ x u _
  have h := abs_smoothing_linear_comparison t σ hσ z w
  rw [hwim, hwn, hd] at h
  simpa only [z, mul_assoc] using h

/-- Away from the origin the characteristic function itself controls the smoothing integrand. -/
theorem smoothing_charFun_bound (μ : Measure ℝ) (x u t σ : ℝ) (hσ : σ ^ 2 = 1) :
    let Q := Complex.exp (((u * x : ℝ) : ℂ) * Complex.I) * charFun μ (-u)
    |σ * (1 - t) * Q.re +
      ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) * Q.im| ≤
      2 * ‖berryEsseenSmoothingKernel t‖ * ‖charFun μ u‖ := by
  have h := abs_smoothing_linear_le t σ hσ
    (Complex.exp (((u * x : ℝ) : ℂ) * Complex.I) * charFun μ (-u))
  simpa [norm_mul, Complex.norm_exp, charFun_neg, Complex.norm_conj] using h



private theorem abs_smoothing_integral_split_error_le {F G M₀ M₁ M₂ : ℝ → ℝ}
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ < 1)
    (hF : IntervalIntegrable F volume 0 1) (hG : IntegrableOn G (Ioi 0))
    (hM₀ : IntervalIntegrable M₀ volume 0 τ) (hM₁ : IntervalIntegrable M₁ volume τ 1)
    (hM₂ : IntegrableOn M₂ (Ioi τ))
    (h₀ : ∀ t ∈ Ioo 0 τ, |F t - G t| ≤ M₀ t)
    (h₁ : ∀ t ∈ Ioo τ 1, |F t| ≤ M₁ t)
    (h₂ : ∀ t ∈ Ioi τ, |G t| ≤ M₂ t) :
    |(∫ t in (0 : ℝ)..1, F t) - ∫ t in Ioi (0 : ℝ), G t| ≤
      (∫ t in (0 : ℝ)..τ, M₀ t) + (∫ t in τ..1, M₁ t) + ∫ t in Ioi τ, M₂ t := by
  have hF₀ : IntervalIntegrable F volume 0 τ := hF.mono_set (by
    rw [uIcc_of_le hτ.le, uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1)]
    exact Icc_subset_Icc le_rfl hτ1.le)
  have hF₁ : IntervalIntegrable F volume τ 1 := hF.mono_set (by
    rw [uIcc_of_le hτ1.le, uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1)]
    exact Icc_subset_Icc hτ.le le_rfl)
  have hG₀ : IntervalIntegrable G volume 0 τ := by
    rw [intervalIntegrable_iff_integrableOn_Ioo_of_le hτ.le]
    exact hG.mono_set Ioo_subset_Ioi_self
  have hG₂ : IntegrableOn G (Ioi τ) := hG.mono_set (Ioi_subset_Ioi hτ.le)
  have hb₀ : |∫ t in (0 : ℝ)..τ, (F t - G t)| ≤ ∫ t in (0 : ℝ)..τ, M₀ t := by
    apply (intervalIntegral.abs_integral_le_integral_abs hτ.le).trans
    exact intervalIntegral.integral_mono_on_of_le_Ioo hτ.le (hF₀.sub hG₀).abs hM₀ h₀
  have hb₁ : |∫ t in τ..1, F t| ≤ ∫ t in τ..1, M₁ t := by
    apply (intervalIntegral.abs_integral_le_integral_abs hτ1.le).trans
    exact intervalIntegral.integral_mono_on_of_le_Ioo hτ1.le hF₁.abs hM₁ h₁
  have hb₂ : |∫ t in Ioi τ, G t| ≤ ∫ t in Ioi τ, M₂ t := by
    apply (abs_integral_le_integral_abs).trans
    exact setIntegral_mono_on hG₂.abs hM₂ measurableSet_Ioi h₂
  rw [← intervalIntegral.integral_add_adjacent_intervals hF₀ hF₁,
    ← intervalIntegral.integral_interval_add_Ioi hG hG₂]
  have heq : (∫ t in (0 : ℝ)..τ, F t) + (∫ t in τ..1, F t) -
      ((∫ t in (0 : ℝ)..τ, G t) + ∫ t in Ioi τ, G t) =
      (∫ t in (0 : ℝ)..τ, (F t - G t)) + (∫ t in τ..1, F t) - ∫ t in Ioi τ, G t := by
    rw [intervalIntegral.integral_sub hF₀ hG₀]
    ring
  rw [heq]
  exact (abs_sub _ _).trans ((add_le_add ((abs_add_le _ _).trans (add_le_add hb₀ hb₁)) hb₂))



private theorem intervalIntegrable_smoothing_charFun_sine (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ : Integrable (fun y : ℝ => y) μ) (x U : ℝ) :
    IntervalIntegrable (fun t : ℝ =>
      ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) *
        (Complex.exp ((((U * t) * x : ℝ) : ℂ) * Complex.I) * charFun μ (-(U * t))).im)
      volume 0 1 := by
  let ν := volume.restrict (Ioo (0 : ℝ) 1)
  let f (y t : ℝ) :=
    ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) *
      Real.sin ((U * t) * (x - y))
  have hi : Integrable (fun y : ℝ => (Real.pi + 2) * |(U / (2 * Real.pi)) * (x - y)|) μ :=
    ((((integrable_const x).sub hμ).const_mul (U / (2 * Real.pi))).abs).const_mul (Real.pi + 2)
  have hf : Integrable (Function.uncurry f) (μ.prod ν) := by
    apply (hi.comp_fst ν).mono'
    · apply Measurable.aestronglyMeasurable
      dsimp [f, Function.uncurry]
      fun_prop
    · rw [Measure.ae_prod_iff_ae_ae (by
        dsimp [f, Function.uncurry]
        apply measurableSet_le <;> fun_prop)]
      filter_upwards [] with y
      filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
      have h := abs_smoothing_sine_integrand_le ((U / (2 * Real.pi)) * (x - y)) ht.1 ht.2
      have heq : 2 * Real.pi * (U / (2 * Real.pi) * (x - y)) * t = (U * t) * (x - y) := by
        field_simp
      simpa only [f, Function.uncurry, Real.norm_eq_abs, heq] using h
  rw [intervalIntegrable_iff_integrableOn_Ioo_of_le (by norm_num : (0 : ℝ) ≤ 1)]
  have h := hf.integral_prod_right
  have heq (t : ℝ) : (∫ y, f y t ∂μ) =
      ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) *
        (Complex.exp ((((U * t) * x : ℝ) : ℂ) * Complex.I) * charFun μ (-(U * t))).im := by
    dsimp [f]
    rw [integral_const_mul, (integral_trig_sub_eq_charFun μ x (U * t)).2]
  change Integrable (fun t => _) ν
  simpa only [Function.uncurry, heq] using h

private theorem intervalIntegrable_smoothing_charFun_cosine (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (x U : ℝ) :
    IntervalIntegrable (fun t : ℝ => (1 - t) *
      (Complex.exp ((((U * t) * x : ℝ) : ℂ) * Complex.I) * charFun μ (-(U * t))).re)
      volume 0 1 := by
  apply Continuous.intervalIntegrable
  fun_prop



/-- The Gaussian tail contribution is integrable on every half-line bounded away from zero. -/
theorem integrableOn_normal_smoothing_tail {U τ : ℝ} (hU : U ≠ 0) (hτ : 0 < τ) :
    IntegrableOn (fun t : ℝ => (1 / (Real.pi * t)) * Real.exp (-(U * t) ^ 2 / 2)) (Ioi τ) := by
  have hg : Integrable (fun t : ℝ => Real.exp (-(U * t) ^ 2 / 2)) := by
    have h := (integrable_exp_neg_mul_sq (by norm_num : (0 : ℝ) < 1 / 2)).comp_mul_left' hU
    have heq (t : ℝ) : -(1 / 2 : ℝ) * (U * t) ^ 2 = -(U * t) ^ 2 / 2 := by ring
    simpa only [heq] using h
  apply ((hg.const_mul (1 / (Real.pi * τ))).restrict).mono'
  · apply Measurable.aestronglyMeasurable
    fun_prop
  · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have ht0 : 0 < t := hτ.trans ht
    rw [Real.norm_eq_abs, abs_of_pos (by positivity)]
    apply mul_le_mul_of_nonneg_right _ (Real.exp_pos _).le
    exact one_div_le_one_div_of_le (by positivity) (mul_le_mul_of_nonneg_left ht.le Real.pi_pos.le)

/-- The four-term finite-frequency error inequality. The integrability premises on the two
low-frequency bounds are discharged by the quantitative characteristic-function estimates. -/
theorem berryEsseen_smoothing_error_of_integrable (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ : Integrable (fun y : ℝ => y) μ) {U τ : ℝ} (hU : 0 < U) (hτ : 0 < τ) (hτ1 : τ < 1)
    (herror : IntervalIntegrable (fun t : ℝ => ‖berryEsseenSmoothingKernel t‖ *
      ‖charFun μ (U * t) - (Real.exp (-(U * t) ^ 2 / 2) : ℂ)‖) volume 0 τ)
    (hcorrection : IntervalIntegrable (fun t : ℝ =>
      ‖berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)‖ *
        Real.exp (-(U * t) ^ 2 / 2)) volume 0 τ)
    (hhigh : IntervalIntegrable (fun t : ℝ =>
      ‖berryEsseenSmoothingKernel t‖ * ‖charFun μ (U * t)‖) volume τ 1) (x : ℝ) :
    |cdf μ x - cdf (gaussianReal 0 1) x| ≤
      2 * (∫ t in (0 : ℝ)..τ, ‖berryEsseenSmoothingKernel t‖ *
        ‖charFun μ (U * t) - (Real.exp (-(U * t) ^ 2 / 2) : ℂ)‖) +
      2 * (∫ t in τ..1, ‖berryEsseenSmoothingKernel t‖ * ‖charFun μ (U * t)‖) +
      2 * (∫ t in (0 : ℝ)..τ, ‖berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)‖ *
        Real.exp (-(U * t) ^ 2 / 2)) +
      ∫ t in Ioi τ, (1 / (Real.pi * t)) * Real.exp (-(U * t) ^ 2 / 2) := by
  let Q (t : ℝ) := Complex.exp ((((U * t) * x : ℝ) : ℂ) * Complex.I) * charFun μ (-(U * t))
  let A (t : ℝ) := (1 - t) * (Q t).re
  let B (t : ℝ) :=
    ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) * (Q t).im
  let F (σ t : ℝ) := σ * A t + B t
  let G (t : ℝ) := (1 / (Real.pi * t)) * Real.exp (-(U * t) ^ 2 / 2) * Real.sin ((U * t) * x)
  let M₀ (t : ℝ) := 2 * (‖berryEsseenSmoothingKernel t‖ *
      ‖charFun μ (U * t) - (Real.exp (-(U * t) ^ 2 / 2) : ℂ)‖) +
    2 * (‖berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)‖ *
      Real.exp (-(U * t) ^ 2 / 2))
  let M₁ (t : ℝ) := 2 * (‖berryEsseenSmoothingKernel t‖ * ‖charFun μ (U * t)‖)
  let M₂ (t : ℝ) := (1 / (Real.pi * t)) * Real.exp (-(U * t) ^ 2 / 2)
  have hA : IntervalIntegrable A volume 0 1 := intervalIntegrable_smoothing_charFun_cosine μ x U
  have hB : IntervalIntegrable B volume 0 1 := intervalIntegrable_smoothing_charFun_sine μ hμ x U
  have hF (σ : ℝ) : IntervalIntegrable (F σ) volume 0 1 := (hA.const_mul σ).add hB
  have hGeq (t : ℝ) : G t = (1 / Real.pi) *
      (Real.exp (-(U * t) ^ 2 / 2) * Real.sin (U * x * t) / t) := by
    dsimp [G]
    rw [show U * t * x = U * x * t by ring]
    simp only [div_eq_mul_inv, mul_inv_rev]
    ring
  have hG : Integrable G := by
    simp_rw [show G = fun t => (1 / Real.pi) *
      (Real.exp (-(U * t) ^ 2 / 2) * Real.sin (U * x * t) / t) from funext hGeq]
    exact (integrable_standardGaussian_sine_quotient_scaled x hU.ne').const_mul _
  have hnormal : cdf (gaussianReal 0 1) x = 1 / 2 + ∫ t in Ioi (0 : ℝ), G t := by
    simp_rw [hGeq]
    rw [integral_const_mul]
    exact standardGaussian_cdf_sine_integral_scaled x hU
  have hsplit (σ : ℝ) (hσ : σ ^ 2 = 1) :
      |(∫ t in (0 : ℝ)..1, F σ t) - ∫ t in Ioi (0 : ℝ), G t| ≤
        (∫ t in (0 : ℝ)..τ, M₀ t) + (∫ t in τ..1, M₁ t) + ∫ t in Ioi τ, M₂ t := by
    apply abs_smoothing_integral_split_error_le hτ hτ1 (hF σ) hG.integrableOn
      ((herror.const_mul 2).add (hcorrection.const_mul 2)) (hhigh.const_mul 2)
      (integrableOn_normal_smoothing_tail hU.ne' hτ)
    · intro t _
      simpa only [F, A, B, Q, G, M₀, mul_assoc] using
        smoothing_charFun_error_bound μ x (U * t) t σ hσ
    · intro t _
      simpa only [F, A, B, Q, M₁, mul_assoc] using smoothing_charFun_bound μ x (U * t) t σ hσ
    · intro t ht
      have ht0 : 0 < t := hτ.trans ht
      dsimp [G, M₂]
      rw [abs_mul, abs_of_pos (by positivity)]
      exact mul_le_of_le_one_right (by positivity) (Real.abs_sin_le_one _)
  have hbase := cdf_bounds_of_charFun_smoothing μ hμ x (T := U / (2 * Real.pi)) (by positivity)
  have hscale : 2 * Real.pi * (U / (2 * Real.pi)) = U := by field_simp
  simp only [hscale] at hbase
  change 1 / 2 + (∫ t in (0 : ℝ)..1, B t) - (∫ t in (0 : ℝ)..1, A t) ≤ cdf μ x ∧
    cdf μ x ≤ 1 / 2 + (∫ t in (0 : ℝ)..1, B t) + (∫ t in (0 : ℝ)..1, A t) at hbase
  have hFi (σ : ℝ) : (∫ t in (0 : ℝ)..1, F σ t) =
      σ * (∫ t in (0 : ℝ)..1, A t) + ∫ t in (0 : ℝ)..1, B t := by
    exact (intervalIntegral.integral_add (hA.const_mul σ) hB).trans (by rw [intervalIntegral.integral_const_mul])
  have hlo := (abs_le.mp (hsplit (-1) (by norm_num))).1
  have hup := (abs_le.mp (hsplit 1 (by norm_num))).2
  rw [hFi] at hlo hup
  have hbound : |cdf μ x - cdf (gaussianReal 0 1) x| ≤
      (∫ t in (0 : ℝ)..τ, M₀ t) + (∫ t in τ..1, M₁ t) + ∫ t in Ioi τ, M₂ t := by
    rw [hnormal, abs_le]
    constructor <;> linarith [hbase.1, hbase.2]
  dsimp [M₀, M₁, M₂] at hbound
  rw [intervalIntegral.integral_add (herror.const_mul 2) (hcorrection.const_mul 2)] at hbound
  simp only [intervalIntegral.integral_const_mul] at hbound
  linarith

private theorem abs_mul_cos_sub_sin_le {x : ℝ} (hx : 0 ≤ x) :
    |x * Real.cos x - Real.sin x| ≤ (2 / 3 : ℝ) * x ^ 3 := by
  have hc : |Real.cos x - 1| ≤ x ^ 2 / 2 := by
    rw [abs_of_nonpos (sub_nonpos.mpr (Real.cos_le_one x))]
    linarith [Real.one_sub_sq_div_two_le_cos (x := x)]
  have hs : |x - Real.sin x| ≤ x ^ 3 / 6 := by
    simpa only [abs_of_nonneg hx] using Real.abs_sub_sin_le x
  calc
    |x * Real.cos x - Real.sin x| = |x * (Real.cos x - 1) + (x - Real.sin x)| := by congr 1; ring
    _ ≤ |x * (Real.cos x - 1)| + |x - Real.sin x| := abs_add_le _ _
    _ ≤ x * (x ^ 2 / 2) + x ^ 3 / 6 := by
      rw [abs_mul, abs_of_nonneg hx]
      exact add_le_add (mul_le_mul_of_nonneg_left hc hx) hs
    _ = (2 / 3 : ℝ) * x ^ 3 := by ring

/-- Cancellation of the cotangent singularity gives a uniform bound on the normal correction. -/
theorem abs_smoothing_cot_correction_le {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    |(1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi -
      1 / (Real.pi * t)| ≤ Real.pi ^ 2 / 3 := by
  have hs : 0 < Real.sin (Real.pi * t) :=
    Real.sin_pos_of_pos_of_lt_pi (mul_pos Real.pi_pos ht) (by nlinarith [Real.pi_pos])
  have hsin : 2 * t * (1 - t) ≤ Real.sin (Real.pi * t) := by
    rcases le_or_gt t (1 / 2) with hh | hh
    · have h := Real.mul_le_sin (x := Real.pi * t) (by positivity) (by nlinarith [Real.pi_pos])
      have he : 2 / Real.pi * (Real.pi * t) = 2 * t := by field_simp
      rw [he] at h
      nlinarith [sq_nonneg t]
    · have h := Real.mul_le_sin (x := Real.pi * (1 - t)) (by positivity)
        (by nlinarith [Real.pi_pos])
      have he : 2 / Real.pi * (Real.pi * (1 - t)) = 2 * (1 - t) := by field_simp
      rw [he, show Real.pi * (1 - t) = Real.pi - Real.pi * t by ring, Real.sin_pi_sub] at h
      nlinarith [sq_nonneg (1 - t)]
  have heq : (1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi -
      1 / (Real.pi * t) = (1 - t) *
        (Real.pi * t * Real.cos (Real.pi * t) - Real.sin (Real.pi * t)) /
          (Real.pi * t * Real.sin (Real.pi * t)) := by
    generalize hsin_value : Real.sin (Real.pi * t) = S at hs ⊢
    field_simp [hs.ne', ht.ne']
    ring
  rw [heq, abs_div, abs_mul, abs_of_pos (sub_pos.mpr ht1),
    abs_of_pos (mul_pos (mul_pos Real.pi_pos ht) hs)]
  calc
    _ ≤ (1 - t) * ((2 / 3 : ℝ) * (Real.pi * t) ^ 3) /
        (Real.pi * t * (2 * t * (1 - t))) := by
      apply div_le_div₀ (by positivity)
      · exact mul_le_mul_of_nonneg_left (abs_mul_cos_sub_sin_le (x := Real.pi * t) (by positivity)) (by positivity)
      · positivity
      · exact mul_le_mul_of_nonneg_left hsin (by positivity)
    _ = Real.pi ^ 2 * t / 3 := by
      field_simp [(sub_pos.mpr ht1).ne', ht.ne']
    _ ≤ Real.pi ^ 2 / 3 := by nlinarith [mul_nonneg (sq_nonneg Real.pi) (sub_nonneg.mpr ht1.le)]

/-- A coarse uniform bound suffices to justify integration of the corrected smoothing kernel. -/
theorem norm_smoothing_kernel_correction_le {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    ‖berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)‖ ≤
      (1 + Real.pi ^ 2 / 3) / 2 := by
  have hr : (berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)).re = (1 - t) / 2 := by
    simp only [Complex.sub_re, Complex.div_ofReal_re, Complex.I_re,
      berryEsseenSmoothingKernel, zero_div, sub_zero]
  have hi : (berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)).im =
      ((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi -
        1 / (Real.pi * t)) / 2 := by
    simp only [Complex.sub_im, Complex.div_ofReal_im, Complex.I_im, berryEsseenSmoothingKernel]
    field_simp
  have h := Complex.norm_le_abs_re_add_abs_im (berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ))
  rw [hr, hi, abs_of_pos (by positivity), abs_div, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)] at h
  have hc := abs_smoothing_cot_correction_le ht ht1
  linarith


/-- The uncorrected kernel has at most a simple pole at the lower endpoint. -/
theorem norm_smoothing_kernel_le {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    ‖berryEsseenSmoothingKernel t‖ ≤ (1 + Real.pi ^ 2 / 3) / 2 + 1 / (2 * Real.pi * t) := by
  have hd : ‖Complex.I / (2 * Real.pi * t : ℝ)‖ = 1 / (2 * Real.pi * t) := by
    rw [norm_div, Complex.norm_I, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
  calc
    _ = ‖(berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)) +
        Complex.I / (2 * Real.pi * t : ℝ)‖ := by rw [sub_add_cancel]
    _ ≤ ‖berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)‖ +
        ‖Complex.I / (2 * Real.pi * t : ℝ)‖ := norm_add_le _ _
    _ ≤ _ := by rw [hd]; exact add_le_add (norm_smoothing_kernel_correction_le ht ht1) le_rfl

/-- Multiplication by the frequency cancels the kernel's simple pole. -/
theorem mul_norm_smoothing_kernel_le {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    t * ‖berryEsseenSmoothingKernel t‖ ≤ (1 + Real.pi ^ 2 / 3) / 2 + 1 / (2 * Real.pi) := by
  have h := mul_le_mul_of_nonneg_left (norm_smoothing_kernel_le ht ht1) ht.le
  have heq : t * ((1 + Real.pi ^ 2 / 3) / 2 + 1 / (2 * Real.pi * t)) =
      ((1 + Real.pi ^ 2 / 3) / 2) * t + 1 / (2 * Real.pi) := by field_simp
  rw [heq] at h
  have hc : 0 ≤ (1 + Real.pi ^ 2 / 3) / 2 := by positivity
  nlinarith [mul_nonneg hc (sub_nonneg.mpr ht1.le)]

/-- A finite first absolute moment gives the local linear modulus of the characteristic function. -/
theorem norm_charFun_sub_one_le_firstMoment (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ : Integrable (fun y : ℝ => y) μ) (u : ℝ) :
    ‖charFun μ u - 1‖ ≤ |u| * ∫ y, |y| ∂μ := by
  have hi : Integrable (fun y : ℝ => Complex.exp ((u : ℂ) * y * Complex.I)) μ := by
    apply (integrable_const (1 : ℝ)).mono'
    · exact Continuous.aestronglyMeasurable (by fun_prop)
    · filter_upwards [] with y
      simp [Complex.norm_exp]
  have heq : charFun μ u - 1 = ∫ y, (Complex.exp ((u : ℂ) * y * Complex.I) - 1) ∂μ := by
    rw [integral_sub hi (integrable_const (1 : ℂ)), charFun_apply_real]
    simp
  rw [heq]
  calc
    _ ≤ ∫ y, ‖Complex.exp ((u : ℂ) * y * Complex.I) - 1‖ ∂μ := norm_integral_le_integral_norm _
    _ ≤ ∫ y, |u| * |y| ∂μ := by
      apply integral_mono (hi.sub (integrable_const (1 : ℂ))).norm (hμ.abs.const_mul |u|)
      intro y
      change ‖Complex.exp ((u : ℂ) * y * Complex.I) - (1 : ℂ)‖ ≤ |u| * |y|
      have h := Real.norm_exp_I_mul_ofReal_sub_one_le (x := u * y)
      have he : Complex.I * ((u * y : ℝ) : ℂ) = (u : ℂ) * y * Complex.I := by push_cast; ring
      simpa only [he, Real.norm_eq_abs, abs_mul] using h
    _ = _ := integral_const_mul _ _



/-- A coarse local normal-comparison bound suffices for integrability of the smoothing error. -/
theorem norm_charFun_sub_normal_le_firstMoment (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ : Integrable (fun y : ℝ => y) μ) (u : ℝ) :
    ‖charFun μ u - (Real.exp (-u ^ 2 / 2) : ℂ)‖ ≤ |u| * (∫ y, |y| ∂μ) + u ^ 2 / 2 := by
  have hg : Real.exp (-u ^ 2 / 2) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith [sq_nonneg u])
  have he : ‖(1 : ℂ) - (Real.exp (-u ^ 2 / 2) : ℂ)‖ ≤ u ^ 2 / 2 := by
    rw [← Complex.ofReal_one, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (sub_nonneg.mpr hg)]
    linarith [Real.add_one_le_exp (-u ^ 2 / 2)]
  calc
    _ = ‖(charFun μ u - 1) + (1 - (Real.exp (-u ^ 2 / 2) : ℂ))‖ := by rw [sub_add_sub_cancel]
    _ ≤ ‖charFun μ u - 1‖ + ‖(1 : ℂ) - (Real.exp (-u ^ 2 / 2) : ℂ)‖ := norm_add_le _ _
    _ ≤ _ := add_le_add (norm_charFun_sub_one_le_firstMoment μ hμ u) he



@[fun_prop]
theorem measurable_berryEsseenSmoothingKernel : Measurable berryEsseenSmoothingKernel := by
  have heq : berryEsseenSmoothingKernel = fun t : ℝ =>
      (((1 - t) / 2 : ℝ) : ℂ) +
        ((((1 - t) * (Real.cos (Real.pi * t) / Real.sin (Real.pi * t)) + 1 / Real.pi) / 2 : ℝ) : ℂ) *
          Complex.I := by
    ext t
    apply Complex.ext <;>
      simp only [berryEsseenSmoothingKernel, Complex.add_re, Complex.add_im,
        Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
        Complex.I_re, Complex.I_im, mul_zero, sub_zero, mul_one,
        add_zero, zero_add]
  rw [heq]
  fun_prop

private theorem intervalIntegrable_smoothing_error (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ : Integrable (fun y : ℝ => y) μ) {U τ : ℝ} (hU : 0 < U) (hτ : 0 < τ) (hτ1 : τ < 1) :
    IntervalIntegrable (fun t : ℝ => ‖berryEsseenSmoothingKernel t‖ *
      ‖charFun μ (U * t) - (Real.exp (-(U * t) ^ 2 / 2) : ℂ)‖) volume 0 τ := by
  let D := U * (∫ y, |y| ∂μ) + U ^ 2 / 2
  let C := (1 + Real.pi ^ 2 / 3) / 2 + 1 / (2 * Real.pi)
  have hD : 0 ≤ D := by
    dsimp [D]
    have hm : 0 ≤ ∫ y, |y| ∂μ := integral_nonneg (fun y => abs_nonneg y)
    positivity
  rw [intervalIntegrable_iff_integrableOn_Ioo_of_le hτ.le]
  apply (integrable_const (C * D)).mono'
  · apply Measurable.aestronglyMeasurable
    fun_prop
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
    have ht1 : t < 1 := ht.2.trans hτ1
    have hdiff : ‖charFun μ (U * t) - (Real.exp (-(U * t) ^ 2 / 2) : ℂ)‖ ≤ t * D := by
      have h := norm_charFun_sub_normal_le_firstMoment μ hμ (U * t)
      rw [abs_of_pos (mul_pos hU ht.1)] at h
      dsimp [D]
      nlinarith [mul_nonneg (sq_nonneg U) (mul_nonneg ht.1.le (sub_nonneg.mpr ht1.le))]
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    calc
      _ ≤ ‖berryEsseenSmoothingKernel t‖ * (t * D) :=
        mul_le_mul_of_nonneg_left hdiff (norm_nonneg _)
      _ = (t * ‖berryEsseenSmoothingKernel t‖) * D := by ring
      _ ≤ C * D := mul_le_mul_of_nonneg_right (mul_norm_smoothing_kernel_le ht.1 ht1) hD

theorem intervalIntegrable_smoothing_correction {U τ : ℝ} (hτ : 0 < τ) (hτ1 : τ < 1) :
    IntervalIntegrable (fun t : ℝ =>
      ‖berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)‖ *
        Real.exp (-(U * t) ^ 2 / 2)) volume 0 τ := by
  let C := (1 + Real.pi ^ 2 / 3) / 2
  have hC : 0 ≤ C := by dsimp [C]; positivity
  rw [intervalIntegrable_iff_integrableOn_Ioo_of_le hτ.le]
  apply (integrable_const C).mono'
  · apply Measurable.aestronglyMeasurable
    fun_prop
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    calc
      _ ≤ C * Real.exp (-(U * t) ^ 2 / 2) :=
        mul_le_mul_of_nonneg_right (norm_smoothing_kernel_correction_le ht.1 (ht.2.trans hτ1))
          (Real.exp_pos _).le
      _ ≤ C := mul_le_of_le_one_right hC (Real.exp_le_one_iff.mpr (by linarith [sq_nonneg (U * t)]))

private theorem intervalIntegrable_smoothing_high (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (U : ℝ) {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ < 1) :
    IntervalIntegrable (fun t : ℝ => ‖berryEsseenSmoothingKernel t‖ * ‖charFun μ (U * t)‖)
      volume τ 1 := by
  let C := (1 + Real.pi ^ 2 / 3) / 2 + 1 / (2 * Real.pi * τ)
  rw [intervalIntegrable_iff_integrableOn_Ioo_of_le hτ1.le]
  apply (integrable_const C).mono'
  · apply Measurable.aestronglyMeasurable
    fun_prop
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
    have ht0 : 0 < t := hτ.trans ht.1
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    calc
      _ ≤ ‖berryEsseenSmoothingKernel t‖ := mul_le_of_le_one_right (norm_nonneg _) (norm_charFun_le_one _)
      _ ≤ (1 + Real.pi ^ 2 / 3) / 2 + 1 / (2 * Real.pi * t) := norm_smoothing_kernel_le ht0 ht.2
      _ ≤ C := by
        apply add_le_add le_rfl
        exact one_div_le_one_div_of_le (by positivity) (mul_le_mul_of_nonneg_left ht.1.le (by positivity))

/-- The four-term smoothing error bound holds for every probability measure with finite first
absolute moment; all endpoint-integrability conditions follow from that hypothesis. -/
theorem berryEsseen_smoothing_error (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ : Integrable (fun y : ℝ => y) μ) {U τ : ℝ} (hU : 0 < U) (hτ : 0 < τ) (hτ1 : τ < 1) (x : ℝ) :
    |cdf μ x - cdf (gaussianReal 0 1) x| ≤
      2 * (∫ t in (0 : ℝ)..τ, ‖berryEsseenSmoothingKernel t‖ *
        ‖charFun μ (U * t) - (Real.exp (-(U * t) ^ 2 / 2) : ℂ)‖) +
      2 * (∫ t in τ..1, ‖berryEsseenSmoothingKernel t‖ * ‖charFun μ (U * t)‖) +
      2 * (∫ t in (0 : ℝ)..τ, ‖berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)‖ *
        Real.exp (-(U * t) ^ 2 / 2)) +
      ∫ t in Ioi τ, (1 / (Real.pi * t)) * Real.exp (-(U * t) ^ 2 / 2) :=
  berryEsseen_smoothing_error_of_integrable μ hμ hU hτ hτ1
    (intervalIntegrable_smoothing_error μ hμ hU hτ hτ1)
    (intervalIntegrable_smoothing_correction hτ hτ1)
    (intervalIntegrable_smoothing_high μ U hτ hτ1) x


@[fun_prop] theorem continuous_berryEsseenNormalErrorBound (ℓ q : ℝ) :
    Continuous (berryEsseenNormalErrorBound ℓ q) := by
  let B (u : ℝ) := clippedSine (u * ℓ / 4) * u *
    Real.exp ((49581 / 250000 : ℝ) * ℓ * u ^ 3 +
      berryEsseenResidualBump (min (u * q) (250000 / 148743)))
  have hB : Continuous B := by unfold B berryEsseenResidualBump; fun_prop
  have hI : Continuous (fun t : ℝ => ∫ u in (0 : ℝ)..t, B u) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous
      (f := fun _ u => B u) (by fun_prop) continuous_id
  unfold berryEsseenNormalErrorBound
  exact (by fun_prop : Continuous (fun t : ℝ => 2 * Real.exp (-t ^ 2 / 2))).mul hI

/-- The normal-error majorant vanishes at least linearly at the origin on bounded intervals. -/
theorem berryEsseenNormalErrorBound_le_linear (ℓ q : ℝ) {U : ℝ} (hU : 0 ≤ U) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u ∈ Icc 0 U, ‖berryEsseenNormalErrorBound ℓ q u‖ ≤ C * u := by
  let B (u : ℝ) := clippedSine (u * ℓ / 4) * u *
    Real.exp ((49581 / 250000 : ℝ) * ℓ * u ^ 3 +
      berryEsseenResidualBump (min (u * q) (250000 / 148743)))
  have hB : Continuous B := by unfold B berryEsseenResidualBump; fun_prop
  obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn (hB.continuousOn (s := Icc 0 U))
  have hC0 : 0 ≤ C := (norm_nonneg (B 0)).trans (hC 0 ⟨le_rfl, hU⟩)
  refine ⟨2 * C, by positivity, ?_⟩
  intro u hu
  have hi : ‖∫ v in (0 : ℝ)..u, B v‖ ≤ C * u := by
    have h := intervalIntegral.norm_integral_le_of_norm_le_const
      (a := 0) (b := u) (C := C) (f := B) (fun v hv => ?_)
    · simpa only [sub_zero, abs_of_nonneg hu.1] using h
    · rw [uIoc_of_le hu.1] at hv
      exact hC v ⟨hv.1.le, hv.2.trans hu.2⟩
  have he : Real.exp (-u ^ 2 / 2) ≤ 1 := Real.exp_le_one_iff.mpr (by nlinarith [sq_nonneg u])
  calc
    _ = 2 * Real.exp (-u ^ 2 / 2) * ‖∫ v in (0 : ℝ)..u, B v‖ := by
      unfold berryEsseenNormalErrorBound
      simp only [B, norm_mul, Real.norm_eq_abs, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2),
        abs_of_pos (Real.exp_pos _)]
    _ ≤ 2 * 1 * (C * u) := mul_le_mul
      (mul_le_mul_of_nonneg_left he (by norm_num)) hi (norm_nonneg _) (by norm_num)
    _ = _ := by ring

/-- The kernel pole is integrable against the explicit normal-error envelope. -/
theorem intervalIntegrable_smoothing_normalErrorBound (ℓ q : ℝ) {U τ : ℝ}
    (hU : 0 < U) (hτ : 0 < τ) (hτ1 : τ < 1) :
    IntervalIntegrable (fun t : ℝ => ‖berryEsseenSmoothingKernel t‖ *
      berryEsseenNormalErrorBound ℓ q (U * t)) volume 0 τ := by
  obtain ⟨C, hC, hlinear⟩ := berryEsseenNormalErrorBound_le_linear ℓ q hU.le
  let D := (1 + Real.pi ^ 2 / 3) / 2 + 1 / (2 * Real.pi)
  rw [intervalIntegrable_iff_integrableOn_Ioo_of_le hτ.le]
  apply (integrable_const (D * (C * U))).mono'
  · apply Measurable.aestronglyMeasurable
    fun_prop
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
    have ht0 := ht.1.le
    have ht1 : t ≤ 1 := (ht.2.trans hτ1).le
    have harg : U * t ∈ Icc 0 U := ⟨mul_nonneg hU.le ht0, mul_le_of_le_one_right hU.le ht1⟩
    rw [norm_mul, norm_norm]
    calc
      _ ≤ ‖berryEsseenSmoothingKernel t‖ * (C * (U * t)) :=
        mul_le_mul_of_nonneg_left (hlinear (U * t) harg) (norm_nonneg _)
      _ = (t * ‖berryEsseenSmoothingKernel t‖) * (C * U) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right
        (mul_norm_smoothing_kernel_le ht.1 (ht.2.trans hτ1)) (mul_nonneg hC hU.le)

/-- The positive cotangent correction obtained by subtracting the pole of the smoothing kernel. -/
def berryEsseenCotangentCorrection (t : ℝ) : ℝ :=
  (1 - t) * (1 / (Real.pi * t) - Real.cot (Real.pi * t))

private theorem real_cotangent_series {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    Summable (fun n : ℕ => 1 / (((n : ℝ) + 1) ^ 2 - t ^ 2)) ∧
      Real.pi * Real.cot (Real.pi * t) - 1 / t =
        (-2 * t) * ∑' n : ℕ, 1 / (((n : ℝ) + 1) ^ 2 - t ^ 2) := by
  have hz : (t : ℂ) ∈ Complex.integerComplement := by
    rw [Complex.mem_integerComplement_iff]
    rintro ⟨n, hn⟩
    have hnt : (n : ℝ) = t := by exact_mod_cast congrArg Complex.re hn
    have hn0 : (0 : ℤ) < n := by exact_mod_cast (hnt.symm ▸ ht)
    have hn1 : n < (1 : ℤ) := by exact_mod_cast (hnt.symm ▸ ht1)
    omega
  have hterm (n : ℕ) : (cotTerm (t : ℂ) n).re =
      (-2 * t) * (1 / (((n : ℝ) + 1) ^ 2 - t ^ 2)) := by
    have hn : 0 ≤ (n : ℝ) := Nat.cast_nonneg n
    have hminus : t - ((n : ℝ) + 1) ≠ 0 := by linarith
    have hplus : t + ((n : ℝ) + 1) ≠ 0 := by positivity
    have hminusC : (t : ℂ) - ((n : ℂ) + 1) ≠ 0 := by exact_mod_cast hminus
    have hplusC : (t : ℂ) + ((n : ℂ) + 1) ≠ 0 := by exact_mod_cast hplus
    have hsqR : ((n : ℝ) + 1) ^ 2 - t ^ 2 ≠ 0 := by nlinarith
    have hsqC : ((n : ℂ) + 1) ^ 2 - (t : ℂ) ^ 2 ≠ 0 := by exact_mod_cast hsqR
    have heq : cotTerm (t : ℂ) n =
        (((-2 * t) * (1 / (((n : ℝ) + 1) ^ 2 - t ^ 2)) : ℝ) : ℂ) := by
      unfold cotTerm
      push_cast
      field_simp [hminusC, hplusC, hsqC]
      ring
    rw [heq, Complex.ofReal_re]
  have hcs := summable_cotTerm hz
  have hrs := (Complex.hasSum_re hcs.hasSum).summable
  simp_rw [hterm] at hrs
  have hs : Summable (fun n : ℕ => 1 / (((n : ℝ) + 1) ^ 2 - t ^ 2)) := by
    have h := hrs.mul_left (-1 / (2 * t))
    convert! h using 1
    ext n
    field_simp
  refine ⟨hs, ?_⟩
  have h := congrArg Complex.re (cot_series_rep' hz)
  have hleft : (Real.pi : ℂ) * Complex.cot ((Real.pi : ℂ) * (t : ℂ)) - 1 / (t : ℂ) =
      ((Real.pi * Real.cot (Real.pi * t) - 1 / t : ℝ) : ℂ) := by
    simp only [Complex.ofReal_sub, Complex.ofReal_mul, Complex.ofReal_div,
      Complex.ofReal_one, Complex.ofReal_cot]
  rw [hleft, Complex.ofReal_re, Complex.re_tsum hcs] at h
  simp_rw [hterm] at h
  rw [tsum_mul_left] at h
  exact h

/-- The reciprocal series used by the smoothing correction is summable on the open unit interval. -/
theorem summable_cotangent_reciprocal {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    Summable (fun n : ℕ => 1 / (((n : ℝ) + 1) ^ 2 - t ^ 2)) :=
  (real_cotangent_series ht ht1).1

/-- The smoothing correction has a positive reciprocal-square series. -/
theorem berryEsseenCotangentCorrection_series {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    berryEsseenCotangentCorrection t = (2 * t * (1 - t) / Real.pi) *
      ∑' n : ℕ, 1 / (((n : ℝ) + 1) ^ 2 - t ^ 2) := by
  have h := (real_cotangent_series ht ht1).2
  have heq : 1 / (Real.pi * t) - Real.cot (Real.pi * t) =
      -(Real.pi * Real.cot (Real.pi * t) - 1 / t) / Real.pi := by field_simp; ring
  unfold berryEsseenCotangentCorrection
  rw [heq, h]
  ring

private theorem hasSum_reciprocal_shifted_difference {x : ℝ} (hx : 0 < x) :
    HasSum (fun n : ℕ => 1 / (x + n) - 1 / (x + (n + 1))) (1 / x) := by
  have hn (n : ℕ) : 0 ≤ 1 / (x + n) - 1 / (x + (n + 1)) := by
    apply sub_nonneg.mpr
    apply one_div_le_one_div_of_le (by positivity)
    linarith
  apply (hasSum_iff_tendsto_nat_of_nonneg hn _).mpr
  have heq (n : ℕ) : (∑ k ∈ Finset.range n, (1 / (x + k) - 1 / (x + (k + 1)))) =
      1 / x - 1 / (x + n) := by
    simpa only [Nat.cast_zero, Nat.cast_add, Nat.cast_one, add_zero] using
      Finset.sum_range_sub' (fun k : ℕ => 1 / (x + k)) n
  simp_rw [heq]
  have ht : Tendsto (fun n : ℕ => 1 / (x + n)) atTop (𝓝 0) := by
    have hnat : Tendsto (fun n : ℕ => x + (n : ℝ)) atTop atTop :=
      atTop.tendsto_atTop_add_const_left x tendsto_natCast_atTop_atTop
    simpa only [one_div, Function.comp_def] using tendsto_inv_atTop_zero.comp hnat
  simpa using tendsto_const_nhds.sub ht

private theorem hasSum_reciprocal_square_sub_one :
    HasSum (fun n : ℕ => 1 / (((n : ℝ) + 2) ^ 2 - 1)) (3 / 4 : ℝ) := by
  have h := ((hasSum_reciprocal_shifted_difference (x := 1) (by norm_num)).add
    (hasSum_reciprocal_shifted_difference (x := 2) (by norm_num))).mul_left (1 / 2 : ℝ)
  convert! h using 1
  · ext n
    have hn : 0 ≤ (n : ℝ) := Nat.cast_nonneg n
    have hsq : ((n : ℝ) + 2) ^ 2 - 1 ≠ 0 := by nlinarith
    field_simp [hsq]
    ring
  · norm_num

/-- A rational upper bound for the positive cotangent correction, valid throughout the unit interval. -/
theorem berryEsseenCotangentCorrection_bounds {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    0 ≤ berryEsseenCotangentCorrection t ∧
      berryEsseenCotangentCorrection t ≤ t * (7 - 3 * t ^ 2) / (2 * Real.pi * (1 + t)) := by
  have hden (n : ℕ) : 0 < ((n : ℝ) + 1) ^ 2 - t ^ 2 := by
    have hn : 0 ≤ (n : ℝ) := Nat.cast_nonneg n
    nlinarith
  have hs := (real_cotangent_series ht ht1).1
  have htail : Summable (fun n : ℕ => 1 / (((n : ℝ) + 2) ^ 2 - t ^ 2)) := by
    simpa only [Nat.cast_add, Nat.cast_one, add_assoc, one_add_one_eq_two] using
      (summable_nat_add_iff 1).mpr hs
  have htaille : (∑' n : ℕ, 1 / (((n : ℝ) + 2) ^ 2 - t ^ 2)) ≤ 3 / 4 := by
    apply hasSum_le _ htail.hasSum hasSum_reciprocal_square_sub_one
    intro n
    have hn : 0 ≤ (n : ℝ) := Nat.cast_nonneg n
    apply one_div_le_one_div_of_le (by nlinarith)
    nlinarith
  have hsplit : (∑' n : ℕ, 1 / (((n : ℝ) + 1) ^ 2 - t ^ 2)) =
      1 / (1 - t ^ 2) + ∑' n : ℕ, 1 / (((n : ℝ) + 2) ^ 2 - t ^ 2) := by
    rw [← hs.sum_add_tsum_nat_add 1]
    norm_num [add_assoc]
  rw [berryEsseenCotangentCorrection_series ht ht1]
  constructor
  · exact mul_nonneg (by positivity) (tsum_nonneg (fun n => (one_div_pos.mpr (hden n)).le))
  · rw [hsplit]
    calc
      _ ≤ (2 * t * (1 - t) / Real.pi) * (1 / (1 - t ^ 2) + 3 / 4) := by
        exact mul_le_mul_of_nonneg_left (add_le_add le_rfl htaille) (by positivity)
      _ = _ := by
        have hneq : 1 - t ^ 2 ≠ 0 := by nlinarith
        field_simp
        ring

/-- The first term in the cotangent power series gives a uniform lower bound for the correction. -/
theorem berryEsseenCotangentCorrection_lower {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    Real.pi * t * (1 - t) / 3 ≤ berryEsseenCotangentCorrection t := by
  have hden (n : ℕ) : 0 < ((n : ℝ) + 1) ^ 2 - t ^ 2 := by
    have hn : 0 ≤ (n : ℝ) := Nat.cast_nonneg n
    nlinarith
  have hsbase : HasSum (fun n : ℕ => 1 / ((n : ℝ) + 1) ^ 2) (Real.pi ^ 2 / 6) := by
    simpa using (hasSum_nat_add_iff' 1).mpr hasSum_zeta_two
  have hs := summable_cotangent_reciprocal ht ht1
  have hlower : Real.pi ^ 2 / 6 ≤ ∑' n : ℕ, 1 / (((n : ℝ) + 1) ^ 2 - t ^ 2) := by
    apply hasSum_le _ hsbase hs.hasSum
    intro n
    exact one_div_le_one_div_of_le (hden n) (by linarith [sq_nonneg t])
  rw [berryEsseenCotangentCorrection_series ht ht1]
  calc
    _ = (2 * t * (1 - t) / Real.pi) * (Real.pi ^ 2 / 6) := by field_simp; ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hlower (by positivity)

theorem berryEsseenCotangentCorrection_le_rational {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    berryEsseenCotangentCorrection t ≤ t * (7 - 3 * t ^ 2) / (6 * (1 + t)) := by
  refine (berryEsseenCotangentCorrection_bounds ht ht1).2.trans ?_
  apply div_le_div_of_nonneg_left
  · have : t ^ 2 ≤ 1 := by nlinarith
    exact mul_nonneg ht.le (by nlinarith)
  · positivity
  · have hp := Real.pi_gt_three
    nlinarith

private theorem cotangentCorrection_sq_le {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    berryEsseenCotangentCorrection t ^ 2 ≤ 2 * t / 3 - 5 * t ^ 2 / 9 := by
  have hC0 := (berryEsseenCotangentCorrection_bounds ht ht1).1
  have hC1 := berryEsseenCotangentCorrection_le_rational ht ht1
  have hR0 : 0 ≤ t * (7 - 3 * t ^ 2) / (6 * (1 + t)) := hC0.trans hC1
  have hsq := (sq_le_sq₀ hC0 hR0).mpr hC1
  have hfactor : 0 ≤ 24 + 3 * t - 13 * t ^ 2 + 9 * t ^ 3 + 9 * t ^ 4 := by
    have ht2 : t ^ 2 ≤ 1 := by nlinarith
    nlinarith [pow_nonneg ht.le 3, pow_nonneg ht.le 4]
  have hpoly : 0 ≤ 4 * t * (6 - 5 * t) * (1 + t) ^ 2 - t ^ 2 * (7 - 3 * t ^ 2) ^ 2 := by
    have heq : 4 * t * (6 - 5 * t) * (1 + t) ^ 2 - t ^ 2 * (7 - 3 * t ^ 2) ^ 2 =
        t * (1 - t) * (24 + 3 * t - 13 * t ^ 2 + 9 * t ^ 3 + 9 * t ^ 4) := by ring
    rw [heq]
    exact mul_nonneg (mul_nonneg ht.le (sub_pos.mpr ht1).le) hfactor
  apply hsq.trans
  rw [div_pow]
  apply (div_le_iff₀ (by positivity : 0 < (6 * (1 + t)) ^ 2)).mpr
  nlinarith

/-- A sharp linear bound for the smoothing-kernel correction, including its limiting
behavior at both endpoints through the open interval. -/
theorem norm_smoothing_kernel_correction_le_linear {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    ‖berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)‖ ≤ 1 / 2 - t / 3 := by
  have hr : (berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)).re = (1 - t) / 2 := by
    simp only [Complex.sub_re, Complex.div_ofReal_re, Complex.I_re,
      berryEsseenSmoothingKernel, zero_div, sub_zero]
  have hi : (berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)).im =
      -berryEsseenCotangentCorrection t / 2 := by
    simp only [Complex.sub_im, Complex.div_ofReal_im, Complex.I_im,
      berryEsseenSmoothingKernel, berryEsseenCotangentCorrection, Real.cot_eq_cos_div_sin]
    field_simp
    ring
  have hnorm := Complex.sq_norm_sub_sq_re (berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ))
  rw [hr, hi] at hnorm
  have hsq := cotangentCorrection_sq_le ht ht1
  have hnon : 0 ≤ 1 / 2 - t / 3 := by linarith
  nlinarith [norm_nonneg (berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ))]

/-- Reflection moves the cotangent correction away from its upper endpoint. -/
theorem berryEsseenCotangentCorrection_reflect {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    berryEsseenCotangentCorrection t = 1 / (Real.pi * t) -
      ((1 - t) / t) * berryEsseenCotangentCorrection (1 - t) := by
  have hcot : Real.cot (Real.pi * (1 - t)) = -Real.cot (Real.pi * t) := by
    rw [show Real.pi * (1 - t) = Real.pi - Real.pi * t by ring]
    simp only [Real.cot_eq_cos_div_sin, Real.cos_pi_sub, Real.sin_pi_sub, neg_div]
  unfold berryEsseenCotangentCorrection
  rw [hcot]
  have ht0 := ht.ne'
  have ht10 := (sub_pos.mpr ht1).ne'
  field_simp
  ring

private theorem cotangentCorrection_half_le {s : ℝ} (hs : 0 < s) (hs1 : s ≤ 1 / 2) :
    berryEsseenCotangentCorrection s ≤ (25 / 36 : ℝ) * (1 - s) := by
  refine (berryEsseenCotangentCorrection_le_rational hs (by linarith)).trans ?_
  apply (div_le_iff₀ (by positivity : 0 < 6 * (1 + s))).mpr
  have hf : 0 ≤ 25 + 8 * s - 9 * s ^ 2 := by nlinarith
  have hp := mul_nonneg (by linarith : 0 ≤ 1 - 2 * s) hf
  nlinarith

/-- Above half the cutoff, the smoothing-kernel norm decays linearly to its upper endpoint. -/
theorem norm_smoothing_kernel_high_le {t : ℝ} (ht : 1 / 2 ≤ t) (ht1 : t < 1) :
    ‖berryEsseenSmoothingKernel t‖ ≤ (61 / 100 : ℝ) * (1 - t) := by
  have ht0 : 0 < t := by linarith
  have hs : 0 < 1 - t := sub_pos.mpr ht1
  have hhalf := cotangentCorrection_half_le hs (by linarith : 1 - t ≤ 1 / 2)
  have hC0 := (berryEsseenCotangentCorrection_bounds hs (by linarith : 1 - t < 1)).1
  have hr : (berryEsseenSmoothingKernel t).re = (1 - t) / 2 := rfl
  have hi : (berryEsseenSmoothingKernel t).im =
      ((1 - t) / (2 * t)) * berryEsseenCotangentCorrection (1 - t) := by
    have hid : (berryEsseenSmoothingKernel t).im =
        (1 / (Real.pi * t) - berryEsseenCotangentCorrection t) / 2 := by
      simp only [berryEsseenSmoothingKernel, berryEsseenCotangentCorrection,
        Real.cot_eq_cos_div_sin]
      field_simp
      ring
    rw [hid, berryEsseenCotangentCorrection_reflect ht0 ht1]
    ring
  have hi0 : 0 ≤ (berryEsseenSmoothingKernel t).im := by rw [hi]; positivity
  have hi1 : (berryEsseenSmoothingKernel t).im ≤ (1 - t) * (25 / 72 : ℝ) := by
    rw [hi]
    have h := mul_le_mul_of_nonneg_left hhalf (by positivity : 0 ≤ (1 - t) / (2 * t))
    convert! h using 1
    field_simp
    ring
  have hib : 0 ≤ (1 - t) * (25 / 72 : ℝ) := by positivity
  have hisq := (sq_le_sq₀ hi0 hib).mpr hi1
  have hnorm := Complex.sq_norm_sub_sq_re (berryEsseenSmoothingKernel t)
  rw [hr] at hnorm
  have hright : 0 ≤ (61 / 100 : ℝ) * (1 - t) := by positivity
  nlinarith [norm_nonneg (berryEsseenSmoothingKernel t), sq_nonneg (1 - t)]

/-- On the upper half of the cutoff interval the pole alone dominates the kernel norm. -/
theorem norm_smoothing_kernel_high_le_pole {t : ℝ} (ht : 1 / 2 ≤ t) (ht1 : t < 1) :
    ‖berryEsseenSmoothingKernel t‖ ≤ 1 / (2 * Real.pi * t) := by
  refine (norm_smoothing_kernel_high_le ht ht1).trans ?_
  have ht0 : 0 < t := by linarith
  apply (le_div_iff₀ (by positivity : 0 < 2 * Real.pi * t)).mpr
  have hprod : t * (1 - t) ≤ 1 / 4 := by nlinarith [sq_nonneg (t - 1 / 2)]
  have hp : (61 / 50 : ℝ) * Real.pi * (t * (1 - t)) ≤
      (61 / 50 : ℝ) * (63 / 20) * (1 / 4) := by
    apply mul_le_mul
    · exact mul_le_mul_of_nonneg_left (by have h := Real.pi_lt_d2; norm_num at h ⊢; linarith) (by norm_num)
    · exact hprod
    · positivity
    · norm_num
  nlinarith

private theorem kernel_pole_polynomial_nonneg {t : ℝ} (ht : 0 ≤ t) (ht1 : t ≤ 1 / 2) :
    0 ≤ 72 - 615*t + 1626*t^2 - 55*t^3 - 1536*t^4 + 384*t^5 - 576*t^7 := by
  by_cases hh : t ≤ 1 / 4
  · have hz0 : 0 ≤ 4*t := by positivity
    have hz1 : 0 ≤ 1-(4*t) := by linarith
    have heq : 72 - 615*t + 1626*t^2 - 55*t^3 - 1536*t^4 + 384*t^5 - 576*t^7 =
      72 * (4*t)^0 * (1-(4*t))^7 +
      (1401 / 4 : ℝ) * (4*t)^1 * (1-(4*t))^6 +
      (5529 / 8 : ℝ) * (4*t)^2 * (1-(4*t))^5 +
      (46145 / 64 : ℝ) * (4*t)^3 * (1-(4*t))^4 +
      (7229 / 16 : ℝ) * (4*t)^4 * (1-(4*t))^3 +
      (6375 / 32 : ℝ) * (4*t)^5 * (1-(4*t))^2 +
      (1103 / 16 : ℝ) * (4*t)^6 * (1-(4*t))^1 +
      (3419 / 256 : ℝ) * (4*t)^7 * (1-(4*t))^0 := by ring
    rw [heq]
    positivity
  · have hz0 : 0 ≤ 4*t-1 := by linarith
    have hz1 : 0 ≤ 1-(4*t-1) := by linarith
    have heq : 72 - 615*t + 1626*t^2 - 55*t^3 - 1536*t^4 + 384*t^5 - 576*t^7 =
      (3419 / 256 : ℝ) * (4*t-1)^0 * (1-(4*t-1))^7 +
      (15109 / 128 : ℝ) * (4*t-1)^1 * (1-(4*t-1))^6 +
      (31605 / 64 : ℝ) * (4*t-1)^2 * (1-(4*t-1))^5 +
      (36597 / 32 : ℝ) * (4*t-1)^3 * (1-(4*t-1))^4 +
      (97557 / 64 : ℝ) * (4*t-1)^4 * (1-(4*t-1))^3 +
      (37083 / 32 : ℝ) * (4*t-1)^5 * (1-(4*t-1))^2 +
      (7435 / 16 : ℝ) * (4*t-1)^6 * (1-(4*t-1))^1 +
      (605 / 8 : ℝ) * (4*t-1)^7 * (1-(4*t-1))^0 := by ring
    rw [heq]
    positivity

/-- A rational pole bound for the smoothing kernel, uniform over the open cutoff interval. -/
theorem norm_smoothing_kernel_le_pole_add {t : ℝ} (ht : 0 < t) (ht1 : t < 1) :
    ‖berryEsseenSmoothingKernel t‖ ≤ 1 / (2 * Real.pi * t) + 1 / 32 := by
  by_cases hh : 1 / 2 ≤ t
  · have h := norm_smoothing_kernel_high_le_pole hh ht1
    linarith
  have ht2 : t ≤ 1 / 2 := (not_le.mp hh).le
  have hp : 0 < Real.pi * t := mul_pos Real.pi_pos ht
  have hC0 := (berryEsseenCotangentCorrection_bounds ht ht1).1
  have hC1 := berryEsseenCotangentCorrection_le_rational ht ht1
  have hR0 : 0 ≤ t * (7 - 3 * t ^ 2) / (6 * (1 + t)) := hC0.trans hC1
  have hC2 := (sq_le_sq₀ hC0 hR0).mpr hC1
  have hprod : (1 - t) / 3 ≤ berryEsseenCotangentCorrection t * (1 / (Real.pi * t)) := by
    have h := mul_le_mul_of_nonneg_right (berryEsseenCotangentCorrection_lower ht ht1)
      (le_of_lt (one_div_pos.mpr hp))
    convert! h using 1
    field_simp
  have hpoly := kernel_pole_polynomial_nonneg ht.le ht2
  have hR : (t * (7 - 3 * t ^ 2) / (6 * (1 + t))) ^ 2 ≤
      1 / (32 * t) + 1 / 256 - (1 - t)^2 + 2 * (1 - t) / 3 := by
    have hd : 0 < 2304*t*(1+t)^2 := by positivity
    have heq : (1 / (32 * t) + 1 / 256 - (1 - t)^2 + 2 * (1 - t) / 3 -
        (t * (7 - 3 * t ^ 2) / (6 * (1 + t))) ^ 2) * (2304*t*(1+t)^2) =
        72 - 615*t + 1626*t^2 - 55*t^3 - 1536*t^4 + 384*t^5 - 576*t^7 := by
      field_simp
      ring
    have := (mul_nonneg_iff_of_pos_right hd).mp (show 0 ≤ _ from heq.symm ▸ hpoly)
    linarith
  have hp4 : 1 / (4*t) ≤ 1 / (Real.pi*t) :=
    one_div_le_one_div_of_le hp (mul_le_mul_of_nonneg_right Real.pi_lt_four.le ht.le)
  have hr : (berryEsseenSmoothingKernel t).re = (1-t)/2 := rfl
  have hi : (berryEsseenSmoothingKernel t).im =
      (1 / (Real.pi*t) - berryEsseenCotangentCorrection t) / 2 := by
    simp only [berryEsseenSmoothingKernel, berryEsseenCotangentCorrection,
      Real.cot_eq_cos_div_sin]
    field_simp
    ring
  have hnorm := Complex.sq_norm_sub_sq_re (berryEsseenSmoothingKernel t)
  rw [hr, hi] at hnorm
  have hscale : 1 / (32*t) = (1 / (4*t)) / 8 := by ring
  have hright : 0 ≤ 1 / (2*Real.pi*t) + 1 / 32 := by positivity
  have hpole : 1 / (2*Real.pi*t) = (1 / (Real.pi*t)) / 2 := by ring
  rw [hscale] at hR
  rw [hpole] at hright ⊢
  nlinarith [norm_nonneg (berryEsseenSmoothingKernel t)]

/-- Finite product sums preserve every available absolute moment. -/
theorem memLp_product_sum_measure {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)] {p : ENNReal}
    (hm : ∀ i, MemLp id p (μ i)) :
    MemLp id p ((Measure.pi μ).map (fun z => ∑ i, z i)) := by
  rw [memLp_map_measure_iff (by fun_prop) (by fun_prop)]
  apply memLp_finsetSum Finset.univ
  intro i _
  exact (hm i).comp_measurePreserving (measurePreserving_eval μ i)

/-- The fully explicit analytic CDF-error bound awaiting numerical certification. -/
def berryEsseenCDFErrorBound (ℓ q U τ : ℝ) : ℝ :=
  2 * (∫ t in (0 : ℝ)..τ, ‖berryEsseenSmoothingKernel t‖ *
    berryEsseenNormalErrorBound ℓ q (U * t)) +
  2 * (∫ t in τ..1, ‖berryEsseenSmoothingKernel t‖ * berryEsseenMagnitudeBound ℓ (U * t)) +
  2 * (∫ t in (0 : ℝ)..τ, ‖berryEsseenSmoothingKernel t - Complex.I / (2 * Real.pi * t : ℝ)‖ *
    Real.exp (-(U * t) ^ 2 / 2)) +
  ∫ t in Ioi τ, (1 / (Real.pi * t)) * Real.exp (-(U * t) ^ 2 / 2)

/-- The high-frequency finite magnitude envelope is integrable against the smoothing kernel. -/
theorem intervalIntegrable_smoothing_magnitudeBound (ℓ U : ℝ) {τ : ℝ}
    (hτ : 0 < τ) (hτ1 : τ < 1) :
    IntervalIntegrable (fun t : ℝ => ‖berryEsseenSmoothingKernel t‖ *
      berryEsseenMagnitudeBound ℓ (U * t)) volume τ 1 := by
  let C := (1 + Real.pi ^ 2 / 3) / 2 + 1 / (2 * Real.pi * τ)
  rw [intervalIntegrable_iff_integrableOn_Ioo_of_le hτ1.le]
  apply (integrable_const C).mono'
  · apply Measurable.aestronglyMeasurable
    fun_prop
  · filter_upwards [ae_restrict_mem measurableSet_Ioo] with t ht
    have ht0 : 0 < t := hτ.trans ht.1
    rw [norm_mul, norm_norm, Real.norm_eq_abs,
      abs_of_nonneg (berryEsseenMagnitudeBound_nonneg ℓ (U * t))]
    calc
      _ ≤ ‖berryEsseenSmoothingKernel t‖ := mul_le_of_le_one_right (norm_nonneg _)
        (min_le_left _ _)
      _ ≤ (1 + Real.pi ^ 2 / 3) / 2 + 1 / (2 * Real.pi * t) := norm_smoothing_kernel_le ht0 ht.2
      _ ≤ C := by
        apply add_le_add le_rfl
        exact one_div_le_one_div_of_le (by positivity) (mul_le_mul_of_nonneg_left ht.1.le (by positivity))

/-- Every normalized finite product of centered laws satisfies the explicit analytic
Berry–Esseen bound; all smoothing integrability conditions are discharged. -/
theorem berryEsseen_product_cdf_error_le {ι : Type*} [Fintype ι]
    (μ : ι → Measure ℝ) [∀ i, IsProbabilityMeasure (μ i)]
    (hm : ∀ i, MemLp id 3 (μ i)) (hmean : ∀ i, (∫ x, x ∂μ i) = 0)
    (hv : (∑ i, ∫ x, x ^ 2 ∂μ i) = 1) {ℓ q U τ : ℝ}
    (hthird : (∑ i, ∫ x, |x| ^ 3 ∂μ i) ≤ ℓ)
    (hq : 0 ≤ q) (hthirdq : (∑ i, ∫ x, |x| ^ 3 ∂μ i) ≤ q ^ 3)
    (hU : 0 < U) (hτ : 0 < τ) (hτ1 : τ < 1) (x : ℝ) :
    |cdf ((Measure.pi μ).map (fun z => ∑ i, z i)) x - cdf (gaussianReal 0 1) x| ≤
      berryEsseenCDFErrorBound ℓ q U τ := by
  let ν := (Measure.pi μ).map (fun z => ∑ i, z i)
  have hν : Integrable (fun y : ℝ => y) ν :=
    (memLp_product_sum_measure μ hm).integrable (by norm_num)
  have hbase := berryEsseen_smoothing_error ν hν hU hτ hτ1 x
  have hlow :
      (∫ t in (0 : ℝ)..τ, ‖berryEsseenSmoothingKernel t‖ *
        ‖charFun ν (U * t) - (Real.exp (-(U * t) ^ 2 / 2) : ℂ)‖) ≤
      (∫ t in (0 : ℝ)..τ, ‖berryEsseenSmoothingKernel t‖ *
        berryEsseenNormalErrorBound ℓ q (U * t)) := by
    rw [intervalIntegral.integral_of_le hτ.le, intervalIntegral.integral_of_le hτ.le]
    apply integral_mono_of_nonneg (Eventually.of_forall (fun t => mul_nonneg (norm_nonneg _) (norm_nonneg _)))
      (intervalIntegrable_smoothing_normalErrorBound ℓ q hU hτ hτ1).1
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with t ht
    exact mul_le_mul_of_nonneg_left
      (charFun_product_normal_error_le μ hm hmean hv hthird hq hthirdq (mul_nonneg hU.le ht.1.le)) (norm_nonneg _)
  have hhigh :
      (∫ t in τ..1, ‖berryEsseenSmoothingKernel t‖ * ‖charFun ν (U * t)‖) ≤
      (∫ t in τ..1, ‖berryEsseenSmoothingKernel t‖ * berryEsseenMagnitudeBound ℓ (U * t)) := by
    rw [intervalIntegral.integral_of_le hτ1.le, intervalIntegral.integral_of_le hτ1.le]
    apply integral_mono_of_nonneg (Eventually.of_forall (fun t => mul_nonneg (norm_nonneg _) (norm_nonneg _)))
      (intervalIntegrable_smoothing_magnitudeBound ℓ U hτ hτ1).1
    exact Eventually.of_forall (fun t => mul_le_mul_of_nonneg_left
      (norm_charFun_product_sum_le_magnitude μ hm hmean hv hthird (U * t)) (norm_nonneg _))
  unfold berryEsseenCDFErrorBound
  change |cdf ν x - cdf (gaussianReal 0 1) x| ≤ _
  linarith

end GeometricGaussianLHL

